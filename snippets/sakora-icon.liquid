{% comment %}
  Sakora SVG Icon Library
  Usage: {% render 'sakora-icon', icon: 'star', size: 16, class: 'my-class' %}
  Icons: star, star-outline, arrow-right, search, heart, cart, check,
         science, list, leaf, sparkle, instagram, tiktok, youtube, pinterest,
         bullet, chevron-right, close, plus, minus, user, truck, shield,
         bottle, dropper, sun, refresh, eye, lock, gift
{% endcomment %}
{%- liquid
  assign icon_size  = size  | default: 20
  assign icon_class = class | default: ''
-%}

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="sakora-icon{% if icon_class != '' %} {{ icon_class }}{% endif %}"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}

  {%- when 'star' -%}
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="currentColor" stroke="none"/>

  {%- when 'star-outline' -%}
    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>

  {%- when 'arrow-right' -%}
    <line x1="5" y1="12" x2="19" y2="12"/>
    <polyline points="12 5 19 12 12 19"/>

  {%- when 'search' -%}
    <circle cx="11" cy="11" r="8"/>
    <line x1="21" y1="21" x2="16.65" y2="16.65"/>

  {%- when 'heart' -%}
    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>

  {%- when 'cart' -%}
    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
    <line x1="3" y1="6" x2="21" y2="6"/>
    <path d="M16 10a4 4 0 0 1-8 0"/>

  {%- when 'check' -%}
    <polyline points="20 6 9 17 4 12"/>

  {%- when 'science' -%}
    <path d="M9 3H15"/>
    <path d="M10 3v6l-4 9a1 1 0 0 0 .9 1.45h10.2A1 1 0 0 0 18 18l-4-9V3"/>
    <path d="M6.53 15h10.94"/>

  {%- when 'list' -%}
    <line x1="8" y1="6" x2="21" y2="6"/>
    <line x1="8" y1="12" x2="21" y2="12"/>
    <line x1="8" y1="18" x2="21" y2="18"/>
    <line x1="3" y1="6" x2="3.01" y2="6"/>
    <line x1="3" y1="12" x2="3.01" y2="12"/>
    <line x1="3" y1="18" x2="3.01" y2="18"/>

  {%- when 'leaf' -%}
    <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10z"/>
    <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>

  {%- when 'sparkle' -%}
    <path d="M12 3l1.09 3.26L16.35 7.5l-3.26 1.09L12 11.85l-1.09-3.26L7.65 7.5l3.26-1.09z"/>
    <path d="M5 14l.55 1.64L7.19 16.5 5.55 17.05 5 18.69l-.55-1.64L2.81 16.5l1.64-.55z"/>
    <path d="M19 14l.55 1.64L21.19 16.5 19.55 17.05 19 18.69l-.55-1.64L16.81 16.5l1.64-.55z"/>

  {%- when 'instagram' -%}
    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>

  {%- when 'tiktok' -%}
    <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5" stroke-width="1.8"/>

  {%- when 'youtube' -%}
    <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.54C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
    <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor" stroke="none"/>

  {%- when 'pinterest' -%}
    <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.03-2.83.19-.77 1.25-5.31 1.25-5.31s-.32-.64-.32-1.58c0-1.48.86-2.59 1.93-2.59.91 0 1.35.68 1.35 1.5 0 .92-.58 2.29-.89 3.56-.25 1.06.53 1.93 1.57 1.93 1.88 0 3.33-1.98 3.33-4.84 0-2.53-1.82-4.3-4.42-4.3-3.01 0-4.77 2.26-4.77 4.59 0 .91.35 1.88.79 2.41.09.1.1.2.07.3l-.29 1.18c-.05.19-.16.23-.37.14-1.39-.65-2.26-2.68-2.26-4.32 0-3.51 2.55-6.74 7.35-6.74 3.86 0 6.86 2.75 6.86 6.42 0 3.83-2.41 6.91-5.76 6.91-1.12 0-2.18-.58-2.54-1.27l-.69 2.58c-.25.97-.93 2.18-1.39 2.92.05.01.1.01.15.01z"/>

  {%- when 'bullet' -%}
    <circle cx="12" cy="12" r="3" fill="currentColor" stroke="none"/>

  {%- when 'diamond' -%}
    <polygon points="12 2 22 12 12 22 2 12"/>

  {%- when 'chevron-right' -%}
    <polyline points="9 18 15 12 9 6"/>

  {%- when 'close' -%}
    <line x1="18" y1="6" x2="6" y2="18"/>
    <line x1="6" y1="6" x2="18" y2="18"/>

  {%- when 'plus' -%}
    <line x1="12" y1="5" x2="12" y2="19"/>
    <line x1="5" y1="12" x2="19" y2="12"/>

  {%- when 'minus' -%}
    <line x1="5" y1="12" x2="19" y2="12"/>

  {%- when 'user' -%}
    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
    <circle cx="12" cy="7" r="4"/>

  {%- when 'truck' -%}
    <rect x="1" y="3" width="15" height="13" rx="1"/>
    <path d="M16 8h4l3 4v4h-7V8z"/>
    <circle cx="5.5" cy="18.5" r="2.5"/>
    <circle cx="18.5" cy="18.5" r="2.5"/>

  {%- when 'shield' -%}
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>

  {%- when 'bottle' -%}
    <path d="M9 3h6"/>
    <path d="M10 3v3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2V3"/>
    <line x1="10" y1="12" x2="14" y2="12"/>

  {%- when 'dropper' -%}
    <path d="M2 22l10-10"/>
    <path d="M16 8l2-2a2.83 2.83 0 0 0-4-4l-2 2"/>
    <path d="M10 12l2 2"/>
    <circle cx="19" cy="5" r="1"/>

  {%- when 'sun' -%}
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/>
    <line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/>
    <line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>

  {%- when 'refresh' -%}
    <polyline points="23 4 23 10 17 10"/>
    <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>

  {%- when 'eye' -%}
    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
    <circle cx="12" cy="12" r="3"/>

  {%- when 'lock' -%}
    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>

  {%- when 'gift' -%}
    <polyline points="20 12 20 22 4 22 4 12"/>
    <rect x="2" y="7" width="20" height="5"/>
    <line x1="12" y1="22" x2="12" y2="7"/>
    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/>
    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>

  {%- else -%}
    <circle cx="12" cy="12" r="10"/>

  {%- endcase -%}
</svg>
