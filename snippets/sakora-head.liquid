{% comment %}
  Sakora — Global head assets
  Loads Syne, Outfit, and Space Mono from Google Fonts as the core brand font stack.
  Loaded globally in layouts/theme.liquid.
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">

{{ 'sakora-base.css' | asset_url | stylesheet_tag }}

<style>
  /* ── Judge.me: app block wrapper collapses to 0px in flex column — fix ── */
  .shopify-app-block {
    width: 100% !important;
    min-width: 0 !important;
  }

  /* ── Judge.me revamp widget — mobile overrides ── */
  @media (max-width: 767px) {
    /* Tighten spacing inside review widget */
    #judgeme_product_reviews {
      --jm-space-600: 16px;
      --jm-space-400: 10px;
      --jm-space-300: 8px;
      --jm-space-200: 6px;
    }
    /* Stars */
    #judgeme_product_reviews .jm-star-rating__font-icon {
      font-size: 1em !important;
    }
    /* Compact reviewer avatar */
    #judgeme_product_reviews .jm-reviewer-avatar__initial {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
    }
    /* Small text details */
    #judgeme_product_reviews .jm-reviewer-info__name {
      font-size: 13px !important;
    }
    #judgeme_product_reviews .jm-reviewer-info__date {
      font-size: 11px !important;
    }
    #judgeme_product_reviews .jm-review-item__body-text {
      font-size: 14px !important;
      line-height: 1.6 !important;
    }
  }
</style>

<style>
  /* Base settings mappings for generic blocks using CSS variable overrides */
  :root {
    --font-heading-family: 'Playfair Display', serif;
    --font-body-family: 'Outfit', sans-serif;
    --font-accent-family: 'Outfit', sans-serif;
  }
</style>
