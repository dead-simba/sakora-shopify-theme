{% comment %}
  Glowve — Global head assets (V2)
  Loads Poppins from Google Fonts as the single font family.
  Merchant font pickers in Theme Settings will override if set.
{% endcomment %}

{%- liquid
  assign gv_heading = settings.gv_heading_font
  assign gv_body    = settings.gv_body_font
-%}

{%- comment -%} Poppins — preconnect + stylesheet {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">

{%- comment -%} Merchant font overrides (optional, set in Theme Settings) {%- endcomment -%}
{%- if gv_heading != blank or gv_body != blank -%}
  <style>
    {%- if gv_heading != blank -%}{{ gv_heading | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if gv_body != blank -%}{{ gv_body | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}

{{ 'glowve-base.css' | asset_url | stylesheet_tag }}

<style>
  /* ── Judge.me mobile overrides ── */
  @media (max-width: 767px) {
    .jdgm-rev {
      padding: 20px 0 !important;
    }
    /* collapse empty review bodies so they don't leave a big gap */
    .jdgm-rev__body,
    .jdgm-rev__body p {
      min-height: 0 !important;
      margin-bottom: 4px !important;
      font-size: 14px !important;
      line-height: 1.6 !important;
    }
    .jdgm-rev__icon {
      width: 36px !important;
      height: 36px !important;
      min-width: 36px !important;
      font-size: 13px !important;
      line-height: 36px !important;
    }
    .jdgm-rev__author {
      gap: 8px !important;
      align-items: center !important;
    }
    .jdgm-rev__author-name {
      font-size: 13px !important;
    }
    .jdgm-rev__timestamp {
      font-size: 11px !important;
    }
    .jdgm-rev__rating {
      font-size: 13px !important;
    }
    .jdgm-paginate {
      margin-top: 16px !important;
      text-align: center !important;
    }
    .jdgm-paginate__load-more-text {
      display: inline-block !important;
      padding: 10px 24px !important;
      border: 1px solid #ECECEC !important;
      border-radius: 100px !important;
      font-size: 13px !important;
      color: #1A1A1A !important;
      text-decoration: none !important;
    }
  }
</style>

<style>
  :root {
    {%- comment -%} Override with merchant-selected fonts only if set {%- endcomment -%}
    {%- if gv_heading != blank -%}
      --font-serif: {{ gv_heading.family | json }}, 'Poppins', sans-serif;
      --gv-heading-weight: {{ gv_heading.weight }};
    {%- endif -%}
    {%- if gv_body != blank -%}
      --font-sans: {{ gv_body.family | json }}, 'Poppins', sans-serif;
    {%- endif -%}
    --gv-hero-headline-size: {{ settings.gv_hero_headline_size | default: 52 }}px;
    --gv-section-title-size: {{ settings.gv_section_title_size | default: 48 }}px;
  }
</style>
