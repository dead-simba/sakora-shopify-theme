{% comment %}
  Glowve — Global head assets
  Font faces are served via Shopify CDN using the font_face filter.
  Fallback to system fonts when no font is selected in Theme Settings.
{% endcomment %}

{%- liquid
  assign gv_heading = settings.gv_heading_font
  assign gv_body    = settings.gv_body_font
-%}

{%- if gv_heading != blank or gv_body != blank -%}
  <style>
    {%- if gv_heading != blank -%}{{ gv_heading | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if gv_body != blank -%}{{ gv_body | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}

{{ 'glowve-base.css' | asset_url | stylesheet_tag }}

<style>
  :root {
    {%- if gv_heading != blank -%}
      --font-serif: {{ gv_heading.family | json }}, Georgia, serif;
      --gv-heading-weight: {{ gv_heading.weight }};
    {%- endif -%}
    {%- if gv_body != blank -%}
      --font-sans: {{ gv_body.family | json }}, system-ui, sans-serif;
    {%- endif -%}
    --gv-hero-headline-size: {{ settings.gv_hero_headline_size | default: 80 }}px;
    --gv-section-title-size: {{ settings.gv_section_title_size | default: 52 }}px;
  }
</style>
