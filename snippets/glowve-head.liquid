{% comment %}
  Glowve — Global head assets (V2)
  Loads Poppins from Google Fonts as the single font family.
  Merchant font pickers in Theme Settings will override if set.
{% endcomment %}

{%- liquid
  assign gv_heading = settings.gv_heading_font
  assign gv_body    = settings.gv_body_font
-%}

{%- comment -%} Poppins — preconnect + stylesheet {%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700&display=swap" rel="stylesheet">

{%- comment -%} Merchant font overrides (optional, set in Theme Settings) {%- endcomment -%}
{%- if gv_heading != blank or gv_body != blank -%}
  <style>
    {%- if gv_heading != blank -%}{{ gv_heading | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if gv_body != blank -%}{{ gv_body | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}

{{ 'glowve-base.css' | asset_url | stylesheet_tag }}

<style>
  /* ── Judge.me: app block wrapper collapses to 0px in flex column — fix ── */
  .shopify-app-block {
    width: 100% !important;
    min-width: 0 !important;
  }

  /* ── Judge.me revamp widget — mobile overrides ── */
  @media (max-width: 767px) {
    /* Tighten all spacing tokens inside the widget */
    #judgeme_product_reviews {
      --jm-space-600: 16px;
      --jm-space-400: 10px;
      --jm-space-300: 8px;
      --jm-space-200: 6px;
    }
    /* Smaller stars */
    #judgeme_product_reviews .jm-star-rating__font-icon {
      font-size: 1em !important;
    }
    /* Compact reviewer avatar */
    #judgeme_product_reviews .jm-reviewer-avatar__initial {
      width: 32px !important;
      height: 32px !important;
      min-width: 32px !important;
    }
    /* Smaller name + date text */
    #judgeme_product_reviews .jm-reviewer-info__name {
      font-size: 13px !important;
    }
    #judgeme_product_reviews .jm-reviewer-info__date {
      font-size: 11px !important;
    }
    /* Readable review body */
    #judgeme_product_reviews .jm-review-item__body-text {
      font-size: 14px !important;
      line-height: 1.6 !important;
    }
  }
</style>

<style>
  :root {
    {%- comment -%} Override with merchant-selected fonts only if set {%- endcomment -%}
    {%- if gv_heading != blank -%}
      --font-serif: {{ gv_heading.family | json }}, 'Poppins', sans-serif;
      --gv-heading-weight: {{ gv_heading.weight }};
    {%- endif -%}
    {%- if gv_body != blank -%}
      --font-sans: {{ gv_body.family | json }}, 'Poppins', sans-serif;
    {%- endif -%}
    --gv-hero-headline-size: {{ settings.gv_hero_headline_size | default: 52 }}px;
    --gv-section-title-size: {{ settings.gv_section_title_size | default: 48 }}px;
  }
</style>
