{%- if block.settings.text != blank -%}
  <div class="gv-pk-callout" {{ block.shopify_attributes }}>
    {{ block.settings.text }}
  </div>
{%- endif -%}

{% stylesheet %}
  .gv-pk-callout {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--warm-espresso);
    background: #FFF0E6;
    border: 1px solid rgba(244,132,95,0.3);
    border-radius: 12px;
    padding: 14px 16px;
    line-height: 1.6;
  }
  .gv-pk-callout strong { color: var(--coral-pulse); }
{% endstylesheet %}

{% schema %}
{
  "name": "Local Callout",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Callout text",
      "info": "Use Bold for coral-highlighted text."
    }
  ]
}
{% endschema %}
