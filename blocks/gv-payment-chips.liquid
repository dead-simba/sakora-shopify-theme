<div class="gv-pays" {{ block.shopify_attributes }}>
  {%- if block.settings.chip_1 != blank -%}
    <span class="gv-pay">{{ block.settings.chip_1 }}</span>
  {%- endif -%}
  {%- if block.settings.chip_2 != blank -%}
    <span class="gv-pay">{{ block.settings.chip_2 }}</span>
  {%- endif -%}
  {%- if block.settings.chip_3 != blank -%}
    <span class="gv-pay">{{ block.settings.chip_3 }}</span>
  {%- endif -%}
  {%- if block.settings.chip_4 != blank -%}
    <span class="gv-pay">{{ block.settings.chip_4 }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .gv-pays {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .gv-pay {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--mid-gray);
    background: white;
    border: 1px solid var(--warm-gray);
    border-radius: 6px;
    padding: 4px 10px;
    white-space: nowrap;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Payment Chips",
  "tag": null,
  "settings": [
    { "type": "text", "id": "chip_1", "label": "Chip 1", "default": "💳 Card" },
    { "type": "text", "id": "chip_2", "label": "Chip 2", "default": "Easypaisa" },
    { "type": "text", "id": "chip_3", "label": "Chip 3", "default": "JazzCash" },
    { "type": "text", "id": "chip_4", "label": "Chip 4", "default": "🏠 Cash on Delivery" }
  ]
}
{% endschema %}
