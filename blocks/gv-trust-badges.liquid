<div class="gv-trust-badges" {{ block.shopify_attributes }}>
  {%- if block.settings.badge_1_label != blank -%}
    <div class="gv-trust-badge">
      {%- if block.settings.badge_1_icon != blank -%}
        <span class="gv-trust-badge-icon" aria-hidden="true">{{ block.settings.badge_1_icon }}</span>
      {%- endif -%}
      <span class="gv-trust-badge-label">{{ block.settings.badge_1_label }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.badge_2_label != blank -%}
    <div class="gv-trust-badge">
      {%- if block.settings.badge_2_icon != blank -%}
        <span class="gv-trust-badge-icon" aria-hidden="true">{{ block.settings.badge_2_icon }}</span>
      {%- endif -%}
      <span class="gv-trust-badge-label">{{ block.settings.badge_2_label }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.badge_3_label != blank -%}
    <div class="gv-trust-badge">
      {%- if block.settings.badge_3_icon != blank -%}
        <span class="gv-trust-badge-icon" aria-hidden="true">{{ block.settings.badge_3_icon }}</span>
      {%- endif -%}
      <span class="gv-trust-badge-label">{{ block.settings.badge_3_label }}</span>
    </div>
  {%- endif -%}
  {%- if block.settings.badge_4_label != blank -%}
    <div class="gv-trust-badge">
      {%- if block.settings.badge_4_icon != blank -%}
        <span class="gv-trust-badge-icon" aria-hidden="true">{{ block.settings.badge_4_icon }}</span>
      {%- endif -%}
      <span class="gv-trust-badge-label">{{ block.settings.badge_4_label }}</span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .gv-trust-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .gv-trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 12px 8px;
    background: white;
    border: 1px solid var(--warm-gray);
    border-radius: 12px;
    flex: 1;
    min-width: 64px;
  }
  .gv-trust-badge-icon {
    font-size: 20px;
    line-height: 1;
  }
  .gv-trust-badge-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 500;
    text-align: center;
    color: var(--mid-gray);
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Badges",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Badge 1" },
    { "type": "text", "id": "badge_1_icon", "label": "Icon (emoji)", "default": "🧪" },
    { "type": "text", "id": "badge_1_label", "label": "Label", "default": "Derm Tested" },
    { "type": "header", "content": "Badge 2" },
    { "type": "text", "id": "badge_2_icon", "label": "Icon (emoji)", "default": "🌿" },
    { "type": "text", "id": "badge_2_label", "label": "Label", "default": "Signature Scent" },
    { "type": "header", "content": "Badge 3" },
    { "type": "text", "id": "badge_3_icon", "label": "Icon (emoji)", "default": "🐰" },
    { "type": "text", "id": "badge_3_label", "label": "Label", "default": "Cruelty Free" },
    { "type": "header", "content": "Badge 4" },
    { "type": "text", "id": "badge_4_icon", "label": "Icon (emoji)", "default": "🇵🇰" },
    { "type": "text", "id": "badge_4_label", "label": "Label", "default": "Made for Pakistan" }
  ]
}
{% endschema %}
