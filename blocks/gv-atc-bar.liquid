{%- comment -%}
  Glowve — Sticky ATC bar + product page button colour overrides.
  Always visible on mobile; appears on desktop once buy-buttons scroll out of view.
{%- endcomment -%}

<div class="gv-bar" id="gv-bar-{{ block.id }}" aria-label="Quick add to cart" {{ block.shopify_attributes }}>
  <div class="gv-bar-inner">
    <div class="gv-bar-product">
      {%- if product.featured_image -%}
        {{- product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', width: 44, height: 44, class: 'gv-bar-img', alt: product.title -}}
      {%- endif -%}
      <div class="gv-bar-meta">
        <div class="gv-bar-name">{{ product.title }}</div>
        <div class="gv-bar-price" id="gv-bar-price-{{ block.id }}">{{ product.price | money }}</div>
      </div>
    </div>
    <button class="gv-bar-btn" id="gv-bar-btn-{{ block.id }}">
      Add to Bag
    </button>
  </div>
</div>

<script>
  (function () {
    var bar     = document.getElementById('gv-bar-{{ block.id }}');
    var priceEl = document.getElementById('gv-bar-price-{{ block.id }}');
    var btn     = document.getElementById('gv-bar-btn-{{ block.id }}');

    if (!bar || !btn) return;

    // ── Click: trigger the main product form ATC button ──
    btn.addEventListener('click', function () {
      var mainBtn = document.querySelector('.add-to-cart-button[name="add"], .add-to-cart-button[type="submit"]');
      if (mainBtn && !mainBtn.disabled) mainBtn.click();
    });

    // ── Sync price when protocol picker option changes ──
    document.addEventListener('change', function (e) {
      if (!e.target.classList.contains('gv-pp-radio')) return;
      var opt   = e.target.closest('.gv-pp-opt');
      var price = opt && opt.querySelector('.gv-pp-price');
      if (price && priceEl) priceEl.textContent = price.textContent;
    });

    // ── Desktop: show/hide based on buy-buttons visibility ──
    var buyButtons = document.querySelector('buy-buttons');
    if (buyButtons && window.matchMedia('(min-width: 750px)').matches) {
      var obs = new IntersectionObserver(function (entries) {
        bar.classList.toggle('gv-bar--desktop-hidden', entries[0].isIntersecting);
      }, { threshold: 0.1 });
      obs.observe(buyButtons);
    }
  })();
</script>

{% stylesheet %}
  /* ═══════════════════════════════════════════
     BUY BUTTON COLOUR OVERRIDES — coral / pink
     ═══════════════════════════════════════════ */
  .add-to-cart-button.button,
  .add-to-cart-button {
    background: var(--coral-pulse) !important;
    color: #fff !important;
    border-color: var(--coral-pulse) !important;
  }
  .add-to-cart-button.button:hover,
  .add-to-cart-button:hover {
    background: #e63974 !important;
    border-color: #e63974 !important;
  }

  /* Accelerated checkout (Buy it now) row */
  .shopify-payment-button__button--unbranded,
  buy-buttons .button--secondary {
    border-color: var(--coral-pulse) !important;
    color: var(--coral-pulse) !important;
    background: transparent !important;
  }
  .shopify-payment-button__button--unbranded:hover,
  buy-buttons .button--secondary:hover {
    background: var(--coral-pulse) !important;
    color: #fff !important;
  }

  /* ═══════════════════════════════════
     STICKY ATC BAR
     ═══════════════════════════════════ */
  .gv-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 300;
    background: #fff;
    border-top: 1px solid #f0eae6;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.10);
    padding: 10px 16px;
    padding-bottom: max(10px, env(safe-area-inset-bottom));
  }

  /* Desktop: hidden by default, shown once buy-buttons scroll out */
  @media (min-width: 750px) {
    .gv-bar { display: none; }
    .gv-bar:not(.gv-bar--desktop-hidden) { display: block; }
  }

  .gv-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .gv-bar-product {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .gv-bar-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    border-radius: 10px;
    background: #f9f5f2;
    flex-shrink: 0;
    display: block;
  }

  .gv-bar-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .gv-bar-name {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--warm-espresso);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gv-bar-price {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--coral-pulse);
    font-weight: 600;
  }

  .gv-bar-btn {
    flex-shrink: 0;
    background: var(--coral-pulse);
    color: #fff;
    border: none;
    border-radius: 100px;
    padding: 13px 24px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    white-space: nowrap;
    letter-spacing: 0.01em;
  }
  .gv-bar-btn:hover  { background: #e63974; }
  .gv-bar-btn:active { transform: scale(0.97); }

  @media (max-width: 749px) {
    .gv-bar-name   { display: none; }
    .gv-bar-price  { font-size: 14px; }
    .gv-bar-btn    { font-size: 13px; padding: 13px 20px; }
  }

  /* Push page content up on mobile so the bar doesn't cover anything */
  @media (max-width: 749px) {
    body { padding-bottom: 72px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sticky ATC Bar",
  "tag": null,
  "settings": []
}
{% endschema %}
