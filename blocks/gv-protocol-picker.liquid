{%- liquid
  assign opt2_prod = all_products[block.settings.opt2_product]
  assign opt3_prod = all_products[block.settings.opt3_product]
-%}

<div class="gv-pp" id="gv-pp-{{ block.id }}" {{ block.shopify_attributes }}>

  {%- if block.settings.title != blank -%}
    <p class="gv-pp-label">{{ block.settings.title }}</p>
  {%- endif -%}

  <div class="gv-pp-opts" role="radiogroup">

    {%- comment -%} ── Option 1 — current product ── {%- endcomment -%}
    <label class="gv-pp-opt gv-pp-opt--active" data-vid="{{ product.first_available_variant.id }}">
      <input class="gv-pp-radio" type="radio" name="gv-pp-{{ block.id }}"
             value="{{ product.first_available_variant.id }}" checked>
      <span class="gv-pp-dot"></span>
      <span class="gv-pp-info">
        <span class="gv-pp-title">{{ block.settings.opt1_title }}</span>
        {%- if block.settings.opt1_subtitle != blank -%}
          <span class="gv-pp-sub">{{ block.settings.opt1_subtitle }}</span>
        {%- endif -%}
      </span>
      <span class="gv-pp-pricing">
        <span class="gv-pp-price">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="gv-pp-was">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </span>
      {%- if block.settings.opt1_badge != blank -%}
        <span class="gv-pp-badge gv-pp-badge--{{ block.settings.opt1_badge_color }}">{{ block.settings.opt1_badge }}</span>
      {%- endif -%}
    </label>

    {%- comment -%} ── Option 2 — 2-bottle bundle ── {%- endcomment -%}
    {%- if opt2_prod != empty and opt2_prod.first_available_variant -%}
      {%- assign v2 = opt2_prod.first_available_variant -%}
      <label class="gv-pp-opt" data-vid="{{ v2.id }}">
        <input class="gv-pp-radio" type="radio" name="gv-pp-{{ block.id }}"
               value="{{ v2.id }}"{% unless v2.available %} disabled{% endunless %}>
        <span class="gv-pp-dot"></span>
        <span class="gv-pp-info">
          <span class="gv-pp-title">{{ block.settings.opt2_title }}</span>
          {%- if block.settings.opt2_free_shipping -%}
            <span class="gv-pp-sub gv-pp-sub--ship">✓ Free Shipping Unlocked</span>
          {%- elsif block.settings.opt2_subtitle != blank -%}
            <span class="gv-pp-sub">{{ block.settings.opt2_subtitle }}</span>
          {%- endif -%}
        </span>
        <span class="gv-pp-pricing">
          <span class="gv-pp-price">{{ opt2_prod.price | money }}</span>
          {%- if opt2_prod.compare_at_price > opt2_prod.price -%}
            <span class="gv-pp-was">{{ opt2_prod.compare_at_price | money }}</span>
          {%- endif -%}
        </span>
        {%- if block.settings.opt2_badge != blank -%}
          <span class="gv-pp-badge gv-pp-badge--{{ block.settings.opt2_badge_color | default: 'coral' }}">{{ block.settings.opt2_badge }}</span>
        {%- endif -%}
      </label>
    {%- endif -%}

    {%- comment -%} ── Option 3 — 3-bottle bundle ── {%- endcomment -%}
    {%- if opt3_prod != empty and opt3_prod.first_available_variant -%}
      {%- assign v3 = opt3_prod.first_available_variant -%}
      <label class="gv-pp-opt" data-vid="{{ v3.id }}">
        <input class="gv-pp-radio" type="radio" name="gv-pp-{{ block.id }}"
               value="{{ v3.id }}"{% unless v3.available %} disabled{% endunless %}>
        <span class="gv-pp-dot"></span>
        <span class="gv-pp-info">
          <span class="gv-pp-title">{{ block.settings.opt3_title }}</span>
          {%- if block.settings.opt3_free_shipping -%}
            <span class="gv-pp-sub gv-pp-sub--ship">✓ Free Shipping Unlocked</span>
          {%- elsif block.settings.opt3_subtitle != blank -%}
            <span class="gv-pp-sub">{{ block.settings.opt3_subtitle }}</span>
          {%- endif -%}
        </span>
        <span class="gv-pp-pricing">
          <span class="gv-pp-price">{{ opt3_prod.price | money }}</span>
          {%- if opt3_prod.compare_at_price > opt3_prod.price -%}
            <span class="gv-pp-was">{{ opt3_prod.compare_at_price | money }}</span>
          {%- endif -%}
        </span>
        {%- if block.settings.opt3_badge != blank -%}
          <span class="gv-pp-badge gv-pp-badge--{{ block.settings.opt3_badge_color | default: 'coral' }}">{{ block.settings.opt3_badge }}</span>
        {%- endif -%}
      </label>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    var pp = document.getElementById('gv-pp-{{ block.id }}');
    if (!pp) return;

    // Hide native variant picker — this replaces it
    var vp = document.querySelector('variant-picker');
    if (vp) vp.style.display = 'none';

    // Find the hidden product form input that drives the cart
    var nativeInput = document.querySelector('input[name="id"], select[name="id"]');

    // Set initial value from the checked radio
    var checked = pp.querySelector('.gv-pp-radio:checked');
    if (checked && nativeInput) nativeInput.value = checked.value;

    // Radio change handler
    pp.querySelectorAll('.gv-pp-radio').forEach(function (radio) {
      radio.addEventListener('change', function () {
        pp.querySelectorAll('.gv-pp-opt').forEach(function (o) {
          o.classList.remove('gv-pp-opt--active');
        });
        this.closest('.gv-pp-opt').classList.add('gv-pp-opt--active');
        if (nativeInput) {
          nativeInput.value = this.value;
          nativeInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
    });
  })();
</script>

{% stylesheet %}
  .gv-pp {
    font-family: var(--font-sans);
  }

  .gv-pp-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mid-gray);
    margin: 0 0 10px;
  }

  .gv-pp-opts {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gv-pp-opt {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    cursor: pointer;
    background: white;
    border: 1.5px solid #E8E0DC;
    border-radius: 12px;
    transition: border-color 0.15s, background 0.15s;
  }
  .gv-pp-opt:hover { border-color: #d4c8c2; }

  .gv-pp-opt--active {
    background: #FFF5F8;
    border-color: var(--coral-pulse);
    border-width: 2px;
  }

  .gv-pp-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  /* Custom radio dot */
  .gv-pp-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid #D4C8C2;
    flex-shrink: 0;
    position: relative;
    transition: border-color 0.15s;
  }
  .gv-pp-dot::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--coral-pulse);
    opacity: 0;
    transition: opacity 0.15s;
  }
  .gv-pp-opt--active .gv-pp-dot { border-color: var(--coral-pulse); }
  .gv-pp-opt--active .gv-pp-dot::after { opacity: 1; }

  .gv-pp-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  .gv-pp-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--warm-espresso);
    line-height: 1.2;
  }

  .gv-pp-sub {
    font-size: 11px;
    color: var(--mid-gray);
    line-height: 1.3;
  }
  .gv-pp-sub--ship {
    color: #2E7D32;
    font-weight: 500;
  }

  /* Badge — inline pill below title */
  .gv-pp-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 100px;
    line-height: 1.6;
    white-space: nowrap;
    margin-top: 1px;
  }
  .gv-pp-badge--coral { background: #FFE8F0; color: var(--coral-pulse); }
  .gv-pp-badge--gold  { background: #FFE8F0; color: var(--coral-pulse); }
  .gv-pp-badge--green { background: #E8F5E9; color: #2E7D32; }

  .gv-pp-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    flex-shrink: 0;
  }

  .gv-pp-price {
    font-size: 15px;
    font-weight: 700;
    color: var(--warm-espresso);
  }
  .gv-pp-opt--active .gv-pp-price { color: var(--coral-pulse); }

  .gv-pp-was {
    font-size: 11px;
    color: var(--mid-gray);
    text-decoration: line-through;
  }

  @media (max-width: 599px) {
    .gv-pp-opt {
      display: grid;
      grid-template-columns: 18px 1fr;
      grid-template-areas: 
        "dot info"
        "dot pricing"
        "dot badge";
      column-gap: 12px;
      row-gap: 6px;
      padding: 12px;
      align-items: start;
    }
    .gv-pp-dot { 
      grid-area: dot; 
      margin-top: 3px; 
    }
    .gv-pp-info { 
      grid-area: info; 
    }
    .gv-pp-pricing { 
      grid-area: pricing; 
      flex-direction: row; 
      align-items: center; 
      gap: 8px;
      justify-content: flex-start;
    }
    .gv-pp-badge { 
      grid-area: badge; 
      justify-self: start;
      margin-top: 0;
    }
    .gv-pp-price {
      font-size: 14px;
    }
    .gv-pp-title {
      font-size: 13px;
    }
    .gv-pp-sub {
      font-size: 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Protocol Picker",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Label",
      "default": "Select Your Protocol"
    },
    { "type": "header", "content": "Option 1 — Single bottle" },
    { "type": "text", "id": "opt1_title", "label": "Title", "default": "1 Bottle" },
    { "type": "text", "id": "opt1_subtitle", "label": "Subtitle", "default": "Try it out." },
    { "type": "text", "id": "opt1_badge", "label": "Badge (leave blank for none)" },
    {
      "type": "select", "id": "opt1_badge_color", "label": "Badge colour",
      "options": [
        { "value": "coral", "label": "Coral" },
        { "value": "gold", "label": "Pink" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    },
    { "type": "header", "content": "Option 2 — 2-bottle bundle" },
    { "type": "product", "id": "opt2_product", "label": "Bundle product" },
    { "type": "text", "id": "opt2_title", "label": "Title", "default": "2 Bottles (2 Month Supply)" },
    { "type": "text", "id": "opt2_subtitle", "label": "Subtitle (if no free shipping)" },
    { "type": "checkbox", "id": "opt2_free_shipping", "label": "Show 'Free Shipping Unlocked'", "default": true },
    { "type": "text", "id": "opt2_badge", "label": "Badge text", "default": "Most Popular (Save 15%)" },
    {
      "type": "select", "id": "opt2_badge_color", "label": "Badge colour",
      "options": [
        { "value": "coral", "label": "Coral" },
        { "value": "gold", "label": "Pink" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    },
    { "type": "header", "content": "Option 3 — 3-bottle bundle" },
    { "type": "product", "id": "opt3_product", "label": "Bundle product" },
    { "type": "text", "id": "opt3_title", "label": "Title", "default": "3 Bottles (3 Month Supply)" },
    { "type": "text", "id": "opt3_subtitle", "label": "Subtitle (if no free shipping)" },
    { "type": "checkbox", "id": "opt3_free_shipping", "label": "Show 'Free Shipping Unlocked'", "default": true },
    { "type": "text", "id": "opt3_badge", "label": "Badge text", "default": "Best Value (Save 20%)" },
    {
      "type": "select", "id": "opt3_badge_color", "label": "Badge colour",
      "options": [
        { "value": "coral", "label": "Coral" },
        { "value": "gold", "label": "Pink" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    }
  ]
}
{% endschema %}
