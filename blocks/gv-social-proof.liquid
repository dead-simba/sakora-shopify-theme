<div class="gv-sp" id="gv-sp-{{ block.id }}">
  <div class="gv-sp-item">
    <div class="gv-sp-icon gv-sp-icon--eye">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path><circle cx="12" cy="12" r="3"></circle></svg>
    </div>
    <span class="gv-sp-text"><span class="gv-sp-w">--</span> viewing now</span>
  </div>
  
  <div class="gv-sp-divider"></div>

  <div class="gv-sp-item">
    <div class="gv-sp-icon gv-sp-icon--flame">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>
    </div>
    <span class="gv-sp-text"><span class="gv-sp-b">--</span> bought today</span>
  </div>
</div>

<script>
  (function () {
    var el = document.getElementById('gv-sp-{{ block.id }}');
    if (!el) return;
    var wEl = el.querySelector('.gv-sp-w');
    var bEl = el.querySelector('.gv-sp-b');
    
    var minW = {{ block.settings.view_min | default: 10 }};
    var maxW = {{ block.settings.view_max | default: 25 }};
    var minB = {{ block.settings.buy_min | default: 3 }};
    var maxB = {{ block.settings.buy_max | default: 15 }};

    // Seed with realistic starting numbers
    var w = Math.floor(Math.random() * (maxW - minW + 1)) + minW;
    var b = Math.floor(Math.random() * (maxB - minB + 1)) + minB;
    
    if (wEl) wEl.textContent = w;
    if (bEl) bEl.textContent = b;
    
    // Animate the 'viewing' number occasionally
    setInterval(function () {
      w = Math.max(minW, Math.min(maxW, w + (Math.random() > 0.5 ? 1 : -1)));
      if (wEl) wEl.textContent = w;
    }, 8000);
  })();
</script>

{% stylesheet %}
  .gv-sp {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: var(--font-sans);
    background: #FAFAFA;
    border: 1px solid #EAEAEA;
    border-radius: 100px;
    padding: 6px 18px;
    margin: 8px 0;
  }

  .gv-sp-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gv-sp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #888;
  }

  .gv-sp-icon--flame {
    color: var(--coral-pulse);
  }

  .gv-sp-text {
    font-size: 12px;
    color: #444;
    letter-spacing: -0.01em;
    font-weight: 500;
  }

  .gv-sp-w, .gv-sp-b {
    font-weight: 700;
    color: #1A1A1A;
  }

  .gv-sp-divider {
    width: 1px;
    height: 14px;
    background: #DDD;
  }

  @media (max-width: 599px) {
    .gv-sp {
      padding: 6px 14px;
      gap: 12px;
    }
    .gv-sp-text {
      font-size: 11px;
    }
    .gv-sp-divider {
      height: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Social Proof",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Viewing Now Settings"
    },
    {
      "type": "range",
      "id": "view_min",
      "min": 1,
      "max": 50,
      "step": 1,
      "label": "Minimum viewers",
      "default": 10
    },
    {
      "type": "range",
      "id": "view_max",
      "min": 5,
      "max": 100,
      "step": 1,
      "label": "Maximum viewers",
      "default": 25
    },
    {
      "type": "header",
      "content": "Bought Today Settings"
    },
    {
      "type": "range",
      "id": "buy_min",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Minimum bought",
      "default": 3
    },
    {
      "type": "range",
      "id": "buy_max",
      "min": 5,
      "max": 50,
      "step": 1,
      "label": "Maximum bought",
      "default": 15
    }
  ]
}
{% endschema %}
