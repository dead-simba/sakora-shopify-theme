<div class="gv-trust-bar" {{ block.shopify_attributes }}>
  {%- if block.settings.item_1 != blank -%}
    <div class="gv-trust-item">
      <div class="gv-trust-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
      </div>
      <span class="gv-trust-text">{{ block.settings.item_1 | remove: "🛡️" | remove: "🛡" | strip }}</span>
    </div>
  {%- endif -%}

  {%- if block.settings.item_2 != blank -%}
    <div class="gv-trust-item">
      <div class="gv-trust-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
      </div>
      <span class="gv-trust-text">{{ block.settings.item_2 | remove: "🚚" | strip }}</span>
    </div>
  {%- endif -%}

  {%- if block.settings.item_3 != blank -%}
    <div class="gv-trust-item">
      <div class="gv-trust-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
      </div>
      <span class="gv-trust-text">{{ block.settings.item_3 | remove: "🏠" | strip }}</span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .gv-trust-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 12px 24px;
    padding: 12px 0;
    border-top: 1px solid #F0F0F0;
    border-bottom: 1px solid #F0F0F0;
    margin: 16px 0;
  }

  .gv-trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gv-trust-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--coral-pulse);
    flex-shrink: 0;
  }

  .gv-trust-text {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: #444;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  @media (max-width: 599px) {
    .gv-trust-bar {
      gap: 10px 16px;
      padding: 10px 0;
    }
    .gv-trust-text {
      font-size: 11px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Guarantee Bar",
  "tag": null,
  "settings": [
    { "type": "text", "id": "item_1", "label": "Item 1", "default": "30-day money-back" },
    { "type": "text", "id": "item_2", "label": "Item 2", "default": "Free delivery above PKR 2,500" },
    { "type": "text", "id": "item_3", "label": "Item 3", "default": "Cash on delivery" }
  ]
}
{% endschema %}
