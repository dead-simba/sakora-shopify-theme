<section class="gv-pdp-ing">
  <div class="gv-pdp-inner">

    <div class="gv-pdp-section-head">
      {%- if section.settings.label != blank -%}
        <div class="gv-section-label">{{ section.settings.label }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="gv-pdp-section-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="gv-pdp-section-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- assign ing_blocks = section.blocks | where: 'type', 'ingredient' -%}
    {%- if ing_blocks.size > 0 -%}
      <div class="gv-ing-scroll-wrap">
        <div class="gv-ing-scroll">
          {%- for block in ing_blocks -%}
            <div class="gv-ing-card" {{ block.shopify_attributes }}>
              <div class="gv-ing-card-img">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'gv-ing-card-photo', width: 200, height: 200, alt: block.settings.name | escape }}
                {%- else -%}
                  <div class="gv-ing-card-placeholder">
                    <span>{{ block.settings.name | slice: 0, 2 | upcase }}</span>
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.badge != blank -%}
                <div class="gv-ing-card-badge">{{ block.settings.badge }}</div>
              {%- endif -%}
              <div class="gv-ing-card-body">
                <div class="gv-ing-card-name">{{ block.settings.name }}</div>
                <div class="gv-ing-card-benefit">{{ block.settings.benefit }}</div>
              </div>
            </div>
          {%- endfor -%}
        </div>
        <p class="gv-ing-scroll-hint">← Scroll to explore all ingredients →</p>
      </div>
    {%- endif -%}

    {%- comment -%} INCI Section {%- endcomment -%}
    <div class="gv-inci-section">

      {%- if section.settings.inci_title != blank -%}
        <h3 class="gv-inci-title">{{ section.settings.inci_title }}</h3>
      {%- endif -%}

      <div class="gv-inci-badges">
        <span class="gv-inci-badge">✓ Fragrance-free</span>
        <span class="gv-inci-badge">✓ Paraben-free</span>
        <span class="gv-inci-badge">✓ Sulphate-free</span>
        <span class="gv-inci-badge">✓ Mineral oil-free</span>
        <span class="gv-inci-badge">✓ Cruelty-free</span>
        <span class="gv-inci-badge">✓ Made in Pakistan</span>
      </div>

      {%- if section.settings.inci_full != blank -%}
        <div class="gv-inci-toggle-wrap">
          <button class="gv-inci-toggle" aria-expanded="false" onclick="this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'false' ? 'true' : 'false'); this.nextElementSibling.classList.toggle('open');">
            <span class="gv-inci-toggle-text">Show full ingredient list</span>
            <svg class="gv-inci-toggle-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="gv-inci-full">
            <p class="gv-inci-list">{{ section.settings.inci_full }}</p>
          </div>
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

{% stylesheet %}
  .gv-pdp-ing {
    background: white;
    padding: 80px 0;
  }

  /* Scrollable ingredient cards */
  .gv-ing-scroll-wrap {
    margin-bottom: 56px;
    overflow: hidden;
  }

  .gv-ing-scroll {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 12px;
    scrollbar-width: none;
  }
  .gv-ing-scroll::-webkit-scrollbar { display: none; }

  .gv-ing-card {
    flex: 0 0 160px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--off-white);
    border: 1px solid var(--warm-gray);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }

  .gv-ing-card-img {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--warm-gray);
    position: relative;
  }

  .gv-ing-card-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .gv-ing-card:hover .gv-ing-card-photo { transform: scale(1.05); }

  .gv-ing-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--warm-gray), rgba(244,132,95,0.2));
  }
  .gv-ing-card-placeholder span {
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    color: var(--coral-pulse);
    opacity: 0.6;
  }

  .gv-ing-card-badge {
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--coral-pulse);
    padding: 8px 12px 0;
  }

  .gv-ing-card-body {
    padding: 6px 12px 14px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gv-ing-card-name {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--berry-dark);
    line-height: 1.3;
  }

  .gv-ing-card-benefit {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--mid-gray);
    line-height: 1.4;
  }

  .gv-ing-scroll-hint {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--mid-gray);
    opacity: 0.6;
    text-align: center;
    margin-top: 8px;
  }

  /* INCI */
  .gv-inci-section {
    border-top: 1px solid var(--warm-gray);
    padding-top: 40px;
  }

  .gv-inci-title {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    color: var(--berry-dark);
    margin-bottom: 16px;
  }

  .gv-inci-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .gv-inci-badge {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: #2E7D32;
    background: #F1F8E9;
    border: 1px solid #C5E1A5;
    border-radius: 100px;
    padding: 5px 12px;
  }

  .gv-inci-toggle-wrap { max-width: 680px; }

  .gv-inci-toggle {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 1px solid var(--warm-gray);
    border-radius: 8px;
    padding: 10px 16px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--warm-espresso);
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .gv-inci-toggle:hover { border-color: var(--coral-pulse); }
  .gv-inci-toggle[aria-expanded="true"] .gv-inci-toggle-icon { transform: rotate(180deg); }
  .gv-inci-toggle-icon { transition: transform 0.2s; flex-shrink: 0; }

  .gv-inci-full {
    display: none;
    padding: 16px 0 0;
  }
  .gv-inci-full.open { display: block; }

  .gv-inci-list {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    line-height: 2;
  }
  .gv-inci-list .active-ing {
    font-family: var(--font-mono);
    color: var(--coral-pulse);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .gv-pdp-ing { padding: 60px 0; }
    .gv-ing-card { flex: 0 0 140px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Ingredients",
  "tag": "section",
  "class": "glowve-pdp-ing-wrapper",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "What's Inside" },
    { "type": "text", "id": "title", "label": "Title", "default": "Every ingredient. Every reason." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "No proprietary blends. No hidden complexes." },
    { "type": "header", "content": "INCI / Full Ingredient List" },
    { "type": "text", "id": "inci_title", "label": "INCI title", "default": "Full Ingredient List" },
    { "type": "textarea", "id": "inci_full", "label": "Full INCI text", "info": "Paste the full INCI list. Wrap active ingredients in <span class='active-ing'>...</span> to highlight them." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Ingredient image" },
        { "type": "text", "id": "badge", "label": "Category badge", "info": "E.g. Brightening, Barrier, UV Filter", "default": "Active" },
        { "type": "text", "id": "name", "label": "Ingredient name", "default": "Alpha-Arbutin 2%" },
        { "type": "textarea", "id": "benefit", "label": "One-line benefit", "default": "Blocks melanin production at the source." }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Ingredients" }
  ]
}
{% endschema %}
