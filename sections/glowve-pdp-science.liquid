<section class="gv-pdp-science">
  <div class="gv-pdp-inner">

    <div class="gv-pdp-section-head">
      {%- if section.settings.label != blank -%}
        <div class="gv-section-label">{{ section.settings.label }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="gv-pdp-section-title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="gv-pdp-section-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gv-science-blocks">
        {%- for block in section.blocks -%}

          {%- case block.type -%}

          {%- when 'pathway_card' -%}
            <div class="gv-sci-pathway-grid" {{ block.shopify_attributes }}>
              {%- if block.settings.card_1_title != blank -%}
                <div class="gv-sci-pathway">
                  <div class="gv-sci-pathway-num">01</div>
                  <div class="gv-sci-pathway-title">{{ block.settings.card_1_title }}</div>
                  <div class="gv-sci-pathway-body">{{ block.settings.card_1_body }}</div>
                  {%- if block.settings.card_1_ingredient != blank -%}
                    <div class="gv-sci-pathway-ing">{{ block.settings.card_1_ingredient }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.card_2_title != blank -%}
                <div class="gv-sci-pathway">
                  <div class="gv-sci-pathway-num">02</div>
                  <div class="gv-sci-pathway-title">{{ block.settings.card_2_title }}</div>
                  <div class="gv-sci-pathway-body">{{ block.settings.card_2_body }}</div>
                  {%- if block.settings.card_2_ingredient != blank -%}
                    <div class="gv-sci-pathway-ing">{{ block.settings.card_2_ingredient }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.card_3_title != blank -%}
                <div class="gv-sci-pathway">
                  <div class="gv-sci-pathway-num">03</div>
                  <div class="gv-sci-pathway-title">{{ block.settings.card_3_title }}</div>
                  <div class="gv-sci-pathway-body">{{ block.settings.card_3_body }}</div>
                  {%- if block.settings.card_3_ingredient != blank -%}
                    <div class="gv-sci-pathway-ing">{{ block.settings.card_3_ingredient }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.card_4_title != blank -%}
                <div class="gv-sci-pathway">
                  <div class="gv-sci-pathway-num">04</div>
                  <div class="gv-sci-pathway-title">{{ block.settings.card_4_title }}</div>
                  <div class="gv-sci-pathway-body">{{ block.settings.card_4_body }}</div>
                  {%- if block.settings.card_4_ingredient != blank -%}
                    <div class="gv-sci-pathway-ing">{{ block.settings.card_4_ingredient }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.card_5_title != blank -%}
                <div class="gv-sci-pathway">
                  <div class="gv-sci-pathway-num">05</div>
                  <div class="gv-sci-pathway-title">{{ block.settings.card_5_title }}</div>
                  <div class="gv-sci-pathway-body">{{ block.settings.card_5_body }}</div>
                  {%- if block.settings.card_5_ingredient != blank -%}
                    <div class="gv-sci-pathway-ing">{{ block.settings.card_5_ingredient }}</div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'stat' -%}
            <div class="gv-sci-stat" {{ block.shopify_attributes }}>
              <div class="gv-sci-stat-num">{{ block.settings.number }}</div>
              <div class="gv-sci-stat-label">{{ block.settings.label }}</div>
              {%- if block.settings.source != blank -%}
                <div class="gv-sci-stat-source">{{ block.settings.source }}</div>
              {%- endif -%}
            </div>

          {%- when 'rich_text' -%}
            <div class="gv-sci-text" {{ block.shopify_attributes }}>
              {{ block.settings.content }}
            </div>

          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .gv-pdp-science {
    background: var(--off-white);
    padding: 80px 0;
  }

  .gv-pdp-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .gv-pdp-section-head {
    margin-bottom: 48px;
  }

  .gv-pdp-section-title {
    font-family: var(--font-serif);
    font-size: 40px;
    font-weight: 300;
    color: var(--berry-dark);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }

  .gv-pdp-section-sub {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--mid-gray);
    line-height: 1.65;
    max-width: 560px;
  }

  /* Pathway cards */
  .gv-sci-pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
  }

  .gv-sci-pathway {
    background: white;
    border: 1px solid var(--warm-gray);
    border-radius: 16px;
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gv-sci-pathway-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--coral-pulse);
    letter-spacing: 0.06em;
  }

  .gv-sci-pathway-title {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    color: var(--berry-dark);
    line-height: 1.3;
  }

  .gv-sci-pathway-body {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    line-height: 1.55;
  }

  .gv-sci-pathway-ing {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--coral-pulse);
    background: rgba(244, 132, 95, 0.08);
    border-radius: 4px;
    padding: 3px 8px;
    align-self: flex-start;
  }

  /* Stat callout */
  .gv-sci-stat {
    background: var(--berry-dark);
    color: white;
    border-radius: 20px;
    padding: 36px 40px;
    text-align: center;
    margin-top: 24px;
  }

  .gv-sci-stat-num {
    font-family: var(--font-serif);
    font-size: 64px;
    font-weight: 300;
    line-height: 1;
    color: var(--coral-pulse);
    margin-bottom: 8px;
  }

  .gv-sci-stat-label {
    font-family: var(--font-sans);
    font-size: 16px;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
  }

  .gv-sci-stat-source {
    font-family: var(--font-sans);
    font-size: 11px;
    color: rgba(255,255,255,0.4);
    margin-top: 8px;
  }

  /* Rich text block */
  .gv-sci-text {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--mid-gray);
    line-height: 1.7;
  }
  .gv-sci-text h3 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    color: var(--berry-dark);
    margin-bottom: 12px;
  }
  .gv-sci-text strong { color: var(--warm-espresso); }

  @media (max-width: 768px) {
    .gv-pdp-science { padding: 60px 0; }
    .gv-pdp-inner { padding: 0 20px; }
    .gv-pdp-section-title { font-size: 32px; }
    .gv-sci-pathway-grid { grid-template-columns: 1fr 1fr; }
    .gv-sci-stat-num { font-size: 48px; }
  }
  @media (max-width: 480px) {
    .gv-sci-pathway-grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Science",
  "tag": "section",
  "class": "glowve-pdp-science-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "The Science"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "How it works."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle"
    }
  ],
  "blocks": [
    {
      "type": "pathway_card",
      "name": "Pathway Cards (up to 5)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "card_1_title", "label": "Card 1 — Title" },
        { "type": "textarea", "id": "card_1_body", "label": "Card 1 — Body" },
        { "type": "text", "id": "card_1_ingredient", "label": "Card 1 — Ingredient tag" },
        { "type": "text", "id": "card_2_title", "label": "Card 2 — Title" },
        { "type": "textarea", "id": "card_2_body", "label": "Card 2 — Body" },
        { "type": "text", "id": "card_2_ingredient", "label": "Card 2 — Ingredient tag" },
        { "type": "text", "id": "card_3_title", "label": "Card 3 — Title" },
        { "type": "textarea", "id": "card_3_body", "label": "Card 3 — Body" },
        { "type": "text", "id": "card_3_ingredient", "label": "Card 3 — Ingredient tag" },
        { "type": "text", "id": "card_4_title", "label": "Card 4 — Title" },
        { "type": "textarea", "id": "card_4_body", "label": "Card 4 — Body" },
        { "type": "text", "id": "card_4_ingredient", "label": "Card 4 — Ingredient tag" },
        { "type": "text", "id": "card_5_title", "label": "Card 5 — Title" },
        { "type": "textarea", "id": "card_5_body", "label": "Card 5 — Body" },
        { "type": "text", "id": "card_5_ingredient", "label": "Card 5 — Ingredient tag" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat Callout",
      "settings": [
        { "type": "text", "id": "number", "label": "Stat number", "default": "92%" },
        { "type": "text", "id": "label", "label": "Stat label", "default": "of participants noticed brighter skin in 8 weeks." },
        { "type": "text", "id": "source", "label": "Source / study note" }
      ]
    },
    {
      "type": "rich_text",
      "name": "Rich Text",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Science" }
  ]
}
{% endschema %}
