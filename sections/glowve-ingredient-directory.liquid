<section class="gv-ing-dir" aria-labelledby="gv-ing-dir-title">
  <div class="gv-ing-dir-inner">

    <!-- LEFT: Text -->
    <div class="gv-ing-dir-text">
      <div class="gv-section-label">{{ section.settings.label }}</div>
      <h2 id="gv-ing-dir-title" class="gv-section-title">{{ section.settings.title }}</h2>
      <p class="gv-ing-dir-desc">{{ section.settings.description }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="gv-btn-primary gv-ing-cta">
          {{ section.settings.cta_label }}
          {% render 'gv-icon', icon: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <!-- RIGHT: Cards + chips -->
    <div class="gv-ing-dir-right">

      {%- assign star_blocks = section.blocks | where: 'type', 'star_card' -%}
      {%- if star_blocks.size > 0 -%}
        <div class="gv-ing-star-grid">
          {%- for block in star_blocks -%}
            {%- assign card_color = block.settings.color | default: 'peach' -%}
            <div class="gv-ing-star-card gv-ing-star-card--{{ card_color }}" {{ block.shopify_attributes }}>

              <div class="gv-ing-star-img">
                {%- if block.settings.image != blank -%}
                  {%- assign img_alt = block.settings.image.alt | default: block.settings.name | escape -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'gv-ing-star-photo', alt: img_alt, width: 300, height: 400, sizes: '(max-width: 768px) 90vw, 30vw' }}
                {%- endif -%}

                <div class="gv-ing-star-overlay"></div>

                <div class="gv-ing-star-img-text">
                  {%- if block.settings.product_tag != blank -%}
                    <div class="gv-ing-product-tag">{{ block.settings.product_tag }}</div>
                  {%- endif -%}
                  <div class="gv-ing-star-name">{{ block.settings.name }}</div>
                </div>
              </div>

              <div class="gv-ing-star-body">
                <div class="gv-ing-star-fn">{{ block.settings.function }}</div>
              </div>

            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign chip_blocks = section.blocks | where: 'type', 'chip' -%}
      {%- if chip_blocks.size > 0 -%}
        <div class="gv-ing-chips-wrap">
          <div class="gv-ing-chips-label">{{ section.settings.chips_label }}</div>
          <div class="gv-ing-chips">
            {%- for block in chip_blocks -%}
              <span class="gv-ing-chip" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-dir {
    background: var(--off-white);
    padding: 100px 0;
  }

  .gv-ing-dir-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 72px;
    align-items: start;
  }

  /* ── LEFT ── */
  .gv-ing-dir-text .gv-section-title {
    margin-bottom: 20px;
  }

  .gv-ing-dir-desc {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--mid-gray);
    line-height: 1.75;
    margin-bottom: 36px;
  }

  .gv-ing-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  /* ── RIGHT ── */
  .gv-ing-dir-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Star cards grid — 3 columns */
  .gv-ing-star-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  /* Individual star card */
  .gv-ing-star-card {
    border-radius: 20px;
    overflow: hidden;
    background: white;
    border: 1px solid var(--warm-gray);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.35s;
    display: flex;
    flex-direction: column;
  }
  .gv-ing-star-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 48px rgba(0,0,0,0.12);
  }

  /* Image area */
  .gv-ing-star-img {
    width: 100%;
    aspect-ratio: 3 / 4;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  /* Gradient fallback backgrounds */
  .gv-ing-star-card--peach  .gv-ing-star-img { background: linear-gradient(160deg, #FFD4B8 0%, #FF8C5A 50%, #C24B1A 100%); }
  .gv-ing-star-card--mint   .gv-ing-star-img { background: linear-gradient(160deg, #B8E8D4 0%, #2ABFA3 50%, #0D7A62 100%); }
  .gv-ing-star-card--yellow .gv-ing-star-img { background: linear-gradient(160deg, #FFE89A 0%, #F5A623 50%, #C47A0A 100%); }

  .gv-ing-star-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .gv-ing-star-card:hover .gv-ing-star-photo {
    transform: scale(1.06);
  }

  /* Dark gradient overlay */
  .gv-ing-star-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.08) 55%, transparent 100%);
    pointer-events: none;
    transition: background 0.3s;
  }
  .gv-ing-star-card:hover .gv-ing-star-overlay {
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
  }

  /* Text on image */
  .gv-ing-star-img-text {
    position: relative;
    z-index: 2;
    padding: 16px 14px;
    width: 100%;
  }

  .gv-ing-product-tag {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 7px;
    background: rgba(255,255,255,0.18);
    color: white;
    border: 1px solid rgba(255,255,255,0.3);
    backdrop-filter: blur(4px);
  }

  .gv-ing-star-name {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: white;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  /* Card bottom */
  .gv-ing-star-body {
    padding: 12px 14px 14px;
  }

  .gv-ing-star-fn {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--mid-gray);
    line-height: 1.5;
  }
  .gv-ing-star-fn strong { color: var(--coral-pulse); }

  /* ── CHIPS ── */
  .gv-ing-chips-wrap {
    padding-top: 4px;
  }

  .gv-ing-chips-label {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--mid-gray);
    margin-bottom: 10px;
    opacity: 0.6;
  }

  .gv-ing-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .gv-ing-chip {
    background: white;
    border: 1.5px solid var(--warm-gray);
    border-radius: 100px;
    padding: 7px 14px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    color: var(--warm-espresso);
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    white-space: nowrap;
  }
  .gv-ing-chip:hover {
    border-color: var(--coral-pulse);
    color: var(--coral-pulse);
    background: #FFF5F9;
  }

  /* ── RESPONSIVE ── */
  @media (max-width: 1000px) {
    .gv-ing-dir-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  @media (max-width: 768px) {
    .gv-ing-dir { padding: 72px 0; }
    .gv-ing-dir-inner { padding: 0 20px; }
    .gv-ing-star-grid { gap: 12px; }
    .gv-ing-star-name { font-size: 14px; }
  }
  @media (max-width: 480px) {
    .gv-ing-star-grid { grid-template-columns: 1fr; }
    .gv-ing-star-img { aspect-ratio: 4 / 3; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient Directory",
  "tag": "section",
  "class": "glowve-ing-dir-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Radical Transparency"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Know every<br><em>ingredient</em><br>we use.</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "No hidden complexes, no marketing names. Every active, every concentration — exactly what goes on your skin and why."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore Ingredient Directory"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    },
    {
      "type": "text",
      "id": "chips_label",
      "label": "Chips row label",
      "default": "Also in our formulas"
    }
  ],
  "blocks": [
    {
      "type": "star_card",
      "name": "Star Ingredient Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image",
          "info": "Portrait crop recommended (3:4 ratio). E.g. bearberry berries, skin texture, sunflower."
        },
        {
          "type": "select",
          "id": "color",
          "label": "Gradient colour (shown when no image)",
          "options": [
            { "value": "peach",  "label": "Peach / Orange" },
            { "value": "mint",   "label": "Mint / Teal" },
            { "value": "yellow", "label": "Yellow / Gold" }
          ],
          "default": "peach"
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product tag",
          "info": "Shown as a small badge over the image. E.g. Fade Theory",
          "default": "Fade Theory"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Alpha-Arbutin 2%"
        },
        {
          "type": "text",
          "id": "function",
          "label": "One-line function",
          "default": "Blocks melanin production at the source. Zero irritation."
        }
      ]
    },
    {
      "type": "chip",
      "name": "Ingredient Chip",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Niacinamide"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient Directory",
      "blocks": [
        { "type": "star_card", "settings": { "color": "peach",  "product_tag": "Fade Theory",   "name": "Alpha-Arbutin 2%",        "function": "Blocks melanin production at the source. Zero irritation." } },
        { "type": "star_card", "settings": { "color": "mint",   "product_tag": "Soft Reset",     "name": "Triple Ceramide Complex", "function": "NP · AP · EOP — rebuilds your barrier the way your skin does it." } },
        { "type": "star_card", "settings": { "color": "yellow", "product_tag": "Daylite SPF 50+","name": "6-Filter UV System",      "function": "Full spectrum UVA + UVB. Built for Pakistan's UV index 10+." } },
        { "type": "chip", "settings": { "name": "Niacinamide" } },
        { "type": "chip", "settings": { "name": "Tranexamic Acid" } },
        { "type": "chip", "settings": { "name": "Hyaluronic Acid" } },
        { "type": "chip", "settings": { "name": "Panthenol B5" } },
        { "type": "chip", "settings": { "name": "Zinc PCA" } },
        { "type": "chip", "settings": { "name": "Licorice Extract" } },
        { "type": "chip", "settings": { "name": "Matrixyl Peptides" } },
        { "type": "chip", "settings": { "name": "Tocopherol" } }
      ]
    }
  ]
}
{% endschema %}
