<section class="gv-ing-dir" aria-labelledby="gv-ing-dir-title">
  <div class="gv-ing-dir-inner">

    <div class="gv-ing-dir-text">
      <div class="gv-section-label">{{ section.settings.label }}</div>
      <h2 id="gv-ing-dir-title" class="gv-section-title">{{ section.settings.title }}</h2>
      <p class="gv-ing-dir-desc">{{ section.settings.description }}</p>
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="gv-btn-primary">
          {{ section.settings.cta_label }}
          {% render 'gv-icon', icon: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <div class="gv-ing-dir-grid" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'ingredient' -%}
          <div class="gv-dir-card" role="listitem" {{ block.shopify_attributes }}>
            <div class="gv-dir-thumb">
              {%- if block.settings.image != blank -%}
                {%- assign dir_img_alt = block.settings.image.alt | default: block.settings.name | escape -%}
                {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'gv-dir-img', alt: dir_img_alt, width: 60, height: 60, sizes: '60px' }}
              {%- else -%}
                <div class="gv-dir-initial gv-dir-initial--{{ forloop.index | modulo: 6 | plus: 1 }}">
                  {{ block.settings.name | slice: 0, 2 | upcase }}
                </div>
              {%- endif -%}
            </div>
            <div class="gv-dir-info">
              <div class="gv-dir-name">{{ block.settings.name }}</div>
              <div class="gv-dir-function">{{ block.settings.function }}</div>
            </div>
          </div>

        {%- elsif block.type == 'more' -%}
          <div class="gv-dir-card gv-dir-card--more" role="listitem" {{ block.shopify_attributes }}>
            <div class="gv-dir-thumb gv-dir-thumb--more">
              {% render 'gv-icon', icon: 'plus', size: 20 %}
            </div>
            <div class="gv-dir-info">
              <div class="gv-dir-name">{{ block.settings.count }}+ more</div>
              <div class="gv-dir-function">ingredients</div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .gv-ing-dir {
    background: var(--off-white);
    padding: 100px 0;
  }

  .gv-ing-dir-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: center;
  }

  .gv-ing-dir-text .gv-section-title { margin-bottom: 20px; }
  .gv-ing-dir-text .gv-btn-primary { display: inline-flex; align-items: center; gap: 8px; }

  .gv-ing-dir-desc {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--mid-gray);
    line-height: 1.75;
    margin-bottom: 36px;
  }

  /* Grid — 3 cols */
  .gv-ing-dir-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  /* Card */
  .gv-dir-card {
    background: #fff;
    border: 1.5px solid var(--warm-gray);
    border-radius: 14px;
    padding: 14px 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: default;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .gv-dir-card:not(.gv-dir-card--more):hover {
    border-color: var(--coral-pulse);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(244,132,95,0.10);
  }
  .gv-dir-card--more {
    border-style: dashed;
    opacity: 0.6;
  }

  /* Thumbnail */
  .gv-dir-thumb {
    width: 44px; height: 44px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .gv-dir-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .gv-dir-thumb--more {
    background: var(--warm-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--mid-gray);
  }

  /* Initial avatar (when no image) */
  .gv-dir-initial {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    color: var(--berry-dark);
    letter-spacing: 0.02em;
  }
  .gv-dir-initial--1 { background: linear-gradient(135deg, #FFF3D6, #FFC85C); }
  .gv-dir-initial--2 { background: linear-gradient(135deg, #FFE0E8, #FF8FA3); }
  .gv-dir-initial--3 { background: linear-gradient(135deg, #E8F5E4, #A8C5A0); }
  .gv-dir-initial--4 { background: linear-gradient(135deg, #F0EBF8, #9B72AA); color: #fff; }
  .gv-dir-initial--5 { background: linear-gradient(135deg, #FFE8D6, #F4845F); color: #fff; }
  .gv-dir-initial--6 { background: linear-gradient(135deg, #FFF8D6, #FFD580); }

  /* Text */
  .gv-dir-info { min-width: 0; }
  .gv-dir-name {
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--warm-espresso);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 2px;
  }
  .gv-dir-function {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--mid-gray);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1000px) {
    .gv-ing-dir-inner { grid-template-columns: 1fr; gap: 48px; }
  }
  @media (max-width: 768px) {
    .gv-ing-dir { padding: 70px 0; }
    .gv-ing-dir-inner { padding: 0 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient Directory",
  "tag": "section",
  "class": "glowve-ing-dir-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Radical Transparency"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Know every<br><em>ingredient</em><br>we use.</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Every ingredient. Every concentration. Every product it's in. No hidden complexes, no marketing names. Browse our complete ingredient directory — searchable, filterable, and linked to real studies."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore Directory"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ingredient image",
          "info": "Square crop, 120×120px recommended. If left blank, initials are shown."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Vitamin C"
        },
        {
          "type": "text",
          "id": "function",
          "label": "Function",
          "default": "Brightening · Antioxidant"
        }
      ]
    },
    {
      "type": "more",
      "name": "More ingredients pill",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "count",
          "label": "Count",
          "default": "40"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient Directory",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Alpha-Arbutin", "function": "Brightening · Fading dark spots" } },
        { "type": "ingredient", "settings": { "name": "Tranexamic Acid", "function": "PIH · Hyperpigmentation" } },
        { "type": "ingredient", "settings": { "name": "Stable Vitamin C", "function": "Antioxidant · Brightening" } },
        { "type": "ingredient", "settings": { "name": "Niacinamide", "function": "Pores · Tone · Barrier" } },
        { "type": "ingredient", "settings": { "name": "Ceramides", "function": "Barrier repair · Skin shield" } },
        { "type": "ingredient", "settings": { "name": "Hyaluronic Acid", "function": "Deep hydration" } },
        { "type": "ingredient", "settings": { "name": "Panthenol", "function": "Healing · Hydration" } },
        { "type": "ingredient", "settings": { "name": "Zinc PCA", "function": "Sebum control · Pores" } },
        { "type": "more", "settings": { "count": "20" } }
      ]
    }
  ]
}
{% endschema %}
