<section class="gv-symptoms-section" style="background: {{ section.settings.bg_color }};">
  <div class="gv-symptoms-inner">
    {%- if section.settings.title != blank -%}
      <h3 class="gv-symptoms-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h3>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gv-symptoms-grid">
        {%- for block in section.blocks -%}
          <div class="gv-symptom-item" {{ block.shopify_attributes }}>
            <span class="gv-symptom-icon">
              {%- if block.settings.icon_type == 'custom' and block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', style: 'width: 32px; height: 32px; object-fit: contain;' }}
              {%- else -%}
                {%- case block.settings.icon_type -%}
                  {%- when 'water' -%}
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-pink, #FF4D8D);"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path></svg>
                  {%- when 'sting' -%}
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-pink, #FF4D8D);"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                  {%- when 'alert' -%}
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-pink, #FF4D8D);"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                  {%- when 'flake' -%}
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-pink, #FF4D8D);"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                  {%- else -%}
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color: var(--brand-pink, #FF4D8D);"><circle cx="12" cy="12" r="10"></circle></svg>
                {%- endcase -%}
              {%- endif -%}
            </span>
            <p class="gv-symptom-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-symptoms-section {
    padding: 72px 40px;
    border-top: 1px solid var(--warm-gray, #ECECEC);
  }
  .gv-symptoms-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .gv-symptoms-title {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 30px;
    font-weight: 400;
    font-style: italic;
    color: var(--berry-dark, #1A1A1A);
    margin-bottom: 36px;
    text-align: center;
    /* Clean casing */
  }
  .gv-symptoms-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .gv-symptom-item {
    background: white;
    border-radius: 16px;
    padding: 28px 24px;
    border: 1px solid var(--warm-gray, #ECECEC);
    text-align: center;
    box-shadow: 0 4px 16px rgba(0,0,0,0.02);
  }
  .gv-symptom-icon {
    font-size: 28px;
    margin-bottom: 12px;
    display: block;
  }
  .gv-symptom-text {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    color: #5A4E48;
    line-height: 1.55;
    margin: 0;
  }

  @media (max-width: 900px) {
    .gv-symptoms-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .gv-symptoms-section {
      padding: 56px 24px;
    }
    .gv-symptoms-grid {
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Symptoms Grid",
  "tag": "section",
  "class": "glowve-symptoms-grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "Signs your barrier needs attention"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1A1A1A"
    }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Style",
          "options": [
            { "value": "water", "label": "Water Drop" },
            { "value": "sting", "label": "Sting / Spark" },
            { "value": "alert", "label": "Redness / Alert" },
            { "value": "flake", "label": "Flaky / Texture" },
            { "value": "custom", "label": "Custom Image" }
          ],
          "default": "water"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon Image",
          "info": "Only used if 'Custom Image' is selected."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Symptom Text",
          "default": "Moisturiser seems to evaporate within an hour"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Symptoms Grid"
    }
  ]
}
{% endschema %}
