<section class="gv-ing-hero">
  <div class="gv-ing-hero-blobs">
    <div class="gv-ing-blob gv-ing-blob-1"></div>
    <div class="gv-ing-blob gv-ing-blob-2"></div>
    <div class="gv-ing-blob gv-ing-blob-3"></div>
  </div>
  
  <div class="gv-container">
    <div class="gv-ing-hero-content">
      <div class="gv-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="gv-ing-hero-title">{{ section.settings.title }}</h1>
      <p class="gv-ing-hero-sub">{{ section.settings.text }}</p>
      
      <div class="gv-ing-stats">
        {%- for block in section.blocks -%}
          <div class="gv-ing-stat" {{ block.shopify_attributes }}>
            <div class="gv-ing-stat-num">{{ block.settings.number }}</div>
            <div class="gv-ing-stat-label">{{ block.settings.label }}</div>
          </div>
          {%- unless forloop.last -%}
            <div class="gv-ing-stat-divider"></div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-hero {
    background: var(--berry-dark, #1A1A1A);
    padding: 120px 0 100px;
    position: relative;
    overflow: hidden;
  }
  
  .gv-ing-hero-blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  
  .gv-ing-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.2;
    animation: gvBlobFloat 20s infinite alternate ease-in-out;
  }
  
  .gv-ing-blob-1 {
    width: 400px;
    height: 400px;
    background: var(--brand-pink, #FF4D8D);
    top: -100px;
    left: -100px;
  }
  
  .gv-ing-blob-2 {
    width: 300px;
    height: 300px;
    background: #9B72AA;
    bottom: -50px;
    right: -50px;
    animation-delay: -5s;
  }
  
  .gv-ing-blob-3 {
    width: 250px;
    height: 250px;
    background: #F5A623;
    top: 40%;
    left: 60%;
    animation-delay: -10s;
  }
  
  @keyframes gvBlobFloat {
    from { transform: translate(0, 0) rotate(0deg); }
    to { transform: translate(50px, 30px) rotate(10deg); }
  }

  .gv-ing-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .gv-ing-hero-title {
    font-size: min(80px, 12vw);
    line-height: 1;
    color: white;
    margin: 20px 0 32px;
    letter-spacing: -0.02em;
    font-weight: 700;
  }
  
  .gv-ing-hero-title em {
    font-style: normal;
    color: var(--brand-pink, #FF4D8D);
  }

  .gv-ing-hero-sub {
    font-size: 18px;
    color: rgba(255,255,255,0.7);
    line-height: 1.6;
    margin-bottom: 60px;
    max-width: 600px;
  }

  .gv-ing-stats {
    display: flex;
    gap: 40px;
    align-items: center;
    flex-wrap: wrap;
  }

  .gv-ing-stat-num {
    font-size: 40px;
    font-weight: 700;
    color: white;
    line-height: 1;
  }

  .gv-ing-stat-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.4);
    margin-top: 8px;
  }

  .gv-ing-stat-divider {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.1);
  }

  @media (max-width: 768px) {
    .gv-ing-hero { padding: 80px 0; }
    .gv-ing-stats { gap: 30px; }
    .gv-ing-stat-divider { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Ingredient Directory"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "No secrets.<br><em>Science,</em> simplified."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every active, every functional ingredient, and exactly why it's there. Clinical concentrations, total transparency."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "25"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Unique Actives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Hero",
      "blocks": [
        { "type": "stat", "settings": { "number": "3", "label": "Products" } },
        { "type": "stat", "settings": { "number": "25", "label": "Unique Actives" } },
        { "type": "stat", "settings": { "number": "0", "label": "Hidden Complexes" } }
      ]
    }
  ]
}
{% endschema %}
