<section class="gv-ing-hero">
  <div class="gv-ing-hero-blobs">
    <div class="gv-ing-blob gv-ing-blob-1"></div>
    <div class="gv-ing-blob gv-ing-blob-2"></div>
    <div class="gv-ing-blob gv-ing-blob-3"></div>
  </div>
  
  <div class="gv-container">
    <div class="gv-ing-hero-content">
      <div class="gv-ing-hero-label">{{ section.settings.label }}</div>
      <h1 class="gv-ing-hero-title">{{ section.settings.title }}</h1>
      <p class="gv-ing-hero-sub">{{ section.settings.text }}</p>
      
      <div class="gv-ing-hero-stats">
        {%- for block in section.blocks -%}
          <div class="gv-ing-hero-stat" {{ block.shopify_attributes }}>
            <div class="gv-ing-hero-stat-num">{{ block.settings.number }}</div>
            <div class="gv-ing-hero-stat-label">{{ block.settings.label }}</div>
          </div>
          {%- unless forloop.last -%}
            <div class="gv-ing-hero-stat-divider"></div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-hero {
    background: #1A1A1A;
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }
  
  .gv-ing-hero-blobs {
    position: absolute; inset: 0; pointer-events: none; overflow: hidden;
  }
  
  .gv-ing-blob {
    position: absolute; border-radius: 50%; filter: blur(80px); opacity: 0.18;
  }
  
  .gv-ing-blob-1 { width: 500px; height: 500px; background: #FF4D8D; top: -150px; left: -100px; }
  .gv-ing-blob-2 { width: 400px; height: 400px; background: #9B72AA; bottom: -120px; right: -80px; }
  .gv-ing-blob-3 { width: 300px; height: 300px; background: #F5A623; top: 50%; left: 55%; }
  
  .gv-ing-hero-content {
    position: relative; z-index: 2; max-width: 1200px;
  }

  .gv-ing-hero-label {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.2em; color: #FF4D8D; margin-bottom: 20px;
  }

  .gv-ing-hero-title {
    font-family: 'Poppins', sans-serif; font-size: min(72px, 12vw); font-weight: 700; color: white;
    line-height: 1.0; margin-bottom: 20px; letter-spacing: -0.02em;
  }
  
  .gv-ing-hero-title em { font-style: normal; color: #FF4D8D; }

  .gv-ing-hero-sub {
    font-family: 'Poppins', sans-serif; font-size: 17px; color: rgba(255,255,255,0.65);
    max-width: 520px; line-height: 1.7; margin-bottom: 48px;
  }

  .gv-ing-hero-stats {
    display: flex; gap: 40px; flex-wrap: wrap;
  }

  .gv-ing-hero-stat { display: flex; flex-direction: column; gap: 4px; }

  .gv-ing-hero-stat-num {
    font-family: 'Poppins', sans-serif; font-size: 32px; font-weight: 700; color: white; line-height: 1;
  }

  .gv-ing-hero-stat-label {
    font-family: 'Poppins', sans-serif; font-size: 12px; color: rgba(255,255,255,0.5);
    text-transform: uppercase; letter-spacing: 0.08em;
  }

  .gv-ing-hero-stat-divider {
    width: 1px; background: rgba(255,255,255,0.15); align-self: stretch; margin: 4px 0;
  }

  @media (max-width: 768px) {
    .gv-ing-hero { padding: 80px 0; }
    .gv-ing-hero-title { font-size: 48px; }
    .gv-ing-hero-stat-divider { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients Hero (Exact)",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "The Ingredient Directory"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "No secrets.<br><em>Science,</em> simplified."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Every active, every functional ingredient, and exactly why it's there. Clinical concentrations, total transparency — no marketing names, no hidden complexes."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "25"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Unique Actives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients Hero (Exact)",
      "blocks": [
        { "type": "stat", "settings": { "number": "3", "label": "Products" } },
        { "type": "stat", "settings": { "number": "25", "label": "Unique Actives" } },
        { "type": "stat", "settings": { "number": "0", "label": "Hidden Complexes" } }
      ]
    }
  ]
}
{% endschema %}
