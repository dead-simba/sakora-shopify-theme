<section class="gv-ugc">
  <div class="gv-container">

    <div class="gv-section-header">
      <div>
        <div class="gv-section-label">{{ section.settings.label }}</div>
        <h2 class="gv-section-title">{{ section.settings.title }}</h2>
      </div>
      {%- if section.settings.social_handle != blank -%}
        <a href="{{ section.settings.social_url }}" class="gv-view-all" target="_blank" rel="noopener">
          Follow {{ section.settings.social_handle }} →
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gv-ugc-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'photo' -%}
            <div class="gv-ugc-cell gv-ugc-cell--{{ forloop.index }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.handle | escape }}"
                  width="600"
                  loading="lazy"
                  class="gv-ugc-img"
                >
              {%- else -%}
                <div class="gv-ugc-placeholder gv-ugc-placeholder--{{ forloop.index | modulo: 7 | plus: 1 }}" aria-hidden="true"></div>
              {%- endif -%}

              <div class="gv-ugc-overlay">
                <div class="gv-ugc-stars" aria-label="5 stars" role="img">
                  {%- for i in (1..5) -%}{% render 'gv-icon', icon: 'star', size: 10 %}{%- endfor -%}
                </div>
                <div class="gv-ugc-handle">{{ block.settings.handle }}</div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .gv-ugc {
    background: var(--off-white);
    padding: 100px 0;
  }

  .gv-ugc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 180px);
    gap: 12px;
  }

  /* First cell spans 2 rows */
  .gv-ugc-cell--1 {
    grid-row: 1 / 3;
    grid-column: 1;
  }

  .gv-ugc-cell {
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
  }

  .gv-ugc-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s;
  }
  .gv-ugc-cell:hover .gv-ugc-img { transform: scale(1.05); }

  /* Placeholder gradients (no real image yet) */
  .gv-ugc-placeholder {
    width: 100%; height: 100%;
    transition: transform 0.4s;
  }
  .gv-ugc-cell:hover .gv-ugc-placeholder { transform: scale(1.05); }

  .gv-ugc-placeholder--1 { background: linear-gradient(135deg, #FFE8D6, #F4845F); }
  .gv-ugc-placeholder--2 { background: linear-gradient(135deg, #E8F5E4, #A8C5A0); }
  .gv-ugc-placeholder--3 { background: linear-gradient(135deg, #FFF3D6, #FFB347); }
  .gv-ugc-placeholder--4 { background: linear-gradient(135deg, #FFE0E8, #FF8FA3); }
  .gv-ugc-placeholder--5 { background: linear-gradient(135deg, #F0EBF8, #9B72AA); }
  .gv-ugc-placeholder--6 { background: linear-gradient(135deg, #FFFAF6, #E8D5C4); }
  .gv-ugc-placeholder--7 { background: linear-gradient(135deg, #E8F5E4, #FFD580); }

  .gv-ugc-overlay {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: linear-gradient(to top, rgba(45,27,53,0.7), transparent);
    padding: 14px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gv-ugc-cell:hover .gv-ugc-overlay { opacity: 1; }

  .gv-ugc-stars {
    color: var(--mango-zest);
    display: flex;
    gap: 1px;
    margin-bottom: 4px;
  }
  .gv-ugc-handle {
    font-family: var(--font-sans);
    font-size: 12px;
    color: #fff;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .gv-ugc { padding: 70px 0; }
    .gv-ugc-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto;
    }
    .gv-ugc-cell--1 { grid-row: auto; grid-column: auto; }
    .gv-ugc-grid .gv-ugc-cell { height: 160px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve UGC Grid",
  "tag": "section",
  "class": "glowve-ugc-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Real People, Real Skin"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Glowve <em>in the wild</em>"
    },
    {
      "type": "text",
      "id": "social_handle",
      "label": "Social handle",
      "default": "@glowve.pk"
    },
    {
      "type": "url",
      "id": "social_url",
      "label": "Social link"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "UGC Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (optional)",
          "info": "Upload a customer or lifestyle photo. If left blank, a gradient placeholder is shown."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Instagram handle",
          "default": "@username"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve UGC Grid",
      "blocks": [
        { "type": "photo", "settings": { "handle": "@nida.skincare" } },
        { "type": "photo", "settings": { "handle": "@sanabeauty.pk" } },
        { "type": "photo", "settings": { "handle": "@zara.glow" } },
        { "type": "photo", "settings": { "handle": "@ayesha.skin" } },
        { "type": "photo", "settings": { "handle": "@maha.glows" } },
        { "type": "photo", "settings": { "handle": "@hira.routine" } },
        { "type": "photo", "settings": { "handle": "@amna.beauty" } }
      ]
    }
  ]
}
{% endschema %}
