{%- liquid
  assign handle = product.handle | downcase
  assign accent_color = '#1D9E75'
  assign text_color = '#0D3828'
  if handle contains 'petal' or handle contains 'moisturizer' or handle contains 'reset'
    assign accent_color = '#E8A0A0'
    assign text_color = '#5C2020'
  elsif handle contains 'veil' or handle contains 'sunscreen' or handle contains 'daylite' or handle contains 'sol'
    assign accent_color = '#E8B84B'
    assign text_color = '#4A2E00'
  elsif handle contains 'drops' or handle contains 'serum' or handle contains 'fade' or handle contains 'dawn'
    assign accent_color = '#1D9E75'
    assign text_color = '#0D3828'
  endif
-%}

<div class="sakora-acc-wrap" style="--product-accent: {{ accent_color }}; --product-accent-text: {{ text_color }};">
  <div class="sakora-acc-list">

    {%- for block in section.blocks -%}
      <details class="sakora-acc-item" id="sakora-acc-{{ block.id }}" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
        <summary class="sakora-acc-summary">
          <span class="sakora-acc-label">{{ block.settings.title }}</span>
          <svg class="sakora-acc-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>

        <div class="sakora-acc-panel">

          {%- case block.type -%}

            {%- when 'pathways' -%}
              <div class="acc-pdp-science acc-pdp-pathways">
                {%- if block.settings.subtitle != blank -%}
                  <p class="sakora-section-sub" style="margin-bottom:24px; color: rgba(255,255,255,0.75);">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <div class="pathway-cards">
                  {%- for i in (1..5) -%}
                    {%- assign num_k = 'pw_' | append: i | append: '_num' -%}
                    {%- assign title_k = 'pw_' | append: i | append: '_title' -%}
                    {%- assign trig_k = 'pw_' | append: i | append: '_trig' -%}
                    {%- assign ing_k = 'pw_' | append: i | append: '_ing' -%}
                    {%- assign mech_k = 'pw_' | append: i | append: '_mech' -%}
                    {%- if block.settings[num_k] != blank -%}
                      <div class="pathway-card">
                        <div class="pathway-num-pill">{{ block.settings[num_k] }}</div>
                        <div class="pathway-name-big">{{ block.settings[title_k] }}</div>
                        <div class="pathway-trigger-text">{{ block.settings[trig_k] }}</div>
                        <div class="pathway-divider"><div class="pathway-divider-line"></div><div class="pathway-divider-text">blocked by</div><div class="pathway-divider-line"></div></div>
                        <div class="pathway-ing-label">{{ block.settings[ing_k] }}</div>
                        <div class="pathway-mech-text">{{ block.settings[mech_k] }}</div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.stat_num != blank -%}
                <div class="science-bottom-stat">
                  <div class="science-stat-num">{{ block.settings.stat_num }}</div>
                  <div class="science-stat-label">{{ block.settings.stat_label }}</div>
                </div>
                {%- endif -%}
              </div>

            {%- when 'science' -%}
              <div class="acc-pdp-science">
                <div class="barrier-diagram">
                  <div class="barrier-col left">
                    <div class="barrier-col-label">↓ Exogenous Repair</div>
                    {%- for i in (1..3) -%}
                      {%- assign ex_k = 'exo_' | append: i -%}
                      {%- if block.settings[ex_k] != blank -%}
                      <div class="barrier-step">
                        <div class="barrier-step-num">{{ i }}</div>
                        <div class="barrier-step-text">{{ block.settings[ex_k] }}</div>
                      </div>
                      {%- endif -%}
                    {%- endfor -%}
                    <div style="margin-top:20px;background:rgba(232,160,160,0.15);border-radius:24px;padding:16px;">
                      <div style="font-family:var(--font-body-family), sans-serif;font-size:11px;letter-spacing:0.1em;color:rgba(255,255,255,0.6);margin-bottom:6px;text-transform:uppercase;">RESULT</div>
                      <div style="font-size:13px;color:rgba(255,255,255,0.85);">{{ block.settings.exo_result }}</div>
                    </div>
                  </div>

                  <div class="barrier-arrow">⇄</div>

                  <div class="barrier-col right">
                    <div class="barrier-col-label">↑ Endogenous Boost</div>
                    {%- for i in (1..3) -%}
                      {%- assign end_k = 'endo_' | append: i -%}
                      {%- if block.settings[end_k] != blank -%}
                      <div class="barrier-step">
                        <div class="barrier-step-num">{{ i }}</div>
                        <div class="barrier-step-text">{{ block.settings[end_k] }}</div>
                      </div>
                      {%- endif -%}
                    {%- endfor -%}
                    <div style="margin-top:20px;background:rgba(232,160,160,0.15);border-radius:24px;padding:16px;">
                      <div style="font-family:var(--font-body-family), sans-serif;font-size:11px;letter-spacing:0.1em;color:rgba(255,255,255,0.6);margin-bottom:6px;text-transform:uppercase;">RESULT</div>
                      <div style="font-size:13px;color:rgba(255,255,255,0.85);">{{ block.settings.endo_result }}</div>
                    </div>
                  </div>
                </div>

                <div style="background:rgba(232,160,160,0.1);border:1px solid rgba(232,160,160,0.25);border-radius:24px;padding:28px;margin-top:32px;text-align:center;">
                  <div style="font-family:var(--font-heading-family), serif;font-size:26px;color:#fff;font-style:italic;line-height:1.4;">"{{ block.settings.quote }}"</div>
                  <div style="font-size:14px;color:rgba(255,255,255,0.55);margin-top:10px;font-family:var(--font-body-family), sans-serif;letter-spacing:0.05em;">{{ block.settings.quote_sub }}</div>
                </div>

                <div class="science-stat">
                  <div class="science-stat-num">{{ block.settings.stat_num }}</div>
                  <div class="science-stat-label">{{ block.settings.stat_label }}</div>
                  <div class="science-stat-source">{{ block.settings.stat_source }}</div>
                </div>
              </div>

            {%- when 'uv_spectrum' -%}
              <div class="acc-pdp-science">
                {%- if block.settings.subtitle != blank -%}
                  <p class="sakora-section-sub" style="margin-bottom:24px; color:rgba(255,255,255,0.75);">{{ block.settings.subtitle }}</p>
                {%- endif -%}

                <div class="uv-spectrum">
                  <div class="uv-labels">
                    <span>UVB (280nm)</span>
                    <span>UVA2 (320nm)</span>
                    <span>UVA1 (400nm)</span>
                  </div>
                  <div class="uv-bar-container">
                    <div class="uv-bar"></div>
                  </div>
                  <div class="uv-markers">
                    {%- for i in (1..6) -%}
                      {%- assign nm_k = 'uv_' | append: i | append: '_nm' -%}
                      {%- assign name_k = 'uv_' | append: i | append: '_name' -%}
                      {%- assign desc_k = 'uv_' | append: i | append: '_desc' -%}
                      {%- if block.settings[name_k] != blank -%}
                        <div class="uv-marker">
                          <div class="uv-marker-nm">{{ block.settings[nm_k] }}</div>
                          <div class="uv-marker-name">{{ block.settings[name_k] }}</div>
                          <div class="uv-marker-desc">{{ block.settings[desc_k] }}</div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.quote != blank -%}
                  <div class="uv-conclusion">
                    <div class="uv-conclusion-main">"{{ block.settings.quote }}"</div>
                    <div class="uv-conclusion-sub">{{ block.settings.quote_sub }}</div>
                  </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.pk_uv_num != blank -%}
                <div class="pk-uv-box">
                  <div>
                    <div class="pk-uv-num">{{ block.settings.pk_uv_num }}</div>
                    <div style="font-family:var(--font-body-family), sans-serif;font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;letter-spacing:0.1em;text-transform:uppercase;">{{ block.settings.pk_uv_label | default: 'PAKISTAN SUMMER UV INDEX' }}</div>
                  </div>
                  <div class="pk-uv-text">
                    {{ block.settings.pk_uv_text }}
                  </div>
                </div>
                {%- endif -%}

                {%- if block.settings.pa_rating != blank -%}
                <div class="pa-badge-section">
                  <div class="pa-badge">
                    <div class="pa-badge-rating">{{ block.settings.pa_rating }}</div>
                    <div class="pa-badge-label">{{ block.settings.pa_label | default: 'UVA PROTECTION RATING' }}</div>
                  </div>
                  <div class="pa-explain">
                    {{ block.settings.pa_explain }}
                  </div>
                </div>
                {%- endif -%}
              </div>

            {%- when 'ingredients' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="sakora-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="ing-scroll-track">
                {%- for i in (1..6) -%}
                  {%- assign n_key   = 'ing_' | append: i | append: '_name' -%}
                  {%- assign b_key   = 'ing_' | append: i | append: '_benefit' -%}
                  {%- assign bdg_key = 'ing_' | append: i | append: '_badge' -%}
                  {%- assign img_key = 'ing_' | append: i | append: '_image' -%}
                  {%- if block.settings[n_key] != blank -%}
                    <div class="ing-card">
                      <div class="ing-card-img">
                        {%- if block.settings[img_key] != blank -%}
                          {{ block.settings[img_key] | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings[n_key] }}
                        {%- else -%}
                          <div style="background:#F3EFE8;width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#B0A898;">Image</div>
                        {%- endif -%}
                      </div>
                      <div class="ing-card-body">
                        {%- if block.settings[bdg_key] != blank -%}<span class="ing-badge">{{ block.settings[bdg_key] }}</span>{%- endif -%}
                        <div class="ing-name-mono">{{ block.settings[n_key] }}</div>
                        <p class="ing-benefit">{{ block.settings[b_key] }}</p>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p style="font-size:12px;color:#B0A898;margin-top:8px;">← Scroll to see all actives</p>

            {%- when 'how_to_use' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="sakora-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="htu-tabs">
                <button type="button" class="htu-tab active" onclick="switchSakoraRoutineTab(this, 'am', '{{ block.id }}')">☀️ Morning</button>
                <button type="button" class="htu-tab" onclick="switchSakoraRoutineTab(this, 'pm', '{{ block.id }}')">🌙 Evening</button>
              </div>

              <!-- AM Steps -->
              <div class="htu-steps active" id="htu-tab-am-{{ block.id }}">
                {%- assign am_count = 0 -%}
                {%- for i in (1..4) -%}
                  {%- assign l_key = 'am_' | append: i | append: '_label' -%}
                  {%- assign ic_key = 'am_' | append: i | append: '_icon' -%}
                  {%- assign n_key = 'am_' | append: i | append: '_note' -%}
                  {%- assign cur_key = 'am_' | append: i | append: '_current' -%}
                  {%- assign spf_key = 'am_' | append: i | append: '_spf' -%}
                  {%- if block.settings[l_key] != blank -%}
                    {%- assign am_count = am_count | plus: 1 -%}
                    {%- if am_count > 1 -%}<div class="step-connector">→</div>{%- endif -%}
                    <div class="step-card {% if block.settings[cur_key] %}current{% endif %}">
                      <div class="step-icon-wrap" {% if block.settings[spf_key] %}style="background:#FFFBF2;"{% endif %}>
                        <span>{{ block.settings[ic_key] }}</span>
                        <span class="step-num-badge" {% if block.settings[spf_key] %}style="background:var(--product-accent, #E8B84B);color:var(--product-accent-text, #4A2E00);"{% endif %}>{{ am_count }}</span>
                      </div>
                      {%- if block.settings[cur_key] -%}<div class="step-current-tag">This product</div>{%- endif -%}
                      <div class="step-label" {% if block.settings[spf_key] %}style="color:var(--product-accent-text, #4A2E00);"{% endif %}>{{ block.settings[l_key] }}</div>
                      <div class="step-note">{{ block.settings[n_key] }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <!-- PM Steps -->
              <div class="htu-steps" id="htu-tab-pm-{{ block.id }}">
                {%- assign pm_count = 0 -%}
                {%- for i in (1..4) -%}
                  {%- assign l_key = 'pm_' | append: i | append: '_label' -%}
                  {%- assign ic_key = 'pm_' | append: i | append: '_icon' -%}
                  {%- assign n_key = 'pm_' | append: i | append: '_note' -%}
                  {%- assign cur_key = 'pm_' | append: i | append: '_current' -%}
                  {%- if block.settings[l_key] != blank -%}
                    {%- assign pm_count = pm_count | plus: 1 -%}
                    {%- if pm_count > 1 -%}<div class="step-connector">→</div>{%- endif -%}
                    <div class="step-card {% if block.settings[cur_key] %}current{% endif %}">
                      <div class="step-icon-wrap">
                        <span>{{ block.settings[ic_key] }}</span>
                        <span class="step-num-badge">{{ pm_count }}</span>
                      </div>
                      {%- if block.settings[cur_key] -%}<div class="step-current-tag">This product</div>{%- endif -%}
                      <div class="step-label">{{ block.settings[l_key] }}</div>
                      <div class="step-note">{{ block.settings[n_key] }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              
              {%- if block.settings.tip != blank -%}
                <div class="htu-tip">{{ block.settings.tip }}</div>
              {%- endif -%}

            {%- when 'timeline' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="sakora-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="tl-cards">
                {%- for i in (1..4) -%}
                  {%- assign p_key = 'tl_' | append: i | append: '_period' -%}
                  {%- assign t_key = 'tl_' | append: i | append: '_title' -%}
                  {%- assign b_key = 'tl_' | append: i | append: '_body' -%}
                  {%- if block.settings[p_key] != blank -%}
                    <div class="tl-card">
                      <div class="tl-week">{{ block.settings[p_key] }}</div>
                      <div class="tl-title">{{ block.settings[t_key] }}</div>
                      <p class="tl-body">{{ block.settings[b_key] }}</p>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.tip != blank -%}
                <div class="tl-note">💡 <span>{{ block.settings.tip }}</span></div>
              {%- endif -%}

            {%- when 'inci' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="sakora-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="inci-clean-badges">
                {%- for i in (1..6) -%}
                  {%- assign bg = 'clean_badge_' | append: i -%}
                  {%- if block.settings[bg] != blank -%}
                    <span class="inci-clean-badge">✓ {{ block.settings[bg] }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.content != blank -%}
                <div class="inci-content">
                  {{ block.settings.content }}
                </div>
              {%- endif -%}

          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}

  </div>
</div>

<script>
  document.querySelectorAll('.sakora-acc-item').forEach(function(det) {
    det.addEventListener('toggle', function() {
      det.querySelector('.sakora-acc-chevron').style.transform = det.open ? 'rotate(180deg)' : '';
    });
    if (det.open) {
      det.querySelector('.sakora-acc-chevron').style.transform = 'rotate(180deg)';
    }
  });

  function switchSakoraRoutineTab(btn, tab, blockId) {
    var parent = btn.closest('.sakora-acc-panel');
    parent.querySelectorAll('.htu-tab').forEach(t => t.classList.remove('active'));
    parent.querySelectorAll('.htu-steps').forEach(t => t.classList.remove('active'));
    
    btn.classList.add('active');
    document.getElementById('htu-tab-' + tab + '-' + blockId).classList.add('active');
  }
</script>

{% stylesheet %}
  /* Wrapper */
  .sakora-acc-wrap {
    background: #FAFAF5; /* Cream */
    padding: 0 0 72px;
    margin-top: 40px;
  }
  .sakora-acc-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Accordion row */
  .sakora-acc-item {
    border-bottom: 1px solid #E8E2D5;
    background: #FFFFFF;
    border: 1px solid #E8E2D5;
    border-radius: 24px; /* Organic curves */
    margin-bottom: 20px;
    box-shadow: 0 4px 12px rgba(28,28,26,0.02);
    overflow: hidden;
  }

  .sakora-acc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 32px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 16px;
  }
  .sakora-acc-summary::-webkit-details-marker { display: none; }

  .sakora-acc-label {
    font-family: var(--font-heading-family), 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 400;
    color: #1C1C1A; /* Charcoal */
    line-height: 1.3;
  }

  .sakora-acc-chevron {
    flex-shrink: 0;
    color: #1C1C1A;
    transition: transform 0.25s ease;
  }

  /* Panel */
  .sakora-acc-panel {
    padding: 0 32px 40px 32px;
  }

  .sakora-section-sub {
    font-family: var(--font-body-family), sans-serif;
    font-size: 15px;
    color: #B0A898; /* Dust */
    line-height: 1.65;
    max-width: 720px;
  }

  /* Pathways */
  .acc-pdp-pathways { padding-top: 32px; }
  .pathway-cards {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 12px;
  }
  .pathway-cards::-webkit-scrollbar { display: none; }
  
  .pathway-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 24px; /* Organic curves */
    padding: 28px 20px;
    transition: background 0.2s;
    min-width: 240px;
    flex: 1;
    flex-shrink: 0;
    scroll-snap-align: start;
  }
  .pathway-card:hover { background: rgba(255,255,255,0.08); }
  
  .pathway-num-pill {
    font-family: var(--font-body-family), sans-serif;
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--product-accent-text, #1D9E75);
    background: rgba(255,255,255,0.15);
    border-radius: 50px; /* Pill profile */
    padding: 6px 12px;
    display: inline-block;
    margin-bottom: 20px;
  }
  
  .pathway-name-big {
    font-family: var(--font-heading-family), serif;
    font-size: 22px;
    color: #ffffff;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  
  .pathway-trigger-text {
    font-family: var(--font-body-family), sans-serif;
    font-size: 12px;
    color: rgba(255,255,255,0.45);
    margin-bottom: 24px;
    line-height: 1.5;
  }
  
  .pathway-divider {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  
  .pathway-divider-line {
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,0.15);
  }
  
  .pathway-divider-text {
    font-family: var(--font-body-family), sans-serif;
    font-size: 8px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--product-accent-text, #1D9E75);
  }
  
  .pathway-ing-label {
    font-family: var(--font-body-family), sans-serif;
    font-size: 14px;
    color: var(--product-accent-text, #1D9E75);
    font-weight: 500;
    margin-bottom: 12px;
  }
  
  .pathway-mech-text {
    font-family: var(--font-body-family), sans-serif;
    font-size: 13px;
    color: rgba(255,255,255,0.6);
    line-height: 1.65;
  }
  
  .science-bottom-stat {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 32px;
    margin-top: 32px;
    text-align: center;
  }

  @media(min-width: 1024px) {
    .pathway-cards { display: grid; grid-template-columns: repeat(5, 1fr); overflow-x: visible; gap: 16px; }
    .pathway-card { min-width: auto; }
  }

  /* Science Barrier */
  .acc-pdp-science {
    background: #1C1C1A; /* Charcoal dark section wrapper */
    border-radius: 24px; /* Organic curves */
    padding: 40px;
    overflow: hidden;
  }
  .barrier-diagram { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0; align-items: stretch; }
  .barrier-col { padding: 32px; }
  .barrier-col.left { background: rgba(255,255,255,0.02); border-radius: 24px 0 0 24px; border: 1px solid rgba(255,255,255,0.08); }
  .barrier-col.right { background: rgba(255,255,255,0.02); border-radius: 0 24px 24px 0; border: 1px solid rgba(255,255,255,0.08); border-left: none; }
  .barrier-col-label { font-family: var(--font-body-family), sans-serif; font-size: 12px; font-weight: 500; color: var(--product-accent, #1D9E75); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 24px; }
  .barrier-arrow { display: flex; align-items: center; justify-content: center; width: 60px; color: var(--product-accent, #1D9E75); font-size: 32px; flex-shrink: 0; }
  .barrier-step { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 20px; }
  .barrier-step-num { width: 28px; height: 28px; border-radius: 50%; background: var(--product-accent, #1D9E75); color: var(--product-accent-text, #ffffff); font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
