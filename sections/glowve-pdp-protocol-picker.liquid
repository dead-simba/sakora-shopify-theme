{%- liquid
  assign opt2_prod = all_products[section.settings.opt2_product]
  assign opt3_prod = all_products[section.settings.opt3_product]
-%}

<div class="gv-protocol-section" data-protocol-picker>

  {%- if section.settings.title != blank -%}
    <p class="gv-protocol-label">{{ section.settings.title }}</p>
  {%- endif -%}

  <div class="gv-protocol-options" role="radiogroup" aria-label="{{ section.settings.title }}">

    {%- comment -%} Option 1 — always the current product {%- endcomment -%}
    <label class="gv-protocol-opt gv-protocol-opt--active"
      data-variant-id="{{ product.first_available_variant.id }}"
    >
      <input
        type="radio"
        name="gv-protocol"
        class="gv-protocol-radio"
        value="{{ product.first_available_variant.id }}"
        checked
      >
      <div class="gv-protocol-content">
        <div class="gv-protocol-left">
          <div class="gv-protocol-dot"><div class="gv-protocol-dot-inner"></div></div>
          <div class="gv-protocol-info">
            <span class="gv-protocol-title">{{ section.settings.opt1_title }}</span>
            {%- if section.settings.opt1_subtitle != blank -%}
              <span class="gv-protocol-sub">{{ section.settings.opt1_subtitle }}</span>
            {%- endif -%}
          </div>
        </div>
        <div class="gv-protocol-right">
          <span class="gv-protocol-price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="gv-protocol-compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.opt1_badge != blank -%}
        <div class="gv-protocol-badge gv-protocol-badge--{{ section.settings.opt1_badge_color }}">
          {{ section.settings.opt1_badge }}
        </div>
      {%- endif -%}
    </label>

    {%- comment -%} Option 2 — bundle product {%- endcomment -%}
    {%- if opt2_prod != empty -%}
      {%- assign opt2_variant = opt2_prod.first_available_variant -%}
      <label class="gv-protocol-opt"
        data-variant-id="{{ opt2_variant.id }}"
      >
        <input
          type="radio"
          name="gv-protocol"
          class="gv-protocol-radio"
          value="{{ opt2_variant.id }}"
          {%- unless opt2_variant.available %} disabled{%- endunless -%}
        >
        <div class="gv-protocol-content">
          <div class="gv-protocol-left">
            <div class="gv-protocol-dot"><div class="gv-protocol-dot-inner"></div></div>
            <div class="gv-protocol-info">
              <span class="gv-protocol-title">{{ section.settings.opt2_title }}</span>
              {%- if section.settings.opt2_free_shipping -%}
                <span class="gv-protocol-sub gv-protocol-sub--ship">Free Shipping Unlocked</span>
              {%- elsif section.settings.opt2_subtitle != blank -%}
                <span class="gv-protocol-sub">{{ section.settings.opt2_subtitle }}</span>
              {%- endif -%}
            </div>
          </div>
          <div class="gv-protocol-right">
            <span class="gv-protocol-price">{{ opt2_prod.price | money }}</span>
            {%- if opt2_prod.compare_at_price > opt2_prod.price -%}
              <span class="gv-protocol-compare">{{ opt2_prod.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.opt2_badge != blank -%}
          <div class="gv-protocol-badge gv-protocol-badge--{{ section.settings.opt2_badge_color | default: 'gold' }}">
            {{ section.settings.opt2_badge }}
          </div>
        {%- endif -%}
      </label>
    {%- endif -%}

    {%- comment -%} Option 3 — bundle product {%- endcomment -%}
    {%- if opt3_prod != empty -%}
      {%- assign opt3_variant = opt3_prod.first_available_variant -%}
      <label class="gv-protocol-opt"
        data-variant-id="{{ opt3_variant.id }}"
      >
        <input
          type="radio"
          name="gv-protocol"
          class="gv-protocol-radio"
          value="{{ opt3_variant.id }}"
          {%- unless opt3_variant.available %} disabled{%- endunless -%}
        >
        <div class="gv-protocol-content">
          <div class="gv-protocol-left">
            <div class="gv-protocol-dot"><div class="gv-protocol-dot-inner"></div></div>
            <div class="gv-protocol-info">
              <span class="gv-protocol-title">{{ section.settings.opt3_title }}</span>
              {%- if section.settings.opt3_free_shipping -%}
                <span class="gv-protocol-sub gv-protocol-sub--ship">Free Shipping Unlocked</span>
              {%- elsif section.settings.opt3_subtitle != blank -%}
                <span class="gv-protocol-sub">{{ section.settings.opt3_subtitle }}</span>
              {%- endif -%}
            </div>
          </div>
          <div class="gv-protocol-right">
            <span class="gv-protocol-price">{{ opt3_prod.price | money }}</span>
            {%- if opt3_prod.compare_at_price > opt3_prod.price -%}
              <span class="gv-protocol-compare">{{ opt3_prod.compare_at_price | money }}</span>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.opt3_badge != blank -%}
          <div class="gv-protocol-badge gv-protocol-badge--{{ section.settings.opt3_badge_color | default: 'coral' }}">
            {{ section.settings.opt3_badge }}
          </div>
        {%- endif -%}
      </label>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    function initProtocolPicker() {
      var picker = document.querySelector('[data-protocol-picker]');
      if (!picker) return;

      // Move picker into the product details column, before buy buttons
      var buyButtons = document.querySelector('buy-buttons');
      if (buyButtons) {
        buyButtons.parentNode.insertBefore(picker, buyButtons);
      }

      // Hide native variant picker — protocol picker replaces it
      var nativePicker = document.querySelector('variant-picker');
      if (nativePicker) nativePicker.style.display = 'none';

      // The native hidden input that holds the variant ID for the form
      var nativeInput = document.querySelector('input[name="id"], select[name="id"]');

      // Set initial value
      var checkedRadio = picker.querySelector('.gv-protocol-radio:checked');
      if (checkedRadio && nativeInput) {
        nativeInput.value = checkedRadio.value;
      }

      // Listen for selection changes
      picker.querySelectorAll('.gv-protocol-radio').forEach(function (radio) {
        radio.addEventListener('change', function () {
          // Update active state
          picker.querySelectorAll('.gv-protocol-opt').forEach(function (opt) {
            opt.classList.remove('gv-protocol-opt--active');
          });
          this.closest('.gv-protocol-opt').classList.add('gv-protocol-opt--active');

          // Swap variant ID in the product form — cart doesn't care which
          // product the variant belongs to, only the variant ID matters
          if (nativeInput) {
            nativeInput.value = this.value;
            nativeInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }

    document.readyState === 'loading'
      ? document.addEventListener('DOMContentLoaded', initProtocolPicker)
      : initProtocolPicker();
  })();
</script>

{% stylesheet %}
  .gv-protocol-section {
    font-family: var(--font-sans);
  }

  .gv-protocol-label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--mid-gray);
    margin-bottom: 10px;
  }

  .gv-protocol-options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gv-protocol-opt {
    position: relative;
    display: block;
    border: 1.5px solid var(--warm-gray);
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
    background: white;
    overflow: hidden;
  }
  .gv-protocol-opt:hover { border-color: var(--mango-zest); }
  .gv-protocol-opt--active {
    border-color: var(--mango-zest);
    background: #FFFBF0;
  }

  .gv-protocol-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .gv-protocol-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .gv-protocol-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .gv-protocol-dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--warm-gray);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s;
  }
  .gv-protocol-opt--active .gv-protocol-dot { border-color: var(--mango-zest); }

  .gv-protocol-dot-inner {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mango-zest);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .gv-protocol-opt--active .gv-protocol-dot-inner { opacity: 1; }

  .gv-protocol-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gv-protocol-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--warm-espresso);
    line-height: 1.3;
  }

  .gv-protocol-sub {
    font-size: 12px;
    color: var(--mid-gray);
  }
  .gv-protocol-sub--ship {
    color: #2E7D32;
    font-weight: 500;
  }

  .gv-protocol-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    flex-shrink: 0;
  }

  .gv-protocol-price {
    font-size: 15px;
    font-weight: 700;
    color: var(--warm-espresso);
  }

  .gv-protocol-compare {
    font-size: 12px;
    color: var(--mid-gray);
    text-decoration: line-through;
  }

  .gv-protocol-badge {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 10px;
    border-radius: 0 10px 0 10px;
    line-height: 1;
  }
  .gv-protocol-badge--gold   { background: var(--mango-zest); color: white; }
  .gv-protocol-badge--coral  { background: var(--coral-pulse); color: white; }
  .gv-protocol-badge--green  { background: #2E7D32; color: white; }
{% endstylesheet %}

{% schema %}
{
  "name": "Protocol Picker",
  "tag": "div",
  "class": "glowve-protocol-picker-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Label",
      "default": "Select Your Protocol"
    },
    {
      "type": "header",
      "content": "Option 1 — Single (current product)"
    },
    { "type": "text", "id": "opt1_title", "label": "Title", "default": "1 Bottle" },
    { "type": "text", "id": "opt1_subtitle", "label": "Subtitle", "default": "Try it out." },
    { "type": "text", "id": "opt1_badge", "label": "Badge text", "info": "Leave blank for no badge." },
    {
      "type": "select",
      "id": "opt1_badge_color",
      "label": "Badge colour",
      "options": [
        { "value": "gold", "label": "Gold" },
        { "value": "coral", "label": "Coral" },
        { "value": "green", "label": "Green" }
      ],
      "default": "gold"
    },
    {
      "type": "header",
      "content": "Option 2 — 2-bottle bundle"
    },
    { "type": "product", "id": "opt2_product", "label": "Bundle product", "info": "Select the 2-bottle bundle product created via your Bundle app." },
    { "type": "text", "id": "opt2_title", "label": "Title", "default": "2 Bottles (2 Month Supply)" },
    { "type": "text", "id": "opt2_subtitle", "label": "Subtitle", "info": "Ignored if 'Free Shipping' is checked." },
    { "type": "checkbox", "id": "opt2_free_shipping", "label": "Show 'Free Shipping Unlocked'", "default": true },
    { "type": "text", "id": "opt2_badge", "label": "Badge text", "default": "Most Popular (Save 15%)" },
    {
      "type": "select",
      "id": "opt2_badge_color",
      "label": "Badge colour",
      "options": [
        { "value": "gold", "label": "Gold" },
        { "value": "coral", "label": "Coral" },
        { "value": "green", "label": "Green" }
      ],
      "default": "gold"
    },
    {
      "type": "header",
      "content": "Option 3 — 3-bottle bundle"
    },
    { "type": "product", "id": "opt3_product", "label": "Bundle product", "info": "Select the 3-bottle bundle product created via your Bundle app." },
    { "type": "text", "id": "opt3_title", "label": "Title", "default": "3 Bottles (Save 20%)" },
    { "type": "text", "id": "opt3_subtitle", "label": "Subtitle", "default": "Never run out." },
    { "type": "checkbox", "id": "opt3_free_shipping", "label": "Show 'Free Shipping Unlocked'", "default": true },
    { "type": "text", "id": "opt3_badge", "label": "Badge text", "default": "Best Value (Save 20%)" },
    {
      "type": "select",
      "id": "opt3_badge_color",
      "label": "Badge colour",
      "options": [
        { "value": "gold", "label": "Gold" },
        { "value": "coral", "label": "Coral" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    }
  ],
  "presets": [
    { "name": "Protocol Picker" }
  ]
}
{% endschema %}
