{%- liquid
  assign opt2_prod = all_products[section.settings.opt2_product]
  assign opt3_prod = all_products[section.settings.opt3_product]
-%}

<div class="gv-pp-section" data-protocol-picker>

  {%- if section.settings.title != blank -%}
    <p class="gv-pp-label">{{ section.settings.title }}</p>
  {%- endif -%}

  <div class="gv-pp-opts" role="radiogroup" aria-label="{{ section.settings.title }}">

    {%- comment -%} Option 1 — always the current product {%- endcomment -%}
    <label class="gv-pp-opt gv-pp-opt--active"
      data-variant-id="{{ product.first_available_variant.id }}"
    >
      <input
        type="radio"
        name="gv-protocol"
        class="gv-pp-radio"
        value="{{ product.first_available_variant.id }}"
        checked
      >
      <div class="gv-pp-dot"></div>
      <div class="gv-pp-info">
        <span class="gv-pp-title">{{ section.settings.opt1_title }}</span>
        {%- if section.settings.opt1_subtitle != blank -%}
          <span class="gv-pp-sub">{{ section.settings.opt1_subtitle }}</span>
        {%- endif -%}
      </div>
      <div class="gv-pp-pricing">
        <span class="gv-pp-price">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="gv-pp-was">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.opt1_badge != blank -%}
        <div class="gv-pp-badge gv-pp-badge--{{ section.settings.opt1_badge_color }}">
          {{ section.settings.opt1_badge }}
        </div>
      {%- endif -%}
    </label>

    {%- comment -%} Option 2 — bundle product {%- endcomment -%}
    {%- if opt2_prod != empty -%}
      {%- assign opt2_variant = opt2_prod.first_available_variant -%}
      <label class="gv-pp-opt"
        data-variant-id="{{ opt2_variant.id }}"
      >
        <input
          type="radio"
          name="gv-protocol"
          class="gv-pp-radio"
          value="{{ opt2_variant.id }}"
          {%- unless opt2_variant.available %} disabled{%- endunless -%}
        >
        <div class="gv-pp-dot"></div>
        <div class="gv-pp-info">
          <span class="gv-pp-title">{{ section.settings.opt2_title }}</span>
          {%- if section.settings.opt2_free_shipping -%}
            <span class="gv-pp-sub gv-pp-sub--ship">Free Shipping Unlocked</span>
          {%- elsif section.settings.opt2_subtitle != blank -%}
            <span class="gv-pp-sub">{{ section.settings.opt2_subtitle }}</span>
          {%- endif -%}
        </div>
        <div class="gv-pp-pricing">
          <span class="gv-pp-price">{{ opt2_prod.price | money }}</span>
          {%- if opt2_prod.compare_at_price > opt2_prod.price -%}
            <span class="gv-pp-was">{{ opt2_prod.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.opt2_badge != blank -%}
          <div class="gv-pp-badge gv-pp-badge--{{ section.settings.opt2_badge_color | default: 'coral' }}">
            {{ section.settings.opt2_badge }}
          </div>
        {%- endif -%}
      </label>
    {%- endif -%}

    {%- comment -%} Option 3 — bundle product {%- endcomment -%}
    {%- if opt3_prod != empty -%}
      {%- assign opt3_variant = opt3_prod.first_available_variant -%}
      <label class="gv-pp-opt"
        data-variant-id="{{ opt3_variant.id }}"
      >
        <input
          type="radio"
          name="gv-protocol"
          class="gv-pp-radio"
          value="{{ opt3_variant.id }}"
          {%- unless opt3_variant.available %} disabled{%- endunless -%}
        >
        <div class="gv-pp-dot"></div>
        <div class="gv-pp-info">
          <span class="gv-pp-title">{{ section.settings.opt3_title }}</span>
          {%- if section.settings.opt3_free_shipping -%}
            <span class="gv-pp-sub gv-pp-sub--ship">Free Shipping Unlocked</span>
          {%- elsif section.settings.opt3_subtitle != blank -%}
            <span class="gv-pp-sub">{{ section.settings.opt3_subtitle }}</span>
          {%- endif -%}
        </div>
        <div class="gv-pp-pricing">
          <span class="gv-pp-price">{{ opt3_prod.price | money }}</span>
          {%- if opt3_prod.compare_at_price > opt3_prod.price -%}
            <span class="gv-pp-was">{{ opt3_prod.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        {%- if section.settings.opt3_badge != blank -%}
          <div class="gv-pp-badge gv-pp-badge--{{ section.settings.opt3_badge_color | default: 'coral' }}">
            {{ section.settings.opt3_badge }}
          </div>
        {%- endif -%}
      </label>
    {%- endif -%}

  </div>
</div>

<script>
  (function () {
    function initProtocolPicker() {
      var picker = document.querySelector('[data-protocol-picker]');
      if (!picker) return;

      var buyButtons = document.querySelector('buy-buttons');
      if (buyButtons) {
        buyButtons.parentNode.insertBefore(picker, buyButtons);
      }

      var nativePicker = document.querySelector('variant-picker');
      if (nativePicker) nativePicker.style.display = 'none';

      var nativeInput = document.querySelector('input[name="id"], select[name="id"]');

      var checkedRadio = picker.querySelector('.gv-pp-radio:checked');
      if (checkedRadio && nativeInput) {
        nativeInput.value = checkedRadio.value;
      }

      picker.querySelectorAll('.gv-pp-radio').forEach(function (radio) {
        radio.addEventListener('change', function () {
          picker.querySelectorAll('.gv-pp-opt').forEach(function (opt) {
            opt.classList.remove('gv-pp-opt--active');
          });
          this.closest('.gv-pp-opt').classList.add('gv-pp-opt--active');
          if (nativeInput) {
            nativeInput.value = this.value;
            nativeInput.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }

    document.readyState === 'loading'
      ? document.addEventListener('DOMContentLoaded', initProtocolPicker)
      : initProtocolPicker();
  })();
</script>

{% stylesheet %}
  .gv-pp-section {
    font-family: var(--font-sans);
    margin-bottom: 24px;
  }

  .gv-pp-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #1A1A1A;
    margin: 0 0 14px;
  }

  .gv-pp-opts {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gv-pp-opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    background: white;
    border: 1px solid #EAEAEA;
    border-radius: 16px;
    transition: all 0.2s ease;
    overflow: visible;
  }

  .gv-pp-opt--active {
    background: #FFF5F8;
    border-color: var(--coral-pulse);
    border-width: 2.5px;
    padding: 18.5px 22.5px;
  }

  .gv-pp-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .gv-pp-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid #D1D1D1;
    flex-shrink: 0;
    position: relative;
    transition: all 0.2s ease;
  }
  .gv-pp-opt--active .gv-pp-dot {
    border-color: var(--coral-pulse);
    border-width: 6px;
  }

  .gv-pp-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .gv-pp-title {
    font-size: 16px;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.2;
  }

  .gv-pp-sub {
    font-size: 13px;
    color: #888;
    line-height: 1.4;
  }
  .gv-pp-sub--ship {
    color: #108043;
    font-weight: 600;
  }

  .gv-pp-pricing {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .gv-pp-price {
    font-size: 18px;
    font-weight: 700;
    color: #1A1A1A;
  }

  .gv-pp-was {
    font-size: 13px;
    color: #A0A0A0;
    text-decoration: line-through;
  }

  .gv-pp-badge {
    position: absolute;
    top: -1px;
    right: 20px;
    background: var(--coral-pulse);
    color: white;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 4px 12px;
    border-radius: 0 0 8px 8px;
    line-height: 1.2;
    z-index: 1;
  }

  @media (max-width: 599px) {
    .gv-pp-opt {
      padding: 16px;
      gap: 12px;
    }
    .gv-pp-opt--active {
      padding: 14.5px 14.5px;
    }
    .gv-pp-title {
      font-size: 14px;
    }
    .gv-pp-sub {
      font-size: 12px;
    }
    .gv-pp-price {
      font-size: 15px;
    }
    .gv-pp-badge {
      right: 12px;
      font-size: 9px;
      padding: 3px 10px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Protocol Picker",
  "tag": "div",
  "class": "glowve-protocol-picker-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Label",
      "default": "Select Your Protocol"
    },
    { "type": "header", "content": "Option 1 — Single" },
    { "type": "text", "id": "opt1_title", "label": "Title", "default": "1 Bottle" },
    { "type": "text", "id": "opt1_subtitle", "label": "Subtitle", "default": "Try it out." },
    { "type": "text", "id": "opt1_badge", "label": "Badge text" },
    {
      "type": "select", "id": "opt1_badge_color", "label": "Badge colour",
      "options": [
        { "value": "coral", "label": "Pink" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    },
    { "type": "header", "content": "Option 2 — 2-bottle bundle" },
    { "type": "product", "id": "opt2_product", "label": "Bundle product" },
    { "type": "text", "id": "opt2_title", "label": "Title", "default": "2 Bottles (2 Month Supply)" },
    { "type": "text", "id": "opt2_subtitle" },
    { "type": "checkbox", "id": "opt2_free_shipping", "label": "Show 'Free Shipping Unlocked'", "default": true },
    { "type": "text", "id": "opt2_badge", "label": "Badge text", "default": "Most Popular (Save 15%)" },
    {
      "type": "select", "id": "opt2_badge_color", "label": "Badge colour",
      "options": [
        { "value": "coral", "label": "Pink" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    },
    { "type": "header", "content": "Option 3 — 3-bottle bundle" },
    { "type": "product", "id": "opt3_product", "label": "Bundle product" },
    { "type": "text", "id": "opt3_title", "label": "Title", "default": "3 Bottles (Save 20%)" },
    { "type": "text", "id": "opt3_subtitle", "label": "Subtitle", "default": "Never run out." },
    { "type": "checkbox", "id": "opt3_free_shipping", "label": "Show 'Free Shipping Unlocked'", "default": true },
    { "type": "text", "id": "opt3_badge", "label": "Badge text", "default": "Best Value (Save 20%)" },
    {
      "type": "select", "id": "opt3_badge_color", "label": "Badge colour",
      "options": [
        { "value": "coral", "label": "Pink" },
        { "value": "green", "label": "Green" }
      ],
      "default": "coral"
    }
  ],
  "presets": [
    { "name": "Protocol Picker" }
  ]
}
{% endschema %}

