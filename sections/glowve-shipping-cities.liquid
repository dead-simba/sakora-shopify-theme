<section class="gv-ship-cities">
  <div class="gv-ship-cities__inner">
    <div class="gv-ship-cities__label">{{ section.settings.label }}</div>
    <h2 class="gv-ship-cities__title">{{ section.settings.title }}</h2>
    <p class="gv-ship-cities__sub">{{ section.settings.subtitle }}</p>

    <div class="gv-ship-cities__pills">
      {%- for block in section.blocks -%}
        <span class="gv-ship-city" {{ block.shopify_attributes }}>{{ block.settings.name }}</span>
      {%- endfor -%}
    </div>

    <p class="gv-ship-cities__cta">
      Don't see your city? <a href="{{ section.settings.contact_link }}">Message us</a> — we'll figure it out.
    </p>
  </div>
</section>

{% stylesheet %}
  .gv-ship-cities { background: #FAFAFA; padding: 80px 0; border-top: 1px solid #ECECEC; }
  .gv-ship-cities__inner { max-width: 760px; margin: 0 auto; padding: 0 40px; }

  .gv-ship-cities__label {
    font-family: 'Poppins', sans-serif !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: #FF4D8D !important; margin-bottom: 12px;
  }
  .gv-ship-cities__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 42px !important; font-weight: 600 !important;
    color: #1A1A1A !important; line-height: 1.2 !important;
    margin-bottom: 24px; 
  }
  .gv-ship-cities__title em { font-style: normal !important; color: #FF4D8D !important; }
  .gv-ship-cities__sub {
    font-family: 'Poppins', sans-serif; font-size: 16px; color: #666;
    line-height: 1.7; margin-bottom: 32px;
  }

  .gv-ship-cities__pills { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .gv-ship-city {
    font-family: 'Poppins', sans-serif; font-size: 13px;
    background: white; border: 1.5px solid #ECECEC;
    padding: 8px 16px; border-radius: 100px; color: #1A1A1A;
    transition: border-color 0.2s, background 0.2s;
  }
  .gv-ship-city:hover { border-color: #FF4D8D; background: #FFF0F5; }

  .gv-ship-cities__cta {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666;
  }
  .gv-ship-cities__cta a { color: #FF4D8D; font-weight: 600; text-decoration: none; }
  .gv-ship-cities__cta a:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .gv-ship-cities__inner { padding: 0 20px; }
    .gv-ship-cities__title { font-size: 32px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cities We Serve",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "— Cities We Serve —" },
    { "type": "html", "id": "title", "label": "Title", "default": "all of <em>Pakistan.</em>" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "We deliver to every major city across Pakistan — with more coverage added regularly." },
    { "type": "url", "id": "contact_link", "label": "Contact Page Link" }
  ],
  "blocks": [
    {
      "type": "city",
      "name": "City",
      "settings": [
        { "type": "text", "id": "name", "label": "City Name", "default": "Lahore" }
      ]
    }
  ],
  "presets": [{ "name": "Cities We Serve" }]
}
{% endschema %}
