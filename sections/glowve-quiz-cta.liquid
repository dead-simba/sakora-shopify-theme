<section class="gv-quiz-cta">
  <div class="gv-container">
    {%- if section.settings.title != blank -%}
      <h3 class="gv-quiz-cta-title">{{ section.settings.title }}</h3>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="gv-quiz-cta-text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link }}" class="gv-btn-quiz">{{ section.settings.btn_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-quiz-cta {
    background: var(--accent-mint, #E2F5EE);
    padding: 80px 40px;
    text-align: center;
  }

  .gv-quiz-cta-title {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 36px;
    font-weight: 600;
    font-style: italic;
    color: var(--berry-dark, #1A1A1A);
    margin-bottom: 10px;
  }

  .gv-quiz-cta-text {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 15px;
    color: var(--mid-gray, #666666);
    margin-bottom: 32px;
  }

  .gv-btn-quiz {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: transparent;
    color: var(--brand-pink, #FF4D8D);
    border: 2px solid var(--brand-pink, #FF4D8D);
    padding: 10px 24px;
    border-radius: 100px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .gv-btn-quiz:hover {
    background: var(--brand-pink, #FF4D8D);
    color: white;
  }

  @media (max-width: 640px) {
    .gv-quiz-cta {
      padding: 60px 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quiz CTA",
  "tag": "section",
  "class": "glowve-quiz-cta-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Not sure which one is right for you?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Answer 5 questions and we'll tell you exactly where to start."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Take the Skin Quiz →"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Quiz CTA"
    }
  ]
}
{% endschema %}
