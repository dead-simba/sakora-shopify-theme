{%- liquid
  assign handle = product.handle | downcase
  
  assign is_moisturizer = false
  assign is_sunscreen = false
  assign is_serum = false

  if handle contains 'petal' or handle contains 'moisturizer' or handle contains 'reset' or handle contains 'moisturiser'
    assign is_moisturizer = true
  elsif handle contains 'veil' or handle contains 'sunscreen' or handle contains 'daylite' or handle contains 'spf'
    assign is_sunscreen = true
  else
    assign is_serum = true
  endif
-%}

{%- style -%}
  .sakora-reviews {
    background-color: var(--sakora-cream);
    padding: 6rem 2rem;
    border-bottom: 0.5px solid #E0DCD4;
  }
  .sakora-reviews__wrapper {
    max-width: 900px;
    margin: 0 auto;
  }
  .sakora-reviews__heading-pre {
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sakora-dust);
    margin: 0 0 1rem;
  }
  .sakora-reviews__heading {
    text-align: center;
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 3.5vw, 4rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--sakora-charcoal);
    margin: 0 0 4rem;
  }
  .sakora-reviews__heading em {
    font-style: italic;
    color: var(--sakora-emerald);
  }
  
  /* Summary Card */
  .sakora-reviews__summary-card {
    background-color: rgba(232, 160, 160, 0.1); /* Dewy pink tint */
    border-radius: 24px;
    padding: 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 4rem;
    border: 0.5px solid rgba(232, 160, 160, 0.25);
  }
  @media screen and (min-width: 750px) {
    .sakora-reviews__summary-card {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      padding: 3rem 4rem;
    }
  }
  .sakora-reviews__summary-stars {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }
  .sakora-reviews__summary-score {
    font-family: var(--font-heading-family);
    font-size: 3.6rem;
    font-weight: 500;
    color: var(--sakora-charcoal);
    line-height: 1;
    margin-right: 1.5rem;
  }
  .sakora-reviews__summary-meta {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    color: #6B6358;
  }
  .sakora-reviews__recommend-text {
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-style: italic;
    color: var(--sakora-emerald);
    margin-top: 1rem;
  }
  @media screen and (min-width: 750px) {
    .sakora-reviews__recommend-text {
      margin-top: 0;
      text-align: right;
    }
  }
  
  /* Reviews List */
  .sakora-reviews__list {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .sakora-reviews__item {
    border-bottom: 0.5px solid #E0DCD4;
    padding-bottom: 3rem;
  }
  .sakora-reviews__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .sakora-reviews__item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.2rem;
  }
  .sakora-reviews__item-stars {
    display: flex;
    gap: 0.2rem;
    color: #E8A0A0; /* Dewy Pink stars */
  }
  .sakora-reviews__item-date {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    color: var(--sakora-dust);
  }
  .sakora-reviews__user-info {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }
  .sakora-reviews__avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--sakora-stone);
    color: var(--sakora-charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 500;
  }
  .sakora-reviews__username {
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--sakora-charcoal);
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .sakora-reviews__verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 1rem;
    color: var(--sakora-emerald);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .sakora-reviews__item-text {
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    line-height: 1.7;
    color: #4A453E;
  }
  
  /* Star SVG styles */
  .sakora-star {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }
  .sakora-star--large {
    width: 24px;
    height: 24px;
  }
{%- endstyle -%}

