<section class="gv-page-hero" style="background: {{ section.settings.bg_color }};">
  <div class="gv-page-hero-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="gv-page-hero-eyebrow" style="color: {{ section.settings.eyebrow_color }};">
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="gv-page-hero-title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="gv-page-hero-desc" style="color: {{ section.settings.text_color }};">
        {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-page-hero {
    padding: 100px 0;
  }
  .gv-page-hero-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .gv-page-hero-eyebrow {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .gv-page-hero-title {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 72px;
    font-weight: 600;
    line-height: 1.05;
    margin-bottom: 16px;
  }
  .gv-page-hero-title em {
    font-style: normal;
    color: var(--brand-pink, #FF4D8D);
  }
  .gv-page-hero-desc {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 18px;
    line-height: 1.7;
    max-width: 500px;
  }
  .gv-page-hero-desc p {
    margin-bottom: 1em;
  }
  .gv-page-hero-desc p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .gv-page-hero { padding: 60px 0; }
    .gv-page-hero-inner { padding: 0 24px; }
    .gv-page-hero-title { font-size: 52px; }
    .gv-page-hero-desc { font-size: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Page Hero",
  "tag": "section",
  "class": "glowve-page-hero-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFF0E6"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Get in Touch"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#FF4D8D"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "We're <em>here.</em>"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1A1A1A"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every message gets a real reply. Not a bot.</p>"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Page Hero"
    }
  ]
}
{% endschema %}
