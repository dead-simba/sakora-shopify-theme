<section class="gv-ing-star-section">
  <div class="gv-container">
    <div class="gv-split-header">
      <div class="gv-header-col gv-header-col--label">
        <div class="gv-section-label">{{ section.settings.label }}</div>
      </div>
      <div class="gv-header-col gv-header-col--title">
        <h2 class="gv-section-title">{{ section.settings.title }}</h2>
      </div>
      <div class="gv-header-col gv-header-col--sub">
        <p class="gv-section-sub">{{ section.settings.text }}</p>
      </div>
    </div>

    <div class="gv-ing-star-grid">
      {%- for block in section.blocks -%}
        <div class="gv-ing-star-card gv-ing-star-card--{{ block.settings.color_theme }}" {{ block.shopify_attributes }}>
          <div class="gv-ing-star-header">
            <div class="gv-ing-star-header-blob"></div>
            <div class="gv-ing-star-visual">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'gv-ing-star-img' }}
              {%- else -%}
                <span class="gv-ing-star-icon">{{ block.settings.icon_emoji }}</span>
              {%- endif -%}
            </div>
          </div>
          
          <div class="gv-ing-star-body">
            <div class="gv-ing-star-badges">
              {%- if block.settings.badge_1 != blank -%}<span class="gv-ing-badge">{{ block.settings.badge_1 }}</span>{%- endif -%}
              {%- if block.settings.badge_2 != blank -%}<span class="gv-ing-badge">{{ block.settings.badge_2 }}</span>{%- endif -%}
            </div>
            
            <h3 class="gv-ing-star-name">{{ block.settings.name }}</h3>
            <div class="gv-ing-star-inci">{{ block.settings.inci }}</div>
            <p class="gv-ing-star-desc">{{ block.settings.desc }}</p>
            
            <div class="gv-ing-why-box">
              <div class="gv-ing-why-label">{{ block.settings.why_label }}</div>
              <div class="gv-ing-why-text">{{ block.settings.why_text }}</div>
            </div>

            {%- if block.settings.product != blank -%}
              {%- assign p = all_products[block.settings.product] -%}
              <div class="gv-ing-found-label">Found In</div>
              <a href="{{ p.url }}" class="gv-ing-product-link">
                <div class="gv-ing-product-img">
                  {%- if p.featured_image != blank -%}
                    {{ p.featured_image | image_url: width: 100 | image_tag: loading: 'lazy' }}
                  {%- else -%}
                    <span>🧴</span>
                  {%- endif -%}
                </div>
                <div class="gv-ing-product-info">
                  <div class="gv-ing-p-name">{{ p.title }}</div>
                  <div class="gv-ing-p-type">{{ p.type | default: 'Treatment' }}</div>
                </div>
                <div class="gv-ing-p-arrow">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </div>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-star-section {
    padding: 96px 0;
    background: white;
  }
  
  /* SPLIT HEADER LAYOUT */
  .gv-split-header {
    display: grid;
    grid-template-columns: 200px 1fr 340px;
    gap: 40px;
    align-items: end;
    margin-bottom: 60px;
  }

  .gv-section-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;
    color: #FF4D8D; margin-bottom: 12px;
    display: flex; align-items: center; gap: 10px;
  }
  .gv-section-label::before { content: ''; display: block; width: 28px; height: 1px; background: #FF4D8D; }
  
  .gv-section-title {
    font-size: 48px; font-weight: 700; color: #1A1A1A; line-height: 1.1; letter-spacing: -0.02em;
  }
  .gv-section-title em { font-style: normal; color: #FF4D8D; }

  .gv-section-sub {
    font-size: 16px; color: #666; line-height: 1.7;
  }

  /* STAR GRID */
  .gv-ing-star-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .gv-ing-star-card {
    background: white; border-radius: 24px; border: 1px solid #ECECEC;
    overflow: hidden; display: flex; flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .gv-ing-star-card:hover { transform: translateY(-8px); box-shadow: 0 20px 60px rgba(0,0,0,0.1); }

  .gv-ing-star-header {
    height: 180px; display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .gv-ing-star-visual { position: relative; z-index: 2; height: 100%; width: 100%; display: flex; align-items: center; justify-content: center; }
  .gv-ing-star-img { width: 100%; height: 100%; object-fit: cover; }
  .gv-ing-star-icon { font-size: 64px; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.15)); }
  .gv-ing-star-header-blob { position: absolute; border-radius: 50%; filter: blur(30px); opacity: 0.5; width: 200px; height: 200px; }

  /* CARD THEMES */
  .gv-ing-star-card--peach .gv-ing-star-header { background: #FFF0E6; }
  .gv-ing-star-card--peach .gv-ing-star-header-blob { background: #FF8C5A; top: -50px; right: -50px; }
  .gv-ing-star-card--peach .gv-ing-badge { background: #FFE6D6; color: #E8622A; }

  .gv-ing-star-card--mint .gv-ing-star-header { background: #E2F5EE; }
  .gv-ing-star-card--mint .gv-ing-star-header-blob { background: #2ABFA3; top: -50px; right: -50px; }
  .gv-ing-star-card--mint .gv-ing-badge { background: #D4F0E6; color: #1A8A72; }

  .gv-ing-star-card--yellow .gv-ing-star-header { background: #FFF8D6; }
  .gv-ing-star-card--yellow .gv-ing-star-header-blob { background: #F5A623; top: -50px; right: -50px; }
  .gv-ing-star-card--yellow .gv-ing-badge { background: #FEF0B2; color: #8B6914; }

  .gv-ing-star-body { padding: 32px; flex-grow: 1; display: flex; flex-direction: column; }
  .gv-ing-star-badges { display: flex; gap: 8px; margin-bottom: 16px; }
  .gv-ing-badge { font-size: 10px; font-weight: 700; text-transform: uppercase; padding: 4px 10px; border-radius: 100px; }
  
  .gv-ing-star-name { font-size: 24px; font-weight: 700; color: #1A1A1A; margin-bottom: 4px; }
  .gv-ing-star-inci { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #666; margin-bottom: 20px; }
  .gv-ing-star-desc { font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 24px; flex-grow: 1; }

  .gv-ing-why-box { background: #F9F9F9; border-left: 3px solid #FF4D8D; padding: 16px; border-radius: 0 12px 12px 0; margin-bottom: 24px; }
  .gv-ing-why-label { font-size: 10px; font-weight: 700; text-transform: uppercase; color: #FF4D8D; margin-bottom: 4px; }
  .gv-ing-why-text { font-size: 12px; color: #1A1A1A; line-height: 1.5; }

  .gv-ing-found-label { font-size: 10px; font-weight: 700; text-transform: uppercase; color: #BBB; margin-bottom: 12px; }
  
  .gv-ing-product-link {
    display: flex; align-items: center; gap: 12px; background: #F9F9F9; padding: 10px;
    border-radius: 16px; text-decoration: none; border: 1px solid #EEE; transition: all 0.2s;
  }
  .gv-ing-product-link:hover { border-color: #FF4D8D; transform: translateX(4px); }
  
  .gv-ing-product-img { width: 44px; height: 44px; border-radius: 8px; background: white; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 20px; }
  .gv-ing-product-img img { width: 100%; height: 100%; object-fit: contain; }
  
  .gv-ing-p-name { font-size: 13px; font-weight: 700; color: #1A1A1A; line-height: 1.2; }
  .gv-ing-p-type { font-size: 11px; color: #666; }
  .gv-ing-p-arrow { margin-left: auto; color: #FF4D8D; }
  .gv-ing-p-arrow svg { width: 16px; height: 16px; }

  @media (max-width: 1024px) {
    .gv-split-header { grid-template-columns: 1fr; gap: 12px; align-items: start; }
    .gv-header-col--sub { margin-bottom: 20px; }
    .gv-ing-star-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .gv-ing-star-grid { grid-template-columns: 1fr; }
    .gv-section-title { font-size: 32px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Star Ingredients (Exact)",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Hero Ingredients"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Title",
      "default": "Three ingredients.<br><em>Everything</em> built around them."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Each product is built around one star active — chosen for clinical evidence, not trends. Here's what they are and why we chose them."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Alpha-Arbutin" },
        { "type": "text", "id": "icon_emoji", "label": "Icon (Emoji)", "default": "🫐" },
        { "type": "image_picker", "id": "image", "label": "Macro Photo (Replaces Emoji)" },
        {
          "type": "select", "id": "color_theme", "label": "Color Theme",
          "options": [
            { "value": "peach", "label": "Peach" },
            { "value": "mint", "label": "Mint" },
            { "value": "yellow", "label": "Yellow" }
          ], "default": "peach"
        },
        { "type": "text", "id": "badge_1", "label": "Badge 1", "default": "Tyrosinase Inhibitor" },
        { "type": "text", "id": "badge_2", "label": "Badge 2", "default": "Brightening" },
        { "type": "text", "id": "inci", "label": "INCI Details", "default": "ALPHA-ARBUTIN · 2% · from bearberry" },
        { "type": "textarea", "id": "desc", "label": "Description", "default": "Blocks melanin production at the source — not by stripping pigment, but by stopping new dark spots from forming." },
        { "type": "text", "id": "why_label", "label": "Why Label", "default": "Why 2%" },
        { "type": "textarea", "id": "why_text", "label": "Why Text", "default": "EU-validated as the exact efficacy threshold without irritation. Not rounded up, not cut down." },
        { "type": "product", "id": "product", "label": "Featured Product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Star Ingredients (Exact)",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Alpha-Arbutin", "icon_emoji": "🫐", "color_theme": "peach" } },
        { "type": "ingredient", "settings": { "name": "Triple Ceramide Complex", "icon_emoji": "🧱", "color_theme": "mint" } },
        { "type": "ingredient", "settings": { "name": "6-Filter UV System", "icon_emoji": "☀️", "color_theme": "yellow" } }
      ]
    }
  ]
}
{% endschema %}
