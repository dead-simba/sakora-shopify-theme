<section class="gv-shop-hero">
  <div class="gv-container">
    {%- if section.settings.eyebrow != blank -%}
      <div class="gv-shop-hero-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="gv-shop-hero-title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="gv-shop-hero-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gv-filter-row">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link }}"
            class="gv-filter-pill{% if block.settings.is_active %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.label }}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-shop-hero {
    background: var(--cream-glow, #FFFFFF);
    padding: 80px 40px 60px;
    text-align: center;
    border-bottom: 1px solid var(--warm-gray, #ECECEC);
  }

  .gv-shop-hero-eyebrow {
    font-family: var(--font-mono, 'Poppins', sans-serif);
    font-size: 12px;
    font-weight: 600;
    color: var(--coral-pulse, #FF4D8D);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .gv-shop-hero-title {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 72px;
    font-weight: 600;
    color: var(--berry-dark, #1A1A1A);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-bottom: 16px;
    text-transform: lowercase;
  }

  .gv-shop-hero-title em {
    font-style: italic;
  }

  .gv-shop-hero-subtitle {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 18px;
    color: var(--mid-gray, #666666);
    letter-spacing: 0.01em;
    max-width: 600px;
    margin: 0 auto 40px;
    line-height: 1.5;
  }

  .gv-filter-row {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .gv-filter-pill {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 9px 20px;
    border-radius: 100px;
    border: 1.5px solid var(--warm-gray, #ECECEC);
    background: transparent;
    color: var(--mid-gray, #666666);
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    display: inline-block;
  }

  .gv-filter-pill:hover {
    border-color: var(--coral-pulse, #FF4D8D);
    color: var(--coral-pulse, #FF4D8D);
  }

  .gv-filter-pill.is-active {
    background: var(--berry-dark, #1A1A1A);
    border-color: var(--berry-dark, #1A1A1A);
    color: white;
  }

  @media (max-width: 900px) {
    .gv-shop-hero-title {
      font-size: 52px;
    }
  }

  @media (max-width: 640px) {
    .gv-shop-hero {
      padding: 60px 24px 40px;
    }
    .gv-shop-hero-title {
      font-size: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop Hero",
  "tag": "section",
  "class": "glowve-shop-hero-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The Full Range"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Headline",
      "default": "the <em>collection</em>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Clinically-proven solutions for South Asian skin. Re-engineered from the ground up for our climate."
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Filter Pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Pill Label",
          "default": "Shop All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "is_active",
          "label": "Set as Active?",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop Hero",
      "blocks": [
        { "type": "pill", "settings": { "label": "Shop All", "is_active": true } },
        { "type": "pill", "settings": { "label": "Serums", "is_active": false } },
        { "type": "pill", "settings": { "label": "Moisturisers", "is_active": false } },
        { "type": "pill", "settings": { "label": "Sunscreens", "is_active": false } }
      ]
    }
  ]
}
{% endschema %}
