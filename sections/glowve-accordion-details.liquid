<div class="gv-pdp-acc">
  <div class="gv-pdp-inner">
    {%- for block in section.blocks -%}
      <details>
        <summary>{{ block.settings.title }}</summary>
        <div class="content">
          {{ block.settings.content }}
        </div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Accordion Details",
  "settings": [],
  "blocks": [
    {
      "type": "row",
      "name": "Accordion Row",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Title" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordion Details"
    }
  ]
}
{% endschema %}
