<section class="gv-ship-exchanges">
  <div class="gv-ship-exchanges__inner">
    <div class="gv-ship-exchange-cards">
      <!-- EXCHANGES -->
      <div class="gv-ship-exchange-card">
        <div class="gv-ship-exchange-card__icon">🔁</div>
        <h3 class="gv-ship-exchange-card__title">{{ section.settings.ex_title }}</h3>
        <p class="gv-ship-exchange-card__text">{{ section.settings.ex_text }}</p>
        {%- if section.settings.ex_note != blank -%}
          <p class="gv-ship-exchange-card__note">{{ section.settings.ex_note }}</p>
        {%- endif -%}
      </div>
      <!-- DAMAGED -->
      <div class="gv-ship-exchange-card">
        <div class="gv-ship-exchange-card__icon">📸</div>
        <h3 class="gv-ship-exchange-card__title">{{ section.settings.dmg_title }}</h3>
        <p class="gv-ship-exchange-card__text">{{ section.settings.dmg_text }}</p>
      </div>
    </div>

    <!-- CANCELLATION -->
    <div class="gv-ship-cancel">
      <div class="gv-ship-cancel__icon">🚫</div>
      <h3 class="gv-ship-cancel__title">{{ section.settings.cancel_title }}</h3>
      <p class="gv-ship-cancel__text">{{ section.settings.cancel_text }}</p>
      <p class="gv-ship-cancel__cta">{{ section.settings.cancel_cta }}</p>
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ship-exchanges { background: white; padding: 80px 0; }
  .gv-ship-exchanges__inner { max-width: 760px; margin: 0 auto; padding: 0 40px; }

  .gv-ship-exchange-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 40px; }
  .gv-ship-exchange-card {
    background: #FAFAFA; border: 1.5px solid #ECECEC; border-radius: 20px; padding: 28px;
    transition: border-color 0.2s;
  }
  .gv-ship-exchange-card:hover { border-color: rgba(255,77,141,0.3); }
  .gv-ship-exchange-card__icon { font-size: 28px; margin-bottom: 12px; }
  .gv-ship-exchange-card__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 20px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 10px; text-transform: lowercase !important;
  }
  .gv-ship-exchange-card__text {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666; line-height: 1.65;
  }
  .gv-ship-exchange-card__note {
    font-family: 'Poppins', sans-serif; font-size: 13px; color: #666;
    line-height: 1.65; margin-top: 12px; font-style: italic;
  }

  .gv-ship-cancel {
    background: #FFF8D6; border: 1px solid rgba(255,200,0,0.3);
    border-radius: 20px; padding: 28px 32px;
  }
  .gv-ship-cancel__icon { font-size: 24px; margin-bottom: 12px; }
  .gv-ship-cancel__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 20px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 10px; text-transform: lowercase !important;
  }
  .gv-ship-cancel__text {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666; line-height: 1.7;
  }
  .gv-ship-cancel__cta {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #1A1A1A;
    font-weight: 500; margin-top: 12px;
  }
  .gv-ship-cancel__cta a { color: #FF4D8D; font-weight: 600; text-decoration: none; }
  .gv-ship-cancel__cta a:hover { text-decoration: underline; }

  @media (max-width: 768px) {
    .gv-ship-exchanges__inner { padding: 0 20px; }
    .gv-ship-exchange-cards { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Exchanges & Damaged",
  "settings": [
    { "type": "text", "id": "ex_title", "label": "Exchanges Title", "default": "Exchanges" },
    { "type": "textarea", "id": "ex_text", "label": "Exchanges Text", "default": "Wrong item or manufacturing defect? We'll ship the correct or replacement product at no extra cost. Same 30-day window applies." },
    { "type": "textarea", "id": "ex_note", "label": "Exchanges Note", "default": "Want a different product instead? Return the original under the 30-Day Guarantee and place a new order — we'll prioritise shipping." },
    { "type": "text", "id": "dmg_title", "label": "Damaged Title", "default": "Damaged on Arrival" },
    { "type": "textarea", "id": "dmg_text", "label": "Damaged Text", "default": "Contact us within 48 hours of delivery with a photo. Do not discard the product or packaging until resolved. We'll arrange a free replacement or full refund — instantly, your choice." },
    { "type": "text", "id": "cancel_title", "label": "Cancellation Title", "default": "Cancellation Policy" },
    { "type": "textarea", "id": "cancel_text", "label": "Cancellation Text", "default": "Orders can be cancelled before they are dispatched. Once handed over to the courier, cancellation isn't possible — but the 30-Day Clinical Guarantee still applies once you receive it." },
    { "type": "html", "id": "cancel_cta", "label": "Cancellation CTA", "default": "To cancel, message us immediately on <a href=\"#\">WhatsApp</a>, <a href=\"#\">Instagram</a>, or our <a href=\"#\">Contact page</a> with your order number." }
  ],
  "presets": [{ "name": "Exchanges & Damaged" }]
}
{% endschema %}
