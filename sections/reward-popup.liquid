<style>
  reward-popup {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    align-items: center;
    justify-content: center;
  }
  reward-popup[is-open="true"] {
    display: flex;
  }
  .reward-popup-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 1;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  reward-popup[is-open="true"] .reward-popup-overlay {
    opacity: 1;
  }
  .reward-popup-modal {
    position: relative;
    z-index: 2;
    background: rgb(var(--color-background));
    border-radius: var(--popup-corner-radius, 16px);
    width: 90%;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    opacity: 0;
    transform: translateY(20px) scale(0.98);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @media screen and (min-width: 750px) {
    .reward-popup-modal {
      flex-direction: row;
      min-height: 400px;
    }
  }
  reward-popup[is-open="true"] .reward-popup-modal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .reward-popup-close {
    position: absolute;
    top: 15px;
    right: 15px;
    background: rgb(var(--color-background));
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    cursor: pointer;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-foreground));
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    transition: transform 0.2s ease;
  }
  .reward-popup-close:hover {
    transform: scale(1.1);
  }
  .reward-popup-close svg {
    width: 14px;
    height: 14px;
  }
  .reward-popup-image {
    flex: 1;
    min-height: 200px;
    position: relative;
  }
  .reward-popup-image img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reward-popup-content {
    flex: 1;
    padding: 40px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .reward-popup-content-inner {
    max-width: 360px;
    margin: 0 auto;
    width: 100%;
  }
  .reward-popup-title {
    font-family: var(--font-heading-family);
    font-size: calc(var(--font-heading-scale) * 2.8rem);
    margin: 0 0 10px 0;
    line-height: 1.1;
  }
  .reward-popup-text {
    font-size: 1.4rem;
    color: rgba(var(--color-foreground), 0.75);
    margin: 0 0 25px 0;
    line-height: 1.4;
  }
  .reward-popup-fields {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .reward-popup-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.65);
    line-height: 1.3;
    cursor: pointer;
    margin-bottom: 5px;
  }
  .reward-popup-consent input[type="checkbox"] {
    margin-top: 2px;
    accent-color: rgb(var(--color-button));
  }
  .reward-popup-success-block {
    text-align: center;
    padding: 20px 0;
  }
  .reward-popup-code {
    display: inline-block;
    background: rgba(var(--color-foreground), 0.05);
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: bold;
    font-family: monospace;
    font-size: 1.8rem;
    letter-spacing: 2px;
    margin-top: 10px;
    border: 1px dashed rgba(var(--color-foreground), 0.2);
  }
  .reward-popup-errors {
    font-size: 1.2rem;
    margin-bottom: 15px;
    padding: 10px;
    background: rgba(var(--color-error, 255, 0, 0), 0.1);
    color: rgb(var(--color-error, 200, 0, 0));
    border-radius: 4px;
  }
</style>

<reward-popup 
  data-trigger="{{ section.settings.trigger_pattern }}" 
  data-delay="{{ section.settings.timer_delay }}" 
  data-cookie="{{ section.settings.cookie_days }}"
>
  <div class="reward-popup-overlay"></div>
  <div class="reward-popup-modal">
    <button class="reward-popup-close" aria-label="Close">
      <svg viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M1 1L13 13M1 13L13 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    {% if section.settings.image != blank %}
      <div class="reward-popup-image" style="background-color: rgb(var(--color-background));">
        {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.image.alt | escape }}
      </div>
    {% endif %}

    <div class="reward-popup-content">
      <div class="reward-popup-content-inner">
        {% form 'customer', id: 'RewardPopupForm' %}
          {% if form.posted_successfully? %}
            <div class="reward-popup-success-block">
              <h3 class="reward-popup-title">{{ section.settings.success_heading }}</h3>
              <div class="reward-popup-text">{{ section.settings.success_subtext }}</div>
              {% if section.settings.success_code != blank %}
                <div class="reward-popup-code">{{ section.settings.success_code }}</div>
              {% endif %}
            </div>
          {% else %}
            <h2 class="reward-popup-title">{{ section.settings.heading }}</h2>
            <div class="reward-popup-text">{{ section.settings.subtext }}</div>

            {% if form.errors %}
              <div class="reward-popup-errors">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            <input type="hidden" id="RewardTags" name="contact[tags]" value="prospect, reward_popup, whatsapp_consent">
            
            <div class="reward-popup-fields">
              <div class="field">
                <input class="field__input" type="email" name="contact[email]" placeholder="Email Address" required>
                <label class="field__label">Email Address</label>
              </div>
              <div class="field">
                <input class="field__input" type="tel" name="contact[phone]" placeholder="WhatsApp Number" required>
                <label class="field__label">WhatsApp Number</label>
              </div>
              
              <label class="reward-popup-consent">
                <input type="checkbox" name="customer[accepts_marketing]" checked="checked" onchange="document.getElementById('RewardTags').value = this.checked ? 'prospect, reward_popup, whatsapp_consent' : 'prospect, reward_popup';">
                <span>{{ section.settings.consent_text }}</span>
              </label>
              
              <button type="submit" class="button button--primary button--full-width">
                {{ section.settings.button_label }}
              </button>
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</reward-popup>

<script>
  if (!customElements.get('reward-popup')) {
    customElements.define('reward-popup', class extends HTMLElement {
      constructor() {
        super();
        this.cookieName = 'glowve_reward_dismissed';
      }

      connectedCallback() {
        this.closeBtn = this.querySelector('.reward-popup-close');
        this.overlay = this.querySelector('.reward-popup-overlay');
        
        if (this.closeBtn) this.closeBtn.addEventListener('click', () => this.dismiss());
        if (this.overlay) this.overlay.addEventListener('click', () => this.dismiss());

        const isSuccess = !!this.querySelector('.reward-popup-success-block');
        const hasErrors = !!this.querySelector('.reward-popup-errors');

        // If form was just submitted, open immediately
        if (isSuccess || hasErrors) {
          this.show();
          if (isSuccess) this.setCookie(); // Prevent showing again if they successfully signed up
          return;
        }

        if (this.hasCookie()) return;
        this.initTriggers();
      }

      initTriggers() {
        const trigger = this.dataset.trigger;
        const delay = parseInt(this.dataset.delay) * 1000;

        if (trigger === 'timer' || trigger === 'both') {
          setTimeout(() => this.show(), delay);
        }

        if (trigger === 'exit' || trigger === 'both') {
          document.addEventListener('mouseleave', this.handleMouseLeave.bind(this));
        }
      }

      handleMouseLeave(e) {
        if (e.clientY <= 0 && !this.hasCookie() && !this.getAttribute('is-open')) {
          this.show();
          document.removeEventListener('mouseleave', this.handleMouseLeave.bind(this));
        }
      }

      show() {
        if (this.hasCookie() && !this.querySelector('.reward-popup-success-block') && !this.querySelector('.reward-popup-errors')) return;
        this.setAttribute('is-open', 'true');
      }

      dismiss() {
        this.removeAttribute('is-open');
        this.setCookie();
      }

      setCookie() {
        const days = parseInt(this.dataset.cookie) || 7;
        const date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        document.cookie = `${this.cookieName}=true;expires=${date.toUTCString()};path=/`;
      }

      hasCookie() {
        return document.cookie.indexOf(`${this.cookieName}=true`) !== -1;
      }
    });
  }
</script>

{% schema %}
{
  "name": "Reward Pop-up",
  "settings": [
    {
      "type": "select",
      "id": "trigger_pattern",
      "label": "Trigger Logic",
      "options": [
        {
          "value": "timer",
          "label": "Timer Delay Only"
        },
        {
          "value": "exit",
          "label": "Exit Intent Only"
        },
        {
          "value": "both",
          "label": "Both (Whichever is first)"
        }
      ],
      "default": "both"
    },
    {
      "type": "range",
      "id": "timer_delay",
      "label": "Timer Delay (Seconds)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 8,
      "info": "If logic includes Timer, how long to wait."
    },
    {
      "type": "range",
      "id": "cookie_days",
      "label": "Dismissal Memory (Days)",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 7,
      "info": "How long to keep hidden after user closes it."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Sidebar Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Reward is Waiting"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>Enter your email & WhatsApp to unlock 10% off your first Glowve routine.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Reveal Reward"
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Consent Text",
      "default": "I agree to receive marketing messages. We promise not to disturb."
    },
    {
      "type": "header",
      "content": "Success State"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success Heading",
      "default": "You're In!"
    },
    {
      "type": "richtext",
      "id": "success_subtext",
      "label": "Success Subtext",
      "default": "<p>Your glow journey begins now.</p>"
    },
    {
      "type": "text",
      "id": "success_code",
      "label": "Discount Code (Optional)",
      "default": "GLOW10",
      "info": "Code to display on success."
    }
  ],
  "presets": [
    {
      "name": "Reward Pop-up"
    }
  ]
}
{% endschema %}
