<section class="gv-email-capture">
  <div class="gv-email-inner">

    <div class="gv-email-icon" aria-hidden="true">
      {% render 'gv-icon', icon: 'leaf', size: 40 %}
    </div>

    <h2 class="gv-email-title">{{ section.settings.title }}</h2>
    <p class="gv-email-desc">{{ section.settings.description }}</p>

    {%- form 'customer', id: 'gv-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="gv-email-form" role="form">
        <label for="gv-email-input" class="visually-hidden">{{ section.settings.placeholder }}</label>
        <input
          type="email"
          name="contact[email]"
          id="gv-email-input"
          class="gv-email-input"
          placeholder="{{ section.settings.placeholder }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="gv-btn-primary">
          {{ section.settings.cta_label }}
        </button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="gv-email-success">{{ section.settings.success_message }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="gv-email-fine">{{ section.settings.fine_print }}</p>

  </div>
</section>

{% stylesheet %}
  .gv-email-capture {
    background: linear-gradient(135deg, #FFF0E8, #FFE0D0);
    padding: 100px 0;
  }

  .gv-email-inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
    padding: 0 40px;
  }

  .gv-email-icon {
    width: 64px; height: 64px;
    background: var(--coral-pulse);
    border-radius: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 28px;
    color: #fff;
  }

  .gv-email-title {
    font-family: var(--font-sans);
    font-size: 44px;
    font-weight: 600;
    color: var(--berry-dark);
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .gv-email-title em { font-style: normal !important; color: var(--coral-pulse) !important; }

  .gv-email-desc {
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--mid-gray);
    line-height: 1.65;
    margin-bottom: 36px;
  }

  .gv-email-form {
    display: flex;
    background: #fff;
    border-radius: 100px;
    padding: 6px 6px 6px 24px;
    box-shadow: 0 8px 32px rgba(45,27,53,0.08);
    align-items: center;
    gap: 0;
  }

  .gv-email-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--warm-espresso);
    outline: none;
    min-width: 0;
  }
  .gv-email-input::placeholder { color: var(--mid-gray); }

  .gv-email-form .gv-btn-primary {
    flex-shrink: 0;
    padding: 12px 28px;
    font-size: 12px;
  }

  .gv-email-success {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--sage-calm);
    margin-top: 16px;
    font-weight: 500;
  }

  .gv-email-fine {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    margin-top: 16px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 568px) {
    .gv-email-capture { padding: 70px 0; }
    .gv-email-inner { padding: 0 20px; }
    .gv-email-title { font-size: 36px; }
    .gv-email-form {
      flex-direction: column;
      border-radius: 16px;
      padding: 16px;
      gap: 12px;
    }
    .gv-email-input { width: 100%; text-align: center; }
    .gv-email-form .gv-btn-primary { width: 100%; text-align: center; border-radius: 100px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Email Capture",
  "tag": "section",
  "class": "glowve-email-capture-wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Get <em>10% off</em><br>your first order.</p>"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Plus: early access to new launches, ingredient deep-dives, and honest skincare advice — straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You're in! Check your inbox for your 10% off code."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "No spam. Unsubscribe any time. We take your privacy seriously."
    }
  ],
  "presets": [
    {
      "name": "Glowve Email Capture"
    }
  ]
}
{% endschema %}
