<section class="gv-featured-section" style="background: {{ section.settings.bg_color }};">
  <div class="gv-featured-inner">
    {%- if section.settings.section_label != blank -%}
      <div class="gv-featured-label" style="color: {{ section.settings.label_color }}; border-color: {{ section.settings.label_color | color_modify: 'alpha', 0.2 }};">
        {{ section.settings.section_label }}
      </div>
    {%- endif -%}

    {%- if section.settings.section_title != blank -%}
      <h2 class="gv-featured-section-title">{{ section.settings.section_title }}</h2>
    {%- endif -%}

    <div class="gv-featured-card">
      <div class="gv-featured-img-wrap" style="background: {{ section.settings.img_bg_gradient }};">
        {%- assign prod = section.settings.product -%}
        {%- if section.settings.custom_image != blank -%}
          {{ section.settings.custom_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {%- elsif prod != empty and prod.featured_image -%}
          {{ prod.featured_image | image_url: width: 800 | image_tag: loading: 'lazy' }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="gv-featured-content">
        {%- if section.settings.badge_text != blank -%}
          <span class="gv-featured-badge" style="background: {{ section.settings.badge_bg }}; color: {{ section.settings.badge_text_color }};">
            {{ section.settings.badge_text }}
          </span>
        {%- endif -%}

        <h3 class="gv-featured-name">
          {%- if section.settings.custom_title != blank -%}
            {{ section.settings.custom_title }}
          {%- else -%}
            {{ prod.title | default: 'Featured Product' }}
          {%- endif -%}
        </h3>

        {%- if section.settings.tagline != blank -%}
          <p class="gv-featured-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          {%- assign has_ingredients = false -%}
          {%- assign has_pills = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'ingredient' -%}{%- assign has_ingredients = true -%}{%- endif -%}
            {%- if block.type == 'pill' -%}{%- assign has_pills = true -%}{%- endif -%}
          {%- endfor -%}

          {%- if has_ingredients -%}
            <ul class="gv-ingredient-list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'ingredient' -%}
                  <li {{ block.shopify_attributes }}>
                    <span class="gv-ing-name" style="color: {{ section.settings.label_color }};">{{ block.settings.name }}</span>
                    <span class="gv-ing-desc">{{ block.settings.desc }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if has_pills -%}
            <div class="gv-product-pills">
              {%- for block in section.blocks -%}
                {%- if block.type == 'pill' -%}
                  <span class="gv-pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.stars -%}
          <div class="gv-featured-stars">
            <span class="gv-star-icons">★★★★★</span>
            <span class="gv-star-text">{{ section.settings.review_text }}</span>
          </div>
        {%- endif -%}

        <div class="gv-featured-footer">
          <span class="gv-featured-price">
            {%- if prod != empty -%}
              {{ prod.price | money }}
            {%- else -%}
              PKR 1,999
            {%- endif -%}
          </span>
          {%- if prod != empty -%}
            <button class="gv-btn-add-bag"
                    onclick="glowveAddSingleToCart(event, this, {{ prod.first_available_variant.id }})" 
                    {% unless prod.available %}disabled{% endunless %}>
              {% if prod.available %}Add to Bag{% else %}Sold Out{% endif %}
            </button>
            <a href="{{ prod.url }}" class="gv-btn-view-details" style="color: {{ section.settings.label_color }};">View Full Details →</a>
          {%- else -%}
            <button class="gv-btn-add-bag">Add to Bag</button>
            <a href="#" class="gv-btn-view-details" style="color: {{ section.settings.label_color }};">View Full Details →</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% render 'glowve-add-to-cart-js' %}

{% stylesheet %}
  .gv-featured-section {
    padding: 80px 40px;
  }
  .gv-featured-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .gv-featured-label {
    font-family: var(--font-mono, 'Poppins', sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 40px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .gv-featured-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.2;
  }
  .gv-featured-section-title {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 48px;
    font-weight: 400;
    color: var(--berry-dark, #1A1A1A);
    line-height: 1.15;
    margin-bottom: 48px;
  }
  .gv-featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: stretch;
    background: white;
    border-radius: 24px;
    border: 1px solid var(--warm-gray, #ECECEC);
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }
  .gv-featured-img-wrap {
    padding: 0;
    display: block;
    align-self: start;
    position: sticky;
    top: 100px;
    border-radius: 24px 0 0 24px;
    overflow: hidden;
  }
  .gv-featured-img-wrap img, .gv-featured-img-wrap svg {
    max-width: 100%;
    width: 100%;
    height: auto;
    display: block;
  }
  .gv-featured-content {
    padding: 56px;
  }
  .gv-featured-badge {
    display: inline-block;
    font-family: var(--font-mono, 'Poppins', sans-serif);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 14px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .gv-featured-name {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 42px;
    font-weight: 600;
    color: var(--berry-dark, #1A1A1A);
    line-height: 1.1;
    margin-bottom: 16px;
    /* Removed text-transform: lowercase; per user mandate */
  }
  .gv-featured-tagline {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 14px;
    color: var(--mid-gray, #666666);
    font-style: italic;
    margin-bottom: 28px;
    line-height: 1.5;
  }
  .gv-ingredient-list {
    list-style: none;
    margin-bottom: 32px;
    padding: 0;
  }
  .gv-ingredient-list li {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--warm-gray, #ECECEC);
    align-items: flex-start;
  }
  .gv-ingredient-list li:last-child {
    border-bottom: none;
  }
  .gv-ing-name {
    font-family: var(--font-mono, 'Poppins', sans-serif);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    min-width: 116px;
    padding-top: 1px;
  }
  .gv-ing-desc {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    color: var(--berry-dark, #1A1A1A) !important;
    line-height: 1.5;
  }
  
  .gv-product-pills {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .gv-pill {
    font-family: var(--font-mono, 'Poppins', sans-serif);
    font-size: 10px;
    background: rgba(255,179,71,0.1);
    color: #FFB347;
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid rgba(255,179,71,0.3);
  }
  .gv-featured-stars {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 24px;
  }
  .gv-star-icons {
    color: #FFB347;
    font-size: 14px;
    letter-spacing: 1px;
  }
  .gv-star-text {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    color: var(--mid-gray, #666666);
  }

  .gv-featured-footer {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-top: 24px;
    border-top: 1px solid var(--warm-gray, #ECECEC);
    flex-wrap: wrap;
  }
  .gv-featured-price {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 32px;
    font-weight: 600;
    color: var(--berry-dark, #1A1A1A);
  }
  .gv-btn-add-bag {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    background: var(--brand-pink, #FF4D8D);
    color: white;
    border: none;
    padding: 14px 32px;
    border-radius: 100px;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .gv-btn-add-bag:hover {
    background: var(--brand-pink-dark, #E63974);
    transform: scale(1.02);
  }
  .gv-btn-add-bag:disabled {
    background: #cccccc;
    cursor: not-allowed;
  }
  .gv-btn-view-details {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .gv-btn-view-details:hover {
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .gv-featured-card {
      grid-template-columns: 1fr;
    }
    .gv-featured-img-wrap {
      position: static;
      border-radius: 24px 24px 0 0;
    }
    .gv-featured-content {
      padding: 40px;
      display: flex;
      flex-direction: column;
    }
    .gv-featured-badge { order: 1; }
    .gv-featured-name { order: 2; margin-top: 0; }
    .gv-featured-tagline { order: 3; }
    .gv-ingredient-list { order: 4; }
    .gv-product-pills { order: 5; }
    .gv-featured-stars { order: 6; }
    
    .gv-featured-footer {
      order: 0;
      border-top: none;
      border-bottom: 1px solid var(--warm-gray, #ECECEC);
      padding-top: 0;
      padding-bottom: 24px;
      margin-bottom: 24px;
    }
  }
  @media (max-width: 640px) {
    .gv-featured-section {
      padding: 60px 24px;
    }
    .gv-featured-content {
      padding: 28px;
    }
    .gv-featured-name {
      font-size: 32px;
    }
    .gv-featured-price {
      font-size: 28px;
    }
    .gv-ingredient-list li {
      flex-direction: column;
      gap: 4px;
    }
    .gv-ing-name {
      min-width: 0;
      padding-top: 0;
      margin-bottom: 2px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Product",
  "tag": "section",
  "class": "glowve-featured-product",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E2F5EE"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Section Label Eyebrow",
      "default": "Your Primary Barrier Product"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Theme Color (Text/Links)",
      "default": "#5A7056"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Optional Large Section Title",
      "info": "Used in the SPF template."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Select Product"
    },
    {
      "type": "html",
      "id": "custom_title",
      "label": "Custom Title Override",
      "info": "Use <br> for new lines"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Product Tagline",
      "default": "Ceramides that repair. Niacinamide that rebuilds."
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom Image (Optional)",
      "info": "Overrides default product image if set."
    },
    {
      "type": "text",
      "id": "img_bg_gradient",
      "label": "Image Area Background",
      "default": "linear-gradient(135deg, #F5EEFF 0%, #E8D5F0 100%)"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "Start Here"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background Color",
      "default": "#5A7056"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "stars",
      "label": "Show Review Stars",
      "default": false
    },
    {
      "type": "text",
      "id": "review_text",
      "label": "Review Text",
      "default": "4.9 · 1,547 reviews"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Row",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient Name"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "Description"
        }
      ]
    },
    {
      "type": "pill",
      "name": "Feature Pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product"
    }
  ]
}
{% endschema %}
