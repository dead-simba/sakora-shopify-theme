<section class="gv-ba-section">
  <div class="gv-ba-inner">

    {%- if section.settings.label != blank or section.settings.title != blank -%}
      <div class="gv-ba-head">
        {%- if section.settings.label != blank -%}
          <div class="gv-section-label">{{ section.settings.label }}</div>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 class="gv-ba-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="gv-ba-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gv-ba-carousel-wrap">
        <div class="gv-ba-row" style="--card-count: {{ section.blocks.size }};" data-ba-row>

        {%- for block in section.blocks -%}
          {%- if block.settings.before_image != blank and block.settings.after_image != blank -%}
            <div class="gv-ba-card" {{ block.shopify_attributes }}>

              <div class="gv-ba-slider" data-ba-slider>
                <div class="gv-ba-img gv-ba-img--after">
                  <img
                    src="{{ block.settings.after_image | image_url: width: 600 }}"
                    alt="{{ block.settings.after_image.alt | default: 'After' | escape }}"
                    width="600"
                    height="400"
                    loading="lazy"
                  >
                </div>

                <div class="gv-ba-img gv-ba-img--before" data-ba-before>
                  <img
                    src="{{ block.settings.before_image | image_url: width: 600 }}"
                    alt="{{ block.settings.before_image.alt | default: 'Before' | escape }}"
                    width="600"
                    height="400"
                    loading="lazy"
                  >
                </div>

                <div class="gv-ba-handle" data-ba-handle aria-hidden="true">
                  <div class="gv-ba-handle-line"></div>
                  <div class="gv-ba-handle-btn">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path d="M5 8L1 5M1 5L5 2M1 5H15M11 8L15 5M15 5L11 2M15 5H1" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                </div>

                <input
                  class="gv-ba-range"
                  type="range"
                  min="0"
                  max="100"
                  value="50"
                  aria-label="Drag to compare before and after"
                  data-ba-range
                >

                <span class="gv-ba-label gv-ba-label--before">Before</span>
                <span class="gv-ba-label gv-ba-label--after">After</span>
              </div>

              <div class="gv-ba-caption">
                {%- if block.settings.reviewer_name != blank -%}
                  <span class="gv-ba-name">{{ block.settings.reviewer_name }}</span>
                {%- endif -%}
                <div class="gv-ba-meta">
                  {%- if block.settings.timeframe != blank -%}
                    <span class="gv-ba-timeframe">{{ block.settings.timeframe }}</span>
                  {%- endif -%}
                  {%- if block.settings.skin_type != blank -%}
                    <span class="gv-ba-dot" aria-hidden="true">·</span>
                    <span class="gv-ba-skin">{{ block.settings.skin_type }}</span>
                  {%- endif -%}
                </div>
              </div>

                  </div>

        {%- if section.blocks.size > 1 -%}
          <div class="gv-ba-nav">
            <button class="gv-ba-arrow gv-ba-prev" data-ba-prev aria-label="Previous">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div class="gv-ba-dots" data-ba-dots>
              {%- for block in section.blocks -%}
                <button class="gv-ba-dot {% if forloop.first %}gv-ba-dot--active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
            <button class="gv-ba-arrow gv-ba-next" data-ba-next aria-label="Next">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
        {%- endfor -%}

      </div>
    {%- endif -%}

    {%- if section.settings.disclaimer != blank -%}
      <p class="gv-ba-disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}

  </div>
</section>

<script>
  (function () {
    function initBASlider(slider) {
      var range  = slider.querySelector('[data-ba-range]');
      var before = slider.querySelector('[data-ba-before]');
      var handle = slider.querySelector('[data-ba-handle]');
      if (!before || !range) return;

      function update(val) {
        val = Math.max(0, Math.min(100, val));
        before.style.clipPath = 'inset(0 ' + (100 - val) + '% 0 0)';
        if (handle) handle.style.left = val + '%';
      }

      update(+range.value);
      range.addEventListener('input', function () { update(+this.value); });
    }

    function initCarousel(section) {
      var row = section.querySelector('[data-ba-row]');
      var prev = section.querySelector('[data-ba-prev]');
      var next = section.querySelector('[data-ba-next]');
      var dots = section.querySelectorAll('.gv-ba-dot');
      if (!row) return;

      function updateDots() {
        if (!dots.length) return;
        var scrollLeft = row.scrollLeft;
        var cardWidth = row.scrollWidth / dots.length;
        var index = Math.round(scrollLeft / cardWidth);
        dots.forEach(function(dot, i) {
          dot.classList.toggle('gv-ba-dot--active', i === index);
        });
      }

      row.addEventListener('scroll', updateDots, { passive: true });

      if (prev) {
        prev.addEventListener('click', function() {
          var cardWidth = row.firstElementChild.offsetWidth + 20;
          row.scrollBy({ left: -cardWidth, behavior: 'smooth' });
        });
      }
      if (next) {
        next.addEventListener('click', function() {
          var cardWidth = row.firstElementChild.offsetWidth + 20;
          row.scrollBy({ left: cardWidth, behavior: 'smooth' });
        });
      }
      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var index = parseInt(dot.getAttribute('data-index'));
          var cardWidth = row.firstElementChild.offsetWidth + 20;
          row.scrollTo({ left: index * cardWidth, behavior: 'smooth' });
        });
      });
    }

    function initAll() {
      document.querySelectorAll('.gv-ba-section').forEach(function(section) {
        section.querySelectorAll('[data-ba-slider]').forEach(initBASlider);
        initCarousel(section);
      });
    }

    document.readyState === 'loading'

      ? document.addEventListener('DOMContentLoaded', initAll)
      : initAll();
  })();
</script>

{% stylesheet %}
  .gv-ba-section {
    background: #FFFFFF;
    padding: 72px 0;
    border-top: 1px solid #ECECEC;
    border-bottom: 1px solid #ECECEC;
  }

  .gv-ba-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .gv-ba-head {
    text-align: center;
    margin-bottom: 48px;
  }

  .gv-ba-head .gv-section-label {
    margin-bottom: 12px;
  }

  .gv-ba-title {
    font-family: 'Poppins', sans-serif;
    font-size: 42px;
    font-weight: 600;
    color: #1A1A1A;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }

  .gv-ba-subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: #666666;
    margin: 0 auto;
    max-width: 480px;
    line-height: 1.65;
  }

  .gv-ba-row {
    display: grid;
    grid-template-columns: repeat(var(--card-count, 1), minmax(0, 300px));
    justify-content: center;
    gap: 20px;
    align-items: start;
  }

  .gv-ba-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .gv-ba-slider {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    aspect-ratio: 4 / 5;
    background: #ECECEC;
    user-select: none;
    cursor: col-resize;
    border: 1px solid #ECECEC;
  }

  .gv-ba-img {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .gv-ba-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .gv-ba-img--before {
    clip-path: inset(0 50% 0 0);
    z-index: 1;
  }

  .gv-ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .gv-ba-handle-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.95);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.2);
  }

  .gv-ba-handle-btn {
    position: relative;
    z-index: 4;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #FF4D8D;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 12px rgba(255, 77, 141, 0.4);
    transition: transform 0.15s ease;
  }

  .gv-ba-slider:active .gv-ba-handle-btn {
    transform: scale(1.1);
  }

  .gv-ba-range {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: col-resize;
    margin: 0;
    padding: 0;
    -webkit-appearance: none;
    appearance: none;
    touch-action: pan-y;
  }

  .gv-ba-label {
    position: absolute;
    bottom: 12px;
    z-index: 2;
    font-family: 'Poppins', sans-serif;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 100px;
    pointer-events: none;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .gv-ba-label--before { left: 12px; }
  .gv-ba-label--after  { right: 12px; }

  .gv-ba-caption { padding: 0 2px; }

  .gv-ba-name {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #1A1A1A;
    display: block;
    margin-bottom: 3px;
  }

  .gv-ba-meta {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .gv-ba-timeframe {
    font-family: 'Poppins', sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #FF4D8D;
  }

  .gv-ba-dot { font-size: 10px; color: #ECECEC; }

  .gv-ba-skin {
    font-family: 'Poppins', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #666666;
  }

  .gv-ba-disclaimer {
    font-family: 'Poppins', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: #666666;
    text-align: center;
    margin: 40px 0 0;
    opacity: 0.65;
  }


  .gv-ba-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-top: 32px;
  }

  .gv-ba-arrow {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }
  .gv-ba-arrow:hover { color: #FF4D8D; }

  .gv-ba-dots {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gv-ba-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E0E0E0;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s;
  }
  .gv-ba-dot--active {
    background: #FF4D8D;
    transform: scale(1.2);
  }

  @media (max-width: 768px) {

    .gv-ba-section { padding: 52px 0; }
    .gv-ba-inner { padding: 0 20px; }
    .gv-ba-title { font-size: 28px; }
    .gv-ba-head { margin-bottom: 32px; }

    .gv-ba-row {
      grid-template-columns: repeat(var(--card-count, 1), min(85vw, 320px));
      justify-content: start;
      overflow-x: scroll;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      padding-bottom: 8px;
    }

    .gv-ba-row::-webkit-scrollbar { display: none; }
    .gv-ba-card { scroll-snap-align: start; }

    .gv-ba-handle-btn { width: 44px; height: 44px; pointer-events: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Before & After",
  "tag": "section",
  "class": "glowve-before-after-wrapper",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Real results"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The proof."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Unedited. Real customers. Consistent use."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Individual results may vary. Images are unretouched."
    }
  ],
  "blocks": [
    {
      "type": "before_after",
      "name": "Before & After pair",
      "settings": [
        {
          "type": "image_picker",
          "id": "before_image",
          "label": "Before image"
        },
        {
          "type": "image_picker",
          "id": "after_image",
          "label": "After image"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer name",
          "default": "Nida A. · Lahore"
        },
        {
          "type": "text",
          "id": "timeframe",
          "label": "Timeframe",
          "default": "Week 8"
        },
        {
          "type": "text",
          "id": "skin_type",
          "label": "Skin type / tone",
          "default": "Fitzpatrick IV · Acne-prone"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Before & After",
      "blocks": [
        { "type": "before_after" }
      ]
    }
  ]
}
{% endschema %}
