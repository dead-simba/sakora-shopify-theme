<section class="sk-email-capture">
  <div class="sk-container">
    <div class="sk-email-inner">

      <div class="sk-email-badge sk-label-caps">{{ section.settings.badge }}</div>

      <h2 class="sk-display-title sk-email-title">{{ section.settings.title | replace: '<em>', '<span class="sk-highlight-active">' | replace: '</em>', '</span>' }}</h2>
      <p class="sk-body-normal sk-email-desc">{{ section.settings.description }}</p>

      {%- form 'customer', id: 'sk-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="sk-email-form" role="form">
          <label for="sk-email-input" class="visually-hidden">{{ section.settings.placeholder }}</label>
          <input
            type="email"
            name="contact[email]"
            id="sk-email-input"
            class="sk-email-input"
            placeholder="{{ section.settings.placeholder }}"
            required
            autocomplete="email"
          >
          <button type="submit" class="sk-btn-primary">
            {{ section.settings.cta_label }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="sk-email-success sk-inci-mono">{{ section.settings.success_message }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="sk-email-fine sk-inci-mono">{{ section.settings.fine_print }}</p>

    </div>
  </div>
</section>

{% stylesheet %}
  .sk-email-capture {
    background-color: var(--chalk);
    color: var(--charcoal);
    padding: 100px 0;
    border-bottom: 1px solid var(--light-border);
  }

  .sk-email-inner {
    max-width: 780px;
    margin: 0 auto;
    text-align: center;
    background-color: var(--petal-bg); /* Warm sweet pink backdrop */
    padding: 60px 40px;
    border-radius: 24px; /* Generous 24px curves */
    border: 1px solid rgba(92, 32, 32, 0.1);
    box-shadow: 0 10px 30px rgba(92, 32, 32, 0.04);
  }

  .sk-email-badge {
    color: var(--petal-text);
    margin-bottom: 20px;
  }

  .sk-email-title {
    font-size: 38px !important;
    text-transform: none !important;
    margin-bottom: 16px !important;
    color: var(--charcoal) !important;
  }

  .sk-email-desc {
    color: var(--petal-text);
    opacity: 0.85;
    margin: 0 auto 32px;
    line-height: 1.6;
    max-width: 520px;
  }

  .sk-email-form {
    display: flex;
    background-color: var(--pure-white);
    border: 1px solid var(--ui-border);
    border-radius: 50px; /* Pill-shaped input wrap */
    padding: 6px;
    align-items: center;
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  
  .sk-email-form:focus-within {
    border-color: var(--petal-text);
    box-shadow: 0 4px 18px rgba(92, 32, 32, 0.1);
  }

  .sk-email-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--charcoal);
    outline: none;
    padding: 10px 20px;
    font-size: 14px;
    font-family: var(--font-body);
  }
  
  .sk-email-input::placeholder { 
    color: var(--subtext-gray); 
  }

  .sk-email-form .sk-btn-primary {
    background-color: var(--sakora-charcoal) !important;
    border-color: var(--sakora-charcoal) !important;
    color: var(--sakora-cream) !important;
    flex-shrink: 0;
    padding: 12px 28px;
    box-shadow: none;
  }
  .sk-email-form .sk-btn-primary:hover {
    background-color: var(--sakora-emerald) !important;
    border-color: var(--sakora-emerald) !important;
    color: var(--pure-white) !important;
  }

  .sk-email-success {
    color: var(--petal-text);
    margin-top: 16px;
    font-weight: 600;
  }

  .sk-email-fine {
    font-size: 11px !important;
    color: var(--petal-text);
    opacity: 0.7;
    margin-top: 20px;
    font-weight: 500;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 768px) {
    .sk-email-capture { padding: 80px 0; }
    .sk-email-inner { padding: 40px 20px; border-radius: 20px; }
    .sk-email-title { font-size: 32px !important; }
    .sk-email-form {
      flex-direction: column;
      padding: 12px;
      gap: 12px;
      border-radius: 24px;
    }
    .sk-email-input { 
      width: 100%; 
      text-align: center; 
      padding: 10px 0; 
    }
    .sk-email-form .sk-btn-primary { 
      width: 100%; 
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sakora Email Capture",
  "tag": "section",
  "class": "sakora-email-capture-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge label",
      "default": "JOIN OUR LUMINOUS CIRCLE"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Let's glow <em>together</em></p>"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Sign up for gentle skincare secrets, fresh formulation drops, and warm, ingredient-led guidance straight to your inbox."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "your.email@address.com"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Welcome to the family! Fresh skin guidance is on its way."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "We believe in gentle communication. Unsubscribe whenever you wish."
    }
  ],
  "presets": [
    {
      "name": "Sakora Email Capture"
    }
  ]
}
{% endschema %}
