<section class="sk-email-capture sk-dot-grid">
  <div class="sk-container">
    <div class="sk-email-inner">

      <div class="sk-email-badge sk-label-caps">SAKORA REGISTRY ACCESS</div>

      <h2 class="sk-display-title sk-email-title">{{ section.settings.title | replace: '<em>', '<span class="sk-highlight-active">' | replace: '</em>', '</span>' }}</h2>
      <p class="sk-body-normal sk-email-desc">{{ section.settings.description }}</p>

      {%- form 'customer', id: 'sk-newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="sk-email-form" role="form">
          <label for="sk-email-input" class="visually-hidden">{{ section.settings.placeholder }}</label>
          <input
            type="email"
            name="contact[email]"
            id="sk-email-input"
            class="sk-email-input sk-inci-mono"
            placeholder="{{ section.settings.placeholder }}"
            required
            autocomplete="email"
          >
          <button type="submit" class="sk-btn-primary">
            {{ section.settings.cta_label }}
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="sk-email-success sk-inci-mono">{{ section.settings.success_message }}</p>
        {%- endif -%}
      {%- endform -%}

      <p class="sk-email-fine sk-inci-mono">{{ section.settings.fine_print }}</p>

    </div>
  </div>
</section>

{% stylesheet %}
  .sk-email-capture {
    background-color: var(--void);
    color: var(--stark-white);
    padding: 100px 0;
    border-bottom: 1px solid var(--border-gray);
  }

  .sk-email-inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }

  .sk-email-badge {
    color: var(--neon-mint);
    margin-bottom: 24px;
  }

  .sk-email-title {
    font-size: 42px !important;
    text-transform: uppercase;
    margin-bottom: 16px !important;
    color: var(--stark-white) !important;
  }

  .sk-email-desc {
    color: var(--subtext);
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  .sk-email-form {
    display: flex;
    background-color: var(--near-black);
    border: 1px solid var(--border-gray);
    border-radius: 6px;
    padding: 6px;
    align-items: center;
    gap: 12px;
    max-width: 580px;
    margin: 0 auto;
  }

  .sk-email-input {
    flex: 1;
    border: none;
    background: transparent;
    color: var(--stark-white);
    outline: none;
    padding: 10px 16px;
    font-size: 13px;
  }
  
  .sk-email-input::placeholder { 
    color: var(--subtext); 
  }

  .sk-email-form .sk-btn-primary {
    flex-shrink: 0;
  }

  .sk-email-success {
    color: var(--neon-mint);
    margin-top: 16px;
    font-weight: 600;
  }

  .sk-email-fine {
    font-size: 10px !important;
    color: var(--subtext);
    margin-top: 20px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 568px) {
    .sk-email-capture { padding: 80px 0; }
    .sk-email-title { font-size: 32px !important; }
    .sk-email-form {
      flex-direction: column;
      padding: 12px;
      gap: 12px;
    }
    .sk-email-input { 
      width: 100%; 
      text-align: center; 
      padding: 10px 0; 
    }
    .sk-email-form .sk-btn-primary { 
      width: 100%; 
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sakora Email Capture",
  "tag": "section",
  "class": "sakora-email-capture-wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>JOIN THE SAKORA <em>PROTOCOL</em> DATABASE.</p>"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "No spam, no soft marketing. Get raw clinical trial summaries, active concentration insights, and priority access to new formulations."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "ENTER CHEMICAL / EMAIL ADDRESS"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "REGISTER FOR DATA ACCESS"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "REGISTRATION APPROVED // ENCRYPTED INBOX VERIFICATION INITIATED."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print",
      "default": "DATA TRANSPARENCY ASSURED. YOU MAY DE-REGISTER FROM DATA LISTS AT ANY TIME."
    }
  ],
  "presets": [
    {
      "name": "Sakora Email Capture"
    }
  ]
}
{% endschema %}
