{%- liquid
  assign upsell_1 = all_products[section.settings.product_1]
  assign upsell_2 = all_products[section.settings.product_2]
-%}

<section class="gv-pdp-upsell">
  <div class="gv-pdp-inner">

    <div class="gv-pdp-section-head">
      {%- if section.settings.label != blank -%}
        <div class="gv-section-label gv-section-label--light">{{ section.settings.label }}</div>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="gv-pdp-section-title gv-pdp-section-title--light">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="gv-upsell-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="gv-upsell-grid">

      {%- for i in (1..2) -%}
        {%- if i == 1 -%}
          {%- assign _prod = all_products[section.settings.product_1] -%}
          {%- assign _tag  = section.settings.product_1_tag -%}
          {%- assign _why  = section.settings.product_1_why -%}
        {%- else -%}
          {%- assign _prod = all_products[section.settings.product_2] -%}
          {%- assign _tag  = section.settings.product_2_tag -%}
          {%- assign _why  = section.settings.product_2_why -%}
        {%- endif -%}

        {%- if _prod != empty -%}
          <a href="{{ _prod.url }}" class="gv-upsell-card">
            <div class="gv-upsell-card-img">
              {%- if _prod.featured_image -%}
                <img
                  src="{{ _prod.featured_image | image_url: width: 300 }}"
                  alt="{{ _prod.featured_image.alt | default: _prod.title | escape }}"
                  width="150" height="150"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="gv-upsell-card-body">
              {%- if _tag != blank -%}
                <div class="gv-upsell-card-tag">{{ _tag }}</div>
              {%- endif -%}
              <div class="gv-upsell-card-name">{{ _prod.title }}</div>
              {%- if _why != blank -%}
                <div class="gv-upsell-card-why">{{ _why }}</div>
              {%- endif -%}
              <div class="gv-upsell-card-price">{{ _prod.price | money }}</div>
            </div>
            <div class="gv-upsell-card-arrow">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}

    </div>

    {%- comment -%} Bundle box {%- endcomment -%}
    {%- if section.settings.bundle_title != blank -%}
      <div class="gv-upsell-bundle">
        <div class="gv-upsell-bundle-left">
          <div class="gv-upsell-bundle-title">{{ section.settings.bundle_title }}</div>
          {%- if section.settings.bundle_desc != blank -%}
            <div class="gv-upsell-bundle-desc">{{ section.settings.bundle_desc }}</div>
          {%- endif -%}
          <div class="gv-upsell-bundle-pricing">
            <span class="gv-upsell-bundle-price">{{ section.settings.bundle_price }}</span>
            {%- if section.settings.bundle_original != blank -%}
              <span class="gv-upsell-bundle-orig">{{ section.settings.bundle_original }}</span>
            {%- endif -%}
          </div>
        </div>
        {%- if section.settings.bundle_product != blank -%}
          {%- assign bundle_prod_target = all_products[section.settings.bundle_product] -%}
          {%- assign bundle_variant_id = bundle_prod_target.first_available_variant.id -%}
          {%- if bundle_variant_id != blank -%}
            <button
              class="gv-btn-primary gv-upsell-bundle-btn"
              data-variant-id="{{ bundle_variant_id }}"
              onclick="glowveAddToCart(event, {{ bundle_variant_id }})"
            >
              Shop the Bundle
              {% render 'gv-icon', icon: 'arrow-right', size: 14 %}
            </button>
          {%- endif -%}
        {%- elsif section.settings.bundle_url != blank -%}
          <a href="{{ section.settings.bundle_url }}" class="gv-btn-primary gv-upsell-bundle-btn">
            Shop the Bundle
            {% render 'gv-icon', icon: 'arrow-right', size: 14 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  if (typeof window.glowveAddToCart !== 'function') {
    window.glowveAddToCart = function(event, variantId) {
      event.preventDefault();
      event.stopPropagation();
      const btn = event.currentTarget;
      if (btn.classList.contains('gv-loading')) return;
      btn.classList.add('gv-loading');
      const originalText = btn.textContent;
      btn.textContent = '...';

      const sectionIds = [];
      document.querySelectorAll('cart-items-component[data-section-id]').forEach(el => {
        sectionIds.push(el.dataset.sectionId);
      });

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1, sections: sectionIds.join(',') })
      })
      .then(r => r.json())
      .then(response => {
        btn.textContent = '✓ Added';
        const cartEvent = new CustomEvent('cart:update', {
          bubbles: true,
          detail: { data: { sections: response.sections } }
        });
        document.dispatchEvent(cartEvent);
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('gv-loading');
        }, 1800);
      })
      .catch(() => {
        btn.textContent = 'Error';
        btn.classList.remove('gv-loading');
        setTimeout(() => { btn.textContent = originalText; }, 1500);
      });
    };
  }
</script>

{% stylesheet %}
  .gv-pdp-upsell {
    background: var(--berry-dark);
    padding: 80px 0;
  }
  .gv-pdp-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .gv-upsell-sub {
    font-family: var(--font-sans);
    font-size: 15px;
    color: rgba(255,255,255,0.55);
    line-height: 1.65;
    max-width: 520px;
    margin-top: 8px;
  }

  /* Product cards */
  .gv-upsell-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin-top: 40px;
    margin-bottom: 24px;
  }

  .gv-upsell-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 16px;
    padding: 20px;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    position: relative;
  }
  .gv-upsell-card:hover {
    background: rgba(255,255,255,0.11);
    border-color: rgba(255,255,255,0.2);
  }

  .gv-upsell-card-img {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    background: rgba(255,255,255,0.08);
    border-radius: 12px;
    overflow: hidden;
  }
  .gv-upsell-card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gv-upsell-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gv-upsell-card-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--coral-pulse);
  }

  .gv-upsell-card-name {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: white;
    line-height: 1.3;
  }

  .gv-upsell-card-why {
    font-family: var(--font-sans);
    font-size: 11px;
    color: rgba(255,255,255,0.5);
    line-height: 1.4;
  }

  .gv-upsell-card-price {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: rgba(255,255,255,0.7);
    margin-top: 4px;
  }

  .gv-upsell-card-arrow {
    color: rgba(255,255,255,0.3);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
  }
  .gv-upsell-card:hover .gv-upsell-card-arrow {
    color: white;
    transform: translateX(3px);
  }

  /* Bundle box */
  .gv-upsell-bundle {
    background: rgba(244,132,95,0.12);
    border: 1px solid rgba(244,132,95,0.3);
    border-radius: 20px;
    padding: 28px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .gv-upsell-bundle-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    color: white;
    margin-bottom: 6px;
  }

  .gv-upsell-bundle-desc {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(255,255,255,0.55);
    line-height: 1.5;
    margin-bottom: 12px;
  }

  .gv-upsell-bundle-pricing {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .gv-upsell-bundle-price {
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 300;
    color: white;
  }

  .gv-upsell-bundle-orig {
    font-family: var(--font-sans);
    font-size: 14px;
    color: rgba(255,255,255,0.35);
    text-decoration: line-through;
  }

  .gv-upsell-bundle-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    border: none;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
  }
  .gv-upsell-bundle-btn.gv-loading {
    opacity: 0.7;
    cursor: wait;
  }

  @media (max-width: 768px) {
    .gv-pdp-upsell { padding: 60px 0; }
    .gv-upsell-grid { grid-template-columns: 1fr; }
    .gv-upsell-bundle { flex-direction: column; align-items: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Upsell",
  "tag": "section",
  "class": "glowve-pdp-upsell-wrapper",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "Complete the Routine" },
    { "type": "text", "id": "title", "label": "Title", "default": "Works better together." },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "header", "content": "Product 1" },
    { "type": "product", "id": "product_1", "label": "Product" },
    { "type": "text", "id": "product_1_tag", "label": "Tag label", "info": "E.g. Step 1 · Serum" },
    { "type": "text", "id": "product_1_why", "label": "Why it pairs well" },
    { "type": "header", "content": "Product 2" },
    { "type": "product", "id": "product_2", "label": "Product" },
    { "type": "text", "id": "product_2_tag", "label": "Tag label" },
    { "type": "text", "id": "product_2_why", "label": "Why it pairs well" },
    { "type": "header", "content": "Bundle Box" },
    { "type": "text", "id": "bundle_title", "label": "Bundle title", "default": "Save with the full protocol" },
    { "type": "textarea", "id": "bundle_desc", "label": "Bundle description" },
    { "type": "text", "id": "bundle_price", "label": "Bundle price", "default": "PKR 3,999" },
    { "type": "text", "id": "bundle_original", "label": "Original price", "default": "PKR 4,999" },
    { "type": "product", "id": "bundle_product", "label": "Bundle Product" },
    { "type": "url", "id": "bundle_url", "label": "Bundle link (fallback)" }
  ],
  "presets": [
    { "name": "PDP Upsell" }
  ]
}
{% endschema %}
