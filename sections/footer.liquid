{% comment %}
  Sakora Custom Footer Section
  Warm charcoal background, unhurried typography, and lowercase geometric brand wordmark.
{% endcomment %}

{%- style -%}
  .sakora-footer {
    background-color: var(--sakora-charcoal) !important;
    color: #888888;
    padding: 5rem 2rem 3rem;
    font-family: var(--font-body-family) !important;
    border-top: none !important;
  }
  @media screen and (min-width: 750px) {
    .sakora-footer {
      padding: 6rem 5rem 4rem;
    }
  }
  .sakora-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    padding-bottom: 4rem;
    border-bottom: 0.5px solid #2A2A28;
  }
  @media screen and (min-width: 750px) {
    .sakora-footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 4rem;
    }
  }
  .sakora-footer__brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sakora-footer__logo {
    font-family: var(--font-body-family) !important;
    font-weight: 800 !important;
    font-size: 2.2rem !important;
    color: var(--sakora-cream) !important;
    letter-spacing: 0.12em !important;
    text-transform: lowercase !important;
    margin: 0;
    line-height: 1;
    text-decoration: none;
    display: inline-block;
  }
  .sakora-footer__bio {
    font-family: var(--font-body-family) !important;
    font-size: 1.15rem !important;
    line-height: 1.75 !important;
    color: #666666 !important;
    max-width: 260px;
    margin: 0;
    font-weight: 400 !important;
  }
  .sakora-footer__socials {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .sakora-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body-family) !important;
    font-size: 0.9rem !important;
    letter-spacing: 0.1em;
    color: #666666 !important;
    cursor: pointer;
    border: 0.5px solid #2A2A28 !important;
    padding: 0.5rem 1rem !important;
    border-radius: 50px !important;
    text-decoration: none;
    transition: color 0.25s, border-color 0.25s, background-color 0.25s;
    font-weight: 500 !important;
  }
  .sakora-footer__social-link:hover {
    color: var(--sakora-cream) !important;
    border-color: var(--sakora-cream) !important;
  }
  .sakora-footer__menu-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .sakora-footer__menu-title {
    font-family: var(--font-body-family) !important;
    font-size: 0.95rem !important;
    letter-spacing: 0.15em !important;
    text-transform: uppercase !important;
    color: var(--sakora-cream) !important;
    font-weight: 500 !important;
    margin: 0;
  }
  .sakora-footer__menu-links {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .sakora-footer__link {
    font-family: var(--font-body-family) !important;
    font-size: 1.1rem !important;
    color: #666666 !important;
    text-decoration: none !important;
    transition: color 0.25s;
    cursor: pointer;
    font-weight: 400 !important;
  }
  .sakora-footer__link:hover {
    color: var(--sakora-cream) !important;
  }
  .sakora-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 2rem;
    font-size: 0.9rem;
    color: #444444;
  }
  @media screen and (min-width: 750px) {
    .sakora-footer__bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
  .sakora-footer__bottom-links {
    display: flex;
    gap: 1.5rem;
  }
  .sakora-footer__bottom-link {
    font-family: var(--font-body-family) !important;
    color: #444444 !important;
    text-decoration: none !important;
    transition: color 0.25s;
    font-size: 0.9rem !important;
  }
  .sakora-footer__bottom-link:hover {
    color: #888888 !important;
  }
{%- endstyle -%}

<footer class="sakora-footer">
  <div class="sakora-footer__grid">
    
    <!-- Brand Column (2fr) -->
    <div class="sakora-footer__brand-col">
      <a href="{{ routes.root_url }}" class="sakora-footer__logo">sakora</a>
      <p class="sakora-footer__bio">
        {{ section.settings.bio_text | default: "Skin rituals rooted in nature. Formulated for real people living real lives." }}
      </p>
      
      <div class="sakora-footer__socials">
        {%- if settings.social_instagram_link != blank or section.settings.fallback_socials -%}
          <a href="{{ settings.social_instagram_link | default: '#' }}" class="sakora-footer__social-link" target="_blank">IG</a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank or section.settings.fallback_socials -%}
          <a href="{{ settings.social_tiktok_link | default: '#' }}" class="sakora-footer__social-link" target="_blank">TT</a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank or section.settings.fallback_socials -%}
          <a href="{{ settings.social_facebook_link | default: '#' }}" class="sakora-footer__social-link" target="_blank">FB</a>
        {%- endif -%}
      </div>
    </div>

    <!-- Dynamic or Fallback Navigation Columns -->
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'link_list' -%}
            <div class="sakora-footer__menu-col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="sakora-footer__menu-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="sakora-footer__menu-links">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="sakora-footer__link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    {%- else -%}
      <!-- Mockup Fallback Menu 1: Shop -->
      <div class="sakora-footer__menu-col">
        <h3 class="sakora-footer__menu-title">Shop</h3>
        <ul class="sakora-footer__menu-links">
          <li><a href="#" class="sakora-footer__link">Petal Melt</a></li>
          <li><a href="#" class="sakora-footer__link">Sol Veil</a></li>
          <li><a href="#" class="sakora-footer__link">Dawn Drops</a></li>
          <li><a href="#" class="sakora-footer__link">Bundles</a></li>
        </ul>
      </div>

      <!-- Mockup Fallback Menu 2: Help -->
      <div class="sakora-footer__menu-col">
        <h3 class="sakora-footer__menu-title">Help</h3>
        <ul class="sakora-footer__menu-links">
          <li><a href="#" class="sakora-footer__link">Skin Guide</a></li>
          <li><a href="#" class="sakora-footer__link">Track Order</a></li>
          <li><a href="#" class="sakora-footer__link">Returns</a></li>
          <li><a href="#" class="sakora-footer__link">Contact Us</a></li>
        </ul>
      </div>

      <!-- Mockup Fallback Menu 3: Sakora -->
      <div class="sakora-footer__menu-col">
        <h3 class="sakora-footer__menu-title">Sakora</h3>
        <ul class="sakora-footer__menu-links">
          <li><a href="#" class="sakora-footer__link">Our Story</a></li>
          <li><a href="#" class="sakora-footer__link">Ingredients</a></li>
          <li><a href="#" class="sakora-footer__link">Sustainability</a></li>
          <li><a href="#" class="sakora-footer__link">Press</a></li>
        </ul>
      </div>
    {%- endif -%}

  </div>

  <!-- Bottom Row: Copyright and Policies -->
  <div class="sakora-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    
    <div class="sakora-footer__bottom-links">
      {%- if section.settings.show_policies and shop.policies.size > 0 -%}
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}
            <a href="{{ policy.url }}" class="sakora-footer__bottom-link">{{ policy.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <a href="#" class="sakora-footer__bottom-link">Privacy</a>
        <a href="#" class="sakora-footer__bottom-link">Terms</a>
        <a href="#" class="sakora-footer__bottom-link">Refund Policy</a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Sakora Custom Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "bio_text",
      "label": "Brand Description / Bio",
      "default": "Skin rituals rooted in nature. Formulated for real people living real lives."
    },
    {
      "type": "checkbox",
      "id": "fallback_socials",
      "label": "Show IG/TT/FB Fallback Icons",
      "default": true,
      "info": "Display fallback social buttons if social links are empty"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show Dynamic Shop Policies",
      "default": false,
      "info": "Use Shopify's active legal policies instead of mock links"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Navigation Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column Title",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sakora Custom Footer"
    }
  ]
}
{% endschema %}
