{%- liquid
  assign p = section.settings.product
  assign tag = section.settings.product_tag
  assign size_text = section.settings.size_text
  assign batch_number = section.settings.batch_number
  assign manufacturing = section.settings.manufacturing
  assign am_title = section.settings.am_title
  assign am_body = section.settings.am_body
  assign pm_title = section.settings.pm_title
  assign pm_body = section.settings.pm_body
  assign discount_code = section.settings.discount_code
  assign discount_label = section.settings.discount_label
  assign discount_body = section.settings.discount_body
  assign whatsapp_url = section.settings.whatsapp_url
  assign review_url = section.settings.review_url
  assign shop_url = section.settings.shop_url
-%}

<section class="gv-auth">
  <div class="gv-auth__container">

    <div class="gv-auth__hero">
      <div class="gv-auth__icon">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h1 class="gv-auth__title">{{ section.settings.hero_title }}</h1>
      <p class="gv-auth__sub">{{ section.settings.hero_subtitle }}</p>
    </div>

    <div class="gv-auth__card">
      <div class="gv-auth__product">
        {%- if p != blank and p.featured_image -%}
          {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '120,200', alt: p.title, class: 'gv-auth__product-img' }}
        {%- elsif section.settings.fallback_image != blank -%}
          {{ section.settings.fallback_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '120,200', alt: section.settings.product_title, class: 'gv-auth__product-img' }}
        {%- else -%}
          <div class="gv-auth__product-img gv-auth__product-img--ph"></div>
        {%- endif -%}

        <div class="gv-auth__product-meta">
          <div class="gv-auth__product-tag">{{ tag }}</div>
          <h2 class="gv-auth__product-name">
            {%- if p != blank -%}{{ p.title }}{%- else -%}{{ section.settings.product_title }}{%- endif -%}
          </h2>
          <p class="gv-auth__product-size">{{ size_text }}</p>
        </div>
      </div>

      <div class="gv-auth__batch">
        <div class="gv-auth__batch-item">
          <div class="gv-auth__batch-label">Batch Number</div>
          <div class="gv-auth__batch-value">{{ batch_number }}</div>
        </div>
        <div class="gv-auth__batch-item">
          <div class="gv-auth__batch-label">Manufacturing</div>
          <div class="gv-auth__batch-value">{{ manufacturing }}</div>
        </div>
      </div>
    </div>

    <div class="gv-auth__card gv-auth__card--delay-1">
      <h3 class="gv-auth__section-title">{{ section.settings.htu_title }}</h3>
      <div class="gv-auth__steps">
        <div class="gv-auth__step">
          <div class="gv-auth__step-icon">☀️</div>
          <div>
            <h4 class="gv-auth__step-title">{{ am_title }}</h4>
            <p class="gv-auth__step-body">{{ am_body }}</p>
          </div>
        </div>
        <div class="gv-auth__step">
          <div class="gv-auth__step-icon gv-auth__step-icon--night">🌙</div>
          <div>
            <h4 class="gv-auth__step-title">{{ pm_title }}</h4>
            <p class="gv-auth__step-body">{{ pm_body }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="gv-auth__card gv-auth__card--delay-2">
      <div class="gv-auth__review-prompt">
        <h3>Rate your experience</h3>
        <p>Let us know how your skin feels.</p>
      </div>
      <div class="gv-auth__stars" aria-hidden="true">☆ ☆ ☆ ☆ ☆</div>
      <a href="{{ review_url | default: '#' }}" class="gv-auth__btn gv-auth__btn--outline">Write a Review</a>
    </div>

    {%- if discount_code != blank -%}
      <div class="gv-auth__offer">
        <h3>{{ discount_label }}</h3>
        <p>{{ discount_body }}</p>
        <button type="button" class="gv-auth__code" data-code="{{ discount_code }}">
          <span>{{ discount_code }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- if whatsapp_url != blank -%}
      <a href="{{ whatsapp_url }}" class="gv-auth__wa" target="_blank" rel="noopener">
        <div class="gv-auth__wa-inner">
          <div class="gv-auth__wa-icon">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" aria-hidden="true">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zM223.9 414.7c-32 0-63.3-8.6-90.8-24.9l-6.5-3.8-67.4 17.7 17.9-65.7-4.2-6.7c-17.8-28.5-27.2-61.9-27.2-96.1 0-98.8 80.3-179.1 179.2-179.1 52.8 0 102.5 20.6 139.8 57.9 37.3 37.3 57.8 87 57.8 139.8 0 98.8-80.3 179.1-179.1 179.1zm98.4-134.4c-5.4-2.7-31.9-15.8-36.8-17.6-4.9-1.8-8.5-2.7-12.2 2.7-3.6 5.4-14 17.6-17.2 21.3-3.2 3.6-6.4 4.1-11.8 1.4-5.4-2.7-22.8-8.4-43.4-26.8-16.1-14.3-26.9-32-30.1-37.4-3.2-5.4-.3-8.3 2.4-11 2.4-2.4 5.4-6.3 8.1-9.5 2.7-3.2 3.6-5.4 5.4-9 1.8-3.6.9-6.8-.5-9.5-1.4-2.7-12.2-29.4-16.7-40.3-4.4-10.7-8.8-9.2-12.2-9.4-3.2-.1-6.8-.1-10.4-.1-3.6 0-9.5 1.4-14.4 6.8-4.9 5.4-19 18.5-19 45s19.4 52.2 22.1 55.8c2.7 3.6 38.1 58.2 92.3 81.6 12.9 5.6 23.3 8.9 31.4 11.4 13 4.1 24.8 3.5 34.2 2.1 10.6-1.5 31.9-13 36.4-25.6 4.5-12.6 4.5-23.4 3.2-25.6-1.3-2.2-4.9-3.5-10.3-6.2z"/>
            </svg>
          </div>
          <div class="gv-auth__wa-text">
            <h3>{{ section.settings.wa_title }}</h3>
            <p>{{ section.settings.wa_body }}</p>
          </div>
          <div class="gv-auth__wa-arrow">→</div>
        </div>
      </a>
    {%- endif -%}

    <a href="{{ shop_url | default: '/collections/all' }}" class="gv-auth__btn gv-auth__btn--solid">{{ section.settings.shop_button_label }}</a>

  </div>
</section>

<script>
  (function () {
    var section = document.currentScript && document.currentScript.previousElementSibling;
    var btn = document.querySelector('[data-code]');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var code = btn.getAttribute('data-code');
      if (navigator.clipboard && code) {
        navigator.clipboard.writeText(code).then(function () {
          var label = btn.querySelector('span');
          var original = label.textContent;
          label.textContent = 'Copied!';
          setTimeout(function () { label.textContent = original; }, 1600);
        });
      }
    });
  })();
</script>

{% stylesheet %}
  .gv-auth {
    --auth-pink: #FF4D8D;
    --auth-pink-dark: #E63974;
    --auth-text: #1A1A1A;
    --auth-gray: #666666;
    --auth-success: #2E7D32;
    --auth-bg: linear-gradient(145deg, #FFF9FB 0%, #FFF0E6 100%);
    --auth-glass: rgba(255, 255, 255, 0.85);
    --auth-glass-border: rgba(255, 255, 255, 0.4);
    background: var(--auth-bg);
    min-height: 100vh;
    padding: 20px 0 60px;
    font-family: 'Poppins', sans-serif;
    color: var(--auth-text);
    -webkit-font-smoothing: antialiased;
  }
  .gv-auth__container {
    max-width: 480px;
    margin: 0 auto;
    padding: 0 20px;
  }

  @keyframes gvAuthPulse {
    0% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.4); }
    70% { box-shadow: 0 0 0 24px rgba(76, 175, 80, 0); }
    100% { box-shadow: 0 0 0 0 rgba(76, 175, 80, 0); }
  }
  @keyframes gvAuthCheck {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }
  @keyframes gvAuthFadeUp {
    0% { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .gv-auth__hero {
    text-align: center;
    padding: 40px 0 32px;
  }
  .gv-auth__icon {
    width: 88px; height: 88px;
    background: var(--auth-success);
    color: #fff;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 24px;
    animation: gvAuthPulse 2s infinite;
    box-shadow: 0 8px 24px rgba(76, 175, 80, 0.3);
  }
  .gv-auth__icon svg {
    width: 44px; height: 44px;
    animation: gvAuthCheck 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  .gv-auth__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 28px !important;
    font-weight: 700 !important;
    color: var(--auth-success) !important;
    margin: 0 0 8px;
    line-height: 1.2;
    animation: gvAuthFadeUp 0.6s ease-out 0.2s forwards;
    opacity: 0;
  }
  .gv-auth__sub {
    font-size: 15px;
    color: var(--auth-gray);
    line-height: 1.5;
    max-width: 320px;
    margin: 0 auto;
    animation: gvAuthFadeUp 0.6s ease-out 0.3s forwards;
    opacity: 0;
  }

  .gv-auth__card {
    background: var(--auth-glass);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border: 1px solid var(--auth-glass-border);
    border-radius: 20px;
    padding: 24px;
    margin-bottom: 24px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04);
    animation: gvAuthFadeUp 0.6s ease-out 0.4s forwards;
    opacity: 0;
  }
  .gv-auth__card--delay-1 { animation-delay: 0.45s; }
  .gv-auth__card--delay-2 { animation-delay: 0.5s; }

  .gv-auth__product {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }
  .gv-auth__product-img {
    width: 80px; height: 80px;
    border-radius: 12px;
    object-fit: contain;
    padding: 8px;
    background-color: #FFF4F8;
    flex-shrink: 0;
  }
  .gv-auth__product-img--ph {
    background-color: #FFF4F8;
  }
  .gv-auth__product-tag {
    font-size: 12px;
    font-weight: 500;
    color: var(--auth-pink);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .gv-auth__product-name {
    font-family: 'Poppins', sans-serif !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    margin: 0 0 4px;
    color: var(--auth-text) !important;
    line-height: 1.2;
  }
  .gv-auth__product-size {
    font-size: 13px;
    color: var(--auth-gray);
    margin: 0;
  }

  .gv-auth__batch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .gv-auth__batch-item {
    background: rgba(255, 255, 255, 0.6);
    padding: 12px;
    border-radius: 12px;
    border: 1px dashed rgba(0, 0, 0, 0.1);
  }
  .gv-auth__batch-label {
    font-size: 11px;
    color: var(--auth-gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
  }
  .gv-auth__batch-value {
    font-size: 14px;
    font-weight: 600;
    color: var(--auth-text);
  }

  .gv-auth__section-title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 20px !important;
    font-weight: 600 !important;
    margin: 0 0 16px;
    color: var(--auth-text) !important;
  }
  .gv-auth__steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gv-auth__step {
    display: flex;
    gap: 16px;
  }
  .gv-auth__step-icon {
    width: 48px; height: 48px;
    background: var(--auth-pink);
    color: #fff;
    border-radius: 14px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(255, 77, 141, 0.2);
  }
  .gv-auth__step-icon--night { background: #2C3E50; }
  .gv-auth__step-title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    margin: 0 0 4px;
  }
  .gv-auth__step-body {
    font-size: 13px;
    color: var(--auth-gray);
    line-height: 1.5;
    margin: 0;
  }

  .gv-auth__review-prompt {
    text-align: center;
    margin-bottom: 16px;
  }
  .gv-auth__review-prompt h3 {
    font-family: 'Poppins', sans-serif !important;
    font-size: 18px !important;
    font-weight: 600 !important;
    margin: 0 0 6px;
  }
  .gv-auth__review-prompt p {
    font-size: 14px;
    color: var(--auth-gray);
    margin: 0;
  }
  .gv-auth__stars {
    color: #FFB800;
    font-size: 32px;
    letter-spacing: 4px;
    margin-bottom: 12px;
    text-align: center;
  }

  .gv-auth__offer {
    background: linear-gradient(135deg, var(--auth-pink) 0%, var(--auth-pink-dark) 100%);
    border-radius: 20px;
    padding: 24px;
    color: #fff;
    text-align: center;
    margin-bottom: 24px;
    box-shadow: 0 12px 24px rgba(255, 77, 141, 0.25);
    animation: gvAuthFadeUp 0.6s ease-out 0.55s forwards;
    opacity: 0;
  }
  .gv-auth__offer h3 {
    font-family: 'Poppins', sans-serif !important;
    font-size: 20px !important;
    font-weight: 700 !important;
    margin: 0 0 8px;
    color: #fff !important;
  }
  .gv-auth__offer p {
    font-size: 14px;
    opacity: 0.9;
    margin: 0 0 16px;
  }
  .gv-auth__code {
    background: rgba(255, 255, 255, 0.2);
    border: 1px dashed rgba(255, 255, 255, 0.6);
    border-radius: 12px;
    padding: 12px 20px;
    font-family: 'SFMono-Regular', Menlo, monospace;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .gv-auth__wa {
    background: #25D366;
    border-radius: 20px;
    padding: 2px;
    margin-bottom: 32px;
    text-decoration: none;
    display: block;
    transition: transform 0.2s;
    animation: gvAuthFadeUp 0.6s ease-out 0.6s forwards;
    opacity: 0;
  }
  .gv-auth__wa:active { transform: scale(0.98); }
  .gv-auth__wa-inner {
    background: #fff;
    border-radius: 18px;
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .gv-auth__wa-icon {
    width: 48px; height: 48px;
    background: #E8F5E9;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #25D366;
    flex-shrink: 0;
  }
  .gv-auth__wa-icon svg {
    width: 28px; height: 28px;
    fill: currentColor;
  }
  .gv-auth__wa-text h3 {
    font-family: 'Poppins', sans-serif !important;
    font-size: 16px !important;
    font-weight: 600 !important;
    color: var(--auth-text) !important;
    margin: 0 0 2px;
  }
  .gv-auth__wa-text p {
    font-size: 13px;
    color: var(--auth-gray);
    margin: 0;
  }
  .gv-auth__wa-arrow {
    margin-left: auto;
    color: #25D366;
    font-weight: bold;
    font-size: 18px;
  }

  .gv-auth__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    border-radius: 100px;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    font-size: 16px;
    width: 100%;
    cursor: pointer;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .gv-auth__btn--solid {
    background: var(--auth-text);
    color: #fff;
    border: none;
  }
  .gv-auth__btn--solid:active { opacity: 0.8; }
  .gv-auth__btn--outline {
    background: transparent;
    color: var(--auth-text);
    border: 2px solid var(--auth-text);
    margin-top: 12px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product Authenticated",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_title", "label": "Title", "default": "Product Authenticated" },
    { "type": "textarea", "id": "hero_subtitle", "label": "Subtitle", "default": "Thank you for validating. You are holding a 100% genuine Glowve product." },

    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "product_title", "label": "Fallback product name" },
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback product image" },
    { "type": "text", "id": "product_tag", "label": "Product tag", "default": "Brightening Serum" },
    { "type": "text", "id": "size_text", "label": "Size", "default": "30ml / 1.0 fl.oz" },
    { "type": "text", "id": "batch_number", "label": "Batch number", "default": "GL XX-0000-X0" },
    { "type": "text", "id": "manufacturing", "label": "Manufacturing date", "default": "January 2026" },

    { "type": "header", "content": "How To Use" },
    { "type": "text", "id": "htu_title", "label": "Section title", "default": "How to get the best results" },
    { "type": "text", "id": "am_title", "label": "AM title", "default": "Morning Application" },
    { "type": "textarea", "id": "am_body", "label": "AM body", "default": "Apply 2-3 drops to clean, dry skin. Press lightly, don't rub. Follow with moisturizer and finish with your daily SPF." },
    { "type": "text", "id": "pm_title", "label": "PM title", "default": "Evening Application" },
    { "type": "textarea", "id": "pm_body", "label": "PM body", "default": "Night offers the longest repair window. Apply after cleansing and follow up with a moisturizer." },

    { "type": "header", "content": "Reviews" },
    { "type": "url", "id": "review_url", "label": "Review URL" },

    { "type": "header", "content": "Discount Offer" },
    { "type": "text", "id": "discount_label", "label": "Headline", "default": "Unlock Your Next Glow ✨" },
    { "type": "textarea", "id": "discount_body", "label": "Body", "default": "As a verified customer, enjoy 15% off your next purchase to continue your skin journey." },
    { "type": "text", "id": "discount_code", "label": "Discount code", "default": "GLOW15" },

    { "type": "header", "content": "WhatsApp Community" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link" },
    { "type": "text", "id": "wa_title", "label": "Title", "default": "Join the Inner Circle" },
    { "type": "text", "id": "wa_body", "label": "Body", "default": "Get early drops, tips & direct support." },

    { "type": "header", "content": "Shop CTA" },
    { "type": "text", "id": "shop_button_label", "label": "Button label", "default": "Explore the Shop" },
    { "type": "url", "id": "shop_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Product Authenticated" }]
}
{% endschema %}
