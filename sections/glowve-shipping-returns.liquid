<section class="gv-ship-returns">
  <div class="gv-ship-returns__inner">
    <div class="gv-ship-returns__label">{{ section.settings.label }}</div>
    <h2 class="gv-ship-returns__title">{{ section.settings.title }}</h2>
    <p class="gv-ship-returns__sub">{{ section.settings.subtitle }}</p>

    <!-- COVERED / NOT ELIGIBLE -->
    <div class="gv-ship-policy-grid">
      <div class="gv-ship-policy-card gv-ship-policy-card--covered">
        <div class="gv-ship-policy-card__label gv-ship-policy-card__label--green">✓ {{ section.settings.covered_title }}</div>
        <ul class="gv-ship-policy-list">
          {%- assign covered_items = section.settings.covered_items | split: '|' -%}
          {%- for item in covered_items -%}
            {%- assign trimmed = item | strip -%}
            {%- if trimmed != blank -%}
              <li><span class="gv-ship-policy-check gv-ship-policy-check--green">✓</span>{{ trimmed }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="gv-ship-policy-card gv-ship-policy-card--not">
        <div class="gv-ship-policy-card__label gv-ship-policy-card__label--red">✕ {{ section.settings.not_title }}</div>
        <ul class="gv-ship-policy-list">
          {%- assign not_items = section.settings.not_items | split: '|' -%}
          {%- for item in not_items -%}
            {%- assign trimmed = item | strip -%}
            {%- if trimmed != blank -%}
              <li><span class="gv-ship-policy-check gv-ship-policy-check--red">✕</span>{{ trimmed }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    <!-- HOW TO RETURN -->
    <h3 class="gv-ship-returns__heading">how to return</h3>
    <p class="gv-ship-returns__text">{{ section.settings.return_intro }}</p>

    <div class="gv-ship-contact-links">
      {%- if section.settings.wa_label != blank -%}
        <a href="{{ section.settings.wa_link }}" class="gv-ship-contact-row">
          <span class="gv-ship-contact-icon">💬</span>
          <div>
            <div class="gv-ship-contact-name">{{ section.settings.wa_label }}</div>
            <div class="gv-ship-contact-desc">{{ section.settings.wa_desc }}</div>
          </div>
        </a>
      {%- endif -%}
      {%- if section.settings.ig_label != blank -%}
        <a href="{{ section.settings.ig_link }}" class="gv-ship-contact-row">
          <span class="gv-ship-contact-icon">📸</span>
          <div>
            <div class="gv-ship-contact-name">{{ section.settings.ig_label }}</div>
            <div class="gv-ship-contact-desc">{{ section.settings.ig_desc }}</div>
          </div>
        </a>
      {%- endif -%}
      {%- if section.settings.web_label != blank -%}
        <a href="{{ section.settings.web_link }}" class="gv-ship-contact-row">
          <span class="gv-ship-contact-icon">🌐</span>
          <div>
            <div class="gv-ship-contact-name">{{ section.settings.web_label }}</div>
            <div class="gv-ship-contact-desc">{{ section.settings.web_desc }}</div>
          </div>
        </a>
      {%- endif -%}
    </div>

    <!-- STEPS -->
    <div class="gv-ship-steps">
      <div class="gv-ship-steps__label">The Process</div>
      {%- assign steps = section.settings.steps | split: '|' -%}
      {%- for step in steps -%}
        {%- assign trimmed = step | strip -%}
        {%- if trimmed != blank -%}
          <div class="gv-ship-step">
            <div class="gv-ship-step__num">{{ forloop.index }}</div>
            <p class="gv-ship-step__text">{{ trimmed }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- REFUND DETAILS -->
    <div class="gv-ship-refund">
      <h3 class="gv-ship-refund__title">refund details</h3>
      <div class="gv-ship-refund__row">
        <span class="gv-ship-refund__key">Speed</span>
        <p class="gv-ship-refund__val">{{ section.settings.refund_speed }}</p>
      </div>
      <div class="gv-ship-refund__row gv-ship-refund__row--border">
        <span class="gv-ship-refund__key">Method</span>
        <p class="gv-ship-refund__val">{{ section.settings.refund_method }}</p>
      </div>
      <div class="gv-ship-refund__row gv-ship-refund__row--border">
        <span class="gv-ship-refund__key">Amount</span>
        <p class="gv-ship-refund__val">{{ section.settings.refund_amount }}</p>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ship-returns { background: white; padding: 80px 0; }
  .gv-ship-returns__inner { max-width: 760px; margin: 0 auto; padding: 0 40px; }

  .gv-ship-returns__label {
    font-family: 'Poppins', sans-serif !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: #FF4D8D !important; margin-bottom: 12px;
  }
  .gv-ship-returns__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 42px !important; font-weight: 600 !important;
    color: #1A1A1A !important; line-height: 1.2 !important;
    margin-bottom: 16px; text-transform: lowercase !important;
  }
  .gv-ship-returns__title em { font-style: normal !important; color: #FF4D8D !important; }
  .gv-ship-returns__sub {
    font-family: 'Poppins', sans-serif; font-size: 16px; color: #666;
    line-height: 1.7; margin-bottom: 48px;
  }
  .gv-ship-returns__heading {
    font-family: 'Poppins', sans-serif !important;
    font-size: 26px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 24px; text-transform: lowercase !important;
  }
  .gv-ship-returns__text {
    font-family: 'Poppins', sans-serif; font-size: 15px; color: #666;
    line-height: 1.7; margin-bottom: 24px;
  }

  /* POLICY GRID */
  .gv-ship-policy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 40px; }

  .gv-ship-policy-card { border-radius: 20px; padding: 28px; }
  .gv-ship-policy-card--covered { background: #F0FBF5; border: 1.5px solid #B8EDD0; }
  .gv-ship-policy-card--not { background: #FFF5F5; border: 1.5px solid #FFD0D0; }

  .gv-ship-policy-card__label {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 16px;
  }
  .gv-ship-policy-card__label--green { color: #3DB87A; }
  .gv-ship-policy-card__label--red { color: #E05050; }

  .gv-ship-policy-list { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .gv-ship-policy-list li {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #1A1A1A;
    display: flex; gap: 10px; line-height: 1.5; align-items: flex-start;
  }
  .gv-ship-policy-check { font-weight: 700; flex-shrink: 0; }
  .gv-ship-policy-check--green { color: #3DB87A; }
  .gv-ship-policy-check--red { color: #E05050; }

  /* CONTACT LINKS */
  .gv-ship-contact-links { display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px; }
  .gv-ship-contact-row {
    display: flex; align-items: center; gap: 16px;
    padding: 16px 20px; background: #FAFAFA;
    border: 1.5px solid #ECECEC; border-radius: 14px;
    transition: border-color 0.2s; text-decoration: none;
  }
  .gv-ship-contact-row:hover { border-color: #FF4D8D; }
  .gv-ship-contact-icon { font-size: 22px; }
  .gv-ship-contact-name { font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 600; color: #1A1A1A; }
  .gv-ship-contact-desc { font-family: 'Poppins', sans-serif; font-size: 13px; color: #666; }

  /* STEPS */
  .gv-ship-steps { display: flex; flex-direction: column; gap: 16px; margin-bottom: 40px; }
  .gv-ship-steps__label {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: #666; margin-bottom: 4px;
  }
  .gv-ship-step { display: flex; gap: 16px; align-items: flex-start; }
  .gv-ship-step__num {
    width: 32px; height: 32px; background: #FF4D8D; border-radius: 50%;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 700; color: white;
  }
  .gv-ship-step__text {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666;
    line-height: 1.6; padding-top: 5px;
  }

  /* REFUND */
  .gv-ship-refund {
    background: rgba(255,77,141,0.06); border: 1px solid rgba(255,77,141,0.18);
    border-radius: 20px; padding: 32px;
  }
  .gv-ship-refund__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 22px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 20px; text-transform: lowercase !important;
  }
  .gv-ship-refund__row { display: flex; gap: 12px; }
  .gv-ship-refund__row--border { border-top: 1px solid rgba(255,77,141,0.12); padding-top: 14px; margin-top: 14px; }
  .gv-ship-refund__key {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 700;
    color: #FF4D8D; min-width: 80px; flex-shrink: 0;
  }
  .gv-ship-refund__val {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666; line-height: 1.6;
  }

  @media (max-width: 768px) {
    .gv-ship-returns__inner { padding: 0 20px; }
    .gv-ship-policy-grid { grid-template-columns: 1fr; }
    .gv-ship-returns__title { font-size: 32px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Returns Policy",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "— Returns —" },
    { "type": "html", "id": "title", "label": "Title", "default": "we make it <em>easy.</em>" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "You have 30 calendar days from delivery to try any Glowve product. If it doesn't meet your expectations — for any reason — return it for a full refund. Even if it's been opened and used." },
    { "type": "text", "id": "covered_title", "label": "Covered Title", "default": "What's Covered" },
    { "type": "textarea", "id": "covered_items", "label": "Covered Items (pipe-separated)", "default": "Opened, used, or partially used products|Texture, feel, or experience not as expected|Wrong product delivered or damaged on arrival|Confirmed manufacturing defects|Any reason at all within 30 days" },
    { "type": "text", "id": "not_title", "label": "Not Eligible Title", "default": "Not Eligible" },
    { "type": "textarea", "id": "not_items", "label": "Not Eligible Items (pipe-separated)", "default": "Products returned after 30 days from delivery|Items purchased during clearance / final sale|Products without any original packaging" },
    { "type": "textarea", "id": "return_intro", "label": "Return Intro Text", "default": "Reach out to us through any of these channels within 30 days of delivery:" },
    { "type": "text", "id": "wa_label", "label": "WhatsApp Label", "default": "WhatsApp" },
    { "type": "text", "id": "wa_desc", "label": "WhatsApp Description", "default": "Message us on the number listed at glowve.pk" },
    { "type": "url", "id": "wa_link", "label": "WhatsApp Link" },
    { "type": "text", "id": "ig_label", "label": "Instagram Label", "default": "Instagram" },
    { "type": "text", "id": "ig_desc", "label": "Instagram Description", "default": "DM us @glowve with your order number" },
    { "type": "url", "id": "ig_link", "label": "Instagram Link" },
    { "type": "text", "id": "web_label", "label": "Website Label", "default": "Website" },
    { "type": "text", "id": "web_desc", "label": "Website Description", "default": "glowve.pk/pages/contact" },
    { "type": "url", "id": "web_link", "label": "Website Link" },
    { "type": "textarea", "id": "steps", "label": "Process Steps (pipe-separated)", "default": "Contact us through WhatsApp, Instagram, or our website with your order number.|Share a photo of the product — nothing fancy, just so we can see its condition.|Our team confirms your return within 24 hours.|Pack the product and ship it to the address we provide.|Your refund is processed instantly. Maximum processing time: 2 business days." },
    { "type": "textarea", "id": "refund_speed", "label": "Refund Speed", "default": "Processed instantly. In rare cases, up to 2 business days for operational processing." },
    { "type": "textarea", "id": "refund_method", "label": "Refund Method", "default": "Issued to your original payment method. For Cash on Delivery (COD) orders, we'll transfer to your bank account or issue store credit — your choice." },
    { "type": "textarea", "id": "refund_amount", "label": "Refund Amount", "default": "100% of the product price. Original shipping charges are non-refundable. Return shipping is covered by us if the return is due to our error; otherwise it's the customer's responsibility." }
  ],
  "presets": [{ "name": "Returns Policy" }]
}
{% endschema %}
