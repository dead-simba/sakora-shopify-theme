<section class="gv-trust-strip" style="background: {{ section.settings.bg_color }}; {% if section.settings.border_top %}border-top: 1px solid var(--warm-gray, #ECECEC);{% endif %}">
  <div class="gv-trust-inner">
    {%- if section.blocks.size > 0 -%}
      <div class="gv-trust-grid" style="grid-template-columns: repeat({{ section.blocks.size }}, 1fr);">
        {%- for block in section.blocks -%}
          <div class="gv-trust-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="gv-trust-icon">{{ block.settings.icon }}</div>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <div class="gv-trust-title" style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</div>
            {%- endif -%}
            
            {%- if block.settings.desc != blank -%}
              <div class="gv-trust-desc" style="color: {{ section.settings.desc_color }};">{{ block.settings.desc }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-trust-strip {
    padding: 60px 0;
  }
  .gv-trust-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .gv-trust-grid {
    display: grid;
    gap: 32px;
    text-align: center;
  }
  .gv-trust-icon {
    font-size: 28px;
    margin-bottom: 10px;
  }
  .gv-trust-title {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--berry-dark, #1A1A1A);
  }
  .gv-trust-desc {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    color: var(--mid-gray, #666666);
  }

  @media (max-width: 768px) {
    .gv-trust-strip { padding: 48px 0; }
    .gv-trust-inner { padding: 0 24px; }
    .gv-trust-grid {
      grid-template-columns: 1fr !important;
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Strip",
  "tag": "section",
  "class": "glowve-trust-strip-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show Top Border",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon/Emoji",
          "default": "⚡"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Replies"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Within 24 hours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip"
    }
  ]
}
{% endschema %}
