<section class="gv-trust-strip" style="background: {{ section.settings.bg_color }}; {% if section.settings.border_top %}border-top: 1px solid var(--warm-gray, #ECECEC);{% endif %}">
  <div class="gv-trust-inner">
    {%- if section.blocks.size > 0 -%}
      <div class="gv-trust-grid" style="grid-template-columns: repeat({{ section.blocks.size }}, 1fr);">
        {%- for block in section.blocks -%}
          <div class="gv-trust-item" {{ block.shopify_attributes }}>
            <div class="gv-trust-icon">
              {%- if block.settings.icon_type == 'custom' and block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {%- case block.settings.icon_type -%}
                  {%- when 'lightning' -%}
                    <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                  {%- when 'support' -%}
                    <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                  {%- when 'shield' -%}
                    <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                  {%- else -%}
                    <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"></circle></svg>
                {%- endcase -%}
              {%- endif -%}
            </div>
            
            {%- if block.settings.title != blank -%}
              <div class="gv-trust-title" style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</div>
            {%- endif -%}
            
            {%- if block.settings.desc != blank -%}
              <div class="gv-trust-desc" style="color: {{ section.settings.desc_color }};">{{ block.settings.desc }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-trust-strip {
    padding: 60px 0;
  }
  .gv-trust-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .gv-trust-grid {
    display: grid;
    gap: 32px;
    text-align: center;
  }
  .gv-trust-icon {
    font-size: 28px;
    margin-bottom: 10px;
    display: flex;
    justify-content: center;
  }
  .gv-trust-icon svg {
    color: var(--brand-pink, #FF4D8D);
  }
  .gv-trust-icon img {
    width: 28px;
    height: 28px;
    object-fit: contain;
  }
  .gv-trust-title {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
    color: var(--berry-dark, #1A1A1A);
  }
  .gv-trust-desc {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    color: var(--mid-gray, #666666);
  }

  @media (max-width: 768px) {
    .gv-trust-strip { padding: 48px 0; }
    .gv-trust-inner { padding: 0 24px; }
    .gv-trust-grid {
      grid-template-columns: 1fr !important;
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Strip",
  "tag": "section",
  "class": "glowve-trust-strip-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Show Top Border",
      "default": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Title Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description Color",
      "default": "#666666"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "label": "Icon Style",
          "options": [
            { "value": "lightning", "label": "Lightning (Fast)" },
            { "value": "support", "label": "Support (Heart)" },
            { "value": "shield", "label": "Shield (Trust)" },
            { "value": "custom", "label": "Custom Image" }
          ],
          "default": "lightning"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom Icon Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast Replies"
        },
        {
          "type": "text",
          "id": "desc",
          "label": "Description",
          "default": "Within 24 hours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Strip"
    }
  ]
}
{% endschema %}
