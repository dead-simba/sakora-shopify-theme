<section class="ba-section">
  <div class="ba-container">
    <div class="section-label">{{ section.settings.label }}</div>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-sub">{{ section.settings.subtitle }}</p>
    <div class="ba-grid">
      {% for block in section.blocks %}
        <div class="ba-card">
          <div class="ba-img" style="background:{{ block.settings.bg_gradient }};">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% else %}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#fff;">Image</div>
            {% endif %}
          </div>
          <div class="ba-info">
            <div class="ba-name">{{ block.settings.title }}</div>
            <div class="ba-detail">{{ block.settings.detail }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.note != blank %}
      <p style="font-size:12px;color:var(--mid-gray);margin-top:24px;line-height:1.6;background:var(--off-white);padding:12px 16px;border-radius:10px;">{{ section.settings.note }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .ba-section{background:var(--off-white, #FAF9F8); padding: 80px 0;}
  .ba-container{max-width: 1200px; margin: 0 auto; padding: 0 24px;}
  .ba-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:40px;}
  .ba-card{background:white;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.06); border: 1px solid var(--warm-gray, #ECECEC);}
  .ba-img{aspect-ratio:4/3;display:flex;align-items:center;justify-content:center;font-size:48px; background:linear-gradient(135deg,#EDE0F5,#D8C8EC); overflow: hidden;}
  .ba-img img{width:100%;height:100%;object-fit:cover;}
  .ba-info{padding:16px 20px;}
  .ba-name{font-weight:600;font-size:14px;color:var(--berry-dark, #1A1A1A);margin-bottom:4px;}
  .ba-detail{font-size:13px;color:var(--mid-gray, #666);}
  
  @media(max-width:900px){
    .ba-grid{grid-template-columns:1fr;}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Clinical Evidence",
  "settings": [
    {
      "type": "text", "id": "label", "label": "Label", "default": "Clinical evidence"
    },
    {
      "type": "text", "id": "title", "label": "Title", "default": "This formula's results speak for themselves."
    },
    {
      "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Ceramide NP/AP/EOP and Matrixyl 3000™ are among the most clinically documented barrier and anti-aging ingredients."
    },
    {
      "type": "html", "id": "note", "label": "Note (HTML)", "default": "⚗️ Images from clinical studies on the active ingredients in this formula at identical concentrations. Individual results vary. Patch test recommended for sensitive skin."
    }
  ],
  "blocks": [
    {
      "type": "clinical_card",
      "name": "Clinical Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "bg_gradient", "label": "Background Gradient", "default": "linear-gradient(135deg,#EDE0F5,#D8C8EC)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "detail", "label": "Detail text" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Clinical Evidence" }
  ]
}
{% endschema %}
