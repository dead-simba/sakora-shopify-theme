<div class="gv-ingredient-moment">
  <div class="gv-ingredient-moment-inner">

    <div class="gv-ing-visual" aria-hidden="true">
      <div class="gv-ing-emoji">{{ section.settings.icon }}</div>
      <div class="gv-ing-stat">
        <div class="gv-ing-stat-num">{{ section.settings.stat_number }}</div>
        <div class="gv-ing-stat-text">{{ section.settings.stat_text }}</div>
      </div>
    </div>

    <div class="gv-ing-text">
      <div class="gv-section-label gv-section-label--light">{{ section.settings.label }}</div>
      <h2 class="gv-ing-title">{{ section.settings.title }}</h2>
      <p class="gv-ing-desc">{{ section.settings.description }}</p>

      {%- if section.blocks.size > 0 -%}
        <div class="gv-ing-pills">
          {%- for block in section.blocks -%}
            {%- if block.type == 'pill' -%}
              <span class="gv-ing-pill" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="gv-btn-ghost">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .gv-ingredient-moment {
    background: var(--berry-dark);
    padding: 120px 0;
    position: relative;
    overflow: hidden;
  }
  .gv-ingredient-moment::before {
    content: '';
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(244,132,95,0.15), transparent);
    top: -200px; right: -100px;
    pointer-events: none;
  }

  .gv-ingredient-moment-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Visual */
  .gv-ing-visual { position: relative; }

  .gv-ing-emoji {
    font-size: 180px;
    line-height: 1;
    filter: drop-shadow(0 30px 60px rgba(0,0,0,0.3));
    animation: gv-float 4s ease-in-out infinite;
  }
  @keyframes gv-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-16px); }
  }

  .gv-ing-stat {
    position: absolute;
    bottom: 0; right: 0;
    background: var(--coral-pulse);
    color: #fff;
    padding: 20px 24px;
    border-radius: 16px;
    font-family: var(--font-sans);
    min-width: 140px;
  }
  .gv-ing-stat-num {
    font-size: 36px;
    font-weight: 600;
    line-height: 1;
    margin-bottom: 4px;
  }
  .gv-ing-stat-text { font-size: 12px; opacity: 0.9; line-height: 1.4; }

  /* Text */
  .gv-section-label--light {
    color: rgba(255,255,255,0.5);
    margin-bottom: 16px;
  }
  .gv-section-label--light::before { background: rgba(255,255,255,0.3); }

  .gv-ing-title {
    font-family: var(--font-serif);
    font-size: 54px;
    font-weight: 300;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }
  .gv-ing-title em { font-style: italic; color: var(--coral-pulse); }

  .gv-ing-desc {
    font-family: var(--font-sans);
    font-size: 16px;
    color: rgba(255,255,255,0.65);
    line-height: 1.75;
    margin-bottom: 36px;
  }

  .gv-ing-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 36px;
  }
  .gv-ing-pill {
    background: rgba(255,255,255,0.1);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 8px 16px;
    border-radius: 100px;
    letter-spacing: 0.04em;
    border: 1px solid rgba(255,255,255,0.2);
  }

  @media (max-width: 900px) {
    .gv-ingredient-moment-inner { grid-template-columns: 1fr; gap: 48px; }
    .gv-ing-emoji { font-size: 120px; }
    .gv-ing-title { font-size: 40px; }
  }
  @media (max-width: 768px) {
    .gv-ingredient-moment { padding: 70px 0; }
    .gv-ingredient-moment-inner { padding: 0 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Ingredient Moment",
  "tag": "section",
  "class": "glowve-ingredient-moment-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Ingredient Spotlight"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "Icon / emoji",
      "default": "⚗️"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Alpha Arbutin.<br>PIH's <em>real</em> match.</p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Post-inflammatory hyperpigmentation sits longer on South Asian skin. Alpha Arbutin at 2% competitively inhibits tyrosinase — the enzyme that produces melanin — at the source. 10x more potent than beta-arbutin, with a strong safety record."
    },
    {
      "type": "text",
      "id": "stat_number",
      "label": "Stat number",
      "default": "92%"
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "Stat description",
      "default": "noticed brighter skin within 4 weeks"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Explore Ingredient Directory"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "pill",
      "name": "Ingredient Pill",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Pill text",
          "default": "Alpha-Arbutin 2%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve Ingredient Moment",
      "blocks": [
        { "type": "pill", "settings": { "text": "Alpha-Arbutin 2%" } },
        { "type": "pill", "settings": { "text": "Tyrosinase Inhibitor" } },
        { "type": "pill", "settings": { "text": "Ethyl Ascorbic Acid" } },
        { "type": "pill", "settings": { "text": "Tranexamic Acid" } },
        { "type": "pill", "settings": { "text": "EU Safety Approved" } }
      ]
    }
  ]
}
{% endschema %}
