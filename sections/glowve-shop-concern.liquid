<section class="gv-shop-concern" aria-labelledby="gv-concern-title">
  <div class="gv-container">

    <div class="gv-section-header">
      <div>
        <div class="gv-section-label">{{ section.settings.label }}</div>
        <h2 id="gv-concern-title" class="gv-section-title">{{ section.settings.title }}</h2>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gv-concern-grid">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link }}"
            class="gv-concern-card"
            aria-label="{{ block.settings.name | escape }} — {{ block.settings.description | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="gv-concern-circle">
              {%- if block.settings.image != blank -%}
                {%- assign concern_img_alt = block.settings.image.alt | default: block.settings.name | escape -%}
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'gv-concern-img', alt: concern_img_alt, width: 150, height: 150, sizes: '150px' }}
              {%- else -%}
                <div class="gv-concern-icon-wrap gv-concern-icon-wrap--{{ forloop.index | modulo: 5 | plus: 1 }}">
                  {%- case block.settings.icon -%}
                    {%- when 'brightening' -%}{% render 'gv-icon', icon: 'sparkle', size: 36 %}
                    {%- when 'barrier' -%}{% render 'gv-icon', icon: 'shield', size: 36 %}
                    {%- when 'spf' -%}{% render 'gv-icon', icon: 'sun', size: 36 %}
                    {%- when 'hydration' -%}{% render 'gv-icon', icon: 'dropper', size: 36 %}
                    {%- when 'acne' -%}{% render 'gv-icon', icon: 'leaf', size: 36 %}
                    {%- else -%}{% render 'gv-icon', icon: 'sparkle', size: 36 %}
                  {%- endcase -%}
                </div>
              {%- endif -%}
            </div>

            <div class="gv-concern-name">{{ block.settings.name }}</div>
            <div class="gv-concern-desc">{{ block.settings.description }}</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .gv-shop-concern {
    background: var(--off-white);
    padding: 100px 0;
  }

  .gv-concern-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 860px;
    margin: 0 auto;
  }

  /* Card — tall rectangle */
  .gv-concern-card {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    display: block;
    aspect-ratio: 3 / 4;
  }

  /* Image container fills the card */
  .gv-concern-circle {
    position: absolute;
    inset: 0;
    border-radius: 0;
    border: none;
    background: var(--warm-gray);
    width: 100%;
    height: 100%;
  }

  .gv-concern-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.5s ease;
  }
  .gv-concern-card:hover .gv-concern-img { transform: scale(1.06); }

  /* Dark gradient overlay at bottom */
  .gv-concern-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, rgba(0,0,0,0.1) 55%, transparent 100%);
    pointer-events: none;
    transition: background 0.3s;
  }
  .gv-concern-card:hover::after {
    background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.2) 60%, transparent 100%);
  }

  /* Icon fallback */
  .gv-concern-icon-wrap {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
  }
  .gv-concern-icon-wrap--1 { background: linear-gradient(160deg, #FFB3C6, #FF4D8D); color: #fff; }
  .gv-concern-icon-wrap--2 { background: linear-gradient(160deg, #A8E6D4, #2ABFA3); color: #fff; }
  .gv-concern-icon-wrap--3 { background: linear-gradient(160deg, #FFD98C, #F5A623); color: #fff; }
  .gv-concern-icon-wrap--4 { background: linear-gradient(160deg, #C9B8F0, #7C5CBF); color: #fff; }
  .gv-concern-icon-wrap--5 { background: linear-gradient(160deg, #FFB89A, #F4845F); color: #fff; }

  /* Text — sits above overlay via z-index */
  .gv-concern-name {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
    transition: transform 0.3s ease;
  }
  .gv-concern-card:hover .gv-concern-name { transform: translateY(-28px); }

  .gv-concern-desc {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 12px;
    color: rgba(255,255,255,0.85);
    line-height: 1.5;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .gv-concern-card:hover .gv-concern-desc {
    opacity: 1;
    transform: translateY(0);
  }

  /* Pink bottom accent line */
  .gv-concern-card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: var(--coral-pulse);
    z-index: 3;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .gv-concern-card:hover::before { transform: scaleX(1); }

  @media (max-width: 768px) {
    .gv-shop-concern { padding: 70px 0; }
    .gv-concern-grid { grid-template-columns: 1fr; max-width: 320px; gap: 16px; }
    .gv-concern-card { aspect-ratio: 4 / 3; }
    .gv-concern-name { font-size: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Shop by Concern",
  "tag": "section",
  "class": "glowve-shop-concern-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Personalised for You"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by <em>concern</em>"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Face / model image",
          "info": "Recommended: square crop, face clearly visible. Shown in a circle."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon (when no image)",
          "options": [
            { "value": "brightening", "label": "Brightening (sparkle)" },
            { "value": "barrier", "label": "Barrier Repair (shield)" },
            { "value": "spf", "label": "Sun Protection (sun)" },
            { "value": "hydration", "label": "Hydration (dropper)" },
            { "value": "acne", "label": "Acne / Soothing (leaf)" }
          ],
          "default": "brightening"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Concern name",
          "default": "Brightening"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Dark spots · PIH · Uneven tone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve Shop by Concern",
      "blocks": [
        { "type": "concern", "settings": { "icon": "brightening", "name": "Brightening", "description": "Dark spots · PIH · Uneven tone" } },
        { "type": "concern", "settings": { "icon": "barrier", "name": "Barrier Repair", "description": "Dryness · Sensitivity · Redness" } },
        { "type": "concern", "settings": { "icon": "spf", "name": "Sun Protection", "description": "Pakistan UV index · Matte finish" } }
      ]
    }
  ]
}
{% endschema %}
