<section class="gv-shop-concern" aria-labelledby="gv-concern-title">
  <div class="gv-container">

    <div class="gv-section-header">
      <div>
        <div class="gv-section-label">{{ section.settings.label }}</div>
        <h2 id="gv-concern-title" class="gv-section-title">{{ section.settings.title }}</h2>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gv-concern-grid">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link }}"
            class="gv-concern-card"
            aria-label="{{ block.settings.name | escape }} — {{ block.settings.description | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="gv-concern-circle">
              {%- if block.settings.image != blank -%}
                {%- assign concern_img_alt = block.settings.image.alt | default: block.settings.name | escape -%}
                {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'gv-concern-img', alt: concern_img_alt, width: 150, height: 150, sizes: '150px' }}
              {%- else -%}
                <div class="gv-concern-icon-wrap gv-concern-icon-wrap--{{ forloop.index | modulo: 5 | plus: 1 }}">
                  {%- case block.settings.icon -%}
                    {%- when 'brightening' -%}{% render 'gv-icon', icon: 'sparkle', size: 36 %}
                    {%- when 'barrier' -%}{% render 'gv-icon', icon: 'shield', size: 36 %}
                    {%- when 'spf' -%}{% render 'gv-icon', icon: 'sun', size: 36 %}
                    {%- when 'hydration' -%}{% render 'gv-icon', icon: 'dropper', size: 36 %}
                    {%- when 'acne' -%}{% render 'gv-icon', icon: 'leaf', size: 36 %}
                    {%- else -%}{% render 'gv-icon', icon: 'sparkle', size: 36 %}
                  {%- endcase -%}
                </div>
              {%- endif -%}
            </div>

            <div class="gv-concern-name">{{ block.settings.name }}</div>
            <div class="gv-concern-desc">{{ block.settings.description }}</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .gv-shop-concern {
    background: var(--off-white);
    padding: 100px 0;
  }

  .gv-concern-grid {
    display: flex;
    gap: 24px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .gv-concern-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    flex: 0 0 160px;
    transition: transform 0.25s;
  }
  .gv-concern-card:hover { transform: translateY(-6px); }

  /* Circle image */
  .gv-concern-circle {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid transparent;
    background: var(--warm-gray);
    transition: border-color 0.25s, box-shadow 0.25s;
    flex-shrink: 0;
    position: relative;
  }
  .gv-concern-card:hover .gv-concern-circle {
    border-color: var(--coral-pulse);
    box-shadow: 0 12px 36px rgba(244,132,95,0.2);
  }

  .gv-concern-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s;
  }
  .gv-concern-card:hover .gv-concern-img { transform: scale(1.06); }

  /* Icon fallback */
  .gv-concern-icon-wrap {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gv-concern-icon-wrap--1 { background: linear-gradient(135deg, #FFF3D6, #FFC85C); color: var(--warm-espresso); }
  .gv-concern-icon-wrap--2 { background: linear-gradient(135deg, #FFE0E8, #FF8FA3); color: var(--berry-dark); }
  .gv-concern-icon-wrap--3 { background: linear-gradient(135deg, #E8F5E4, #A8C5A0); color: var(--warm-espresso); }
  .gv-concern-icon-wrap--4 { background: linear-gradient(135deg, #F0EBF8, #9B72AA); color: var(--berry-dark); }
  .gv-concern-icon-wrap--5 { background: linear-gradient(135deg, #FFE8D6, #F4845F); color: #fff; }

  .gv-concern-name {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    color: var(--warm-espresso);
    text-align: center;
    line-height: 1.3;
  }

  .gv-concern-desc {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    text-align: center;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .gv-shop-concern { padding: 70px 0; }
    .gv-concern-grid { gap: 20px; }
    .gv-concern-card { flex: 0 0 130px; }
    .gv-concern-circle { width: 120px; height: 120px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Shop by Concern",
  "tag": "section",
  "class": "glowve-shop-concern-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Personalised for You"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by <em>concern</em>"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Face / model image",
          "info": "Recommended: square crop, face clearly visible. Shown in a circle."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon (when no image)",
          "options": [
            { "value": "brightening", "label": "Brightening (sparkle)" },
            { "value": "barrier", "label": "Barrier Repair (shield)" },
            { "value": "spf", "label": "Sun Protection (sun)" },
            { "value": "hydration", "label": "Hydration (dropper)" },
            { "value": "acne", "label": "Acne / Soothing (leaf)" }
          ],
          "default": "brightening"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Concern name",
          "default": "Brightening"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Dark spots · PIH · Uneven tone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve Shop by Concern",
      "blocks": [
        { "type": "concern", "settings": { "icon": "brightening", "name": "Brightening", "description": "Dark spots · PIH · Uneven tone" } },
        { "type": "concern", "settings": { "icon": "barrier", "name": "Barrier Repair", "description": "Dryness · Sensitivity · Redness" } },
        { "type": "concern", "settings": { "icon": "spf", "name": "Sun Protection", "description": "Pakistan UV index · Matte finish" } }
      ]
    }
  ]
}
{% endschema %}
