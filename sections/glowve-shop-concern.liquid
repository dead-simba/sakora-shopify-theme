<section class="gv-shop-concern">
  <div class="gv-container">

    <div class="gv-section-header">
      <div>
        <div class="gv-section-label">{{ section.settings.label }}</div>
        <h2 class="gv-section-title">{{ section.settings.title }}</h2>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="gv-concern-grid" style="--concern-cols: {{ section.blocks.size | at_most: 5 }};">
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link }}"
            class="gv-concern-card"
            {{ block.shopify_attributes }}
          >
            <span class="gv-concern-icon" aria-hidden="true">{{ block.settings.icon }}</span>
            <div class="gv-concern-name">{{ block.settings.name }}</div>
            <div class="gv-concern-desc">{{ block.settings.description }}</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .gv-shop-concern {
    background: var(--off-white);
    padding: 100px 0;
  }

  .gv-concern-grid {
    display: grid;
    grid-template-columns: repeat(var(--concern-cols, 3), 1fr);
    gap: 16px;
  }

  .gv-concern-card {
    background: var(--cream-glow);
    border: 1.5px solid var(--warm-gray);
    border-radius: 20px;
    padding: 32px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.25s;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .gv-concern-card:hover {
    border-color: var(--coral-pulse);
    background: #fff;
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(244,132,95,0.12);
  }

  .gv-concern-icon {
    font-size: 40px;
    margin-bottom: 16px;
    display: block;
    line-height: 1;
  }

  .gv-concern-name {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    color: var(--warm-espresso);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .gv-concern-desc {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .gv-concern-grid { grid-template-columns: repeat(2, 1fr); }
    .gv-shop-concern { padding: 70px 0; }
  }
  @media (max-width: 400px) {
    .gv-concern-grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Shop by Concern",
  "tag": "section",
  "class": "glowve-shop-concern-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "Personalised for You"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Shop by <em>concern</em>"
    }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern Card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / emoji",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Concern name",
          "default": "Brightening"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Dark spots · PIH · Uneven tone"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve Shop by Concern",
      "blocks": [
        {
          "type": "concern",
          "settings": {
            "icon": "✨",
            "name": "Brightening",
            "description": "Dark spots · PIH · Uneven tone"
          }
        },
        {
          "type": "concern",
          "settings": {
            "icon": "🛡️",
            "name": "Barrier Repair",
            "description": "Dryness · Sensitivity · Redness"
          }
        },
        {
          "type": "concern",
          "settings": {
            "icon": "☀️",
            "name": "Sun Protection",
            "description": "Pakistan UV index · Matte finish"
          }
        }
      ]
    }
  ]
}
{% endschema %}
