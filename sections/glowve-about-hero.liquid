<section class="gv-about-hero" id="top">
  <div class="gv-about-hero__orb gv-about-hero__orb--1"></div>
  <div class="gv-about-hero__orb gv-about-hero__orb--2"></div>
  <div class="gv-about-hero__orb gv-about-hero__orb--3"></div>

  <div class="gv-about-hero__inner">
    <p class="gv-about-hero__eyebrow">{{ section.settings.label }}</p>
    <h1 class="gv-about-hero__title">
      {{ section.settings.title_prefix }}<br>
      {{ section.settings.title_mid }} <em id="type-target"></em><span class="type-cursor" id="type-cursor"></span>
    </h1>
    <p class="gv-about-hero__sub">{{ section.settings.subtitle }}</p>
    {%- if section.settings.cta_label != blank -%}
      <a href="#gv-about-story" class="gv-about-hero__cta">
        {{ section.settings.cta_label }}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    {%- endif -%}
  </div>

  <div class="gv-about-hero__scroll">
    <span>Scroll</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
  </div>
</section>

<!-- WAVE DIVIDER -->
<div class="gv-about-wave" style="background:#FFF0E6;">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none" style="height:80px;display:block;width:100%;">
    <path d="M0,48L80,42.7C160,37,320,27,480,32C640,37,800,59,960,64C1120,69,1280,59,1360,53.3L1440,48V80H0Z" fill="white"/>
  </svg>
</div>

{% stylesheet %}
  .gv-about-hero {
    min-height: 88vh; background: #FFF0E6;
    display: flex; align-items: center; justify-content: center;
    text-align: center; padding: 80px 40px;
    position: relative; overflow: hidden;
  }
  .gv-about-hero__orb {
    position: absolute; border-radius: 50%;
    filter: blur(80px); opacity: 0.35; pointer-events: none;
  }
  .gv-about-hero__orb--1 { width: 500px; height: 500px; background: #FF4D8D; top: -150px; right: -100px; animation: gvAboutDrift1 12s ease-in-out infinite; }
  .gv-about-hero__orb--2 { width: 400px; height: 400px; background: #FFD6A5; bottom: -100px; left: -80px; animation: gvAboutDrift2 15s ease-in-out infinite; }
  .gv-about-hero__orb--3 { width: 250px; height: 250px; background: #FF8DC7; top: 30%; right: 15%; animation: gvAboutDrift3 10s ease-in-out infinite; }

  @keyframes gvAboutDrift1 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-30px,20px) scale(1.08); } }
  @keyframes gvAboutDrift2 { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(20px,-30px) scale(1.05); } }
  @keyframes gvAboutDrift3 { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-15px,20px); } }

  .gv-about-hero__inner { position: relative; z-index: 2; max-width: 860px; }
  .gv-about-hero__eyebrow {
    font-family: 'Poppins', sans-serif !important;
    color: #FF4D8D !important; font-weight: 700 !important;
    text-transform: uppercase; letter-spacing: 0.2em; font-size: 11px !important;
    margin-bottom: 28px; display: flex; align-items: center; justify-content: center; gap: 12px;
  }
  .gv-about-hero__eyebrow::before, .gv-about-hero__eyebrow::after { content: ''; width: 40px; height: 1px; background: #FF4D8D; opacity: 0.5; }

  .gv-about-hero__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: clamp(42px, 6vw, 76px) !important; font-weight: 600 !important;
    line-height: 1.05 !important; color: #1A1A1A !important;
    letter-spacing: -0.02em; margin-bottom: 28px;
  }
  .gv-about-hero__title em { font-style: normal !important; color: #FF4D8D !important; }

  .type-cursor { display: inline-block; width: 3px; height: 0.85em; background: #FF4D8D; border-radius: 2px; vertical-align: middle; margin-left: 3px; animation: gvAboutBlink 1s step-end infinite; }
  @keyframes gvAboutBlink { 0%,100% { opacity: 1; } 50% { opacity: 0; } }

  .gv-about-hero__sub {
    font-family: 'Poppins', sans-serif !important;
    font-size: 18px !important; color: #666 !important;
    line-height: 1.7; max-width: 560px; margin: 0 auto 44px;
  }

  .gv-about-hero__cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: #FF4D8D; color: white; padding: 16px 36px;
    border-radius: 100px; font-family: 'Poppins', sans-serif;
    font-weight: 700; font-size: 13px; letter-spacing: 0.06em;
    text-transform: uppercase; text-decoration: none;
    transition: transform 0.25s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.25s;
  }
  .gv-about-hero__cta:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(255,77,141,0.35); }

  .gv-about-hero__scroll {
    position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    animation: gvAboutBob 2.5s ease-in-out infinite;
  }
  .gv-about-hero__scroll span { font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: #666; }
  .gv-about-hero__scroll svg { color: #FF4D8D; }
  @keyframes gvAboutBob { 0%,100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(6px); } }

  @media (max-width: 600px) {
    .gv-about-hero { padding: 60px 24px; min-height: 80vh; }
    .gv-about-hero__title { font-size: 38px !important; }
  }
{% endstylesheet %}

<script>
  (function typeEffect() {
    const el = document.getElementById('type-target');
    const cursor = document.getElementById('type-cursor');
    if (!el || !cursor) return;

    const phrases = {{ section.settings.titles_json | default: '["skincare aisle.", "pharmacy shelf.", "bathroom mirror.", "skin concern."]' }};
    let phraseIdx = 0;
    let charIdx = 0;
    let deleting = false;

    function tick() {
      const current = phrases[phraseIdx];
      if (!deleting) {
        charIdx++;
        el.textContent = current.slice(0, charIdx);
        if (charIdx === current.length) {
          deleting = true;
          setTimeout(tick, 2200);
          return;
        }
      } else {
        charIdx--;
        el.textContent = current.slice(0, charIdx);
        if (charIdx === 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(tick, 400);
          return;
        }
      }
      const speed = deleting ? 40 : 80;
      setTimeout(tick, speed);
    }
    setTimeout(tick, 1000);
  })();

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    const orbs = document.querySelectorAll('.gv-about-hero__orb');
    orbs.forEach((orb, i) => {
      const speed = 0.08 + i * 0.04;
      orb.style.transform = `translateY(${scrollY * speed}px)`;
    });
  }, { passive: true });
</script>

{% schema %}
{
  "name": "About Hero",
  "settings": [
    { "type": "text", "id": "label", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "title_prefix", "label": "Title Prefix", "default": "We didn't start in a lab." },
    { "type": "text", "id": "title_mid", "label": "Title Mid", "default": "We started in a" },
    { "type": "textarea", "id": "titles_json", "label": "Typing Phrases (JSON Array)", "default": "[\"skincare aisle.\", \"pharmacy shelf.\", \"bathroom mirror.\", \"skin concern.\"]" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Walk into any pharmacy in Pakistan and you'll find hundreds of products. But how many were made for our UV index? Our humidity? Our skin tones?" },
    { "type": "text", "id": "cta_label", "label": "CTA Label", "default": "Read Our Journey" }
  ],
  "presets": [{ "name": "About Hero" }]
}
{% endschema %}
