<div class="gv-pdp-acc section-spacing color-{{ section.settings.color_scheme }}">
  <div class="gv-pdp-inner">
    
    <div class="gv-acc-container">
      {%- for block in section.blocks -%}
        <details class="gv-acc-row" id="gv-acc-{{ block.id }}" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
          <summary class="gv-acc-header">
            <span class="gv-acc-title">{{ block.settings.title }}</span>
            <span class="gv-acc-icon">
              <svg class="gv-acc-plus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <svg class="gv-acc-minus" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </span>
          </summary>
          
          <div class="gv-acc-content">
            {%- case block.type -%}
              
              {%- when 'science' -%}
                <div class="gv-acc-science">
                  {%- if block.settings.subtitle != blank -%}
                    <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                  
                  <div class="gv-sci-pathway-grid">
                    {%- for i in (1..5) -%}
                      {%- capture t_key -%}card_{{ i }}_title{%- endcapture -%}
                      {%- capture b_key -%}card_{{ i }}_body{%- endcapture -%}
                      {%- capture i_key -%}card_{{ i }}_ingredient{%- endcapture -%}
                      
                      {%- if block.settings[t_key] != blank -%}
                        <div class="gv-sci-pathway">
                          <div class="gv-sci-pathway-num">0{{ i }}</div>
                          <div class="gv-sci-pathway-title">{{ block.settings[t_key] }}</div>
                          <div class="gv-sci-pathway-body">{{ block.settings[b_key] }}</div>
                          {%- if block.settings[i_key] != blank -%}
                            <div class="gv-sci-pathway-ing">{{ block.settings[i_key] }}</div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>

                  {%- if block.settings.stat_num != blank -%}
                    <div class="gv-sci-stat">
                      <div class="gv-sci-stat-num">{{ block.settings.stat_num }}</div>
                      <div class="gv-sci-stat-label">{{ block.settings.stat_label }}</div>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'ingredients' -%}
                <div class="gv-acc-ing">
                  {%- if block.settings.subtitle != blank -%}
                    <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                  <div class="gv-ing-scroll">
                    {%- comment -%} This block uses a collection or manual entry? Let's use metafields or a linked section. 
                        For now, let's allow up to 6 manual ingredients for maximum control. {%- endcomment -%}
                    {%- for i in (1..6) -%}
                      {%- capture n_key -%}ing_{{ i }}_name{%- endcapture -%}
                      {%- capture b_key -%}ing_{{ i }}_benefit{%- endcapture -%}
                      {%- capture i_key -%}ing_{{ i }}_image{%- endcapture -%}
                      
                      {%- if block.settings[n_key] != blank -%}
                        <div class="gv-ing-card">
                          <div class="gv-ing-card-img">
                            {%- if block.settings[i_key] != blank -%}
                              {{ block.settings[i_key] | image_url: width: 300 | image_tag: loading: 'lazy' }}
                            {%- else -%}
                              <div class="gv-ing-card-placeholder"><span>{{ block.settings[n_key] | slice: 0, 2 | upcase }}</span></div>
                            {%- endif -%}
                          </div>
                          <div class="gv-ing-card-body">
                            <div class="gv-ing-card-name">{{ block.settings[n_key] }}</div>
                            <div class="gv-ing-card-benefit">{{ block.settings[b_key] }}</div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>

              {%- when 'how_to_use' -%}
                <div class="gv-acc-htu">
                  {%- if block.settings.subtitle != blank -%}
                    <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                  
                  <div class="gv-htu-grid">
                    {%- for i in (1..4) -%}
                      {%- capture l_key -%}step_{{ i }}_label{%- endcapture -%}
                      {%- capture n_key -%}step_{{ i }}_note{%- endcapture -%}
                      {%- capture c_key -%}step_{{ i }}_current{%- endcapture -%}
                      
                      {%- if block.settings[l_key] != blank -%}
                        <div class="gv-htu-step {% if block.settings[c_key] %}gv-htu-step--current{% endif %}">
                          <div class="gv-htu-num">{{ i }}</div>
                          <div class="gv-htu-info">
                            <div class="gv-htu-label">{{ block.settings[l_key] }}</div>
                            <div class="gv-htu-note">{{ block.settings[n_key] }}</div>
                          </div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>

              {%- when 'timeline' -%}
                <div class="gv-acc-timeline">
                  {%- if block.settings.subtitle != blank -%}
                    <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                  <div class="gv-tl-grid">
                    {%- for i in (1..4) -%}
                      {%- capture p_key -%}tl_{{ i }}_period{%- endcapture -%}
                      {%- capture t_key -%}tl_{{ i }}_title{%- endcapture -%}
                      {%- capture b_key -%}tl_{{ i }}_body{%- endcapture -%}
                      
                      {%- if block.settings[p_key] != blank -%}
                        <div class="gv-tl-item">
                          <div class="gv-tl-period">{{ block.settings[p_key] }}</div>
                          <div class="gv-tl-title">{{ block.settings[t_key] }}</div>
                          <p class="gv-tl-body">{{ block.settings[b_key] }}</p>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>

              {%- when 'inci' -%}
                <div class="gv-acc-inci">
                  <div class="gv-inci-badges">
                    <span class="gv-inci-badge">✓ Fragrance-free</span>
                    <span class="gv-inci-badge">✓ Paraben-free</span>
                    <span class="gv-inci-badge">✓ Sulphate-free</span>
                    <span class="gv-inci-badge">✓ Mineral oil-free</span>
                    <span class="gv-inci-badge">✓ Cruelty-free</span>
                    <span class="gv-inci-badge">✓ Made in Pakistan</span>
                  </div>
                  <div class="gv-inci-list">
                    {{ block.settings.content }}
                  </div>
                </div>

              {%- when 'rich_text' -%}
                <div class="gv-acc-rich-text">
                  {{ block.settings.content }}
                </div>

            {%- endcase -%}
          </div>
        </details>
      {%- endfor -%}
    </div>

  </div>
</div>

{% stylesheet %}
  .gv-pdp-acc {
    background: white;
    padding: 40px 0 80px;
  }

  .gv-pdp-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .gv-acc-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .gv-acc-row {
    border: 1px solid #EAEAEA;
    border-radius: 16px;
    background: #FFFFFF;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .gv-acc-row[open] {
    border-color: #DDD;
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
  }

  .gv-acc-header {
    padding: 24px;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    user-select: none;
  }
  .gv-acc-header::-webkit-details-marker { display: none; }

  .gv-acc-title {
    font-size: 18px;
    font-weight: 600;
    color: #1A1A1A;
    letter-spacing: -0.01em;
  }

  .gv-acc-icon {
    color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gv-acc-minus { display: none; }
  .gv-acc-row[open] .gv-acc-plus { display: none; }
  .gv-acc-row[open] .gv-acc-minus { display: block; }

  .gv-acc-content {
    padding: 0 24px 32px;
  }

  .gv-acc-sub {
    font-size: 15px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 700px;
  }

  /* Science Styles */
  .gv-sci-pathway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }
  .gv-sci-pathway {
    background: #F9F9F9;
    border-radius: 12px;
    padding: 20px;
  }
  .gv-sci-pathway-num { font-family: var(--font-mono); font-size: 11px; color: var(--coral-pulse); margin-bottom: 8px; }
  .gv-sci-pathway-title { font-weight: 700; font-size: 14px; margin-bottom: 6px; }
  .gv-sci-pathway-body { font-size: 12px; color: #666; line-height: 1.5; }
  .gv-sci-pathway-ing { display: inline-block; margin-top: 10px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--coral-pulse); background: rgba(255,77,141,0.1); padding: 3px 8px; border-radius: 4px; }

  .gv-sci-stat { text-align: center; padding: 32px; background: #1A1A1A; color: white; border-radius: 16px; margin-top: 16px; }
  .gv-sci-stat-num { font-size: 48px; font-weight: 300; color: var(--coral-pulse); line-height: 1; margin-bottom: 8px; }
  .gv-sci-stat-label { font-size: 14px; opacity: 0.8; }

  /* Ingredients Styles */
  .gv-ing-scroll { display: flex; gap: 16px; overflow-x: auto; padding-bottom: 16px; scrollbar-width: none; }
  .gv-ing-scroll::-webkit-scrollbar { display: none; }
  .gv-ing-card { flex: 0 0 180px; background: #F9F9F9; border-radius: 12px; overflow: hidden; }
  .gv-ing-card-img { aspect-ratio: 1; background: #EEE; overflow: hidden; }
  .gv-ing-card-img img { width: 100%; height: 100%; object-fit: cover; }
  .gv-ing-card-body { padding: 12px; }
  .gv-ing-card-name { font-weight: 700; font-size: 13px; margin-bottom: 4px; }
  .gv-ing-card-benefit { font-size: 11px; color: #666; line-height: 1.4; }

  /* HTU Styles */
  .gv-htu-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .gv-htu-step { display: flex; gap: 16px; padding: 16px; border-radius: 12px; background: #F9F9F9; }
  .gv-htu-step--current { background: #FFF5F8; border: 1px solid var(--coral-pulse); }
  .gv-htu-num { width: 28px; height: 28px; border-radius: 50%; background: #1A1A1A; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0; }
  .gv-htu-step--current .gv-htu-num { background: var(--coral-pulse); }
  .gv-htu-label { font-weight: 700; font-size: 14px; margin-bottom: 2px; }
  .gv-htu-note { font-size: 12px; color: #666; line-height: 1.4; }

  /* Timeline Styles */
  .gv-tl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
  .gv-tl-item { background: #F9F9F9; padding: 20px; border-radius: 12px; border-top: 3px solid var(--coral-pulse); }
  .gv-tl-period { font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--coral-pulse); margin-bottom: 8px; }
  .gv-tl-title { font-weight: 700; font-size: 15px; margin-bottom: 6px; }
  .gv-tl-body { font-size: 12px; color: #666; line-height: 1.5; }

  /* INCI Styles */
  .gv-inci-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .gv-inci-badge { font-size: 11px; font-weight: 600; color: #108043; background: #E3F1DF; padding: 4px 12px; border-radius: 100px; }
  .gv-inci-list { font-family: var(--font-mono); font-size: 12px; color: #888; line-height: 2; }

  @media (max-width: 768px) {
    .gv-htu-grid { grid-template-columns: 1fr; }
    .gv-pdp-acc { padding: 20px 0 60px; }
    .gv-acc-title { font-size: 16px; }
    .gv-acc-header { padding: 20px; }
  }
{% endstylesheet %}

