<div class="gv-acc-wrap">
  <div class="gv-acc-list">

    {%- for block in section.blocks -%}
      <details class="gv-acc-item" id="gv-acc-{{ block.id }}" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
        <summary class="gv-acc-summary">
          <span class="gv-acc-label">{{ block.settings.title }}</span>
          <svg class="gv-acc-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>

        <div class="gv-acc-panel">

          {%- case block.type -%}

            {%- when 'pathways' -%}
              <div class="acc-pdp-science acc-pdp-pathways">
                {%- if block.settings.subtitle != blank -%}
                  <p class="gv-section-sub" style="margin-bottom:24px; color:var(--pearl-glow, rgba(255,255,255,0.75));">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <div class="pathway-cards">
                  {%- for i in (1..5) -%}
                    {%- assign num_k = 'pw_' | append: i | append: '_num' -%}
                    {%- assign title_k = 'pw_' | append: i | append: '_title' -%}
                    {%- assign trig_k = 'pw_' | append: i | append: '_trig' -%}
                    {%- assign ing_k = 'pw_' | append: i | append: '_ing' -%}
                    {%- assign mech_k = 'pw_' | append: i | append: '_mech' -%}
                    {%- if block.settings[num_k] != blank -%}
                      <div class="pathway-card">
                        <div class="pathway-num-pill">{{ block.settings[num_k] }}</div>
                        <div class="pathway-name-big">{{ block.settings[title_k] }}</div>
                        <div class="pathway-trigger-text">{{ block.settings[trig_k] }}</div>
                        <div class="pathway-divider"><div class="pathway-divider-line"></div><div class="pathway-divider-text">blocked by</div><div class="pathway-divider-line"></div></div>
                        <div class="pathway-ing-label">{{ block.settings[ing_k] }}</div>
                        <div class="pathway-mech-text">{{ block.settings[mech_k] }}</div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.stat_num != blank -%}
                <div class="science-bottom-stat">
                  <div class="science-stat-num">{{ block.settings.stat_num }}</div>
                  <div class="science-stat-label">{{ block.settings.stat_label }}</div>
                </div>
                {%- endif -%}
              </div>

            {%- when 'science' -%}
              <div class="acc-pdp-science">
                <div class="barrier-diagram">
                  <div class="barrier-col left">
                    <div class="barrier-col-label">↓ Exogenous Repair</div>
                    {%- for i in (1..3) -%}
                      {%- assign ex_k = 'exo_' | append: i -%}
                      {%- if block.settings[ex_k] != blank -%}
                      <div class="barrier-step">
                        <div class="barrier-step-num">{{ i }}</div>
                        <div class="barrier-step-text">{{ block.settings[ex_k] }}</div>
                      </div>
                      {%- endif -%}
                    {%- endfor -%}
                    <div style="margin-top:20px;background:rgba(155,114,170,0.25);border-radius:12px;padding:16px;">
                      <div style="font-family:var(--font-mono);font-size:11px;color:var(--plum-dusk);margin-bottom:6px;">RESULT</div>
                      <div style="font-size:13px;color:rgba(255,255,255,0.75);">{{ block.settings.exo_result }}</div>
                    </div>
                  </div>

                  <div class="barrier-arrow">⇄</div>

                  <div class="barrier-col right">
                    <div class="barrier-col-label">↑ Endogenous Boost</div>
                    {%- for i in (1..3) -%}
                      {%- assign end_k = 'endo_' | append: i -%}
                      {%- if block.settings[end_k] != blank -%}
                      <div class="barrier-step">
                        <div class="barrier-step-num">{{ i }}</div>
                        <div class="barrier-step-text">{{ block.settings[end_k] }}</div>
                      </div>
                      {%- endif -%}
                    {%- endfor -%}
                    <div style="margin-top:20px;background:rgba(155,114,170,0.25);border-radius:12px;padding:16px;">
                      <div style="font-family:var(--font-mono);font-size:11px;color:var(--plum-dusk);margin-bottom:6px;">RESULT</div>
                      <div style="font-size:13px;color:rgba(255,255,255,0.75);">{{ block.settings.endo_result }}</div>
                    </div>
                  </div>
                </div>

                <div style="background:rgba(155,114,170,0.2);border:1px solid rgba(155,114,170,0.4);border-radius:16px;padding:28px;margin-top:32px;text-align:center;">
                  <div style="font-family:var(--font-serif);font-size:26px;color:#fff;font-style:italic;line-height:1.4;">"{{ block.settings.quote }}"</div>
                  <div style="font-size:14px;color:rgba(255,255,255,0.55);margin-top:10px;font-family:var(--font-mono);">{{ block.settings.quote_sub }}</div>
                </div>

                <div class="science-stat">
                  <div class="science-stat-num">{{ block.settings.stat_num }}</div>
                  <div class="science-stat-label">{{ block.settings.stat_label }}</div>
                  <div class="science-stat-source">{{ block.settings.stat_source }}</div>
                </div>
              </div>

            {%- when 'uv_spectrum' -%}
              <div class="acc-pdp-science">
                {%- if block.settings.subtitle != blank -%}
                  <p class="gv-section-sub" style="margin-bottom:24px; color:var(--pearl-glow, rgba(255,255,255,0.75));">{{ block.settings.subtitle }}</p>
                {%- endif -%}

                <div class="uv-spectrum">
                  <div class="uv-labels">
                    <span>UVB (280nm)</span>
                    <span>UVA2 (320nm)</span>
                    <span>UVA1 (400nm)</span>
                  </div>
                  <div class="uv-bar-container">
                    <div class="uv-bar"></div>
                  </div>
                  <div class="uv-markers">
                    {%- for i in (1..6) -%}
                      {%- assign nm_k = 'uv_' | append: i | append: '_nm' -%}
                      {%- assign name_k = 'uv_' | append: i | append: '_name' -%}
                      {%- assign desc_k = 'uv_' | append: i | append: '_desc' -%}
                      {%- if block.settings[name_k] != blank -%}
                        <div class="uv-marker">
                          <div class="uv-marker-nm">{{ block.settings[nm_k] }}</div>
                          <div class="uv-marker-name">{{ block.settings[name_k] }}</div>
                          <div class="uv-marker-desc">{{ block.settings[desc_k] }}</div>
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                  {%- if block.settings.quote != blank -%}
                  <div class="uv-conclusion">
                    <div class="uv-conclusion-main">"{{ block.settings.quote }}"</div>
                    <div class="uv-conclusion-sub">{{ block.settings.quote_sub }}</div>
                  </div>
                  {%- endif -%}
                </div>

                {%- if block.settings.pk_uv_num != blank -%}
                <div class="pk-uv-box">
                  <div>
                    <div class="pk-uv-num">{{ block.settings.pk_uv_num }}</div>
                    <div style="font-family:var(--font-mono);font-size:12px;color:rgba(255,255,255,0.5);margin-top:4px;">{{ block.settings.pk_uv_label | default: 'PAKISTAN SUMMER UV INDEX' }}</div>
                  </div>
                  <div class="pk-uv-text">
                    {{ block.settings.pk_uv_text }}
                  </div>
                </div>
                {%- endif -%}

                {%- if block.settings.pa_rating != blank -%}
                <div class="pa-badge-section">
                  <div class="pa-badge">
                    <div class="pa-badge-rating">{{ block.settings.pa_rating }}</div>
                    <div class="pa-badge-label">{{ block.settings.pa_label | default: 'UVA PROTECTION RATING' }}</div>
                  </div>
                  <div class="pa-explain">
                    {{ block.settings.pa_explain }}
                  </div>
                </div>
                {%- endif -%}
              </div>


            {%- when 'ingredients' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="ing-scroll-track">
                {%- for i in (1..6) -%}
                  {%- assign n_key   = 'ing_' | append: i | append: '_name' -%}
                  {%- assign b_key   = 'ing_' | append: i | append: '_benefit' -%}
                  {%- assign bdg_key = 'ing_' | append: i | append: '_badge' -%}
                  {%- assign img_key = 'ing_' | append: i | append: '_image' -%}
                  {%- if block.settings[n_key] != blank -%}
                    <div class="ing-card">
                      <div class="ing-card-img">
                        {%- if block.settings[img_key] != blank -%}
                          {{ block.settings[img_key] | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings[n_key] }}
                        {%- else -%}
                          <div style="background:var(--warm-gray);width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#999;">Image</div>
                        {%- endif -%}
                      </div>
                      <div class="ing-card-body">
                        {%- if block.settings[bdg_key] != blank -%}<span class="ing-badge">{{ block.settings[bdg_key] }}</span>{%- endif -%}
                        <div class="ing-name-mono">{{ block.settings[n_key] }}</div>
                        <p class="ing-benefit">{{ block.settings[b_key] }}</p>
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p style="font-size:12px;color:var(--mid-gray);margin-top:8px;">← Scroll to see all actives</p>

            {%- when 'how_to_use' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="htu-tabs">
                <button type="button" class="htu-tab active" onclick="switchRoutineTab(this, 'am', '{{ block.id }}')">☀️ Morning</button>
                <button type="button" class="htu-tab" onclick="switchRoutineTab(this, 'pm', '{{ block.id }}')">🌙 Evening</button>
              </div>

              <!-- AM Steps -->
              <div class="htu-steps active" id="htu-tab-am-{{ block.id }}">
                {%- assign am_count = 0 -%}
                {%- for i in (1..4) -%}
                  {%- assign l_key = 'am_' | append: i | append: '_label' -%}
                  {%- assign ic_key = 'am_' | append: i | append: '_icon' -%}
                  {%- assign n_key = 'am_' | append: i | append: '_note' -%}
                  {%- assign cur_key = 'am_' | append: i | append: '_current' -%}
                  {%- assign spf_key = 'am_' | append: i | append: '_spf' -%}
                  {%- if block.settings[l_key] != blank -%}
                    {%- assign am_count = am_count | plus: 1 -%}
                    {%- if am_count > 1 -%}<div class="step-connector">→</div>{%- endif -%}
                    <div class="step-card {% if block.settings[cur_key] %}current{% endif %}">
                      <div class="step-icon-wrap" {% if block.settings[spf_key] %}style="background:#FFF8E8;"{% endif %}>
                        <span>{{ block.settings[ic_key] }}</span>
                        <span class="step-num-badge" {% if block.settings[spf_key] %}style="background:var(--mango-zest);"{% endif %}>{{ am_count }}</span>
                      </div>
                      {%- if block.settings[cur_key] -%}<div class="step-current-tag">This product</div>{%- endif -%}
                      <div class="step-label" {% if block.settings[spf_key] %}style="color:var(--mango-zest);"{% endif %}>{{ block.settings[l_key] }}</div>
                      <div class="step-note">{{ block.settings[n_key] }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              <!-- PM Steps -->
              <div class="htu-steps" id="htu-tab-pm-{{ block.id }}">
                {%- assign pm_count = 0 -%}
                {%- for i in (1..4) -%}
                  {%- assign l_key = 'pm_' | append: i | append: '_label' -%}
                  {%- assign ic_key = 'pm_' | append: i | append: '_icon' -%}
                  {%- assign n_key = 'pm_' | append: i | append: '_note' -%}
                  {%- assign cur_key = 'pm_' | append: i | append: '_current' -%}
                  {%- if block.settings[l_key] != blank -%}
                    {%- assign pm_count = pm_count | plus: 1 -%}
                    {%- if pm_count > 1 -%}<div class="step-connector">→</div>{%- endif -%}
                    <div class="step-card {% if block.settings[cur_key] %}current{% endif %}">
                      <div class="step-icon-wrap">
                        <span>{{ block.settings[ic_key] }}</span>
                        <span class="step-num-badge">{{ pm_count }}</span>
                      </div>
                      {%- if block.settings[cur_key] -%}<div class="step-current-tag">This product</div>{%- endif -%}
                      <div class="step-label">{{ block.settings[l_key] }}</div>
                      <div class="step-note">{{ block.settings[n_key] }}</div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              
              {%- if block.settings.tip != blank -%}
                <div class="htu-tip">{{ block.settings.tip }}</div>
              {%- endif -%}

            {%- when 'timeline' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="tl-cards">
                {%- for i in (1..4) -%}
                  {%- assign p_key = 'tl_' | append: i | append: '_period' -%}
                  {%- assign t_key = 'tl_' | append: i | append: '_title' -%}
                  {%- assign b_key = 'tl_' | append: i | append: '_body' -%}
                  {%- if block.settings[p_key] != blank -%}
                    <div class="tl-card">
                      <div class="tl-week">{{ block.settings[p_key] }}</div>
                      <div class="tl-title">{{ block.settings[t_key] }}</div>
                      <p class="tl-body">{{ block.settings[b_key] }}</p>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.tip != blank -%}
                <div class="tl-note">💡 <span>{{ block.settings.tip }}</span></div>
              {%- endif -%}

            {%- when 'inci' -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub" style="margin-bottom:24px;">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="inci-clean-badges">
                {%- for i in (1..6) -%}
                  {%- assign bg = 'clean_badge_' | append: i -%}
                  {%- if block.settings[bg] != blank -%}
                    <span class="inci-clean-badge">✓ {{ block.settings[bg] }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.content != blank -%}
                <div class="inci-content">
                  {{ block.settings.content }}
                </div>
              {%- endif -%}

          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}

  </div>
</div>

<script>
  // Rotate chevron on open/close
  document.querySelectorAll('.gv-acc-item').forEach(function(det) {
    det.addEventListener('toggle', function() {
      det.querySelector('.gv-acc-chevron').style.transform = det.open ? 'rotate(180deg)' : '';
    });
    if (det.open) {
      det.querySelector('.gv-acc-chevron').style.transform = 'rotate(180deg)';
    }
  });

  function switchRoutineTab(btn, tab, blockId) {
    var parent = btn.closest('.gv-acc-panel');
    parent.querySelectorAll('.htu-tab').forEach(t => t.classList.remove('active'));
    parent.querySelectorAll('.htu-steps').forEach(t => t.classList.remove('active'));
    
    btn.classList.add('active');
    document.getElementById('htu-tab-' + tab + '-' + blockId).classList.add('active');
  }
</script>

{% stylesheet %}
  /* Wrapper */
  .gv-acc-wrap {
    background: #fff;
    padding: 0 0 64px;
    margin-top: 40px;
  }
  .gv-acc-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Accordion row */
  .gv-acc-item {
    border-bottom: 1px solid #EAEAEA;
    background: #FFFFFF;
    border: 1px solid #EAEAEA;
    border-radius: 12px;
    margin-bottom: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.02);
  }

  .gv-acc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 16px;
  }
  .gv-acc-summary::-webkit-details-marker { display: none; }

  .gv-acc-label {
    font-family: var(--font-sans, "Poppins", sans-serif);
    font-size: 18px;
    font-weight: 600;
    color: #1A1A1A;
    line-height: 1.3;
  }

  .gv-acc-chevron {
    flex-shrink: 0;
    color: #1A1A1A;
    transition: transform 0.25s ease;
  }

  /* Panel */
  .gv-acc-panel {
    padding: 0 28px 32px 28px;
  }

  .gv-section-sub {
    font-size: 15px;
    color: #666;
    line-height: 1.65;
    max-width: 680px;
  }

  /* Pathways */
  .acc-pdp-pathways { padding-top: 32px; }
  .pathway-cards{display:flex; gap:14px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 8px;}
  .pathway-cards::-webkit-scrollbar{display:none;}
  .pathway-card{background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:24px 18px;transition:background 0.2s; min-width: 220px; flex: 1; flex-shrink: 0; scroll-snap-align: start;}
  .pathway-card:hover{background:rgba(255,255,255,0.08);}
  .pathway-num-pill{font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.1em;color:var(--accent, #FF4D8D);background:rgba(255,77,141,0.15);border-radius:100px;padding:4px 10px;display:inline-block;margin-bottom:16px;}
  .pathway-name-big{font-family:var(--font-serif);font-size:20px;color:var(--cream-glow, #fff);margin-bottom:6px;line-height:1.2;}
  .pathway-trigger-text{font-size:11px;color:rgba(255,255,255,0.38);margin-bottom:20px;line-height:1.5;}
  .pathway-divider{display:flex;align-items:center;gap:6px;margin-bottom:14px;}
  .pathway-divider-line{flex:1;height:1px;background:rgba(255,77,141,0.25);}
  .pathway-divider-text{font-family:var(--font-mono);font-size:8px;text-transform:uppercase;letter-spacing:0.12em;color:var(--accent, #FF4D8D);}
  .pathway-ing-label{font-family:var(--font-mono);font-size:13px;color:var(--accent, #FF4D8D);font-weight:500;margin-bottom:10px;}
  .pathway-mech-text{font-size:12px;color:rgba(255,255,255,0.45);line-height:1.65;}
  .science-bottom-stat{background:rgba(155,114,170,0.2); border:1px solid rgba(155,114,170,0.4);border-radius:16px;padding:28px;margin-top:32px;text-align:center;}
  @media(min-width:1024px) {
    .pathway-cards { display: grid; grid-template-columns: repeat(5, 1fr); overflow-x: visible; }
    .pathway-card { min-width: auto; }
  }

  /* Science Barrier */
  .acc-pdp-science {
    background: var(--berry-dark, #1A1A1A);
    border-radius: 20px;
    padding: 32px;
    overflow: hidden;
  }
  .barrier-diagram { display:grid; grid-template-columns:1fr auto 1fr; gap:0; align-items:stretch; }
  .barrier-col { padding:24px; }
  .barrier-col.left { background:rgba(155,114,170,0.15); border-radius:20px 0 0 20px; border:1px solid rgba(155,114,170,0.3); }
  .barrier-col.right { background:rgba(155,114,170,0.15); border-radius:0 20px 20px 0; border:1px solid rgba(155,114,170,0.3); border-left:none; }
  .barrier-col-label { font-family:var(--font-mono); font-size:11px; color:var(--plum-dusk, #9B72AA); text-transform:uppercase; letter-spacing:0.1em; margin-bottom:20px; }
  .barrier-arrow { display:flex; align-items:center; justify-content:center; width:60px; color:var(--plum-dusk, #9B72AA); font-size:32px; flex-shrink:0; }
  .barrier-step { display:flex; align-items:flex-start; gap:12px; margin-bottom:16px; }
  .barrier-step-num { width:28px; height:28px; border-radius:50%; background:var(--accent, #FF4D8D); color:white; font-size:13px; font-weight:600; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .barrier-step-text { font-size:14px; color:rgba(255,255,255,0.8); line-height:1.5; }
  .barrier-step-text strong { color:var(--plum-dusk, #9B72AA); font-family:var(--font-mono); }
  .science-stat { background:rgba(155,114,170,0.2); border:1px solid rgba(155,114,170,0.4); border-radius:16px; padding:32px; margin-top:32px; text-align:center; }
  .science-stat-num { font-family:var(--font-serif); font-size:60px; font-weight:300; color:var(--plum-dusk, #9B72AA); line-height:1; margin-bottom:8px;}
  .science-stat-label { font-size:15px; color:rgba(255,255,255,0.7); linha-height:1.4;}
  .science-stat-source { font-size:11px; color:rgba(255,255,255,0.4); margin-top:8px; font-family:var(--font-mono);}

  /* UV Spectrum */
  .uv-spectrum{margin-top:24px;}
  .uv-bar-container{position:relative;margin:32px 0;}
  .uv-bar{height:40px;border-radius:12px;background:linear-gradient(to right, #4A90E2 0%, #7B68EE 30%, #9B72AA 55%, #E07070 80%, #FF8C00 100%);display:flex;align-items:center;position:relative;}
  .uv-labels{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:11px;color:rgba(255,255,255,0.5);margin-bottom:8px;}
  .uv-markers{display:flex; gap:8px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:8px;}
  .uv-markers::-webkit-scrollbar{display:none;}
  .uv-marker{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:12px;padding:16px;text-align:center; min-width: 140px; flex: 1; flex-shrink: 0; scroll-snap-align: start;}
  .uv-marker-nm{font-family:var(--font-mono);font-size:11px;color:var(--mango-zest, #FFB347);margin-bottom:6px;}
  .uv-marker-name{font-family:var(--font-mono);font-size:12px;color:var(--cream-glow, #fff);margin-bottom:6px;font-weight:500; min-height:30px;}
  .uv-marker-desc{font-size:11px;color:rgba(255,255,255,0.55);line-height:1.4;}
  .uv-conclusion{margin-top:32px;background:rgba(255,179,71,0.1);border:1px solid rgba(255,179,71,0.3);border-radius:16px;padding:24px;text-align:center;}
  .uv-conclusion-main{font-family:var(--font-serif);font-size:20px;color:var(--cream-glow, #fff);font-style:italic;}
  .uv-conclusion-sub{font-size:13px;color:rgba(255,255,255,0.6);margin-top:8px;}
  .pk-uv-box{background:rgba(255,179,71,0.15);border:1px solid rgba(255,179,71,0.4);border-radius:16px;padding:20px;margin-top:32px;display:flex;flex-direction:column;gap:16px;}
  .pk-uv-num{font-family:var(--font-serif);font-size:48px;font-weight:300;color:var(--mango-zest, #FFB347);line-height:1;}
  .pk-uv-text{font-size:13px;color:rgba(255,255,255,0.75);line-height:1.65;}
  .pk-uv-text strong{color:var(--mango-zest, #FFB347);}
  .pa-badge-section{margin-top:32px;display:flex;gap:20px;flex-direction:column;}
  .pa-badge{background:rgba(255,179,71,0.2);border:1px solid rgba(255,179,71,0.5);border-radius:16px;padding:20px;text-align:center;}
  .pa-badge-rating{font-family:var(--font-serif);font-size:32px;color:var(--mango-zest, #FFB347);font-weight:300;line-height:1;}
  .pa-badge-label{font-family:var(--font-mono);font-size:10px;color:rgba(255,255,255,0.6);margin-top:8px;}
  .pa-explain{font-size:13px;color:rgba(255,255,255,0.65);line-height:1.7;}
  .pa-explain strong{color:var(--cream-glow, #fff);}
  @media(min-width:1024px) {
    .uv-markers { display: grid; grid-template-columns: repeat(6, 1fr); overflow-x: visible; }
    .uv-marker { min-width: auto; }
    .pk-uv-box { flex-direction: row; align-items: center; gap: 32px; padding: 28px; }
    .pk-uv-num { font-size: 80px; }
    .pk-uv-text { font-size: 15px; }
    .pa-badge-section { flex-direction: row; align-items: center; }
    .pa-badge { padding: 20px 32px; }
    .pa-badge-rating { font-size: 48px; }
  }

  /* Ingredients scroll */
  .ing-scroll-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  .ing-scroll-track::-webkit-scrollbar{display:none;}
  .ing-card{background:white;border-radius:20px;overflow:hidden;transition:transform 0.25s,box-shadow 0.25s;min-width:210px;max-width:210px;scroll-snap-align:start;flex-shrink:0; border: 1px solid #EAEAEA;}
  .ing-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,0.1);}
  .ing-card-img{aspect-ratio:1/1;overflow:hidden;background:var(--warm-gray);}
  .ing-card-img img{width:100%;height:100%;object-fit:cover;}
  .ing-card-body{padding:16px;}
  .ing-badge{display:inline-block;font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.08em;padding:3px 10px;border-radius:100px;background:var(--accent-light, #FFF0E6);color:var(--accent, #FF4D8D);margin-bottom:8px;}
  .ing-name-mono{font-family:var(--font-mono);font-size:14px;color:var(--accent, #FF4D8D);font-weight:500;margin-bottom:6px;}
  .ing-benefit{font-size:12px;color:var(--mid-gray, #666);line-height:1.55;}

  /* Routine Tabs */
  .htu-tabs{display:flex;border:1.5px solid var(--warm-gray, #ECECEC);border-radius:100px;overflow:hidden;width:fit-content;margin-bottom:32px;}
  .htu-tab{padding:8px 24px;font-size:13px;font-weight:500;cursor:pointer;background:none;border:none;font-family:var(--font-sans);color:var(--mid-gray);transition:all 0.2s;}
  .htu-tab.active{background:var(--berry-dark, #1A1A1A);color:white;}
  .htu-steps{display:none;}.htu-steps.active{display:flex;align-items:flex-start;gap:0;overflow-x:auto;-webkit-overflow-scrolling:touch;}
  .step-card{flex:1;min-width:130px;text-align:center;position:relative;padding:0 12px 8px;}
  .step-connector{display:flex;align-items:center;justify-content:center;padding-top:28px;color:var(--warm-gray);font-size:24px;flex-shrink:0;}
  .step-icon-wrap{width:64px;height:64px;border-radius:50%;background:var(--warm-gray, #ECECEC);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 12px;transition:all 0.2s;position:relative;}
  .step-card.current .step-icon-wrap{background:var(--accent, #FF4D8D);box-shadow:0 0 0 6px rgba(255,77,141,0.18);}
  .step-num-badge{position:absolute;top:-4px;right:-4px;width:22px;height:22px;background:var(--berry-dark, #1A1A1A);color:white;border-radius:50%;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;}
  .step-card.current .step-num-badge{background:var(--accent, #FF4D8D);}
  .step-label{font-weight:600;font-size:13px;color:var(--berry-dark, #1A1A1A);margin-bottom:5px;}
  .step-card.current .step-label{color:var(--accent, #FF4D8D);}
  .step-note{font-size:11px;color:var(--mid-gray, #666);line-height:1.5;}
  .step-current-tag{display:inline-block;font-family:var(--font-mono);font-size:9px;background:var(--accent, #FF4D8D);color:white;border-radius:100px;padding:2px 8px;margin-bottom:5px;text-transform:uppercase;letter-spacing:0.06em;}
  .htu-tip{background:white;border-radius:16px;padding:20px 24px;margin-top:24px;font-size:13px;color:var(--mid-gray, #666);line-height:1.7;border:1px solid var(--warm-gray, #ECECEC);}
  .htu-tip b, .htu-tip strong{color:var(--berry-dark, #1A1A1A);}

  /* Timeline */
  .tl-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .tl-card{background:#fafafa;border-radius:16px;padding:24px;position:relative;overflow:hidden;border:1px solid var(--warm-gray, #ECECEC);}
  .tl-card::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--accent, #FF4D8D);opacity:0.4;}
  .tl-week{font-family:var(--font-mono);font-size:11px;color:var(--accent, #FF4D8D);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:10px;}
  .tl-title{font-family:var(--font-serif);font-size:18px;color:var(--berry-dark, #1A1A1A);margin-bottom:8px; line-height: 1.2;}
  .tl-body{font-size:13px;color:var(--mid-gray, #666);line-height:1.65;}
  .tl-note{background:#F5F0FF;border-radius:12px;padding:16px;margin-top:32px;font-size:14px;color:#5A3E80;display:flex;align-items:flex-start;gap:10px;}

  /* INCI */
  .inci-clean-badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;}
  .inci-clean-badge{background:white;border:1.5px solid var(--warm-gray, #ECECEC);border-radius:100px;padding:6px 14px;font-size:11px;font-family:var(--font-mono);color:var(--berry-dark);letter-spacing:0.04em;}
  .inci-content{padding:24px;font-family:var(--font-mono);font-size:12px;color:var(--mid-gray, #666);line-height:2.4;border:1.5px solid var(--warm-gray, #ECECEC);border-radius:12px;background:white;}
  .inci-content strong, .inci-content b{color:var(--plum-dusk, #9B72AA);font-weight:500;}

  /* Responsive fixes */
  @media(max-width:900px){
    .barrier-diagram{grid-template-columns:1fr;grid-template-rows:auto auto auto;}
    .barrier-col.left{border-radius:20px 20px 0 0;}
    .barrier-col.right{border-radius:0 0 20px 20px;border-left:1px solid rgba(155,114,170,0.3);border-top:none;}
    .barrier-arrow{transform:rotate(90deg);height:40px;width:100%;}
    .tl-cards{grid-template-columns:1fr 1fr;}
  }
  @media(max-width:480px){
    .tl-cards{grid-template-columns:1fr;}
  }

