<div class="gv-acc-wrap">
  <div class="gv-acc-list">

    {%- for block in section.blocks -%}
      <details class="gv-acc-item" id="gv-acc-{{ block.id }}" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
        <summary class="gv-acc-summary">
          <span class="gv-acc-label">{{ block.settings.title }}</span>
          <svg class="gv-acc-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>

        <div class="gv-acc-panel">

          {%- case block.type -%}

            {%- when 'ingredients' -%}
              {%- if block.settings.kicker != blank -%}
                <div class="gv-section-kicker">{{ block.settings.kicker }}</div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="gv-section-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="gv-ing-track">
                {%- for i in (1..6) -%}
                  {%- assign n_key   = 'ing_' | append: i | append: '_name' -%}
                  {%- assign b_key   = 'ing_' | append: i | append: '_benefit' -%}
                  {%- assign img_key = 'ing_' | append: i | append: '_image' -%}
                  {%- assign bdg_key = 'ing_' | append: i | append: '_badge' -%}
                  {%- if block.settings[n_key] != blank -%}
                    <div class="gv-ing-card">
                      <div class="gv-ing-card-img">
                        {%- if block.settings[img_key] != blank -%}
                          {{ block.settings[img_key] | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings[n_key] }}
                        {%- else -%}
                          <div class="gv-ing-card-placeholder"></div>
                        {%- endif -%}
                      </div>
                      <div class="gv-ing-card-body">
                        {%- if block.settings[bdg_key] != blank -%}
                          <span class="gv-ing-badge">{{ block.settings[bdg_key] }}</span>
                        {%- endif -%}
                        <div class="gv-ing-name">{{ block.settings[n_key] }}</div>
                        {%- if block.settings[b_key] != blank -%}
                          <p class="gv-ing-benefit">{{ block.settings[b_key] }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              <p class="gv-ing-hint">← Scroll to see all actives</p>

            {%- when 'inci' -%}
              {%- if block.settings.kicker != blank -%}
                <div class="gv-section-kicker">{{ block.settings.kicker }}</div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="gv-inci-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-inci-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="gv-inci-badges">
                {%- for i in (1..8) -%}
                  {%- assign bdg = 'clean_badge_' | append: i -%}
                  {%- if block.settings[bdg] != blank -%}
                    <span class="gv-inci-clean-badge">✓ {{ block.settings[bdg] }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.content != blank -%}
                <button class="gv-inci-toggle" type="button" aria-expanded="false">
                  <span class="gv-inci-toggle-text">Expand full INCI list</span>
                  <span class="gv-inci-toggle-icon">+</span>
                </button>
                <div class="gv-inci-content" hidden>
                  {{ block.settings.content }}
                </div>
              {%- endif -%}

            {%- when 'how_to_use' -%}
              {%- if block.settings.kicker != blank -%}
                <div class="gv-section-kicker">{{ block.settings.kicker }}</div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="gv-section-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="gv-htu-steps">
                {%- for i in (1..5) -%}
                  {%- assign l_key = 'step_' | append: i | append: '_label' -%}
                  {%- assign n_key = 'step_' | append: i | append: '_note' -%}
                  {%- assign ic_key = 'step_' | append: i | append: '_icon' -%}
                  {%- assign cur_key = 'step_' | append: i | append: '_current' -%}
                  {%- if block.settings[l_key] != blank -%}
                    {%- if i > 1 -%}<div class="gv-htu-arrow">→</div>{%- endif -%}
                    <div class="gv-htu-step{% if block.settings[cur_key] %} gv-htu-step--current{% endif %}">
                      <div class="gv-htu-icon-wrap">
                        <span class="gv-htu-emoji">{{ block.settings[ic_key] | default: i }}</span>
                        <span class="gv-htu-num">{{ i }}</span>
                      </div>
                      {%- if block.settings[cur_key] -%}
                        <div class="gv-htu-current-tag">This product</div>
                      {%- endif -%}
                      <div class="gv-htu-step-label">{{ block.settings[l_key] }}</div>
                      {%- if block.settings[n_key] != blank -%}
                        <div class="gv-htu-step-note">{{ block.settings[n_key] }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.tip != blank -%}
                <div class="gv-htu-tip">{{ block.settings.tip }}</div>
              {%- endif -%}

            {%- when 'timeline' -%}
              {%- if block.settings.kicker != blank -%}
                <div class="gv-section-kicker">{{ block.settings.kicker }}</div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="gv-section-title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="gv-section-sub">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              <div class="gv-tl-grid">
                {%- for i in (1..4) -%}
                  {%- assign p_key = 'tl_' | append: i | append: '_period' -%}
                  {%- assign t_key = 'tl_' | append: i | append: '_title' -%}
                  {%- assign b_key = 'tl_' | append: i | append: '_body' -%}
                  {%- if block.settings[p_key] != blank -%}
                    <div class="gv-tl-card">
                      <div class="gv-tl-week">{{ block.settings[p_key] }}</div>
                      <div class="gv-tl-title">{{ block.settings[t_key] }}</div>
                      <p class="gv-tl-body">{{ block.settings[b_key] }}</p>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if block.settings.tip != blank -%}
                <div class="gv-tl-note">💡 {{ block.settings.tip }}</div>
              {%- endif -%}

            {%- when 'rich_text' -%}
              <div class="gv-rich-content">{{ block.settings.content }}</div>

          {%- endcase -%}

        </div>
      </details>
    {%- endfor -%}

  </div>
</div>

<script>
  // Rotate chevron on open/close
  document.querySelectorAll('.gv-acc-item').forEach(function(det) {
    det.addEventListener('toggle', function() {
      det.querySelector('.gv-acc-chevron').style.transform = det.open ? 'rotate(180deg)' : '';
    });
    if (det.open) {
      det.querySelector('.gv-acc-chevron').style.transform = 'rotate(180deg)';
    }
  });

  // INCI toggle
  document.querySelectorAll('.gv-inci-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var content = btn.nextElementSibling;
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', !expanded);
      btn.querySelector('.gv-inci-toggle-icon').textContent = expanded ? '+' : '−';
      if (expanded) {
        content.setAttribute('hidden', '');
      } else {
        content.removeAttribute('hidden');
      }
    });
  });
</script>

{% stylesheet %}

  /* ── Wrapper ── */
  .gv-acc-wrap {
    background: #fff;
    padding: 0 0 64px;
  }
  .gv-acc-list {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ── Accordion row ── */
  .gv-acc-item {
    border-bottom: 1px solid #EAEAEA;
  }
  .gv-acc-item:first-child {
    border-top: 1px solid #EAEAEA;
  }

  .gv-acc-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    user-select: none;
    gap: 16px;
  }
  .gv-acc-summary::-webkit-details-marker { display: none; }

  .gv-acc-label {
    font-size: 17px;
    font-weight: 600;
    color: #1A1A1A;
    line-height: 1.3;
  }

  .gv-acc-chevron {
    flex-shrink: 0;
    color: #1A1A1A;
    transition: transform 0.25s ease;
  }

  /* ── Panel ── */
  .gv-acc-panel {
    padding-bottom: 40px;
  }

  /* ── Section kicker / title / sub (match mockup section-label / section-title / section-sub) ── */
  .gv-section-kicker {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--coral-pulse);
    margin-bottom: 10px;
  }
  .gv-section-title {
    font-size: 36px;
    font-weight: 700;
    color: #1A1A1A;
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .gv-section-sub {
    font-size: 16px;
    color: #666;
    line-height: 1.65;
    margin-bottom: 32px;
    max-width: 680px;
  }

  /* ── Ingredient cards (exact mockup match) ── */
  .gv-ing-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 8px 0 24px;
  }
  .gv-ing-track::-webkit-scrollbar { display: none; }

  .gv-ing-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    min-width: 210px;
    max-width: 210px;
    flex-shrink: 0;
    scroll-snap-align: start;
    border: 1px solid #EAEAEA;
    transition: transform 0.25s, box-shadow 0.25s;
  }
  .gv-ing-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.1);
  }

  .gv-ing-card-img {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #ECECEC;
  }
  .gv-ing-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gv-ing-card-placeholder {
    width: 100%;
    height: 100%;
    background: #ECECEC;
  }

  .gv-ing-card-body {
    padding: 16px;
  }

  .gv-ing-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 100px;
    background: #FFF0E6;
    color: var(--coral-pulse);
    margin-bottom: 8px;
  }

  .gv-ing-name {
    font-size: 14px;
    font-weight: 600;
    color: var(--coral-pulse);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .gv-ing-benefit {
    font-size: 12px;
    color: #666;
    line-height: 1.55;
    margin: 0;
  }

  .gv-ing-hint {
    font-size: 12px;
    color: #AAA;
    margin-top: 0;
  }

  /* ── INCI (exact mockup match) ── */
  .gv-inci-title {
    font-size: 36px;
    font-weight: 300;
    color: #1A1A1A;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .gv-inci-sub {
    font-size: 15px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .gv-inci-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }
  .gv-inci-clean-badge {
    background: white;
    border: 1.5px solid #ECECEC;
    border-radius: 100px;
    padding: 6px 14px;
    font-size: 11px;
    color: #1A1A1A;
    letter-spacing: 0.04em;
  }

  .gv-inci-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: 1.5px solid #ECECEC;
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 15px;
    font-family: inherit;
    color: #1A1A1A;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s;
  }
  .gv-inci-toggle:hover { border-color: var(--coral-pulse); }
  .gv-inci-toggle-icon {
    font-size: 20px;
    color: #666;
    flex-shrink: 0;
    line-height: 1;
  }

  .gv-inci-content {
    padding: 24px;
    font-size: 12px;
    color: #888;
    line-height: 2.4;
    border: 1.5px solid #ECECEC;
    border-top: none;
    border-radius: 0 0 12px 12px;
    background: white;
  }
  .gv-inci-content strong, .gv-inci-content b {
    color: var(--coral-pulse);
    font-weight: 600;
  }

  /* ── How to Use ── */
  .gv-htu-steps {
    display: flex;
    align-items: flex-start;
    gap: 0;
    overflow-x: auto;
    padding-bottom: 8px;
  }
  .gv-htu-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: 28px;
    color: #ECECEC;
    font-size: 24px;
    flex-shrink: 0;
    padding-left: 4px;
    padding-right: 4px;
  }
  .gv-htu-step {
    flex: 1;
    min-width: 120px;
    text-align: center;
    padding: 0 8px 8px;
  }
  .gv-htu-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #ECECEC;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin: 0 auto 12px;
    position: relative;
    transition: background 0.2s;
  }
  .gv-htu-step--current .gv-htu-icon-wrap {
    background: var(--coral-pulse);
    box-shadow: 0 0 0 6px rgba(255,77,141,0.12);
  }
  .gv-htu-num {
    position: absolute;
    top: -4px;
    right: -4px;
    width: 22px;
    height: 22px;
    background: #1A1A1A;
    color: white;
    border-radius: 50%;
    font-size: 10px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gv-htu-step--current .gv-htu-num {
    background: var(--coral-pulse);
  }
  .gv-htu-emoji { line-height: 1; }
  .gv-htu-current-tag {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--coral-pulse);
    color: white;
    border-radius: 100px;
    padding: 2px 8px;
    margin-bottom: 5px;
  }
  .gv-htu-step-label {
    font-weight: 600;
    font-size: 13px;
    color: #1A1A1A;
    margin-bottom: 5px;
  }
  .gv-htu-step--current .gv-htu-step-label { color: var(--coral-pulse); }
  .gv-htu-step-note {
    font-size: 11px;
    color: #888;
    line-height: 1.5;
  }
  .gv-htu-tip {
    background: white;
    border-radius: 16px;
    padding: 20px 24px;
    margin-top: 32px;
    font-size: 14px;
    color: #666;
    line-height: 1.7;
    border: 1px solid #ECECEC;
  }

  /* ── Timeline (exact mockup match) ── */
  .gv-tl-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 24px;
  }
  .gv-tl-card {
    background: #FAFAFA;
    border-radius: 16px;
    padding: 24px;
    position: relative;
    overflow: hidden;
  }
  .gv-tl-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--coral-pulse);
    opacity: 0.5;
  }
  .gv-tl-week {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--coral-pulse);
    margin-bottom: 10px;
  }
  .gv-tl-title {
    font-size: 18px;
    font-weight: 700;
    color: #1A1A1A;
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .gv-tl-body {
    font-size: 13px;
    color: #666;
    line-height: 1.65;
    margin: 0;
  }
  .gv-tl-note {
    background: #FFF0E6;
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .gv-rich-content {
    font-size: 15px;
    color: #555;
    line-height: 1.7;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .gv-acc-list { padding: 0 16px; }
    .gv-acc-label { font-size: 15px; }
    .gv-section-title { font-size: 26px; }
    .gv-tl-grid { grid-template-columns: 1fr 1fr; }
    .gv-htu-steps { gap: 0; }
    .gv-htu-step { min-width: 100px; }
    .gv-htu-icon-wrap { width: 52px; height: 52px; font-size: 22px; }
  }
  @media (max-width: 480px) {
    .gv-tl-grid { grid-template-columns: 1fr; }
    .gv-ing-card { min-width: 180px; max-width: 180px; }
  }

{% endstylesheet %}

