<div class="gv-pdp-acc">
  <div class="gv-pdp-inner">
    <div class="gv-acc-container">

      {%- for block in section.blocks -%}
        <details class="gv-acc-row" id="gv-acc-{{ block.id }}" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
          <summary class="gv-acc-header">
            <div class="gv-acc-header-left">
              {%- if block.settings.icon != blank -%}
                <span class="gv-acc-emoji">{{ block.settings.icon }}</span>
              {%- endif -%}
              <span class="gv-acc-title">{{ block.settings.title }}</span>
            </div>
            <span class="gv-acc-icon">
              <svg class="gv-acc-plus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              <svg class="gv-acc-minus" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
            </span>
          </summary>

          <div class="gv-acc-body">

            {%- case block.type -%}

              {%- when 'ingredients' -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <div class="gv-ing-track">
                  {%- for i in (1..6) -%}
                    {%- assign n_key = 'ing_' | append: i | append: '_name' -%}
                    {%- assign b_key = 'ing_' | append: i | append: '_benefit' -%}
                    {%- assign img_key = 'ing_' | append: i | append: '_image' -%}
                    {%- assign badge_key = 'ing_' | append: i | append: '_badge' -%}
                    {%- assign icon_key = 'ing_' | append: i | append: '_icon' -%}
                    {%- if block.settings[n_key] != blank -%}
                      <div class="gv-ing-card">
                        <div class="gv-ing-card-img">
                          {%- if block.settings[img_key] != blank -%}
                            {{ block.settings[img_key] | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings[n_key] }}
                          {%- elsif block.settings[icon_key] != blank -%}
                            <div class="gv-ing-card-icon">{{ block.settings[icon_key] }}</div>
                          {%- else -%}
                            <div class="gv-ing-card-icon">🌿</div>
                          {%- endif -%}
                        </div>
                        <div class="gv-ing-card-body">
                          {%- if block.settings[badge_key] != blank -%}
                            <span class="gv-ing-badge">{{ block.settings[badge_key] }}</span>
                          {%- endif -%}
                          <div class="gv-ing-name">{{ block.settings[n_key] }}</div>
                          {%- if block.settings[b_key] != blank -%}
                            <p class="gv-ing-benefit">{{ block.settings[b_key] }}</p>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                <p class="gv-ing-hint">← Scroll to see all actives</p>

              {%- when 'how_to_use' -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <div class="gv-htu-steps">
                  {%- for i in (1..5) -%}
                    {%- assign l_key = 'step_' | append: i | append: '_label' -%}
                    {%- assign n_key = 'step_' | append: i | append: '_note' -%}
                    {%- assign c_key = 'step_' | append: i | append: '_current' -%}
                    {%- assign ic_key = 'step_' | append: i | append: '_icon' -%}
                    {%- if block.settings[l_key] != blank -%}
                      <div class="gv-htu-step{% if block.settings[c_key] %} gv-htu-step--current{% endif %}">
                        <div class="gv-htu-bubble">
                          {%- if block.settings[ic_key] != blank -%}
                            {{ block.settings[ic_key] }}
                          {%- else -%}
                            {{ i }}
                          {%- endif -%}
                        </div>
                        <div class="gv-htu-info">
                          {%- if block.settings[c_key] -%}
                            <div class="gv-htu-this-tag">This product</div>
                          {%- endif -%}
                          <div class="gv-htu-label">{{ block.settings[l_key] }}</div>
                          {%- if block.settings[n_key] != blank -%}
                            <div class="gv-htu-note">{{ block.settings[n_key] }}</div>
                          {%- endif -%}
                        </div>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.tip != blank -%}
                  <div class="gv-htu-tip">💡 {{ block.settings.tip }}</div>
                {%- endif -%}

              {%- when 'timeline' -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <div class="gv-tl-grid">
                  {%- for i in (1..4) -%}
                    {%- assign p_key = 'tl_' | append: i | append: '_period' -%}
                    {%- assign t_key = 'tl_' | append: i | append: '_title' -%}
                    {%- assign b_key = 'tl_' | append: i | append: '_body' -%}
                    {%- if block.settings[p_key] != blank -%}
                      <div class="gv-tl-item">
                        <div class="gv-tl-period">{{ block.settings[p_key] }}</div>
                        <div class="gv-tl-title">{{ block.settings[t_key] }}</div>
                        <p class="gv-tl-body">{{ block.settings[b_key] }}</p>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>

              {%- when 'inci' -%}
                <div class="gv-inci-badges">
                  {%- for i in (1..8) -%}
                    {%- assign badge_key = 'clean_badge_' | append: i -%}
                    {%- if block.settings[badge_key] != blank -%}
                      <span class="gv-inci-badge">✓ {{ block.settings[badge_key] }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.content != blank -%}
                  <div class="gv-inci-list">{{ block.settings.content }}</div>
                {%- endif -%}

              {%- when 'science' -%}
                {%- if block.settings.subtitle != blank -%}
                  <p class="gv-acc-sub">{{ block.settings.subtitle }}</p>
                {%- endif -%}
                <div class="gv-sci-grid">
                  {%- for i in (1..5) -%}
                    {%- assign t_key = 'card_' | append: i | append: '_title' -%}
                    {%- assign b_key = 'card_' | append: i | append: '_body' -%}
                    {%- assign ing_key = 'card_' | append: i | append: '_ingredient' -%}
                    {%- if block.settings[t_key] != blank -%}
                      <div class="gv-sci-card">
                        <div class="gv-sci-num">0{{ i }}</div>
                        <div class="gv-sci-title">{{ block.settings[t_key] }}</div>
                        <div class="gv-sci-body">{{ block.settings[b_key] }}</div>
                        {%- if block.settings[ing_key] != blank -%}
                          <div class="gv-sci-ing">{{ block.settings[ing_key] }}</div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
                {%- if block.settings.stat_num != blank -%}
                  <div class="gv-sci-stat">
                    <div class="gv-sci-stat-num">{{ block.settings.stat_num }}</div>
                    <div class="gv-sci-stat-label">{{ block.settings.stat_label }}</div>
                  </div>
                {%- endif -%}

              {%- when 'rich_text' -%}
                <div class="gv-acc-rich">{{ block.settings.content }}</div>

            {%- endcase -%}

          </div>
        </details>
      {%- endfor -%}

    </div>
  </div>
</div>

{% stylesheet %}
  /* ── Wrapper ── */
  .gv-pdp-acc {
    background: #fff;
    padding: 32px 0 64px;
  }
  .gv-pdp-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── Accordion shell ── */
  .gv-acc-container {
    display: flex;
    flex-direction: column;
  }
  .gv-acc-row {
    border-bottom: 1px solid #EAEAEA;
    background: #fff;
  }
  .gv-acc-row:first-child {
    border-top: 1px solid #EAEAEA;
  }

  /* ── Summary / header ── */
  .gv-acc-header {
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    user-select: none;
  }
  .gv-acc-header::-webkit-details-marker { display: none; }

  .gv-acc-header-left {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .gv-acc-emoji {
    font-size: 20px;
    flex-shrink: 0;
    line-height: 1;
  }

  .gv-acc-title {
    font-size: 16px;
    font-weight: 600;
    color: #1A1A1A;
    line-height: 1.3;
  }

  .gv-acc-icon {
    color: #1A1A1A;
    flex-shrink: 0;
    display: flex;
  }
  .gv-acc-minus { display: none; }
  .gv-acc-row[open] .gv-acc-plus { display: none; }
  .gv-acc-row[open] .gv-acc-minus { display: flex; }

  /* ── Body ── */
  .gv-acc-body {
    padding-bottom: 28px;
  }
  .gv-acc-sub {
    font-size: 14px;
    color: #666;
    line-height: 1.65;
    margin-bottom: 20px;
  }
  .gv-acc-rich { font-size: 15px; color: #555; line-height: 1.7; }

  /* ── Ingredient cards ── */
  .gv-ing-track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 8px;
  }
  .gv-ing-track::-webkit-scrollbar { display: none; }

  .gv-ing-card {
    flex: 0 0 180px;
    background: #FAFAFA;
    border-radius: 16px;
    overflow: hidden;
    scroll-snap-align: start;
    border: 1px solid #EAEAEA;
  }

  .gv-ing-card-img {
    aspect-ratio: 1;
    background: #F0F0F0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .gv-ing-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gv-ing-card-icon {
    font-size: 40px;
    line-height: 1;
  }

  .gv-ing-card-body {
    padding: 14px;
  }
  .gv-ing-badge {
    display: inline-block;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--coral-pulse);
    background: rgba(255,77,141,0.1);
    padding: 3px 8px;
    border-radius: 100px;
    margin-bottom: 7px;
  }
  .gv-ing-name {
    font-weight: 700;
    font-size: 13px;
    color: #1A1A1A;
    margin-bottom: 5px;
    line-height: 1.3;
  }
  .gv-ing-benefit {
    font-size: 11px;
    color: #777;
    line-height: 1.5;
    margin: 0;
  }
  .gv-ing-hint {
    font-size: 11px;
    color: #AAA;
    margin-top: 10px;
  }

  /* ── How to Use ── */
  .gv-htu-steps {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gv-htu-step {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 12px;
    background: #F9F9F9;
  }
  .gv-htu-step--current {
    background: #FFF5F8;
    border: 1.5px solid var(--coral-pulse);
  }
  .gv-htu-bubble {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #1A1A1A;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
    line-height: 1;
  }
  .gv-htu-step--current .gv-htu-bubble {
    background: var(--coral-pulse);
  }
  .gv-htu-this-tag {
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--coral-pulse);
    margin-bottom: 2px;
  }
  .gv-htu-label {
    font-weight: 700;
    font-size: 14px;
    color: #1A1A1A;
    margin-bottom: 3px;
  }
  .gv-htu-note {
    font-size: 12px;
    color: #666;
    line-height: 1.5;
  }
  .gv-htu-tip {
    margin-top: 16px;
    background: #FFFBF0;
    border: 1px solid #FFE082;
    border-radius: 12px;
    padding: 14px 16px;
    font-size: 13px;
    color: #555;
    line-height: 1.6;
  }

  /* ── Timeline ── */
  .gv-tl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .gv-tl-item {
    background: #F9F9F9;
    border-radius: 12px;
    padding: 18px 16px;
    border-top: 3px solid var(--coral-pulse);
  }
  .gv-tl-period {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--coral-pulse);
    margin-bottom: 6px;
  }
  .gv-tl-title {
    font-weight: 700;
    font-size: 14px;
    color: #1A1A1A;
    margin-bottom: 6px;
  }
  .gv-tl-body {
    font-size: 12px;
    color: #666;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Science ── */
  .gv-sci-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }
  .gv-sci-card {
    background: #F9F9F9;
    border-radius: 12px;
    padding: 18px 16px;
  }
  .gv-sci-num {
    font-size: 10px;
    font-weight: 700;
    color: var(--coral-pulse);
    margin-bottom: 8px;
    letter-spacing: 0.06em;
  }
  .gv-sci-title {
    font-weight: 700;
    font-size: 13px;
    color: #1A1A1A;
    margin-bottom: 5px;
  }
  .gv-sci-body {
    font-size: 12px;
    color: #666;
    line-height: 1.5;
  }
  .gv-sci-ing {
    display: inline-block;
    margin-top: 8px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--coral-pulse);
    background: rgba(255,77,141,0.1);
    padding: 3px 8px;
    border-radius: 4px;
  }
  .gv-sci-stat {
    text-align: center;
    padding: 28px 20px;
    background: #1A1A1A;
    color: white;
    border-radius: 14px;
  }
  .gv-sci-stat-num {
    font-size: 48px;
    font-weight: 300;
    color: var(--coral-pulse);
    line-height: 1;
    margin-bottom: 8px;
  }
  .gv-sci-stat-label {
    font-size: 14px;
    opacity: 0.75;
  }

  /* ── INCI ── */
  .gv-inci-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }
  .gv-inci-badge {
    font-size: 11px;
    font-weight: 600;
    color: #108043;
    background: #E3F1DF;
    padding: 5px 12px;
    border-radius: 100px;
  }
  .gv-inci-list {
    font-size: 12px;
    color: #888;
    line-height: 2.2;
  }
  .gv-inci-list strong, .gv-inci-list b {
    color: var(--coral-pulse);
    font-weight: 600;
  }

  /* ── Mobile ── */
  @media (max-width: 599px) {
    .gv-pdp-acc { padding: 24px 0 48px; }
    .gv-acc-title { font-size: 15px; }
    .gv-acc-header { padding: 18px 0; }
    .gv-tl-grid { grid-template-columns: 1fr; }
    .gv-sci-grid { grid-template-columns: 1fr; }
    .gv-ing-card { flex: 0 0 160px; }
  }
{% endstylesheet %}

