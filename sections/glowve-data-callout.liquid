<section class="gv-data-section" style="background: {{ section.settings.bg_color }};">
  <div class="gv-data-inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="gv-data-eyebrow" style="color: {{ section.settings.accent_color }};">
        {{ section.settings.eyebrow }}
      </div>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h2 class="gv-data-title" style="color: {{ section.settings.text_color }};">
        {{ section.settings.title }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="gv-data-grid">
        {%- for block in section.blocks -%}
          {%- assign highlight = block.settings.is_highlighted -%}
          <div class="gv-data-item {% if highlight %}gv-data-item--highlight{% endif %}" {{ block.shopify_attributes }} 
               style="{% if highlight %}background: {{ section.settings.accent_color | color_modify: 'alpha', 0.15 }}; border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.3 }};{% else %}background: {{ section.settings.accent_color | color_modify: 'alpha', 0.12 }}; border: 1px solid {{ section.settings.accent_color | color_modify: 'alpha', 0.2 }};{% endif %}">
            
            <div class="gv-data-value" style="color: {{ section.settings.accent_color }};">
              {{ block.settings.value }}
            </div>
            <div class="gv-data-name" style="color: {{ section.settings.text_color }};">
              {{ block.settings.name }}
            </div>
            <div class="gv-data-note" style="color: {{ section.settings.text_color | color_modify: 'alpha', 0.5 }};">
              {{ block.settings.note }}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.footer_text != blank -%}
      <p class="gv-data-footer-text" style="color: {{ section.settings.text_color | color_modify: 'alpha', 0.5 }};">
        {{ section.settings.footer_text }}
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-data-section {
    padding: 80px 40px;
  }
  .gv-data-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .gv-data-eyebrow {
    font-family: var(--font-mono, 'Poppins', sans-serif);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .gv-data-title {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 42px;
    font-weight: 300;
    line-height: 1.2;
    margin-bottom: 48px;
    /* Proper casing */
  }
  .gv-data-title em {
    font-style: italic;
  }
  .gv-data-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 40px;
  }
  .gv-data-item {
    border-radius: 16px;
    padding: 28px;
  }
  .gv-data-value {
    font-family: var(--font-serif, 'Poppins', sans-serif);
    font-size: 52px;
    font-weight: 300;
    line-height: 1;
  }
  .gv-data-name {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 13px;
    margin-top: 8px;
    font-weight: 600;
  }
  .gv-data-note {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 12px;
    margin-top: 4px;
  }
  .gv-data-footer-text {
    font-family: var(--font-sans, 'Poppins', sans-serif);
    font-size: 14px;
    line-height: 1.7;
    max-width: 760px;
    margin: 0 auto;
  }

  @media (max-width: 900px) {
    .gv-data-title {
      font-size: 36px;
    }
  }
  @media (max-width: 640px) {
    .gv-data-section {
      padding: 60px 24px;
    }
    .gv-data-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .gv-data-title {
      font-size: 28px;
      margin-bottom: 32px;
    }
    .gv-data-value {
      font-size: 42px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Data Callout",
  "tag": "section",
  "class": "glowve-data-callout",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#FFB347"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "UV INDEX IN PAKISTAN"
    },
    {
      "type": "html",
      "id": "title",
      "label": "Section Title",
      "default": "Your skin is dealing with a<br><em style=\"font-style:italic;color:#FFB347;\">UV reality</em> most SPFs weren't built for."
    },
    {
      "type": "textarea",
      "id": "footer_text",
      "label": "Footer Text",
      "default": "UVA is present year-round — even on cloudy days, even through glass."
    }
  ],
  "blocks": [
    {
      "type": "data_point",
      "name": "Data Point",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value (Large)",
          "default": "10-12"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Karachi Summer"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "UV Index (Jun-Aug)"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "Highlight Block",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Data Callout"
    }
  ]
}
{% endschema %}
