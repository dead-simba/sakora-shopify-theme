<footer class="sk-footer" aria-label="Site footer">
  <div class="sk-container">
    <div class="sk-footer-inner">

      <!-- COLUMN 1: Brand details -->
      <div class="sk-footer-brand">
        {%- if section.settings.logo != blank -%}
          <a href="{{ routes.root_url }}" class="sk-footer-logo-link" aria-label="{{ shop.name }}">
            {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
            {{ section.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', class: 'sk-footer-logo', alt: logo_alt, width: 140, height: 40 }}
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="sk-footer-wordmark">
            SAKORA<sup>&reg;</sup>
          </a>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="sk-footer-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        <!-- Friendly registry information -->
        <div class="sk-footer-registry sk-inci-mono">
          <span>Formulated under dermatologist supervision</span><br>
          <span>100% Vegan &amp; Cruelty-Free</span><br>
          <span>Made with love in Pakistan</span>
        </div>

        {%- assign has_social = false -%}
        {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_url != blank or section.settings.pinterest_url != blank -%}
          {%- assign has_social = true -%}
        {%- endif -%}

        {%- if has_social -%}
          <div class="sk-footer-social" aria-label="Social media">
            {%- if section.settings.instagram_url != blank -%}
              <a href="{{ section.settings.instagram_url }}" class="sk-footer-social-btn" target="_blank" rel="noopener" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <a href="{{ section.settings.tiktok_url }}" class="sk-footer-social-btn" target="_blank" rel="noopener" aria-label="TikTok">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.youtube_url != blank -%}
              <a href="{{ section.settings.youtube_url }}" class="sk-footer-social-btn" target="_blank" rel="noopener" aria-label="YouTube">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.95 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.95 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.95-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.pinterest_url != blank -%}
              <a href="{{ section.settings.pinterest_url }}" class="sk-footer-social-btn" target="_blank" rel="noopener" aria-label="Pinterest">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 8a4 4 0 0 0-4 4"></path></svg>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <!-- NAV COLUMNS -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'nav_column' -%}
          {%- assign nav_menu = linklists[block.settings.menu] -%}
          <nav class="sk-footer-col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
            <h3 class="sk-footer-col-title sk-label-caps">{{ block.settings.title }}</h3>
            {%- if nav_menu.links.size > 0 -%}
              <ul class="sk-footer-col-list" role="list">
                {%- for link in nav_menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="sk-footer-col-link"
                      {%- if link.active %} aria-current="page"{%- endif -%}>
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <!-- BOTTOM BAR -->
    <div class="sk-footer-bottom">
      <div class="sk-footer-bottom-inner">
        <p class="sk-footer-copy sk-inci-mono">
          &copy; {{ 'now' | date: '%Y' }} SAKORA.
          {%- if section.settings.bottom_note != blank -%}
            &nbsp;{{ section.settings.bottom_note }}
          {%- endif -%}
        </p>
        
        <div class="sk-footer-compliance sk-inci-mono">
          100% INGREDIENT TRANSPARENCY // FORMULATED FOR SOUTH ASIAN SKIN
        </div>

        {%- if shop.enabled_policies.size > 0 -%}
          <ul class="sk-footer-legal" role="list">
            {%- for policy in shop.enabled_policies -%}
              <li><a href="{{ policy.url }}" class="sk-footer-legal-link sk-inci-mono">{{ policy.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

  </div>
</footer>

{% stylesheet %}
  .sk-footer {
    background-color: #F7F7F2; /* Warm Cream background */
    color: var(--charcoal);
    padding-top: 80px;
    border-top: 1px solid var(--light-border);
  }

  /* ── Main grid ─────────────────────────────── */
  .sk-footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    align-items: start;
    padding-bottom: 60px;
  }

  /* ── Brand column ──────────────────────────── */
  .sk-footer-logo-link {
    display: inline-block;
    margin-bottom: 20px;
  }
  .sk-footer-logo {
    display: block;
    max-height: 40px;
    width: auto;
    filter: none; /* Charcoal / Natural rendering */
  }

  .sk-footer-wordmark {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 700;
    color: var(--charcoal);
    text-decoration: none;
    margin-bottom: 20px;
    letter-spacing: -0.01em;
  }

  .sk-footer-wordmark sup {
    font-size: 10px;
    top: -1em;
    color: var(--fade-accent);
  }

  .sk-footer-tagline {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.6;
    color: var(--subtext-gray);
    margin-bottom: 24px;
    max-width: 320px;
  }

  .sk-footer-registry {
    color: var(--subtext-gray);
    font-size: 11px !important;
    line-height: 1.8 !important;
    margin-bottom: 28px;
    border-left: 2px solid var(--fade-accent);
    padding-left: 12px;
  }

  /* Social buttons (Soft circular elements) */
  .sk-footer-social {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .sk-footer-social-btn {
    width: 38px;
    height: 38px;
    border-radius: 50% !important; /* Soft circular buttons */
    background: var(--pure-white);
    border: 1px solid var(--ui-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--charcoal);
    text-decoration: none;
    transition: all 0.25s ease;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
  }
  .sk-footer-social-btn:hover {
    background: var(--fade-bg);
    border-color: var(--fade-accent);
    color: var(--fade-accent);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(255, 92, 138, 0.15);
  }

  /* ── Nav columns ───────────────────────────── */
  .sk-footer-col-title {
    color: var(--charcoal);
    margin-bottom: 24px;
    font-size: 11px;
    font-weight: 600;
  }

  .sk-footer-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sk-footer-col-list li { margin-bottom: 12px; }

  .sk-footer-col-link {
    font-size: 13px !important;
    color: var(--subtext-gray) !important;
    text-decoration: none;
    transition: color 0.2s;
    font-weight: 500;
  }
  .sk-footer-col-link:hover { color: var(--fade-accent) !important; }

  /* ── Bottom bar ────────────────────────────── */
  .sk-footer-bottom {
    border-top: 1px solid var(--light-border);
  }

  .sk-footer-bottom-inner {
    padding: 36px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .sk-footer-copy {
    font-size: 12px !important;
    color: var(--subtext-gray);
  }

  .sk-footer-compliance {
    font-size: 11px !important;
    color: var(--reset-accent);
    font-weight: 600;
  }

  .sk-footer-legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .sk-footer-legal-link {
    font-size: 12px !important;
    color: var(--subtext-gray) !important;
    text-decoration: none;
    transition: color 0.2s;
  }
  .sk-footer-legal-link:hover { color: var(--charcoal) !important; }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 1024px) {
    .sk-footer-inner {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 48px;
    }
    .sk-footer-brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1.5fr 1fr;
      align-items: start;
      column-gap: 40px;
    }
    .sk-footer-tagline { max-width: none; }
    .sk-footer-social { grid-column: 2; grid-row: 1 / 3; align-self: start; justify-content: flex-end; }
  }

  @media (max-width: 768px) {
    .sk-footer-inner {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-bottom: 56px;
    }
    .sk-footer-brand {
      grid-column: auto;
      display: block;
    }
    .sk-footer-social { justify-content: flex-start; }
    .sk-footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .sk-footer-legal { gap: 16px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sakora Footer",
  "tag": "footer",
  "class": "sakora-footer-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Technical version recommended. If blank, SAKORA text wordmark is displayed."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Ingredient maximum. Formulated under strict dermatologist supervision for South Asian skin barriers."
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Copyright Suffix",
      "default": "Formulated for South Asian skin.",
      "info": "Appears after copyright text"
    },
    {
      "type": "header",
      "content": "Social Registry Links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Link"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok Link"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube Link"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest Link"
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Navigation Menu",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Menu Heading",
          "default": "REGIMENS"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Shopify Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sakora Footer",
      "blocks": [
        { "type": "nav_column", "settings": { "title": "Protocol" } },
        { "type": "nav_column", "settings": { "title": "Transparency" } },
        { "type": "nav_column", "settings": { "title": "Help/Support" } }
      ]
    }
  ]
}
{% endschema %}
