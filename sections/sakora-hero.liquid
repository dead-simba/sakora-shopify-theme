{%- style -%}
  .sakora-hero {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 90vh;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero {
      grid-template-columns: 55% 45%;
    }
  }
  .sakora-hero--full_width {
    grid-template-columns: 1fr !important;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero--full_width {
      grid-template-columns: 1fr !important;
    }
  }
  .sakora-hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 4rem 2rem;
    animation: fadeUp 0.8s ease both;
    background-color: var(--sakora-cream);
    overflow: hidden;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero__content {
      padding: 5rem 4rem 5rem 3rem;
    }
  }
  .sakora-hero--full_width .sakora-hero__content {
    justify-content: flex-end;
    align-items: center;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero--full_width .sakora-hero__content {
      align-items: flex-start;
      padding: 6rem;
    }
    .sakora-hero--full_width .sakora-hero__card {
      margin: 0;
    }
  }
  .sakora-hero__card {
    width: 100%;
    z-index: 3;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .sakora-hero__content--has-bg {
    padding: 2.5rem 1.5rem;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero__content--has-bg {
      padding: 5rem 4rem;
    }
  }
  .sakora-hero__content--has-bg .sakora-hero__card {
    background-color: rgba(250, 250, 245, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 3.5rem 2.5rem;
    border-radius: 24px;
    border: 1px solid rgba(28, 28, 26, 0.08);
    box-shadow: 0 15px 45px rgba(28, 28, 26, 0.04);
    max-width: 560px;
    margin: 0 auto;
  }
  @media screen and (min-width: 990px) {
    .sakora-hero__content--has-bg .sakora-hero__card {
      padding: 5rem 4.5rem;
      margin: 0;
    }
  }
  .sakora-hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    z-index: 1;
    pointer-events: none;
  }
  .sakora-hero__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(250, 250, 245, calc(0.92 + 0.08 * var(--overlay-op))) 0%,
      rgba(250, 250, 245, calc(0.85 + 0.13 * var(--overlay-op))) 40%,
      rgba(250, 250, 245, calc(0.50 + 0.40 * var(--overlay-op))) 70%,
      rgba(250, 250, 245, calc(0.15 + 0.65 * var(--overlay-op))) 100%
    );
    backdrop-filter: blur(calc(6px + 8px * var(--overlay-op)));
    -webkit-backdrop-filter: blur(calc(6px + 8px * var(--overlay-op)));
    z-index: 2;
    pointer-events: none;
  }
  .sakora-hero--full_width .sakora-hero__bg-overlay {
    background: linear-gradient(
      0deg,
      rgba(250, 250, 245, calc(0.90 + 0.10 * var(--overlay-op))) 0%,
      rgba(250, 250, 245, calc(0.70 + 0.25 * var(--overlay-op))) 30%,
      rgba(250, 250, 245, calc(0.20 + 0.40 * var(--overlay-op))) 60%,
      rgba(250, 250, 245, 0) 100%
    );
    backdrop-filter: blur(calc(3px + 4px * var(--overlay-op)));
    -webkit-backdrop-filter: blur(calc(3px + 4px * var(--overlay-op)));
  }
  /* Ensure hero content overlays on top of background visual */
  .sakora-hero__eyebrow,
  .sakora-hero__title,
  .sakora-hero__text,
  .sakora-hero__buttons,
  .sakora-hero__stats {
    position: relative;
    z-index: 3;
  }
  .sakora-hero__eyebrow {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sakora-dust);
    margin: 0 0 1.5rem;
  }
  .sakora-hero__title {
    font-size: clamp(3.5rem, 5vw, 6.5rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0 0 1.6rem;
    color: var(--sakora-charcoal);
    letter-spacing: -0.01em;
  }
  .sakora-hero__title em {
    font-style: italic;
    color: var(--sakora-emerald);
  }
  .sakora-hero__text {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    line-height: 1.75;
    color: var(--sakora-charcoal);
    max-width: 380px;
    margin: 0 0 2.5rem;
  }
  .sakora-hero__buttons {
    display: flex;
    gap: 1.2rem;
    flex-wrap: wrap;
  }
  .sakora-hero__btn {
    text-transform: uppercase;
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    padding: 1.4rem 2.8rem;
    cursor: pointer;
    border-radius: 50px !important;
    transition: opacity 0.2s, background-color 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }
  .sakora-hero__btn--primary {
    background-color: var(--sakora-charcoal);
    color: var(--sakora-cream);
    border: none;
  }
  .sakora-hero__btn--primary:hover {
    opacity: 0.85;
  }
  .sakora-hero__btn--secondary {
    background-color: transparent;
    color: var(--sakora-charcoal);
    border: 0.5px solid var(--sakora-charcoal);
  }
  .sakora-hero__btn--secondary:hover {
    background-color: var(--sakora-charcoal);
    color: var(--sakora-cream);
  }
  .sakora-hero__stats {
    display: flex;
    gap: 3rem;
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 0.5px solid #E0DCD4;
  }
  .sakora-hero__stat-val {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-style: italic;
    color: var(--sakora-charcoal);
    line-height: 1;
  }
  .sakora-hero__stat-label {
    font-family: var(--font-body-family);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sakora-dust);
    margin-top: 0.4rem;
  }
  .sakora-hero__strips {
    display: flex;
    flex-direction: column;
    min-height: 45vh;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero__strips {
      height: auto;
      min-height: 90vh;
    }
  }
  .sakora-hero__strip {
    flex: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 2.5rem 2.2rem;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    text-decoration: none;
  }
  @media screen and (min-width: 750px) {
    .sakora-hero__strip:hover {
      transform: translateX(10px);
    }
  }
  .sakora-hero__strip-name {
    font-family: var(--font-heading-family);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.1;
  }
  .sakora-hero__strip-type {
    font-family: var(--font-body-family);
    font-size: 1rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
    margin-top: 0.4rem;
  }
  .sakora-hero__strip-meta {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    opacity: 0.6;
    align-self: flex-end;
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{%- endstyle -%}

<section class="sakora-hero sakora-hero--{{ section.settings.layout_style | default: 'split' }}">
  <div class="sakora-hero__content{% if section.settings.hero_image != blank %} sakora-hero__content--has-bg{% endif %}">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 1500 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        preload: true,
        class: 'sakora-hero__bg-img',
        widths: '375, 550, 750, 1100, 1500',
        alt: section.settings.hero_image.alt | default: 'American Pakistani model displaying glowing dewy skin'
      }}
      <div class="sakora-hero__bg-overlay" style="--overlay-op: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
    {%- endif -%}
    <div class="sakora-hero__card">
      <p class="sakora-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="sakora-hero__title">
        {{ section.settings.title }}
      </h1>
      <p class="sakora-hero__text">
        {{ section.settings.text }}
      </p>
      <div class="sakora-hero__buttons">
        {%- if section.settings.primary_button_label != blank -%}
          <a href="{{ section.settings.primary_button_link }}" class="sakora-hero__btn sakora-hero__btn--primary">
            {{ section.settings.primary_button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="sakora-hero__btn sakora-hero__btn--secondary">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>
      <div class="sakora-hero__stats">
        {%- if section.settings.stat1_val != blank -%}
          <div>
            <div class="sakora-hero__stat-val">{{ section.settings.stat1_val }}</div>
            <div class="sakora-hero__stat-label">{{ section.settings.stat1_label }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.stat2_val != blank -%}
          <div>
            <div class="sakora-hero__stat-val">{{ section.settings.stat2_val }}</div>
            <div class="sakora-hero__stat-label">{{ section.settings.stat2_label }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.stat3_val != blank -%}
          <div>
            <div class="sakora-hero__stat-val">{{ section.settings.stat3_val }}</div>
            <div class="sakora-hero__stat-label">{{ section.settings.stat3_label }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.layout_style == 'split' or section.settings.layout_style == blank -%}
    <div class="sakora-hero__strips">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product_strip' -%}
            {%- liquid
              assign product = block.settings.product
              assign title = block.settings.title | default: product.title
              assign subtitle = block.settings.subtitle
              assign bg_color = block.settings.bg_color
              assign text_color = block.settings.text_color
              assign size = block.settings.size
              assign price = block.settings.price | default: product.price | money_without_trailing_zeros
              assign url = block.settings.link | default: product.url
            -%}
            <a href="{{ url }}" class="sakora-hero__strip" style="background-color: {{ bg_color }}; color: {{ text_color }};">
              <div>
                <div class="sakora-hero__strip-name" style="color: {{ text_color }};">{{ title }}</div>
                <div class="sakora-hero__strip-type" style="color: {{ text_color }};">{{ subtitle }}</div>
              </div>
              <div class="sakora-hero__strip-meta" style="color: {{ text_color }};">
                {%- if size != blank -%}{{ size }} · {% endif %}{{ price }}
              </div>
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sakora Hero",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout Style",
      "options": [
        {
          "value": "split",
          "label": "Split Hero (Image + 3 Product Strips)"
        },
        {
          "value": "full_width",
          "label": "Full Width Hero (Full Image with Floating Card)"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Background Image",
      "info": "Upload an editorial image (e.g. American-Pakistani beauty model) to override the solid cream canvas."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Dewy Gradient Overlay Opacity",
      "info": "Adjust the warm dewy mask opacity to ensure maximum typography readability over custom graphics.",
      "default": 60
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Skin rituals, reimagined"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Nature's <em>best kept</em> secrets."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body Text",
      "default": "Three products. Each one obsessed with one thing: making your skin feel exactly like it's supposed to."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary Button Label",
      "default": "Shop the Collection"
    },
