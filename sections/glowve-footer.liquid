<footer class="gv-footer" aria-label="Site footer">

  <div class="gv-footer-inner">

    {%- comment -%} Brand column {%- endcomment -%}
    <div class="gv-footer-brand">

      {%- if section.settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="gv-footer-logo-link" aria-label="{{ shop.name }}">
          {%- assign logo_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{ section.settings.logo | image_url: width: 280 | image_tag: loading: 'lazy', class: 'gv-footer-logo', alt: logo_alt, width: 140, height: 40 }}
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="gv-footer-wordmark">
          {{ shop.name | split: '' | first }}{{ shop.name | slice: 1, 100 }}
        </a>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="gv-footer-tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- assign has_social = false -%}
      {%- if section.settings.instagram_url != blank or section.settings.tiktok_url != blank or section.settings.youtube_url != blank or section.settings.pinterest_url != blank -%}
        {%- assign has_social = true -%}
      {%- endif -%}

      {%- if has_social -%}
        <div class="gv-footer-social" aria-label="Social media">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="gv-footer-social-btn" target="_blank" rel="noopener" aria-label="Instagram">
              {% render 'gv-icon', icon: 'instagram', size: 18 %}
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="gv-footer-social-btn" target="_blank" rel="noopener" aria-label="TikTok">
              {% render 'gv-icon', icon: 'tiktok', size: 18 %}
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" class="gv-footer-social-btn" target="_blank" rel="noopener" aria-label="YouTube">
              {% render 'gv-icon', icon: 'youtube', size: 18 %}
            </a>
          {%- endif -%}
          {%- if section.settings.pinterest_url != blank -%}
            <a href="{{ section.settings.pinterest_url }}" class="gv-footer-social-btn" target="_blank" rel="noopener" aria-label="Pinterest">
              {% render 'gv-icon', icon: 'pinterest', size: 18 %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

    {%- comment -%} Nav columns from Shopify menus {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_column' -%}
        {%- assign nav_menu = linklists[block.settings.menu] -%}
        <nav class="gv-footer-col" aria-label="{{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          <h3 class="gv-footer-col-title">{{ block.settings.title }}</h3>
          {%- if nav_menu.links.size > 0 -%}
            <ul class="gv-footer-col-list" role="list">
              {%- for link in nav_menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="gv-footer-col-link"
                    {%- if link.active %} aria-current="page"{%- endif -%}>
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endfor -%}

  </div>

  {%- comment -%} Bottom bar {%- endcomment -%}
  <div class="gv-footer-bottom">
    <div class="gv-footer-bottom-inner">
      <p class="gv-footer-copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}.
        {%- if section.settings.bottom_note != blank -%}
          &nbsp;{{ section.settings.bottom_note }}
        {%- endif -%}
      </p>
      {%- if shop.enabled_policies.size > 0 -%}
        <ul class="gv-footer-legal" role="list">
          {%- for policy in shop.enabled_policies -%}
            <li><a href="{{ policy.url }}" class="gv-footer-legal-link">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

</footer>

{% stylesheet %}
  .gv-footer {
    background: var(--berry-dark);
    padding-top: 80px;
  }

  /* ── Main grid ─────────────────────────────── */
  .gv-footer-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px 72px;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px;
    align-items: start;
  }

  /* ── Brand column ──────────────────────────── */
  .gv-footer-logo-link {
    display: inline-block;
    margin-bottom: 20px;
  }
  .gv-footer-logo {
    display: block;
    max-height: 40px;
    width: auto;
  }

  .gv-footer-wordmark {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 300;
    color: #fff;
    text-decoration: none;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .gv-footer-tagline {
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255,255,255,0.5);
    margin-bottom: 28px;
    max-width: 280px;
  }

  /* Social buttons */
  .gv-footer-social {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .gv-footer-social-btn {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
  }
  .gv-footer-social-btn:hover {
    background: var(--coral-pulse);
    color: #fff;
  }

  /* ── Nav columns ───────────────────────────── */
  .gv-footer-col-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 20px;
  }

  .gv-footer-col-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .gv-footer-col-list li { margin-bottom: 12px; }

  .gv-footer-col-link {
    font-family: var(--font-sans);
    font-size: 14px;
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: color 0.2s;
  }
  .gv-footer-col-link:hover { color: #fff; }

  /* ── Bottom bar ────────────────────────────── */
  .gv-footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .gv-footer-bottom-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 28px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .gv-footer-copy {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(255,255,255,0.3);
  }

  .gv-footer-legal {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .gv-footer-legal-link {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(255,255,255,0.3);
    text-decoration: none;
    transition: color 0.2s;
  }
  .gv-footer-legal-link:hover { color: rgba(255,255,255,0.7); }

  /* ── Responsive ────────────────────────────── */
  @media (max-width: 1024px) {
    .gv-footer-inner {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 48px;
    }
    .gv-footer-brand {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: start;
      column-gap: 40px;
    }
    .gv-footer-tagline { max-width: none; }
    .gv-footer-social { grid-column: 2; grid-row: 1 / 3; align-self: start; justify-content: flex-end; }
  }

  @media (max-width: 768px) {
    .gv-footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
      padding: 0 20px 56px;
    }
    .gv-footer-brand {
      grid-column: 1 / -1;
      display: block;
    }
    .gv-footer-social { justify-content: flex-start; }
    .gv-footer-bottom-inner {
      padding: 24px 20px;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .gv-footer-legal { gap: 16px; }
  }

  @media (max-width: 480px) {
    .gv-footer { padding-top: 56px; }
    .gv-footer-inner { grid-template-columns: 1fr 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Footer",
  "tag": "footer",
  "class": "glowve-footer-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Use a white version. Recommended max height 40px. If blank, shop name is used."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Glow your way. Ingredient-first skincare for Pakistan."
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Copyright suffix",
      "default": "Made for Pakistan.",
      "info": "Shown after shop name, e.g. 'Made for Pakistan.'"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "paragraph",
      "content": "Social icons appear only when a URL is entered. Add your links here and they'll show automatically."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest"
    }
  ],
  "blocks": [
    {
      "type": "nav_column",
      "name": "Nav Column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation menu",
          "default": "footer",
          "info": "Create and manage menus in Online Store → Navigation."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve Footer",
      "blocks": [
        { "type": "nav_column", "settings": { "title": "Shop", "menu": "footer" } },
        { "type": "nav_column", "settings": { "title": "Learn", "menu": "footer" } },
        { "type": "nav_column", "settings": { "title": "Help", "menu": "footer" } }
      ]
    }
  ]
}
{% endschema %}
