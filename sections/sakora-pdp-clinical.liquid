{%- liquid
  assign handle = product.handle | downcase
  assign accent_color = '#1D9E75'
  assign text_color = '#0D3828'
  if handle contains 'petal' or handle contains 'moisturizer' or handle contains 'reset'
    assign accent_color = '#E8A0A0'
    assign text_color = '#5C2020'
  elsif handle contains 'veil' or handle contains 'sunscreen' or handle contains 'daylite' or handle contains 'sol'
    assign accent_color = '#E8B84B'
    assign text_color = '#4A2E00'
  elsif handle contains 'drops' or handle contains 'serum' or handle contains 'fade' or handle contains 'dawn'
    assign accent_color = '#1D9E75'
    assign text_color = '#0D3828'
  endif
-%}

<section class="sakora-clinical-section" style="--product-accent: {{ accent_color }}; --product-accent-text: {{ text_color }};">
  <div class="sakora-clinical-container">
    <div class="sakora-clinical-label">{{ section.settings.label }}</div>
    <h2 class="sakora-clinical-title">{{ section.settings.title }}</h2>
    <p class="sakora-clinical-sub">{{ section.settings.subtitle }}</p>
    
    <div class="sakora-clinical-grid">
      {% for block in section.blocks %}
        <div class="sakora-clinical-card" {{ block.shopify_attributes }}>
          <div class="sakora-clinical-img" style="background:{{ block.settings.bg_gradient }};">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {% else %}
              <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#B0A898;">Image</div>
            {% endif %}
          </div>
          <div class="sakora-clinical-info">
            <div class="sakora-clinical-name">{{ block.settings.title }}</div>
            <div class="sakora-clinical-detail">{{ block.settings.detail }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
    
    {% if section.settings.note != blank %}
      <div class="sakora-clinical-note">
        {{ section.settings.note }}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .sakora-clinical-section {
    background: #F3EFE8; /* Stone */
    padding: 80px 0;
    border-top: 1px solid #E8E2D5;
    border-bottom: 1px solid #E8E2D5;
  }
  .sakora-clinical-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .sakora-clinical-label {
    font-family: var(--font-body-family), sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--product-accent-text, #1D9E75);
    margin-bottom: 12px;
  }
  
  .sakora-clinical-title {
    font-family: var(--font-heading-family), 'Playfair Display', serif;
    font-size: 40px;
    font-weight: 400;
    color: #1C1C1A; /* Charcoal */
    line-height: 1.2;
    margin: 0 0 12px;
  }
  
  .sakora-clinical-sub {
    font-family: var(--font-body-family), sans-serif;
    font-size: 15px;
    color: #B0A898; /* Dust */
    line-height: 1.65;
    max-width: 680px;
    margin: 0;
  }
  
  .sakora-clinical-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  
  .sakora-clinical-card {
    background: #FFFFFF;
    border-radius: 24px; /* Organic curves */
    overflow: hidden;
    box-shadow: 0 4px 12px rgba(28,28,26,0.02);
    border: 1px solid #E8E2D5;
    display: flex;
    flex-direction: column;
  }
  
  .sakora-clinical-img {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  
  .sakora-clinical-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .sakora-clinical-info {
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex-grow: 1;
  }
  
  .sakora-clinical-name {
    font-family: var(--font-heading-family), serif;
    font-size: 16px;
    font-weight: 400;
    color: #1C1C1A; /* Charcoal */
  }
  
  .sakora-clinical-detail {
    font-family: var(--font-body-family), sans-serif;
    font-size: 13px;
    color: #B0A898; /* Dust */
    line-height: 1.5;
  }
  
  .sakora-clinical-note {
    font-family: var(--font-body-family), sans-serif;
    font-size: 13px;
    color: #B0A898; /* Dust */
    margin-top: 32px;
    line-height: 1.6;
    background: #FAFAF5; /* Cream */
    padding: 16px 24px;
    border-radius: 24px; /* Organic curves */
    border: 1px solid #E8E2D5;
  }
  
  @media(max-width: 900px) {
    .sakora-clinical-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Clinical Evidence",
  "settings": [
    {
      "type": "text", "id": "label", "label": "Label", "default": "Clinical evidence"
    },
    {
      "type": "text", "id": "title", "label": "Title", "default": "This formula's results speak for themselves."
    },
    {
      "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Ceramide NP/AP/EOP and Matrixyl 3000™ are among the most clinically documented barrier and anti-aging ingredients."
    },
    {
      "type": "html", "id": "note", "label": "Note (HTML)", "default": "⚗️ Images from clinical studies on the active ingredients in this formula at identical concentrations. Individual results vary. Patch test recommended for sensitive skin."
    }
  ],
  "blocks": [
    {
      "type": "clinical_card",
      "name": "Clinical Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "bg_gradient", "label": "Background Gradient", "default": "linear-gradient(135deg,#EDE0F5,#D8C8EC)" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "detail", "label": "Detail text" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Clinical Evidence" }
  ]
}
{% endschema %}
