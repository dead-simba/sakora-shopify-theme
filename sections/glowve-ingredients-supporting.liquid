<section class="gv-ing-supporting-section">
  <div class="gv-container">
    <!-- STACKED header — matches mockup -->
    <div class="gv-ing-section-label">{{ section.settings.label }}</div>
    <h2 class="gv-ing-section-title">{{ section.settings.title }}</h2>
    <p class="gv-ing-section-sub">{{ section.settings.text }}</p>

    <div class="gv-ing-support-grid">
      {%- for block in section.blocks -%}
        <div class="gv-ing-support-card js-ing-card" 
             data-name="{{ block.settings.name | escape }}"
             data-inci="{{ block.settings.inci | escape }}"
             data-desc="{{ block.settings.desc | escape }}"
             data-why="{{ block.settings.why | escape }}"
             data-whylabel="{{ block.settings.why_label | escape }}"
             data-badge="{{ block.settings.badge | escape }}"
             data-icon="{{ block.settings.icon | escape }}"
             data-color="{{ block.settings.gradient }}"
             {{ block.shopify_attributes }}>
          
          <div class="gv-ing-support-img" style="background: {{ block.settings.gradient }};">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
            {%- else -%}
              <span class="gv-ing-emoji">{{ block.settings.icon }}</span>
            {%- endif -%}
          </div>
          
          <div class="gv-ing-support-body">
            <h3 class="gv-ing-support-name">{{ block.settings.name }}</h3>
            <p class="gv-ing-support-fn">{{ block.settings.short_fn }}</p>
            
            <div class="gv-ing-support-products" onclick="event.stopPropagation();">
              {%- if block.settings.prod_1 != blank -%}
                {%- assign p1 = block.settings.prod_1 -%}
                <a href="{{ p1.url }}" class="gv-ing-spl gv-ing-spl--pink" data-prod-name="{{ p1.title | escape }}" data-prod-type="{{ p1.type | default: 'Skincare' | escape }}" data-prod-url="{{ p1.url }}">{{ p1.title }}</a>
              {%- endif -%}
              {%- if block.settings.prod_2 != blank -%}
                {%- assign p2 = block.settings.prod_2 -%}
                <a href="{{ p2.url }}" class="gv-ing-spl gv-ing-spl--mint" data-prod-name="{{ p2.title | escape }}" data-prod-type="{{ p2.type | default: 'Skincare' | escape }}" data-prod-url="{{ p2.url }}">{{ p2.title }}</a>
              {%- endif -%}
              {%- if block.settings.prod_3 != blank -%}
                {%- assign p3 = block.settings.prod_3 -%}
                <a href="{{ p3.url }}" class="gv-ing-spl gv-ing-spl--gold" data-prod-name="{{ p3.title | escape }}" data-prod-type="{{ p3.type | default: 'Skincare' | escape }}" data-prod-url="{{ p3.url }}">{{ p3.title }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <!-- MODAL -->
  <div class="gv-ing-modal-overlay" id="IngModalOverlay">
    <div class="gv-ing-modal" id="IngModal">
      <div class="gv-ing-modal-img" id="ModalImg">
        <button class="gv-ing-modal-close" id="IngModalClose">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
        <span class="gv-ing-modal-emoji" id="ModalEmoji"></span>
      </div>
      
      <div class="gv-ing-modal-body">
        <div class="gv-ing-modal-badge" id="ModalBadge"></div>
        <h2 class="gv-ing-modal-name" id="ModalName"></h2>
        <div class="gv-ing-modal-inci" id="ModalInci"></div>
        <div class="gv-ing-modal-divider"></div>
        <p class="gv-ing-modal-desc" id="ModalDesc"></p>
        <div class="gv-ing-modal-why-label" id="ModalWhyLabel"></div>
        <div class="gv-ing-modal-why" id="ModalWhy"></div>
        <div class="gv-ing-modal-found-label">Found in</div>
        <div class="gv-ing-modal-products" id="ModalProducts"></div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-supporting-section { padding: 96px 40px; background: #FAFAFA; }
  .gv-ing-supporting-section .gv-container { max-width: 1200px; margin: 0 auto; }

  /* STACKED HEADER — matching mockup */
  .gv-ing-section-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;
    color: #FF4D8D; margin-bottom: 12px;
    display: flex; align-items: center; gap: 10px;
  }
  .gv-ing-section-label::before { content: ''; display: block; width: 28px; height: 1px; background: #FF4D8D; }
  .gv-ing-section-title {
    font-size: 48px; font-weight: 700; color: #1A1A1A; line-height: 1.1;
    letter-spacing: -0.02em; margin-bottom: 12px;
  }
  .gv-ing-section-title em { font-style: normal; color: #FF4D8D; }
  .gv-ing-section-sub { font-size: 16px; color: #666; line-height: 1.7; margin-bottom: 56px; max-width: 580px; }

  .gv-ing-support-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

  .gv-ing-support-card {
    background: white; border-radius: 20px; border: 1px solid #ECECEC;
    overflow: hidden; cursor: pointer; transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s;
    display: flex; flex-direction: column;
  }
  .gv-ing-support-card:hover { transform: translateY(-6px); box-shadow: 0 16px 48px rgba(0,0,0,0.10); }

  .gv-ing-support-img { width: 100%; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; font-size: 48px; position: relative; overflow: hidden; }
  .gv-ing-emoji { position: relative; z-index: 2; }
  .gv-ing-support-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s cubic-bezier(0.25,0.46,0.45,0.94); }
  .gv-ing-support-card:hover .gv-ing-support-img img { transform: scale(1.05); }

  .gv-ing-support-body { padding: 18px 20px 20px; display: flex; flex-direction: column; flex-grow: 1; }
  .gv-ing-support-name { font-size: 16px; font-weight: 700; color: #1A1A1A; letter-spacing: -0.01em; margin-bottom: 4px; }
  .gv-ing-support-fn { font-size: 12px; color: #666; line-height: 1.5; margin-bottom: 14px; flex-grow: 1; }

  .gv-ing-support-products { display: flex; gap: 6px; flex-wrap: wrap; }
  .gv-ing-spl { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 5px 12px; border-radius: 100px; transition: all 0.2s; display: inline-block; text-decoration: none; }
  .gv-ing-spl--pink { background: #FFF0F5; color: #FF4D8D; border: 1px solid #FFD0E4; }
  .gv-ing-spl--pink:hover { background: #FF4D8D; color: white; border-color: #FF4D8D; }
  .gv-ing-spl--mint { background: #E8F8F3; color: #1A8A72; border: 1px solid #B8E8D4; }
  .gv-ing-spl--mint:hover { background: #1A8A72; color: white; border-color: #1A8A72; }
  .gv-ing-spl--gold { background: #FFF8E8; color: #8B6914; border: 1px solid #FFE4A0; }
  .gv-ing-spl--gold:hover { background: #8B6914; color: white; border-color: #8B6914; }

  /* "Tap to learn more" on hover */
  .gv-ing-support-body::after {
    content: 'Tap to learn more →';
    display: block; margin-top: 12px;
    font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    color: #FF4D8D; opacity: 0; transition: opacity 0.2s;
  }
  .gv-ing-support-card:hover .gv-ing-support-body::after { opacity: 1; }

  /* MODAL — matches mockup exactly */
  .gv-ing-modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.55); backdrop-filter: blur(4px); z-index: 999; display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: opacity 0.3s, visibility 0.3s; padding: 20px; }
  .gv-ing-modal-overlay.is-active { opacity: 1; visibility: visible; }

  .gv-ing-modal { background: white; border-radius: 24px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; transform: translateY(20px) scale(0.97); transition: transform 0.35s cubic-bezier(0.25,0.46,0.45,0.94); position: relative; }
  .gv-ing-modal-overlay.is-active .gv-ing-modal { transform: translateY(0) scale(1); }

  .gv-ing-modal-img { width: 100%; aspect-ratio: 16/7; display: flex; align-items: center; justify-content: center; border-radius: 24px 24px 0 0; position: relative; overflow: hidden; }
  .gv-ing-modal-emoji { font-size: 56px; position: relative; z-index: 1; }
  .gv-ing-modal-close { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.25); backdrop-filter: blur(4px); border: none; cursor: pointer; color: white; display: flex; align-items: center; justify-content: center; transition: background 0.2s; z-index: 2; }
  .gv-ing-modal-close:hover { background: rgba(0,0,0,0.45); }
  .gv-ing-modal-close svg { width: 16px; height: 16px; }

  .gv-ing-modal-body { padding: 28px; }
  .gv-ing-modal-badge { display: inline-block; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; padding: 4px 12px; border-radius: 100px; background: #FFF0F5; color: #FF4D8D; margin-bottom: 12px; }
  .gv-ing-modal-name { font-size: 26px; font-weight: 700; color: #1A1A1A; letter-spacing: -0.01em; margin-bottom: 4px; }
  .gv-ing-modal-inci { font-size: 11px; color: #666; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 16px; }
  .gv-ing-modal-divider { height: 1px; background: #ECECEC; margin-bottom: 16px; }
  .gv-ing-modal-desc { font-size: 14px; color: #666; line-height: 1.8; margin-bottom: 20px; }
  .gv-ing-modal-why-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #FF4D8D; margin-bottom: 6px; }
  .gv-ing-modal-why { background: #F8F8F8; border-left: 3px solid #FF4D8D; border-radius: 0 10px 10px 0; padding: 12px 14px; font-size: 13px; color: #1A1A1A; line-height: 1.65; margin-bottom: 24px; }
  .gv-ing-modal-found-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #BBB; margin-bottom: 10px; }
  .gv-ing-modal-products { display: flex; flex-direction: column; gap: 8px; }

  /* product cards inside modal */
  .gv-ing-modal-products .gv-modal-prod {
    display: flex; align-items: center; gap: 12px;
    background: #F8F8F8; border-radius: 14px; padding: 10px 14px 10px 10px;
    border: 1px solid #ECECEC; transition: border-color 0.2s, transform 0.2s;
    text-decoration: none; color: inherit;
  }
  .gv-ing-modal-products .gv-modal-prod:hover { border-color: #FF4D8D; box-shadow: 0 4px 16px rgba(255,77,141,0.12); transform: translateY(-2px); }
  .gv-modal-prod-img { width: 48px; height: 48px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 22px; overflow: hidden; }
  .gv-modal-prod-name { font-size: 13px; font-weight: 700; color: #1A1A1A; line-height: 1.2; }
  .gv-modal-prod-type { font-size: 11px; color: #666; margin-top: 2px; }
  .gv-modal-prod-arrow { margin-left: auto; color: #FF4D8D; opacity: 0; transform: translateX(-4px); transition: opacity 0.2s, transform 0.2s; }
  .gv-modal-prod-arrow svg { width: 14px; height: 14px; }
  .gv-modal-prod:hover .gv-modal-prod-arrow { opacity: 1; transform: translateX(0); }

  @media (max-width: 900px) {
    .gv-ing-support-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .gv-ing-supporting-section { padding: 64px 20px; }
    .gv-ing-support-grid { grid-template-columns: 1fr; }
    .gv-ing-section-title { font-size: 32px; }
  }
{% endstylesheet %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('.js-ing-card');
    const overlay = document.getElementById('IngModalOverlay');
    const closeBtn = document.getElementById('IngModalClose');

    cards.forEach(card => {
      card.addEventListener('click', () => {
        const d = card.dataset;
        document.getElementById('ModalName').innerText = d.name;
        document.getElementById('ModalInci').innerText = d.inci;
        document.getElementById('ModalDesc').innerText = d.desc;
        document.getElementById('ModalWhy').innerText = d.why;
        document.getElementById('ModalWhyLabel').innerText = d.whylabel || 'Why we use it';
        document.getElementById('ModalBadge').innerText = d.badge || 'Active';
        document.getElementById('ModalEmoji').innerText = d.icon;
        document.getElementById('ModalImg').style.background = d.color;

        /* Build product links from the card's product bubbles */
        const prodContainer = document.getElementById('ModalProducts');
        prodContainer.innerHTML = '';
        const bubbles = card.querySelectorAll('.gv-ing-spl');
        const gradients = [
          'linear-gradient(135deg, #FFF0E6, #FF8C5A)',
          'linear-gradient(135deg, #E2F5EE, #2ABFA3)',
          'linear-gradient(135deg, #FFF8D6, #F5A623)'
        ];
        bubbles.forEach((b, i) => {
          const url = b.getAttribute('data-prod-url') || b.getAttribute('href') || '#';
          const name = b.getAttribute('data-prod-name') || b.innerText;
          const type = b.getAttribute('data-prod-type') || 'Glowvé Product';
          const a = document.createElement('a');
          a.className = 'gv-modal-prod';
          a.href = url;
          a.innerHTML = `
            <div class="gv-modal-prod-img" style="background:${gradients[i] || gradients[0]}">🧴</div>
            <div>
              <div class="gv-modal-prod-name">${name}</div>
              <div class="gv-modal-prod-type">${type}</div>
            </div>
            <div class="gv-modal-prod-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></div>`;
          prodContainer.appendChild(a);
        });

        overlay.classList.add('is-active');
        document.body.style.overflow = 'hidden';
      });
    });

    const closeModal = () => {
      overlay.classList.remove('is-active');
      document.body.style.overflow = '';
    };
    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  });
</script>

{% schema %}
{
  "name": "Supporting Cast",
  "settings": [
    { "type": "text", "id": "label", "label": "Section Label", "default": "Supporting Cast" },
    { "type": "html", "id": "title", "label": "Title", "default": "Every ingredient<br>pulls its <em>weight.</em>" },
    { "type": "textarea", "id": "text", "label": "Description", "default": "No fillers, no padding. Every ingredient in our formulas has a functional reason to be there." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Niacinamide" },
        { "type": "text", "id": "icon", "label": "Icon (Emoji)", "default": "💊" },
        { "type": "text", "id": "badge", "label": "Badge (Modal)", "default": "Multi-tasker" },
        { "type": "text", "id": "gradient", "label": "Gradient BG", "default": "linear-gradient(135deg, #FFF0F5, #FF85B0)" },
        { "type": "image_picker", "id": "image", "label": "Override Image (Macro)" },
        { "type": "text", "id": "inci", "label": "INCI Name", "default": "Niacinamide (Vitamin B3)" },
        { "type": "text", "id": "short_fn", "label": "Card Summary", "default": "Minimises pores and strengthens the skin barrier." },
        { "type": "textarea", "id": "desc", "label": "Modal Full Description" },
        { "type": "text", "id": "why_label", "label": "Why Label", "default": "Why we use it" },
        { "type": "textarea", "id": "why", "label": "Modal Why Text" },
        { "type": "product", "id": "prod_1", "label": "Product 1 (Pink Bubble)" },
        { "type": "product", "id": "prod_2", "label": "Product 2 (Mint Bubble)" },
        { "type": "product", "id": "prod_3", "label": "Product 3 (Gold Bubble)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Supporting Cast"
    }
  ]
}
{% endschema %}
