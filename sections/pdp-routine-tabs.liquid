<section class="how-to-use">
  <div class="container">
    <div class="section-label">{{ section.settings.label }}</div>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-sub">{{ section.settings.subtitle }}</p>

    <div class="htu-tabs">
      <button class="htu-tab active" onclick="switchRoutineTab('am')">☀️ Morning</button>
      <button class="htu-tab" onclick="switchRoutineTab('pm')">🌙 Evening</button>
    </div>

    <!-- Morning steps -->
    <div class="htu-steps active" id="htu-tab-am">
      {% assign am_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'routine_step_am' %}
          {% assign am_count = am_count | plus: 1 %}
          {% if am_count > 1 %}
            <div class="step-connector">→</div>
          {% endif %}
          <div class="step-card {% if block.settings.is_current %}current{% endif %}">
            <div class="step-icon-wrap" {% if block.settings.is_spf %}style="background:#FFF8E8;"{% endif %}>
              <span>{{ block.settings.icon }}</span>
              <span class="step-num-badge" {% if block.settings.is_spf %}style="background:var(--mango-zest);"{% endif %}>{{ am_count }}</span>
            </div>
            {% if block.settings.is_current %}
              <div class="step-current-tag">This product</div>
            {% endif %}
            <div class="step-label" {% if block.settings.is_spf %}style="color:var(--mango-zest);"{% endif %}>{{ block.settings.title }}</div>
            <div class="step-note">{{ block.settings.note }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Evening steps -->
    <div class="htu-steps" id="htu-tab-pm">
      {% assign pm_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'routine_step_pm' %}
          {% assign pm_count = pm_count | plus: 1 %}
          {% if pm_count > 1 %}
             <div class="step-connector">→</div>
          {% endif %}
          <div class="step-card {% if block.settings.is_current %}current{% endif %}">
            <div class="step-icon-wrap">
              <span>{{ block.settings.icon }}</span>
              <span class="step-num-badge">{{ pm_count }}</span>
            </div>
            {% if block.settings.is_current %}
              <div class="step-current-tag">This product</div>
            {% endif %}
            <div class="step-label">{{ block.settings.title }}</div>
            <div class="step-note">{{ block.settings.note }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.tip != blank %}
    <div class="htu-tip">
      {{ section.settings.tip }}
    </div>
    {% endif %}
  </div>
</section>

<script>
function switchRoutineTab(tab) {
  document.querySelectorAll('.htu-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.htu-steps').forEach(t => t.classList.remove('active'));
  
  event.currentTarget.classList.add('active');
  document.getElementById('htu-tab-' + tab).classList.add('active');
}
</script>

{% stylesheet %}
  .how-to-use{background:var(--cream-glow, #fff); padding: 80px 0;}
  .htu-tabs{display:flex;border:1.5px solid var(--warm-gray);border-radius:100px;overflow:hidden;width:fit-content;margin-bottom:40px;}
  .htu-tab{padding:10px 32px;font-size:14px;font-weight:500;cursor:pointer;background:none;border:none;font-family:var(--font-sans);color:var(--mid-gray);transition:all 0.2s;}
  .htu-tab.active{background:var(--berry-dark);color:white;}
  .htu-steps{display:none;}.htu-steps.active{display:flex;align-items:flex-start;gap:0;overflow-x:auto;-webkit-overflow-scrolling:touch;}
  .step-card{flex:1;min-width:130px;text-align:center;position:relative;padding:0 12px 8px;}
  .step-connector{display:flex;align-items:center;justify-content:center;padding-top:28px;color:var(--warm-gray);font-size:24px;flex-shrink:0;}
  .step-icon-wrap{width:64px;height:64px;border-radius:50%;background:var(--warm-gray);display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 12px;transition:all 0.2s;position:relative;}
  .step-card.current .step-icon-wrap{background:var(--accent);box-shadow:0 0 0 6px rgba(255,77,141,0.18);}
  .step-num-badge{position:absolute;top:-4px;right:-4px;width:22px;height:22px;background:var(--berry-dark);color:white;border-radius:50%;font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;}
  .step-card.current .step-num-badge{background:var(--accent);}
  .step-label{font-weight:600;font-size:13px;color:var(--berry-dark);margin-bottom:5px;}
  .step-card.current .step-label{color:var(--accent);}
  .step-note{font-size:11px;color:var(--mid-gray);line-height:1.5;}
  .step-current-tag{display:inline-block;font-family:var(--font-mono);font-size:9px;background:var(--accent);color:white;border-radius:100px;padding:2px 8px;margin-bottom:5px;text-transform:uppercase;letter-spacing:0.06em;}
  .htu-tip{background:white;border-radius:16px;padding:20px 24px;margin-top:32px;font-size:14px;color:var(--mid-gray);line-height:1.7;border:1px solid var(--warm-gray);}
  .htu-tip strong{color:var(--berry-dark);}
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Routine Tabs",
  "settings": [
    {
      "type": "text", "id": "label", "label": "Label", "default": "Your daily routine"
    },
    {
      "type": "text", "id": "title", "label": "Title", "default": "Takes 30 seconds. Works for 24 hours."
    },
    {
      "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Moisturiser goes on after serum, before SPF. It seals everything in — and adds its own actives on top."
    },
    {
      "type": "richtext", "id": "tip", "label": "Pro Tip box (optional)"
    }
  ],
  "blocks": [
    {
      "type": "routine_step_am",
      "name": "AM Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🫧" },
        { "type": "text", "id": "title", "label": "Step Title" },
        { "type": "textarea", "id": "note", "label": "Note" },
        { "type": "checkbox", "id": "is_current", "label": "Is Current Product?", "default": false },
        { "type": "checkbox", "id": "is_spf", "label": "Highlight as SPF?", "default": false }
      ]
    },
    {
      "type": "routine_step_pm",
      "name": "PM Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🫧" },
        { "type": "text", "id": "title", "label": "Step Title" },
        { "type": "textarea", "id": "note", "label": "Note" },
        { "type": "checkbox", "id": "is_current", "label": "Is Current Product?", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Routine Tabs" }
  ]
}
{% endschema %}
