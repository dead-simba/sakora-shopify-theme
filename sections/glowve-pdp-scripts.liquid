{% comment %}
  Glowve PDP — Info panel extras + social proof + shipping tracker + sticky ATC
  Renders all content in Liquid (Theme Editor editable), then JS moves it into
  the product details column in the correct visual order.
{% endcomment %}

{%- liquid
  assign ing_blocks   = section.blocks | where: 'type', 'ingredient'
  assign badge_blocks = section.blocks | where: 'type', 'trust_badge'
-%}

{%- comment -%} ── Hidden source container — JS reads and moves these nodes ── {%- endcomment -%}
<div id="gv-inject-src" aria-hidden="true">

  {%- comment -%} Social proof {%- endcomment -%}
  <div class="gv-sp" data-social-proof>
    <span class="gv-sp-watchers">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="3"/><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/></svg>
      &#x2009;<span class="gv-sp-n" data-w>11</span> viewing now
    </span>
    <span class="gv-sp-mid"> &middot; </span>
    <span>🔥&#x2009;<span class="gv-sp-n" data-b>23</span> bought today</span>
  </div>

  {%- comment -%} Urgency strip {%- endcomment -%}
  {%- if section.settings.urgency_enabled and section.settings.urgency_text != blank -%}
    <div class="gv-urgency">
      🚀 {{ section.settings.urgency_text }}
    </div>
  {%- endif -%}

  {%- comment -%} Guarantee bar {%- endcomment -%}
  <div class="gv-guarantee">
    {%- if section.settings.guarantee_1 != blank -%}
      <span>{{ section.settings.guarantee_1 }}</span>
    {%- endif -%}
    {%- if section.settings.guarantee_2 != blank -%}
      <span>{{ section.settings.guarantee_2 }}</span>
    {%- endif -%}
    {%- if section.settings.guarantee_3 != blank -%}
      <span>{{ section.settings.guarantee_3 }}</span>
    {%- endif -%}
  </div>

  {%- comment -%} Shipping tracker {%- endcomment -%}
  <div class="gv-ship" data-ship-wrap>
    <div class="gv-ship-bar"><div class="gv-ship-fill" data-ship-fill style="width:0%"></div></div>
    <p class="gv-ship-msg" data-ship-msg>Checking free delivery status…</p>
  </div>

  {%- comment -%} Payment chips {%- endcomment -%}
  <div class="gv-pays">
    <span class="gv-pay">💳 Card</span>
    <span class="gv-pay">Easypaisa</span>
    <span class="gv-pay">JazzCash</span>
    <span class="gv-pay">🏠 Cash on Delivery</span>
  </div>

  {%- comment -%} Ingredient callouts {%- endcomment -%}
  {%- if ing_blocks.size > 0 -%}
    <div class="gv-ing-callouts">
      {%- for block in ing_blocks -%}
        <div class="gv-ing-callout" {{ block.shopify_attributes }}>
          <span class="gv-ing-callout-icon">{{ block.settings.icon }}</span>
          <div class="gv-ing-callout-body">
            <div class="gv-ing-callout-name">{{ block.settings.name }}</div>
            <div class="gv-ing-callout-desc">{{ block.settings.desc }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Trust badges {%- endcomment -%}
  {%- if badge_blocks.size > 0 -%}
    <div class="gv-trust-badges">
      {%- for block in badge_blocks -%}
        <div class="gv-trust-badge" {{ block.shopify_attributes }}>
          <span class="gv-trust-badge-icon">{{ block.settings.icon }}</span>
          <span class="gv-trust-badge-label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Pakistan / local callout {%- endcomment -%}
  {%- if section.settings.pk_callout != blank -%}
    <div class="gv-pk-callout">{{ section.settings.pk_callout }}</div>
  {%- endif -%}

</div>

{%- comment -%} ── Sticky Add-to-Cart bar ── {%- endcomment -%}
{%- if section.settings.sticky_enabled -%}
  <div id="gv-sticky-atc" class="gv-sticky-atc" aria-hidden="true">
    <div class="gv-sticky-atc-info">
      {%- if product.featured_image -%}
        <div class="gv-sticky-img-wrap">
          {{- product.featured_image | image_url: width: 80 | image_tag: loading: 'lazy', width: 40, height: 40, class: 'gv-sticky-img' -}}
        </div>
      {%- endif -%}
      <div>
        <div class="gv-sticky-name">{{ product.title }}</div>
        <div class="gv-sticky-price">{{ product.price | money }}</div>
      </div>
    </div>
    <button class="gv-sticky-btn" id="gv-sticky-btn">
      Add to Bag — {{ product.price | money }}
    </button>
  </div>
{%- endif -%}

<script>
  (function () {
    var THRESHOLD = {{ section.settings.threshold | default: 2500 }};

    // ── Move all nodes from #gv-inject-src into the product details column ──
    function injectAll() {
      var buyButtons = document.querySelector('buy-buttons');
      if (!buyButtons) return;
      var parent = buyButtons.parentNode;

      var src = document.getElementById('gv-inject-src');
      if (!src) return;

      // Helper: insert a node after a reference node; returns the inserted node
      function insertAfter(node, ref) {
        if (!node || !ref || !ref.parentNode) return ref;
        ref.parentNode.insertBefore(node, ref.nextSibling);
        return node;
      }

      // ── Before buy-buttons ──
      var sp = src.querySelector('[data-social-proof]');
      if (sp) parent.insertBefore(sp, buyButtons);

      var urgency = src.querySelector('.gv-urgency');
      if (urgency) parent.insertBefore(urgency, buyButtons);

      // ── Chain after buy-buttons ──
      var ref = buyButtons;

      var guarantee = src.querySelector('.gv-guarantee');
      if (guarantee) ref = insertAfter(guarantee, ref);

      var ship = src.querySelector('[data-ship-wrap]');
      if (ship) ref = insertAfter(ship, ref);

      var pays = src.querySelector('.gv-pays');
      if (pays) ref = insertAfter(pays, ref);

      var ingCallouts = src.querySelector('.gv-ing-callouts');
      if (ingCallouts) ref = insertAfter(ingCallouts, ref);

      var trust = src.querySelector('.gv-trust-badges');
      if (trust) ref = insertAfter(trust, ref);

      var pkCallout = src.querySelector('.gv-pk-callout');
      if (pkCallout) insertAfter(pkCallout, ref);

      // Hide the now-empty source container
      src.style.display = 'none';

      // ── Social proof counter animation ──
      initSocialProof();

      // ── Shipping tracker ──
      updateTracker();

      // ── Sticky ATC ──
      initStickyATC();
    }

    // ── Social proof ──
    function initSocialProof() {
      document.querySelectorAll('[data-social-proof]').forEach(function (el) {
        var wEl = el.querySelector('[data-w]');
        var bEl = el.querySelector('[data-b]');
        var watchers = Math.floor(Math.random() * 14) + 8;
        var bought   = Math.floor(Math.random() * 27) + 12;
        if (wEl) wEl.textContent = watchers;
        if (bEl) bEl.textContent = bought;
        setInterval(function () {
          watchers = Math.max(5, watchers + (Math.random() > 0.45 ? 1 : -1));
          if (wEl) wEl.textContent = watchers;
        }, 9500);
      });
    }

    // ── Shipping tracker ──
    function updateTracker() {
      var fills = document.querySelectorAll('[data-ship-fill]');
      var msgs  = document.querySelectorAll('[data-ship-msg]');
      if (!fills.length) return;

      fetch('/cart.js')
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var total = cart.total_price / 100;
          var pct   = Math.min(100, (total / THRESHOLD) * 100);
          var rem   = Math.ceil(THRESHOLD - total);
          fills.forEach(function (f) { f.style.width = pct.toFixed(1) + '%'; });
          msgs.forEach(function (m) {
            if (rem <= 0) {
              m.textContent = '🎉 You qualify for free delivery!';
              m.classList.add('gv-ship-done');
            } else {
              m.innerHTML = 'Add <strong>PKR\u00A0' + rem.toLocaleString() + '</strong> more for free delivery';
              m.classList.remove('gv-ship-done');
            }
          });
        })
        .catch(function () {});
    }

    // ── Sticky ATC ──
    function initStickyATC() {
      var bar    = document.getElementById('gv-sticky-atc');
      var btn    = document.getElementById('gv-sticky-btn');
      var mainBtn = document.querySelector('buy-buttons [name="add"], buy-buttons button[type="submit"]');
      if (!bar) return;

      var trigger = document.querySelector('buy-buttons');
      if (!trigger) return;

      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          bar.classList.toggle('gv-sticky-atc--visible', !e.isIntersecting);
          bar.setAttribute('aria-hidden', e.isIntersecting ? 'true' : 'false');
        });
      }, { threshold: 0 });
      obs.observe(trigger);

      if (btn && mainBtn) {
        btn.addEventListener('click', function () {
          mainBtn.click();
        });
      }
    }

    document.readyState === 'loading'
      ? document.addEventListener('DOMContentLoaded', injectAll)
      : injectAll();

    document.addEventListener('cart:update', updateTracker);
  })();
</script>

{% stylesheet %}
  /* ── Social proof ── */
  .gv-sp {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    background: var(--off-white);
    border: 1px solid var(--warm-gray);
    border-radius: 8px;
    padding: 8px 12px;
  }
  .gv-sp-mid { color: var(--warm-gray); }
  .gv-sp-n { font-weight: 600; color: var(--warm-espresso); }

  /* ── Urgency strip ── */
  .gv-urgency {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: #5A3E80;
    background: #F5F0FF;
    border: 1px solid #C9B8F0;
    border-radius: 100px;
    padding: 8px 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: fit-content;
  }

  /* ── Guarantee bar ── */
  .gv-guarantee {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    background: var(--off-white);
    border: 1px solid var(--warm-gray);
    border-radius: 10px;
    padding: 10px 14px;
  }
  .gv-guarantee span {
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  /* ── Shipping tracker ── */
  .gv-ship {
    font-family: var(--font-sans);
  }
  .gv-ship-bar {
    height: 5px;
    background: var(--warm-gray);
    border-radius: 100px;
    overflow: hidden;
    margin-bottom: 7px;
  }
  .gv-ship-fill {
    height: 100%;
    background: linear-gradient(90deg, #66BB6A, #2E7D32);
    border-radius: 100px;
    transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .gv-ship-msg {
    font-size: 12px;
    color: var(--mid-gray);
    line-height: 1.4;
    margin: 0;
  }
  .gv-ship-msg strong { color: var(--warm-espresso); }
  .gv-ship-msg.gv-ship-done { color: #2E7D32; font-weight: 600; }

  /* ── Payment chips ── */
  .gv-pays {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .gv-pay {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 500;
    color: var(--mid-gray);
    background: white;
    border: 1px solid var(--warm-gray);
    border-radius: 6px;
    padding: 4px 10px;
    white-space: nowrap;
  }

  /* ── Ingredient callouts ── */
  .gv-ing-callouts {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .gv-ing-callout {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 16px;
    background: var(--off-white);
    border-radius: 12px;
    border-left: 3px solid var(--coral-pulse);
  }
  .gv-ing-callout-icon {
    font-size: 22px;
    flex-shrink: 0;
    margin-top: 1px;
    line-height: 1;
  }
  .gv-ing-callout-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .gv-ing-callout-name {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--coral-pulse);
    letter-spacing: 0.02em;
  }
  .gv-ing-callout-desc {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--mid-gray);
    line-height: 1.5;
  }

  /* ── Trust badges ── */
  .gv-trust-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .gv-trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    padding: 12px 8px;
    background: white;
    border: 1px solid var(--warm-gray);
    border-radius: 12px;
    flex: 1;
    min-width: 64px;
  }
  .gv-trust-badge-icon {
    font-size: 20px;
    line-height: 1;
  }
  .gv-trust-badge-label {
    font-family: var(--font-sans);
    font-size: 10px;
    text-align: center;
    color: var(--mid-gray);
    line-height: 1.3;
  }

  /* ── Pakistan callout ── */
  .gv-pk-callout {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--warm-espresso);
    background: #FFF0E6;
    border: 1px solid rgba(244,132,95,0.3);
    border-radius: 12px;
    padding: 14px 16px;
    line-height: 1.6;
  }
  .gv-pk-callout strong { color: var(--coral-pulse); }

  /* ── Sticky ATC ── */
  .gv-sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: white;
    border-top: 1.5px solid var(--warm-gray);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    box-shadow: 0 -4px 24px rgba(0,0,0,0.1);
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .gv-sticky-atc--visible {
    transform: translateY(0);
  }
  .gv-sticky-atc-info {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .gv-sticky-img-wrap {
    flex-shrink: 0;
  }
  .gv-sticky-img {
    width: 44px;
    height: 44px;
    object-fit: contain;
    background: var(--off-white);
    border-radius: 10px;
    display: block;
  }
  .gv-sticky-name {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--warm-espresso);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gv-sticky-price {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--mid-gray);
  }
  .gv-sticky-btn {
    background: var(--coral-pulse);
    color: white;
    border: none;
    padding: 13px 28px;
    border-radius: 100px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .gv-sticky-btn:hover { background: var(--coral-dark, #e63974); }

  @media (max-width: 600px) {
    .gv-sticky-atc { padding: 10px 16px; }
    .gv-sticky-name { display: none; }
    .gv-sticky-btn { font-size: 13px; padding: 12px 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Extras",
  "tag": "div",
  "class": "gv-pdp-scripts",
  "settings": [
    {
      "type": "number",
      "id": "threshold",
      "label": "Free shipping threshold (PKR)",
      "default": 2500,
      "info": "Customers get free delivery when their cart reaches this amount."
    },
    {
      "type": "header",
      "content": "Urgency Strip"
    },
    {
      "type": "checkbox",
      "id": "urgency_enabled",
      "label": "Show urgency strip",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency text",
      "default": "Order before 2pm PKT — ships today"
    },
    {
      "type": "header",
      "content": "Guarantee Bar"
    },
    {
      "type": "text",
      "id": "guarantee_1",
      "label": "Guarantee item 1",
      "default": "🛡️ 30-day money-back"
    },
    {
      "type": "text",
      "id": "guarantee_2",
      "label": "Guarantee item 2",
      "default": "🚚 Free delivery above PKR 2,500"
    },
    {
      "type": "text",
      "id": "guarantee_3",
      "label": "Guarantee item 3",
      "default": "🏠 Cash on delivery"
    },
    {
      "type": "header",
      "content": "Local Callout"
    },
    {
      "type": "textarea",
      "id": "pk_callout",
      "label": "Pakistan / local callout",
      "info": "Shown at the bottom of the info panel. Use <strong> for pink text."
    },
    {
      "type": "header",
      "content": "Sticky Add-to-Cart"
    },
    {
      "type": "checkbox",
      "id": "sticky_enabled",
      "label": "Show sticky ATC bar on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient Callout",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🧬"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Ingredient name",
          "default": "Triple Ceramide Complex"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "One-line benefit",
          "default": "The exact lipids your barrier is made of — applied directly."
        }
      ]
    },
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🧪"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Badge label",
          "default": "Derm Tested"
        }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Extras" }
  ]
}
{% endschema %}
