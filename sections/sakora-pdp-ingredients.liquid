<section class="sk-pdp-ing">
  <div class="sk-container">
    <div class="sk-pdp-ing-layout">
      
      <!-- LEFT: Technical Specs & Scales -->
      <div class="sk-pdp-ing-specs">
        <div class="sk-label-caps sk-pdp-ing-eyebrow">{{ section.settings.label }}</div>
        <h2 class="sk-display-title sk-pdp-ing-title">{{ section.settings.title }}</h2>
        <p class="sk-body-normal sk-pdp-ing-sub">{{ section.settings.subtitle }}</p>

        <!-- Spec Comparison Cards Grid -->
        <div class="sk-pdp-ing-cards">
          {%- assign spec_blocks = section.blocks | where: 'type', 'spec_block' -%}
          {%- if spec_blocks.size > 0 -%}
            {%- for block in spec_blocks -%}
              <div class="sk-pdp-ing-card" {{ block.shopify_attributes }}>
                <div class="sk-pdp-ing-card-header">
                  <span class="sk-inci-mono" style="color: {{ block.settings.active_color | default: 'var(--fade-accent)' }}">{{ block.settings.inci }}</span>
                  <span class="sk-badge-pill sk-ing-badge" style="background-color: {{ block.settings.active_color | color_modify: 'alpha', 0.1 }}; color: {{ block.settings.active_color }};">{{ block.settings.badge }}</span>
                </div>
                <h3 class="sk-ing-card-name">{{ block.settings.name }}</h3>
                <p class="sk-ing-card-function">{{ block.settings.benefit }}</p>
                
                <!-- Concentration Comparison Scale -->
                <div class="sk-spec-scale">
                  <div class="sk-spec-scale__header">
                    <span class="sk-inci-mono text-focus" style="color: {{ block.settings.active_color | default: 'var(--fade-accent)' }};">SAKORA: {{ block.settings.concentration }}</span>
                    <span class="sk-inci-mono text-sub">TYPICAL: {{ block.settings.industry_typical }}</span>
                  </div>
                  <div class="sk-spec-scale__bar-container">
                    <div class="sk-spec-scale__bar-fill" style="width: {{ block.settings.percentage }}%; background-color: {{ block.settings.active_color | default: 'var(--fade-accent)' }};"></div>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback design static blocks -->
            <div class="sk-pdp-ing-card">
              <div class="sk-pdp-ing-card-header">
                <span class="sk-inci-mono" style="color: var(--petal-text);">CERAMIDE-NP-AP-EOP</span>
                <span class="sk-badge-pill sk-ing-badge" style="background-color: var(--petal-bg); color: var(--petal-text);">Barrier Repair</span>
              </div>
              <h3 class="sk-ing-card-name">Petal Melt Complex</h3>
              <p class="sk-ing-card-function">Triple Ceramide and Peptide matrix that locks hydration, mimicking the skin's lipid structure to restore compromised barriers.</p>
              
              <div class="sk-spec-scale">
                <div class="sk-spec-scale__header">
                  <span class="sk-inci-mono text-focus" style="color: var(--petal-text);">SAKORA: 1.5%</span>
                  <span class="sk-inci-mono text-sub">TYPICAL: 0.1%</span>
                </div>
                <div class="sk-spec-scale__bar-container">
                  <div class="sk-spec-scale__bar-fill" style="width: 95%; background-color: var(--petal-bg);"></div>
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

      <!-- RIGHT: Full INCI Registry & Claims -->
      <div class="sk-pdp-ing-disclosure">
        <div class="sk-pdp-inci-box">
          <h3 class="sk-display-title sk-inci-title">{{ section.settings.inci_title }}</h3>
          
          <div class="sk-inci-claims">
            <span class="sk-inci-claim sk-inci-mono">✓ 100% TRANSPARENT ACTIVE LEVEL</span>
            <span class="sk-inci-claim sk-inci-mono">✓ FRAGRANCE-FREE</span>
            <span class="sk-inci-claim sk-inci-mono">✓ CRUELTY-FREE & VEGAN</span>
            <span class="sk-inci-claim sk-inci-mono">✓ HUMIDITY-STABLE FORMULATION</span>
          </div>

          <div class="sk-inci-disclosure-text">
            <p class="sk-inci-list sk-inci-mono">{{ section.settings.inci_full | replace: '<strong>', '<span class="sk-highlight-active">' | replace: '</strong>', '</span>' }}</p>
          </div>

          <div class="sk-inci-caution">
            <div class="sk-inci-caution-heading sk-label-caps">Gentle Stability Guidance</div>
            <p class="sk-inci-caution-body">Keep isolated from direct sunlight. Storage below 30°C recommended. Highly active formula—patch test behind the ear for 24 hours prior to facial introduction.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .sk-pdp-ing {
    background-color: var(--chalk);
    color: var(--charcoal);
    padding: 100px 0;
    border-bottom: 1px solid var(--light-border);
  }

  .sk-pdp-ing-layout {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 72px;
    align-items: start;
  }

  .sk-pdp-ing-eyebrow {
    color: var(--sakora-emerald);
    margin-bottom: 16px;
  }

  .sk-pdp-ing-title {
    font-size: 38px !important;
    text-transform: none !important;
  }

  .sk-pdp-ing-sub {
    color: var(--subtext-gray);
    margin-top: 14px;
    margin-bottom: 40px;
    line-height: 1.6;
  }

  /* Spec Blocks Grid (Soft 20px curves & shadows) */
  .sk-pdp-ing-cards {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .sk-pdp-ing-card {
    background-color: var(--sakora-stone);
    border: 1px solid var(--ui-border);
    border-radius: 24px; /* Soft 24px curves */
    padding: 24px;
    box-shadow: 0 8px 24px rgba(44, 44, 53, 0.02);
  }

  .sk-pdp-ing-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .sk-ing-badge {
    font-size: 9px !important;
    font-weight: 600;
  }

  .sk-ing-card-name {
    font-family: var(--font-heading) !important;
    font-size: 22px !important;
    font-weight: 600 !important;
    color: var(--charcoal) !important;
    margin-bottom: 8px !important;
  }

  .sk-ing-card-function {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--charcoal);
    opacity: 0.85;
    line-height: 1.5;
    margin-bottom: 20px;
  }

  /* RIGHT: INCI Box */
  .sk-pdp-inci-box {
    background-color: var(--sakora-stone);
    border: 1px solid var(--ui-border);
    border-radius: 24px; /* Soft 24px curves */
    padding: 40px;
    box-shadow: 0 8px 24px rgba(44, 44, 53, 0.02);
  }

  .sk-inci-title {
    font-size: 26px !important;
    text-transform: none !important;
    margin-bottom: 24px !important;
    color: var(--charcoal) !important;
  }

  .sk-inci-claims {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 28px;
    border-bottom: 1px dashed var(--light-border);
    padding-bottom: 20px;
  }

  .sk-inci-claim {
    font-size: 11px !important;
    color: var(--sakora-emerald) !important;
    font-weight: 600;
  }

  .sk-inci-disclosure-text {
    margin-bottom: 28px;
  }

  .sk-inci-list {
    font-size: 12px !important;
    line-height: 2.1 !important;
    color: var(--charcoal);
    opacity: 0.85;
    word-break: break-word;
  }

  .sk-inci-caution {
    background-color: var(--petal-bg);
    border: 1px solid var(--petal-text);
    border-radius: 24px; /* Soft 24px curves */
    padding: 20px;
  }

  .sk-inci-caution-heading {
    color: var(--petal-text);
    font-size: 11px;
    font-weight: 700;
    margin-bottom: 6px;
  }

  .sk-inci-caution-body {
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.5;
    color: var(--petal-text);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .sk-pdp-ing-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }

  @media (max-width: 768px) {
    .sk-pdp-ing {
      padding: 72px 0;
    }
    .sk-pdp-ing-title {
      font-size: 32px !important;
    }
    .sk-pdp-inci-box {
      padding: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Sakora PDP Ingredients",
  "tag": "section",
  "class": "sakora-pdp-ing-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section Label",
      "default": "Active Ingredients"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Explore Our Formulation Ethics"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Disclosed percentages, gentle botanical bases, and clinically proven results. Your skin barrier's best friend."
    },
    {
      "type": "text",
      "id": "inci_title",
      "label": "INCI Title",
      "default": "Full Ingredient List"
    },
    {
      "type": "textarea",
      "id": "inci_full",
      "label": "Full INCI List",
      "default": "Water (Aqua), <strong>Niacinamide (Vitamin B3)</strong>, <strong>Alpha-Arbutin</strong>, <strong>Tranexamic Acid</strong>, Glycerin, Propanediol, Sodium Hyaluronate, Phenoxyethanol, Ethylhexylglycerin, Citric Acid."
    }
  ],
  "blocks": [
    {
      "type": "spec_block",
      "name": "Active Spec Card",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Active Name",
          "default": "Alpha Arbutin 2%"
        },
        {
          "type": "text",
          "id": "inci",
          "label": "INCI Chemical Name",
          "default": "ALPHA-ARBUTIN"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Skin Action Tag",
          "default": "BRIGHTENING"
        },
        {
          "type": "color",
          "id": "active_color",
          "label": "Action Accent Color",
          "default": "#FF5C8A"
        },
        {
          "type": "text",
          "id": "concentration",
          "label": "Sakora Concentration",
          "default": "2.0%"
        },
        {
          "type": "text",
          "id": "industry_typical",
          "label": "Typical Cosmetic Concentration",
          "default": "0.5%–1.0%"
        },
        {
          "type": "range",
          "id": "percentage",
          "label": "Scale Value Percentage",
          "min": 10,
          "max": 100,
          "step": 5,
          "default": 85
        },
        {
          "type": "textarea",
          "id": "benefit",
          "label": "Biological Benefit Description",
          "default": "Inhibits tyrosinase synthesis in melanocytes to aggressively control melasma, dark spots, and post-inflammatory acne spots."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sakora PDP Ingredients",
      "blocks": [
        {
          "type": "spec_block",
          "settings": {
            "name": "Alpha Arbutin 2%",
            "inci": "ALPHA-ARBUTIN",
            "badge": "BRIGHTENING",
            "active_color": "#E8A0A0",
            "concentration": "2.0%",
            "industry_typical": "0.5%",
            "percentage": 90,
            "benefit": "Shuts down hyperactive melanin pigment pathways to target melasma and stubborn post-acne blemishes."
          }
        },
        {
          "type": "spec_block",
          "settings": {
            "name": "Tranexamic Acid 2%",
            "inci": "TRANEXAMIC ACID",
            "badge": "UV PROTECTION",
            "active_color": "#E8B84B",
            "concentration": "2.0%",
            "industry_typical": "0.2%",
            "percentage": 85,
            "benefit": "Acts as an anti-plasmin compound to control skin redness and vascular UV pigmentation responses."
          }
        }
      ]
    }
  ]
}
{% endschema %}
