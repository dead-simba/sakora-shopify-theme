<section class="gv-ship-bundles">
  <div class="gv-ship-bundles__inner">
    <div class="gv-ship-bundles__label">{{ section.settings.label }}</div>
    <h2 class="gv-ship-bundles__title">{{ section.settings.title }}</h2>
    <p class="gv-ship-bundles__sub">{{ section.settings.subtitle }}</p>

    <div class="gv-ship-bundle-cards">
      <div class="gv-ship-bundle-card">
        <div class="gv-ship-bundle-card__icon">🔄</div>
        <h3 class="gv-ship-bundle-card__title">{{ section.settings.card_1_title }}</h3>
        <p class="gv-ship-bundle-card__text">{{ section.settings.card_1_text }}</p>
        {%- if section.settings.card_1_example != blank -%}
          <div class="gv-ship-bundle-card__example">
            <p><em>Example:</em> {{ section.settings.card_1_example }}</p>
          </div>
        {%- endif -%}
      </div>
      <div class="gv-ship-bundle-card">
        <div class="gv-ship-bundle-card__icon">📦</div>
        <h3 class="gv-ship-bundle-card__title">{{ section.settings.card_2_title }}</h3>
        <p class="gv-ship-bundle-card__text">{{ section.settings.card_2_text }}</p>
      </div>
    </div>

    {%- if section.settings.footer_note != blank -%}
      <div class="gv-ship-bundles__footer">
        <p>{{ section.settings.footer_note }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .gv-ship-bundles { background: #FAFAFA; padding: 80px 0; border-top: 1px solid #ECECEC; }
  .gv-ship-bundles__inner { max-width: 760px; margin: 0 auto; padding: 0 40px; }

  .gv-ship-bundles__label {
    font-family: 'Poppins', sans-serif !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: #FF4D8D !important; margin-bottom: 12px;
  }
  .gv-ship-bundles__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 42px !important; font-weight: 600 !important;
    color: #1A1A1A !important; line-height: 1.2 !important;
    margin-bottom: 24px; 
  }
  .gv-ship-bundles__title em { font-style: normal !important; color: #FF4D8D !important; }
  .gv-ship-bundles__sub {
    font-family: 'Poppins', sans-serif; font-size: 16px; color: #666;
    line-height: 1.7; margin-bottom: 32px;
  }

  .gv-ship-bundle-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 32px; }
  .gv-ship-bundle-card {
    background: #FAFAFA; border: 1.5px solid #ECECEC; border-radius: 20px; padding: 28px;
    transition: border-color 0.2s;
  }
  .gv-ship-bundle-card:hover { border-color: rgba(255,77,141,0.3); }
  .gv-ship-bundle-card__icon { font-size: 28px; margin-bottom: 12px; }
  .gv-ship-bundle-card__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 18px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 10px; 
  }
  .gv-ship-bundle-card__text {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666; line-height: 1.65;
  }
  .gv-ship-bundle-card__example {
    margin-top: 16px; padding: 12px; background: white; border-radius: 10px;
    border: 1px solid #ECECEC;
  }
  .gv-ship-bundle-card__example p {
    font-family: 'Poppins', sans-serif; font-size: 12px; color: #666; line-height: 1.6;
  }
  .gv-ship-bundle-card__example em { color: #FF4D8D !important; font-style: normal !important; }

  .gv-ship-bundles__footer {
    background: rgba(255,77,141,0.06); border: 1px solid rgba(255,77,141,0.15);
    border-radius: 16px; padding: 24px 28px;
  }
  .gv-ship-bundles__footer p {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #666; line-height: 1.7;
  }

  @media (max-width: 768px) {
    .gv-ship-bundles__inner { padding: 0 20px; }
    .gv-ship-bundle-cards { grid-template-columns: 1fr; }
    .gv-ship-bundles__title { font-size: 32px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Bundle Returns",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "— Bundles & Protocols —" },
    { "type": "html", "id": "title", "label": "Title", "default": "returning a <em>bundle?</em>" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Our bundles are designed to work together — but we know that one product in a set might not suit your skin. Here's how it works:" },
    { "type": "text", "id": "card_1_title", "label": "Card 1 Title", "default": "Returning one item" },
    { "type": "textarea", "id": "card_1_text", "label": "Card 1 Text", "default": "Absolutely allowed. We refund the proportional amount you paid — not the individual retail price." },
    { "type": "textarea", "id": "card_1_example", "label": "Card 1 Example", "default": "Bundle of 3 for PKR 4,500 (retail PKR 6,000). One item retails at PKR 2,000 → your refund is PKR 1,500." },
    { "type": "text", "id": "card_2_title", "label": "Card 2 Title", "default": "Returning the full bundle" },
    { "type": "textarea", "id": "card_2_text", "label": "Card 2 Text", "default": "You'll receive a full refund of exactly what you paid — no calculation needed." },
    { "type": "textarea", "id": "footer_note", "label": "Footer Note", "default": "Before you return, message us on WhatsApp. If one product isn't working for your skin, we'd love to understand what's happening. Sometimes a small adjustment in application makes all the difference. And if it's still not right — we'll process your return right there in the conversation." }
  ],
  "presets": [{ "name": "Bundle Returns" }]
}
{% endschema %}
