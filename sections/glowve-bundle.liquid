{%- liquid
  assign bundle_product_1 = all_products[section.settings.product_1]
  assign bundle_product_2 = all_products[section.settings.product_2]
  assign bundle_product_3 = all_products[section.settings.product_3]
  assign bundle_product    = all_products[section.settings.bundle_product]
-%}

<section class="gv-bundle" id="bundle">
  <div class="gv-container">

    <div class="gv-bundle-header">
      <div class="gv-section-label gv-section-label--light gv-section-label--center">
        {{ section.settings.label }}
      </div>
      <h2 class="gv-bundle-title">{{ section.settings.title }}</h2>
      <p class="gv-bundle-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="gv-bundle-products">

      {%- comment -%} Product 1 {%- endcomment -%}
      <div class="gv-bundle-product">
        <div class="gv-bundle-product-img-wrap">
          {%- if bundle_product_1.featured_image -%}
            <img
              src="{{ bundle_product_1.featured_image | image_url: width: 300 }}"
              alt="{{ bundle_product_1.title | escape }}"
              width="300" height="300"
              loading="lazy"
            >
          {%- else -%}
            <div class="gv-bundle-no-img"></div>
          {%- endif -%}
        </div>
        <div class="gv-bundle-step" style="color: var(--coral-pulse);">{{ section.settings.step_1 }}</div>
        <div class="gv-bundle-product-name">
          {%- if section.settings.name_1 != blank -%}{{ section.settings.name_1 }}{%- elsif bundle_product_1 != empty -%}{{ bundle_product_1.title }}{%- endif -%}
        </div>
        <div class="gv-bundle-product-price">
          {%- if bundle_product_1 != empty -%}
            {{ bundle_product_1.price | money }}
          {%- else -%}
            {{ section.settings.price_1 }}
          {%- endif -%}
        </div>
      </div>

      <div class="gv-bundle-plus" aria-hidden="true">+</div>

      {%- comment -%} Product 2 (larger) {%- endcomment -%}
      <div class="gv-bundle-product gv-bundle-product--featured">
        <div class="gv-bundle-product-img-wrap">
          {%- if bundle_product_2.featured_image -%}
            <img
              src="{{ bundle_product_2.featured_image | image_url: width: 340 }}"
              alt="{{ bundle_product_2.title | escape }}"
              width="340" height="340"
              loading="lazy"
            >
          {%- else -%}
            <div class="gv-bundle-no-img gv-bundle-no-img--2"></div>
          {%- endif -%}
        </div>
        <div class="gv-bundle-step" style="color: var(--plum-dusk);">{{ section.settings.step_2 }}</div>
        <div class="gv-bundle-product-name">
          {%- if section.settings.name_2 != blank -%}{{ section.settings.name_2 }}{%- elsif bundle_product_2 != empty -%}{{ bundle_product_2.title }}{%- endif -%}
        </div>
        <div class="gv-bundle-product-price">
          {%- if bundle_product_2 != empty -%}
            {{ bundle_product_2.price | money }}
          {%- else -%}
            {{ section.settings.price_2 }}
          {%- endif -%}
        </div>
      </div>

      <div class="gv-bundle-plus" aria-hidden="true">+</div>

      {%- comment -%} Product 3 {%- endcomment -%}
      <div class="gv-bundle-product">
        <div class="gv-bundle-product-img-wrap">
          {%- if bundle_product_3.featured_image -%}
            <img
              src="{{ bundle_product_3.featured_image | image_url: width: 300 }}"
              alt="{{ bundle_product_3.title | escape }}"
              width="300" height="300"
              loading="lazy"
            >
          {%- else -%}
            <div class="gv-bundle-no-img gv-bundle-no-img--3"></div>
          {%- endif -%}
        </div>
        <div class="gv-bundle-step" style="color: var(--mango-zest);">{{ section.settings.step_3 }}</div>
        <div class="gv-bundle-product-name">
          {%- if section.settings.name_3 != blank -%}{{ section.settings.name_3 }}{%- elsif bundle_product_3 != empty -%}{{ bundle_product_3.title }}{%- endif -%}
        </div>
        <div class="gv-bundle-product-price">
          {%- if bundle_product_3 != empty -%}
            {{ bundle_product_3.price | money }}
          {%- else -%}
            {{ section.settings.price_3 }}
          {%- endif -%}
        </div>
      </div>

    </div>

    <div class="gv-bundle-cta">
      <div class="gv-bundle-pricing">
        <span class="gv-bundle-sale-price">{{ section.settings.bundle_price }}</span>
        <span class="gv-bundle-orig-price">{{ section.settings.original_price }}</span>
      </div>
      <div class="gv-bundle-saving">{{ section.settings.saving_text }}</div>
      {%- if section.settings.cta_label != blank -%}
        <button
          class="gv-btn-primary gv-btn-primary--lg"
          onclick="glowveAddBundle(event, this)"
          data-variant="{{ bundle_product.first_available_variant.id }}"
          data-label="{{ section.settings.cta_label | escape }}"
        >
          {{ section.settings.cta_label }}
        </button>
      {%- endif -%}
      <p class="gv-bundle-note">{{ section.settings.note }}</p>
    </div>

  </div>
</section>

<script>
  window.glowveAddBundle = function(event, btn) {
    event.preventDefault();
    var variantId = parseInt(btn.dataset.variant);
    if (!variantId) return;

    btn.disabled = true;
    btn.textContent = 'Adding…';

    var sectionIds = [];
    document.querySelectorAll('cart-items-component[data-section-id]').forEach(function(el) {
      sectionIds.push(el.dataset.sectionId);
    });

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1, sections: sectionIds.join(',') })
    })
    .then(function(r) { return r.json(); })
    .then(function(response) {
      document.dispatchEvent(new CustomEvent('cart:update', {
        bubbles: true,
        detail: { data: { sections: response.sections } }
      }));
      btn.textContent = 'Added to Bag ✓';
      setTimeout(function() {
        btn.disabled = false;
        btn.textContent = btn.getAttribute('data-label') || 'Add Bundle to Bag';
      }, 2500);
    })
    .catch(function() {
      btn.disabled = false;
      btn.textContent = 'Try again';
    });
  };
</script>

{% stylesheet %}
  .gv-bundle {
    background: var(--berry-dark);
    padding: 100px 0;
    position: relative;
    overflow: hidden;
  }
  .gv-bundle::before {
    content: '';
    position: absolute;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(244,132,95,0.12), transparent);
    top: -180px; right: -80px;
    pointer-events: none;
  }

  .gv-bundle-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .gv-bundle-title {
    font-family: var(--font-serif);
    font-size: 52px;
    font-weight: 300;
    color: #fff;
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: 16px;
  }
  .gv-bundle-title em { font-style: italic; color: var(--coral-pulse); }
  .gv-bundle-subtitle {
    font-family: var(--font-sans);
    font-size: 17px;
    color: rgba(255,255,255,0.6);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .gv-bundle-products {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 60px;
    flex-wrap: wrap;
  }

  .gv-bundle-product { text-align: center; }

  .gv-bundle-product-img-wrap {
    background: rgba(255,255,255,0.08);
    border-radius: 24px;
    padding: 24px;
    width: 180px;
    margin: 0 auto 16px;
  }
  .gv-bundle-product--featured .gv-bundle-product-img-wrap {
    width: 200px;
    padding: 24px;
  }
  .gv-bundle-product-img-wrap img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    display: block;
  }

  .gv-bundle-no-img {
    width: 100%;
    aspect-ratio: 1;
    background: linear-gradient(135deg, #FFE8D6, #F4845F44);
    border-radius: 12px;
  }
  .gv-bundle-no-img--2 { background: linear-gradient(135deg, #F0EBF8, #9B72AA44); }
  .gv-bundle-no-img--3 { background: linear-gradient(135deg, #FFF8D6, #FFB34744); }

  .gv-bundle-step {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .gv-bundle-product-name {
    font-family: var(--font-serif);
    font-size: 18px;
    color: #fff;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin-bottom: 4px;
  }
  .gv-bundle-product-price {
    font-family: var(--font-sans);
    font-size: 14px;
    color: rgba(255,255,255,0.45);
  }

  .gv-bundle-plus {
    font-size: 24px;
    color: rgba(255,255,255,0.3);
    padding-bottom: 52px;
  }

  .gv-bundle-cta { text-align: center; }

  .gv-bundle-pricing {
    font-family: var(--font-serif);
    font-size: 42px;
    font-weight: 300;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1;
  }
  .gv-bundle-orig-price {
    font-size: 22px;
    color: rgba(255,255,255,0.4);
    text-decoration: line-through;
    margin-left: 12px;
  }
  .gv-bundle-saving {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--sage-calm);
    margin-bottom: 32px;
  }
  .gv-btn-primary--lg {
    font-size: 15px !important;
    padding: 18px 48px !important;
  }
  .gv-bundle-note {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(255,255,255,0.4);
    margin-top: 16px;
  }

  @media (max-width: 768px) {
    .gv-bundle { padding: 70px 0; }
    .gv-bundle-title { font-size: 36px; }
    .gv-bundle-products { gap: 12px; }
    .gv-bundle-product-img-wrap,
    .gv-bundle-product--featured .gv-bundle-product-img-wrap { width: 140px; padding: 16px; }
    .gv-bundle-plus { padding-bottom: 36px; }
  }
{% endstylesheet %}

