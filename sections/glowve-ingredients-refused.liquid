<section class="gv-ing-no-section">
  <div class="gv-container">
    <!-- STACKED header — matches mockup -->
    <div class="gv-ing-no-label">{{ section.settings.label }}</div>
    <h2 class="gv-ing-no-title">{{ section.settings.title }}</h2>
    <p class="gv-ing-no-sub">{{ section.settings.text }}</p>

    <div class="gv-ing-no-grid">
      {%- for block in section.blocks -%}
        <div class="gv-ing-no-card" {{ block.shopify_attributes }}>
          <div class="gv-ing-no-icon">✕</div>
          <div class="gv-ing-no-content">
            <h3 class="gv-ing-no-name">{{ block.settings.name }}</h3>
            <p class="gv-ing-no-why">{{ block.settings.why }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-no-section { background: #1A1A1A; padding: 96px 40px; }
  .gv-ing-no-section .gv-container { max-width: 1200px; margin: 0 auto; }

  /* STACKED header for dark section */
  .gv-ing-no-label {
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;
    color: #FF4D8D; margin-bottom: 12px;
    display: flex; align-items: center; gap: 10px;
  }
  .gv-ing-no-label::before { content: ''; display: block; width: 28px; height: 1px; background: #FF4D8D; }

  .gv-ing-no-title {
    font-size: 48px; font-weight: 700; color: white; line-height: 1.1;
    letter-spacing: -0.02em; margin-bottom: 12px;
  }
  .gv-ing-no-title em { font-style: normal; color: #FF4D8D; }

  .gv-ing-no-sub {
    font-size: 16px; color: rgba(255,255,255,0.6); line-height: 1.7; margin-bottom: 56px; max-width: 580px;
  }

  .gv-ing-no-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  
  .gv-ing-no-card {
    background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 16px; padding: 22px 20px; display: flex; align-items: flex-start; gap: 14px;
    transition: background 0.2s, border-color 0.2s;
  }
  .gv-ing-no-card:hover { background: rgba(255,255,255,0.09); border-color: rgba(255,77,141,0.4); }

  .gv-ing-no-icon {
    width: 32px; height: 32px; border-radius: 50%; background: rgba(255,77,141,0.15);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    color: #FF4D8D; font-size: 14px; font-weight: 700;
  }

  .gv-ing-no-name { font-size: 13px; font-weight: 600; color: white; margin-bottom: 3px; }
  .gv-ing-no-why { font-size: 11px; color: rgba(255,255,255,0.45); line-height: 1.5; }

  @media (max-width: 1100px) {
    .gv-ing-no-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .gv-ing-no-section { padding: 64px 20px; }
    .gv-ing-no-grid { grid-template-columns: 1fr; }
    .gv-ing-no-title { font-size: 32px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Refused Ingredients",
  "settings": [
    { "type": "text", "id": "label", "label": "Section Label", "default": "Our Standards" },
    { "type": "html", "id": "title", "label": "Title", "default": "What we <em>refuse</em><br>to put in your skin." },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Transparency goes both ways — knowing what's in the formula matters, but so does knowing what we deliberately left out." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Parabens" },
        { "type": "textarea", "id": "why", "label": "Why we avoid it", "default": "Preservatives linked to hormone disruption." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refused Ingredients"
    }
  ]
}
{% endschema %}
