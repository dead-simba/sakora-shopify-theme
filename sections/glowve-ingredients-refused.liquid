<section class="gv-ing-no-section">
  <div class="gv-container">
    <div class="gv-split-header">
      <div class="gv-header-col gv-header-col--label">
        <div class="gv-section-label gv-section-label--pink">{{ section.settings.label }}</div>
      </div>
      <div class="gv-header-col gv-header-col--title">
        <h2 class="gv-section-title gv-text-white">{{ section.settings.title }}</h2>
      </div>
      <div class="gv-header-col gv-header-col--sub">
        <p class="gv-section-sub gv-text-dim">{{ section.settings.text }}</p>
      </div>
    </div>

    <div class="gv-ing-no-grid">
      {%- for block in section.blocks -%}
        <div class="gv-ing-no-card" {{ block.shopify_attributes }}>
          <div class="gv-ing-no-icon">✕</div>
          <div class="gv-ing-no-content">
            <h3 class="gv-ing-no-name">{{ block.settings.name }}</h3>
            <p class="gv-ing-no-why">{{ block.settings.why }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ing-no-section { background: #1A1A1A; padding: 100px 0; }
  .gv-text-white { color: white !important; }
  .gv-text-dim { color: rgba(255,255,255,0.65) !important; }
  .gv-section-label--pink { color: #FF4D8D !important; }
  .gv-section-label--pink::before { background: #FF4D8D !important; }

  /* SPLIT HEADER MATCH */
  .gv-split-header { display: grid; grid-template-columns: 200px 1fr 340px; gap: 40px; align-items: end; margin-bottom: 60px; }
  .gv-section-label { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em; display: flex; align-items: center; gap: 10px; }
  .gv-section-label::before { content: ''; display: block; width: 28px; height: 1px; }
  .gv-section-title { font-size: 48px; font-weight: 700; color: #1A1A1A; line-height: 1.1; letter-spacing: -0.02em; }
  .gv-section-title em { font-style: normal; color: #FF4D8D; }
  .gv-section-sub { font-size: 16px; line-height: 1.7; }

  .gv-ing-no-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .gv-ing-no-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 20px; padding: 24px; display: flex; align-items: flex-start; gap: 16px; transition: all 0.2s; }
  .gv-ing-no-card:hover { background: rgba(255,255,255,0.08); border-color: rgba(255,77,141,0.3); }
  .gv-ing-no-icon { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,77,141,0.15); color: #FF4D8D; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 14px; font-weight: 700; }
  .gv-ing-no-name { font-size: 14px; font-weight: 700; color: white; margin-bottom: 6px; }
  .gv-ing-no-why { font-size: 11px; color: rgba(255,255,255,0.4); line-height: 1.5; }

  @media (max-width: 1024px) {
    .gv-split-header { grid-template-columns: 1fr; gap: 12px; align-items: start; }
    .gv-ing-no-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .gv-ing-no-grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Refused Components (Exact)",
  "settings": [
    { "type": "text", "id": "label", "label": "Section Label", "default": "Our Standards" },
    { "type": "html", "id": "title", "label": "Title", "default": "What we <em>refuse</em><br>to put in your skin." },
    { "type": "textarea", "id": "text", "label": "Description", "default": "Transparency goes both ways — knowing what's in the formula matters, but so does knowing what we deliberately left out." }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Parabens" },
        { "type": "textarea", "id": "why", "label": "Why we avoid it", "default": "Preservatives linked to hormone disruption." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Refused Components (Exact)"
    }
  ]
}
{% endschema %}
