<section class="gv-ship-options">
  <div class="gv-ship-options__inner">
    <div class="gv-ship-options__label">{{ section.settings.label }}</div>
    <h2 class="gv-ship-options__title">{{ section.settings.title }}</h2>

    <div class="gv-ship-cards">
      {%- for block in section.blocks -%}
        <div class="gv-ship-card gv-ship-card--{{ block.settings.style }}" {{ block.shopify_attributes }}>
          <div class="gv-ship-card__icon">{{ block.settings.icon }}</div>
          <div class="gv-ship-card__tier">{{ block.settings.tier }}</div>
          <h3 class="gv-ship-card__name">{{ block.settings.name }}</h3>
          <div class="gv-ship-card__price">{{ block.settings.price }}</div>
          
          <ul class="gv-ship-card__list">
            {%- if block.settings.feat_1 != blank -%}
              <li><span class="gv-ship-check">✓</span>{{ block.settings.feat_1 }}</li>
            {%- endif -%}
            {%- if block.settings.feat_2 != blank -%}
              <li><span class="gv-ship-check">✓</span>{{ block.settings.feat_2 }}</li>
            {%- endif -%}
            {%- if block.settings.feat_3 != blank -%}
              <li><span class="gv-ship-check">✓</span>{{ block.settings.feat_3 }}</li>
            {%- endif -%}
          </ul>

          {%- if block.settings.note != blank -%}
            <div class="gv-ship-card__note">{{ block.settings.note }}</div>
          {%- endif -%}

          {%- if block.settings.tagline != blank -%}
            <div class="gv-ship-card__tagline">{{ block.settings.tagline }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .gv-ship-options { background: white; padding: 80px 0; }
  .gv-ship-options__inner { max-width: 1280px; margin: 0 auto; padding: 0 40px; }

  .gv-ship-options__label {
    font-family: 'Poppins', sans-serif !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 0.15em; text-transform: uppercase;
    color: #FF4D8D !important; margin-bottom: 12px;
  }
  .gv-ship-options__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 42px !important; font-weight: 600 !important;
    color: #1A1A1A !important; line-height: 1.2 !important;
    margin-bottom: 40px; 
  }
  .gv-ship-options__title em { font-style: normal !important; color: #FF4D8D !important; }

  .gv-ship-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  .gv-ship-card {
    border-radius: 24px !important; padding: 36px;
    display: flex; flex-direction: column;
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s;
  }
  .gv-ship-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,0.08); }

  /* FREE card */
  .gv-ship-card--free { background: linear-gradient(135deg, #FFE8D6, #FFF3EE); border: 2px solid rgba(255,77,141,0.15); }
  .gv-ship-card--free .gv-ship-card__tier { color: #FF4D8D; }
  .gv-ship-card--free .gv-ship-card__price { color: #FF4D8D; }

  /* STANDARD card */
  .gv-ship-card--standard { background: white; border: 1.5px solid #ECECEC; }
  .gv-ship-card--standard .gv-ship-card__tier { color: #666; }
  .gv-ship-card--standard .gv-ship-card__price { color: #1A1A1A; }

  /* EXPRESS card */
  .gv-ship-card--express { background: #1A1A1A; }
  .gv-ship-card--express .gv-ship-card__tier { color: rgba(255,255,255,0.5); }
  .gv-ship-card--express .gv-ship-card__name { color: white !important; }
  .gv-ship-card--express .gv-ship-card__price { color: #FF4D8D; }
  .gv-ship-card--express .gv-ship-card__list li { color: rgba(255,255,255,0.8); }

  .gv-ship-card__icon { font-size: 36px; margin-bottom: 20px; }
  .gv-ship-card__tier {
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 8px;
  }
  .gv-ship-card__name {
    font-family: 'Poppins', sans-serif !important;
    font-size: 26px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 8px; 
  }
  .gv-ship-card__price {
    font-family: 'Poppins', sans-serif; font-size: 22px; font-weight: 700;
    margin-bottom: 16px;
  }
  .gv-ship-card__list {
    list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px;
    flex-grow: 1;
  }
  .gv-ship-card__list li {
    font-family: 'Poppins', sans-serif; font-size: 14px; color: #1A1A1A;
    display: flex; gap: 8px; align-items: flex-start;
  }
  .gv-ship-check { color: #3DB87A; font-weight: 700; flex-shrink: 0; }

  .gv-ship-card__note {
    margin-top: 20px; padding: 12px 16px; background: rgba(255,77,141,0.08);
    border-radius: 10px; font-family: 'Poppins', sans-serif; font-size: 12px; color: #FF4D8D;
    line-height: 1.5;
  }
  .gv-ship-card__tagline {
    margin-top: 20px; font-family: 'Poppins', sans-serif; font-size: 12px;
    color: rgba(255,255,255,0.4); font-style: italic;
  }

  @media (max-width: 768px) {
    .gv-ship-cards { grid-template-columns: 1fr; }
    .gv-ship-options__inner { padding: 0 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping Cards",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "— Delivery —" },
    { "type": "html", "id": "title", "label": "Title", "default": "how your order<br><em>gets to you.</em>" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Shipping Option",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji Icon", "default": "🎁" },
        { "type": "text", "id": "tier", "label": "Tier Label", "default": "FREE" },
        { "type": "text", "id": "name", "label": "Name", "default": "Free Delivery" },
        { "type": "text", "id": "price", "label": "Price Text", "default": "PKR 0" },
        {
          "type": "select", "id": "style", "label": "Card Style",
          "options": [
            { "value": "free", "label": "Free (Peach)" },
            { "value": "standard", "label": "Standard (White)" },
            { "value": "express", "label": "Express (Dark)" }
          ],
          "default": "free"
        },
        { "type": "text", "id": "feat_1", "label": "Feature 1", "default": "Orders PKR 2,500 and above" },
        { "type": "text", "id": "feat_2", "label": "Feature 2", "default": "3–5 working days" },
        { "type": "text", "id": "feat_3", "label": "Feature 3", "default": "All major Pakistani cities" },
        { "type": "textarea", "id": "note", "label": "Highlight Note (optional)" },
        { "type": "text", "id": "tagline", "label": "Tagline (optional)" }
      ]
    }
  ],
  "presets": [{ "name": "Shipping Cards" }]
}
{% endschema %}
