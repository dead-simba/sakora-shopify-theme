<section class="timeline-section">
  <div class="container">
    <div class="section-label">{{ section.settings.label }}</div>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-sub">{{ section.settings.subtitle }}</p>
    <div class="tl-cards">
      {% for block in section.blocks %}
        <div class="tl-card">
          <div class="tl-week">{{ block.settings.period }}</div>
          <div class="tl-title">{{ block.settings.title }}</div>
          <p class="tl-body">{{ block.settings.body }}</p>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.note != blank %}
      <div class="tl-note">
        💡 <span>{{ section.settings.note }}</span>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .timeline-section{background:white; padding: 80px 0;}
  .tl-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:40px;}
  .tl-card{background:var(--cream-glow, #fff);border-radius:16px;padding:24px;position:relative;overflow:hidden;border:1px solid var(--warm-gray, #ECECEC);}
  .tl-card::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--accent, #FF4D8D);opacity:0.4;}
  .tl-week{font-family:var(--font-mono);font-size:11px;color:var(--accent, #FF4D8D);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:10px;}
  .tl-title{font-family:var(--font-serif);font-size:22px;color:var(--berry-dark, #1A1A1A);margin-bottom:8px; line-height: 1.2;}
  .tl-body{font-size:13px;color:var(--mid-gray, #666);line-height:1.65;}
  .tl-note{background:#F5F0FF;border-radius:12px;padding:16px;margin-top:32px;font-size:14px;color:#5A3E80;display:flex;align-items:flex-start;gap:10px;}
  
  @media(max-width:900px){
    .tl-cards{grid-template-columns:1fr 1fr;}
  }
  @media(max-width:480px){
    .tl-cards{grid-template-columns:1fr;}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Timeline Cards",
  "settings": [
    {
      "type": "text", "id": "label", "label": "Label", "default": "Real timelines"
    },
    {
      "type": "text", "id": "title", "label": "Title", "default": "What to actually expect."
    },
    {
      "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "No overnight miracles. This is what rebuilding a real skin barrier looks like in weeks."
    },
    {
      "type": "richtext", "id": "note", "label": "Note (Tip)"
    }
  ],
  "blocks": [
    {
      "type": "timeline_card",
      "name": "Timeline Card",
      "settings": [
        { "type": "text", "id": "period", "label": "Period" },
        { "type": "text", "id": "title", "label": "Card Title" },
        { "type": "textarea", "id": "body", "label": "Card Body" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Timeline Cards" }
  ]
}
{% endschema %}
