<section class="ing-cards-section">
  <div class="container">
    <div class="section-label">{{ section.settings.label }}</div>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-sub">{{ section.settings.subtitle }}</p>
    
    <div class="ing-scroll-track">
      {% for block in section.blocks %}
        <div class="ing-card">
          <div class="ing-card-img">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}
            {% else %}
              <div style="background:var(--warm-gray);width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#999;">Image</div>
            {% endif %}
          </div>
          <div class="ing-card-body">
            <span class="ing-badge">{{ block.settings.badge }}</span>
            <div class="ing-name-mono">{{ block.settings.name }}</div>
            <p class="ing-benefit">{{ block.settings.benefit }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
    <p style="font-size:12px;color:var(--mid-gray);margin-top:8px;">← Scroll to see all actives</p>
  </div>
</section>

{% stylesheet %}
  .ing-cards-section { padding: 80px 0; background: var(--cream-glow, #fff); }
  .ing-scroll-track{display:flex;gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px 0 24px;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  .ing-scroll-track::-webkit-scrollbar{display:none;}
  .ing-card{background:white;border-radius:20px;overflow:hidden;transition:transform 0.25s,box-shadow 0.25s;min-width:210px;max-width:210px;scroll-snap-align:start;flex-shrink:0;}
  .ing-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,0.1);}
  .ing-card-img{aspect-ratio:1/1;overflow:hidden;background:var(--warm-gray);}
  .ing-card-img img{width:100%;height:100%;object-fit:cover;}
  .ing-card-body{padding:16px;}
  .ing-badge{display:inline-block;font-family:var(--font-mono);font-size:10px;text-transform:uppercase;letter-spacing:0.08em;padding:3px 10px;border-radius:100px;background:var(--accent-light, #FFF0E6);color:var(--accent, #FF4D8D);margin-bottom:8px;}
  .ing-name-mono{font-family:var(--font-mono);font-size:14px;color:var(--accent, #FF4D8D);font-weight:500;margin-bottom:6px;}
  .ing-benefit{font-size:12px;color:var(--mid-gray, #666);line-height:1.55;}
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Ingredients Scroll",
  "settings": [
    {
      "type": "text", "id": "label", "label": "Label", "default": "Every ingredient earns its place"
    },
    {
      "type": "text", "id": "title", "label": "Title", "default": "What's inside — and why."
    },
    {
      "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "No filler. No marketing ingredients. Every active in here has a job, a dose, and a reason."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Barrier Builder" },
        { "type": "text", "id": "name", "label": "Name", "default": "Triple Ceramide Complex" },
        { "type": "textarea", "id": "benefit", "label": "Benefit", "default": "Integrates directly into your barrier. Physically seals what was cracked." }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Ingredients Scroll" }
  ]
}
{% endschema %}
