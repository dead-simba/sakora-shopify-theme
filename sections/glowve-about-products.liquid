<section class="gv-about-products">
  <div class="gv-about-products__header">
    <p class="gv-about-products__label">{{ section.settings.label }}</p>
    <h2 class="gv-about-products__title">{{ section.settings.title }}</h2>
    <p class="gv-about-products__sub">{{ section.settings.subtitle }}</p>
  </div>

  <div class="gv-about-products__grid">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <div class="gv-about-product-card" {{ block.shopify_attributes }}>
        <div class="gv-about-product-card__visual gv-about-product-card__visual--{{ block.settings.style }}">
          <div class="gv-about-product-card__letter">{{ block.settings.letter }}</div>
          <span class="gv-about-product-card__badge">{{ block.settings.badge }}</span>
        </div>
        <div class="gv-about-product-card__info">
          <div class="gv-about-product-card__num">{{ block.settings.step }}</div>
          <div class="gv-about-product-card__name">
            {%- if block.settings.name != blank -%}
              {{ block.settings.name }}
            {%- elsif p != blank -%}
              {{ p.title }}
            {%- endif -%}
          </div>
          <p class="gv-about-product-card__desc">
            {%- if block.settings.desc != blank -%}
              {{ block.settings.desc }}
            {%- elsif p != blank -%}
              {{ p.description | strip_html | truncatewords: 20 }}
            {%- endif -%}
          </p>
          <div class="gv-about-product-card__footer">
            <div class="gv-about-product-card__price">
              {%- if block.settings.price != blank -%}
                {{ block.settings.price }}
              {%- elsif p != blank -%}
                {{ p.price | money }}
              {%- endif -%}
              <small>{{ block.settings.size }}</small>
            </div>
            {%- if p != blank -%}
              <a href="{{ p.url }}" class="gv-about-product-card__link">Shop <span>→</span></a>
            {%- elsif block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="gv-about-product-card__link">Shop <span>→</span></a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .gv-about-products { padding: 120px 40px; background: #FAFAFA; }
  .gv-about-products__header { text-align: center; margin-bottom: 72px; }

  .gv-about-products__label {
    font-family: 'Poppins', sans-serif !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #FF4D8D !important; margin-bottom: 16px;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .gv-about-products__label::before { content: ''; width: 28px; height: 1px; background: #FF4D8D; }

  .gv-about-products__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: clamp(32px, 3.5vw, 48px) !important; font-weight: 600 !important;
    color: #1A1A1A !important; line-height: 1.1 !important;
    letter-spacing: -0.02em; margin-bottom: 16px;
  }
  .gv-about-products__title em { font-style: normal !important; color: #FF4D8D !important; }
  .gv-about-products__sub { font-family: 'Poppins', sans-serif; font-size: 15px; color: #666; }

  .gv-about-products__grid {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;
  }

  .gv-about-product-card {
    background: white; border-radius: 16px; overflow: hidden;
    border: 1px solid #ECECEC;
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s;
  }
  .gv-about-product-card:hover { transform: translateY(-6px); box-shadow: 0 16px 48px rgba(0,0,0,0.1); }

  .gv-about-product-card__visual {
    height: 220px; display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .gv-about-product-card__visual--serum { background: linear-gradient(145deg, #FFF3D6, #FFCBA4, #F4845F); }
  .gv-about-product-card__visual--moisturizer { background: linear-gradient(145deg, #E8F4E8, #C8E6C8, #A8C5A0); }
  .gv-about-product-card__visual--spf { background: linear-gradient(145deg, #FFF9D6, #FFE4A0, #FFB347); }

  .gv-about-product-card__letter {
    font-family: 'Poppins', sans-serif; font-size: 100px; font-weight: 700;
    color: rgba(0,0,0,0.07); letter-spacing: -0.05em; line-height: 1;
  }
  .gv-about-product-card__badge {
    position: absolute; top: 14px; right: 14px; background: #1A1A1A;
    color: white; font-family: 'Poppins', sans-serif; font-size: 10px;
    font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 5px 10px; border-radius: 100px;
  }

  .gv-about-product-card__info { padding: 24px; }
  .gv-about-product-card__num {
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    color: #FF4D8D; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px;
  }
  .gv-about-product-card__name {
    font-family: 'Poppins', sans-serif !important;
    font-size: 19px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 8px; letter-spacing: -0.01em;
  }
  .gv-about-product-card__desc {
    font-family: 'Poppins', sans-serif; font-size: 13px; color: #666;
    line-height: 1.65; margin-bottom: 20px;
  }
  .gv-about-product-card__footer { display: flex; align-items: center; justify-content: space-between; }
  .gv-about-product-card__price {
    font-family: 'Poppins', sans-serif; font-size: 18px; font-weight: 700; color: #1A1A1A;
  }
  .gv-about-product-card__price small { font-size: 12px; font-weight: 400; color: #666; margin-left: 2px; }
  .gv-about-product-card__link {
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 600;
    color: #FF4D8D; display: flex; align-items: center; gap: 4px;
    text-decoration: none; transition: gap 0.2s;
  }
  .gv-about-product-card__link:hover { gap: 9px; }

  @media (max-width: 900px) { .gv-about-products__grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .gv-about-products { padding: 80px 24px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "About Products",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "— The Protocol —" },
    { "type": "html", "id": "title", "label": "Title", "default": "Three Products.<br><em>One System.</em>" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Each one complete. Better together." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "letter", "label": "Visual Letter", "default": "S" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Step 1" },
        {
          "type": "select", "id": "style", "label": "Visual Style",
          "options": [
            { "value": "serum", "label": "Serum (Warm)" },
            { "value": "moisturizer", "label": "Moisturizer (Green)" },
            { "value": "spf", "label": "SPF (Gold)" }
          ],
          "default": "serum"
        },
        { "type": "text", "id": "step", "label": "Step Label", "default": "01 — Brightening" },
        { "type": "text", "id": "name", "label": "Override Name" },
        { "type": "textarea", "id": "desc", "label": "Override Description" },
        { "type": "text", "id": "price", "label": "Override Price" },
        { "type": "text", "id": "size", "label": "Size", "default": "/30ml" },
        { "type": "url", "id": "link", "label": "Manual Link (If no product selected)" }
      ]
    }
  ],
  "presets": [{ "name": "About Products" }]
}
{% endschema %}
