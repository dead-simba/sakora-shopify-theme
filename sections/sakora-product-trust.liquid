{%- style -%}
  .sakora-trust {
    background-color: var(--sakora-stone);
    padding: 3rem 2rem;
    border-top: 0.5px solid #E0DCD4;
    border-bottom: 0.5px solid #E0DCD4;
  }
  .sakora-trust__wrapper {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media screen and (min-width: 750px) {
    .sakora-trust__wrapper {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }
  .sakora-trust__item {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }
  .sakora-trust__icon-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .sakora-trust__icon-dot--emerald {
    background-color: var(--sakora-emerald);
  }
  .sakora-trust__icon-dot--pink {
    background-color: #E8A0A0;
  }
  .sakora-trust__icon-dot--yellow {
    background-color: #E8B84B;
  }
  .sakora-trust__icon-dot--charcoal {
    background-color: var(--sakora-charcoal);
  }
  .sakora-trust__text {
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--sakora-charcoal);
  }
  .sakora-trust__text strong {
    font-weight: 500;
    display: block;
    font-size: 1.35rem;
    margin-bottom: 0.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
{%- endstyle -%}

<section class="sakora-trust">
  <div class="sakora-trust__wrapper">
    <div class="sakora-trust__item">
      <div class="sakora-trust__icon-dot sakora-trust__icon-dot--emerald"></div>
      <div class="sakora-trust__text">
        <strong>South Asian Skin</strong>
        Formulated specifically for local climate & pigmentation needs.
      </div>
    </div>
    <div class="sakora-trust__item">
      <div class="sakora-trust__icon-dot sakora-trust__icon-dot--pink"></div>
      <div class="sakora-trust__text">
        <strong>100% Ceramide Rebuild</strong>
        Clinically focused skin barrier protection & recovery.
      </div>
    </div>
    <div class="sakora-trust__item">
      <div class="sakora-trust__icon-dot sakora-trust__icon-dot--yellow"></div>
      <div class="sakora-trust__text">
        <strong>Zero Cast & Pilling</strong>
        Optimized for clean everyday summer layering.
      </div>
    </div>
    <div class="sakora-trust__item">
      <div class="sakora-trust__icon-dot sakora-trust__icon-dot--charcoal"></div>
      <div class="sakora-trust__text">
        <strong>Clean & Cruelty-Free</strong>
        Ethically formulated, paraben-free & vegan.
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sakora Product Trust",
  "settings": [],
  "presets": [
    {
      "name": "Sakora Product Trust"
    }
  ]
}
{% endschema %}
