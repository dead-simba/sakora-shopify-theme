<section class="gv-routine-builder">
  <div class="gv-container">
    <div class="gv-routine-inner">

      <div class="gv-routine-text">
        <div class="gv-routine-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="gv-routine-title">{{ section.settings.title }}</h2>
        <p class="gv-routine-desc">{{ section.settings.description }}</p>
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_url }}" class="gv-btn-primary gv-routine-cta">
            {{ section.settings.cta_label }} →
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="gv-routine-steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <div class="gv-routine-step" {{ block.shopify_attributes }}>
                <div class="gv-step-num">{{ forloop.index }}</div>
                <div class="gv-step-text">
                  <strong>{{ block.settings.title }}</strong>
                  {{ block.settings.description }}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% stylesheet %}
  .gv-routine-builder {
    background: var(--cream-glow);
    padding: 100px 0;
  }

  .gv-routine-inner {
    background: var(--berry-dark);
    border-radius: 32px;
    padding: 80px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
    position: relative;
    overflow: hidden;
  }
  .gv-routine-inner::before {
    content: '';
    position: absolute;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(244,132,95,0.2), transparent);
    top: -150px; right: -100px;
    pointer-events: none;
  }

  .gv-routine-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--coral-pulse);
    margin-bottom: 16px;
  }

  .gv-routine-title {
    font-family: var(--font-serif);
    font-size: 52px;
    font-weight: 300;
    color: #fff;
    line-height: 1.1;
    margin-bottom: 16px;
  }
  .gv-routine-title em { font-style: italic; color: var(--mango-zest); }

  .gv-routine-desc {
    font-family: var(--font-sans);
    font-size: 16px;
    color: rgba(255,255,255,0.6);
    max-width: 440px;
    line-height: 1.65;
    margin-bottom: 36px;
  }

  .gv-routine-cta { position: relative; z-index: 1; }

  /* Steps */
  .gv-routine-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: relative;
    z-index: 1;
    min-width: 260px;
  }

  .gv-routine-step {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .gv-step-num {
    background: var(--coral-pulse);
    color: #fff;
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .gv-step-text {
    font-family: var(--font-sans);
    font-size: 13px;
    color: rgba(255,255,255,0.85);
    line-height: 1.4;
  }
  .gv-step-text strong {
    color: #fff;
    display: block;
    font-size: 14px;
    margin-bottom: 2px;
  }

  @media (max-width: 900px) {
    .gv-routine-inner {
      grid-template-columns: 1fr;
      padding: 48px 32px;
      gap: 36px;
    }
    .gv-routine-title { font-size: 40px; }
  }
  @media (max-width: 568px) {
    .gv-routine-builder { padding: 70px 0; }
    .gv-routine-inner { padding: 36px 24px; border-radius: 24px; }
    .gv-routine-title { font-size: 32px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Routine Builder",
  "tag": "section",
  "class": "glowve-routine-builder-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "✦ Personalised Skincare"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title",
      "default": "<p>Not sure where<br>to <em>start?</em></p>"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Answer 5 quick questions and we'll build a custom routine for your skin type, concerns, and budget. No fluff — just the products that will actually work for you."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Take the Skin Quiz"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Quiz Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Tell us your skin type"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Step description",
          "default": "Dry, oily, combination, sensitive"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Glowve Routine Builder",
      "blocks": [
        { "type": "step", "settings": { "title": "Tell us your skin type", "description": "Dry, oily, combination, sensitive" } },
        { "type": "step", "settings": { "title": "Pick your concern", "description": "Dullness, dryness, acne, ageing" } },
        { "type": "step", "settings": { "title": "Get your routine", "description": "AM + PM, step by step" } }
      ]
    }
  ]
}
{% endschema %}
