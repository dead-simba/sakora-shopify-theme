<section class="gv-about-stats">
  <div class="gv-about-stats__inner">
    {%- for block in section.blocks -%}
      <div class="gv-about-stat" {{ block.shopify_attributes }}>
        <div class="gv-about-stat__num" data-stat-target="{{ block.settings.value | escape }}">{{ block.settings.value }}</div>
        <div class="gv-about-stat__label">{{ block.settings.label }}</div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .gv-about-stats { background: #FF4D8D; padding: 56px 40px; }
  .gv-about-stats__inner {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 40px; text-align: center;
  }
  .gv-about-stat__num {
    font-family: 'Poppins', sans-serif !important;
    font-size: 52px !important; font-weight: 700 !important;
    color: white !important; line-height: 1; margin-bottom: 8px;
    letter-spacing: -0.03em;
  }
  .gv-about-stat__label {
    font-family: 'Poppins', sans-serif; font-size: 13px;
    color: rgba(255,255,255,0.75); font-weight: 500; letter-spacing: 0.04em;
  }
  @media (max-width: 900px) { .gv-about-stats__inner { grid-template-columns: 1fr 1fr; gap: 32px; } }
{% endstylesheet %}

<script>
  (function initStatsCounter() {
    const statNumbers = document.querySelectorAll('.gv-about-stat__num');
    
    function animateCounter(el) {
      const targetStr = el.getAttribute('data-stat-target');
      const targetNum = parseFloat(targetStr.replace(/[^0-9.]/g, ''));
      const suffix = targetStr.replace(/[0-9.]/g, '');
      const duration = 2000;
      const startTime = performance.now();

      function update(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const currentVal = Math.floor(progress * targetNum);
        
        el.textContent = currentVal + suffix;
        
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          el.textContent = targetStr;
        }
      }
      requestAnimationFrame(update);
    }

    const statsObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          statsObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    statNumbers.forEach(el => statsObserver.observe(el));
  })();
</script>

{% schema %}
{
  "name": "Stats Bar",
  "settings": [],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "100%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Signature Scent" }
      ]
    }
  ],
  "presets": [{ "name": "Stats Bar" }]
}
{% endschema %}
