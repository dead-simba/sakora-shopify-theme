<section class="gv-about-gaps">
  <div class="gv-about-gaps__header">
    <p class="gv-about-gaps__label">{{ section.settings.label }}</p>
    <h2 class="gv-about-gaps__title">{{ section.settings.title }}</h2>
    <p class="gv-about-gaps__sub">{{ section.settings.subtitle }}</p>
  </div>

  <div class="gv-about-gaps__grid">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      <div class="gv-about-gap-card" {{ block.shopify_attributes }}>
        <div class="gv-about-gap-card__num">{{ block.settings.number }}</div>
        <h3 class="gv-about-gap-card__title">{{ block.settings.headline }}</h3>
        <p class="gv-about-gap-card__body">{{ block.settings.body }}</p>
        {%- if block.settings.chip != blank -%}
          {%- if p != blank or block.settings.link != blank -%}
            <a href="{% if p != blank %}{{ p.url }}{% else %}{{ block.settings.link }}{% endif %}" class="gv-about-gap-card__chip gv-about-gap-card__chip--link">
              {{ block.settings.chip }}
            </a>
          {%- else -%}
            <span class="gv-about-gap-card__chip">{{ block.settings.chip }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .gv-about-gaps { padding: 120px 40px; background: #FFF0E6; }
  .gv-about-gaps__header { text-align: center; max-width: 640px; margin: 0 auto 80px; }

  .gv-about-gaps__label {
    font-family: 'Poppins', sans-serif !important;
    font-size: 11px !important; font-weight: 700 !important;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: #FF4D8D !important; margin-bottom: 16px;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }
  .gv-about-gaps__label::before { content: ''; width: 28px; height: 1px; background: #FF4D8D; }

  .gv-about-gaps__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: clamp(32px, 3.5vw, 48px) !important; font-weight: 600 !important;
    color: #1A1A1A !important; line-height: 1.1 !important;
    letter-spacing: -0.02em; margin-bottom: 16px;
  }
  .gv-about-gaps__title em { font-style: normal !important; color: #FF4D8D !important; }
  .gv-about-gaps__sub { font-family: 'Poppins', sans-serif; font-size: 16px; color: #666; line-height: 1.7; }

  .gv-about-gaps__grid {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr; gap: 20px;
  }

  .gv-about-gap-card {
    background: white; border-radius: 20px; padding: 48px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 4px 20px rgba(0,0,0,0.04);
    transition: transform 0.3s cubic-bezier(0.25,0.46,0.45,0.94), box-shadow 0.3s;
  }
  .gv-about-gap-card:hover { transform: translateY(-8px); box-shadow: 0 16px 48px rgba(0,0,0,0.1); }

  .gv-about-gap-card__num {
    font-family: 'Poppins', sans-serif; font-size: 72px; font-weight: 700;
    color: #FF4D8D; opacity: 0.12; line-height: 1; margin-bottom: 4px; letter-spacing: -0.04em;
  }
  .gv-about-gap-card__title {
    font-family: 'Poppins', sans-serif !important;
    font-size: 24px !important; font-weight: 600 !important;
    color: #1A1A1A !important; margin-bottom: 14px; letter-spacing: -0.01em;
  }
  .gv-about-gap-card__body {
    font-family: 'Poppins', sans-serif; font-size: 15px; color: #666;
    line-height: 1.75; margin-bottom: 24px;
  }
  .gv-about-gap-card__chip {
    display: inline-flex; align-items: center; gap: 8px;
    background: #FF4D8D; color: white; padding: 10px 18px;
    border-radius: 100px; font-family: 'Poppins', sans-serif;
    font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
    text-decoration: none;
  }
  .gv-about-gap-card__chip::before { content: '→'; }
  .gv-about-gap-card__chip--link:hover { opacity: 0.9; transform: scale(1.02); }

  @media (max-width: 900px) { .gv-about-gaps__grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .gv-about-gaps { padding: 80px 24px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Science Gaps",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "— Why We Exist —" },
    { "type": "html", "id": "title", "label": "Title", "default": "Solving the<br><em>Mismatched Science.</em>" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Every Glowve product exists because a specific gap did." }
  ],
  "blocks": [
    {
      "type": "gap",
      "name": "Gap Card",
      "settings": [
        { "type": "product", "id": "product", "label": "Product (Optional link)" },
        { "type": "url", "id": "link", "label": "Manual Link (If no product)" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "headline", "label": "Headline", "default": "The UV Mismatch" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Most sunscreens are tested for European UV indices (average 4). In Pakistan, we regularly hit 10–12." },
        { "type": "text", "id": "chip", "label": "Chip Label", "default": "PA++++ · SPF 50+" }
      ]
    }
  ],
  "presets": [{ "name": "Science Gaps" }]
}
{% endschema %}
