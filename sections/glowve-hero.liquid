{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
{%- assign slide_count = slide_blocks | size -%}

<section
  class="gv-hero"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  aria-label="Hero banner"
>

  {%- comment -%} SLIDE IMAGES {%- endcomment -%}
  <div class="gv-hero-slides">
    {%- if slide_count > 0 -%}
      {%- for block in slide_blocks -%}
        <div class="gv-hero-slide{% if forloop.first %} active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <picture>
              {%- if block.settings.mobile_image != blank -%}
                <source media="(max-width: 768px)" srcset="{{ block.settings.mobile_image | image_url: width: 800 }} 800w, {{ block.settings.mobile_image | image_url: width: 1200 }} 1200w" sizes="100vw">
              {%- endif -%}
              <source media="(min-width: 769px)" srcset="{{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2000 }} 2000w" sizes="100vw">
              {%- if forloop.first -%}
                {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'gv-hero-bg-img' }}
              {%- else -%}
                {{ block.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'gv-hero-bg-img' }}
              {%- endif -%}
            </picture>
          {%- else -%}
            <div class="gv-hero-bg-placeholder gv-hero-bg-placeholder--{{ forloop.index }}"></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="gv-hero-slide active">
        <div class="gv-hero-bg-placeholder gv-hero-bg-placeholder--1"></div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} FLOATING COPY CARDS — one per slide {%- endcomment -%}
  <div class="gv-hero-cards">
    {%- if slide_count > 0 -%}
      {%- for block in slide_blocks -%}
        <div class="gv-hero-card{% if forloop.first %} active{% endif %}">
          {%- if block.settings.eyebrow != blank -%}
            <p class="gv-hero-eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          <h1 class="gv-hero-headline">{{ block.settings.headline }}</h1>
          {%- if block.settings.subline != blank -%}
            <p class="gv-hero-subline">{{ block.settings.subline }}</p>
          {%- endif -%}
          <div class="gv-hero-ctas">
            {%- if block.settings.cta_primary_label != blank -%}
              <a href="{{ block.settings.cta_primary_url }}" class="gv-btn-primary">{{ block.settings.cta_primary_label }}</a>
            {%- endif -%}
            {%- if block.settings.cta_secondary_label != blank -%}
              <a href="{{ block.settings.cta_secondary_url }}" class="gv-btn-secondary">{{ block.settings.cta_secondary_label }}</a>
            {%- endif -%}
          </div>
          {%- if section.settings.trust_rating != blank -%}
            <div class="gv-hero-trust">
              <span class="gv-hero-stars">★★★★★</span>
              <p class="gv-hero-trust-text"><strong>{{ section.settings.trust_rating }}</strong> {{ section.settings.trust_reviews }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="gv-hero-card active">
        <p class="gv-hero-eyebrow">{{ section.settings.eyebrow }}</p>
        <h1 class="gv-hero-headline">{{ section.settings.headline }}</h1>
        <p class="gv-hero-subline">{{ section.settings.subline }}</p>
        <div class="gv-hero-ctas">
          <a href="{{ section.settings.cta_primary_url }}" class="gv-btn-primary">{{ section.settings.cta_primary_label }}</a>
          <a href="{{ section.settings.cta_secondary_url }}" class="gv-btn-secondary">{{ section.settings.cta_secondary_label }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} DOTS + ARROWS (only when 2+ slides) {%- endcomment -%}
  {%- if slide_count > 1 -%}
    <div class="gv-hero-dots">
      {%- for block in slide_blocks -%}
        <button class="gv-hero-dot{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
    <button class="gv-hero-arrow gv-hero-arrow--prev" aria-label="Previous">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="gv-hero-arrow gv-hero-arrow--next" aria-label="Next">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  {%- endif -%}

</section>

<script>
(function() {
  var wrap = document.currentScript.closest('.glowve-hero-wrapper').querySelector('.gv-hero');
  if (!wrap) return;
  var slides  = wrap.querySelectorAll('.gv-hero-slide');
  var cards   = wrap.querySelectorAll('.gv-hero-card');
  var dots    = wrap.querySelectorAll('.gv-hero-dot');
  var total   = slides.length;
  if (total < 2) return;
  var cur = 0, timer = null;
  var doAutoplay = wrap.dataset.autoplay === 'true';
  var speed = parseInt(wrap.dataset.speed) || 5000;

  function go(n) {
    slides[cur].classList.remove('active');
    cards[cur].classList.remove('active');
    if (dots[cur]) dots[cur].classList.remove('active');
    cur = (n + total) % total;
    slides[cur].classList.add('active');
    cards[cur].classList.add('active');
    if (dots[cur]) dots[cur].classList.add('active');
  }
  function tick() { go(cur + 1); }
  function start() { if (doAutoplay) timer = setInterval(tick, speed); }
  function reset() { clearInterval(timer); start(); }

  dots.forEach(function(d) { d.addEventListener('click', function() { go(+this.dataset.index); reset(); }); });
  var prev = wrap.querySelector('.gv-hero-arrow--prev');
  var next = wrap.querySelector('.gv-hero-arrow--next');
  if (prev) prev.addEventListener('click', function() { go(cur - 1); reset(); });
  if (next) next.addEventListener('click', function() { go(cur + 1); reset(); });
  wrap.addEventListener('mouseenter', function() { clearInterval(timer); });
  wrap.addEventListener('mouseleave', start);
  var tx = 0;
  wrap.addEventListener('touchstart', function(e) { tx = e.touches[0].clientX; }, { passive: true });
  wrap.addEventListener('touchend', function(e) {
    var d = tx - e.changedTouches[0].clientX;
    if (Math.abs(d) > 50) { go(d > 0 ? cur + 1 : cur - 1); reset(); }
  });
  start();
})();
</script>

{% stylesheet %}
  .gv-hero { position: relative; background: var(--cream-glow); overflow: hidden; }

  /* Slides */
  .gv-hero-slides { position: relative; min-height: 560px; }
  .gv-hero-slide {
    position: absolute; inset: 0;
    opacity: 0; transition: opacity 0.8s ease; pointer-events: none;
  }
  .gv-hero-slide.active { opacity: 1; position: relative; pointer-events: auto; }

  .gv-hero-bg-img { width: 100%; min-height: 560px; object-fit: cover; object-position: center top; display: block; }
  @media (max-width: 768px) { .gv-hero-bg-img { object-position: center center; } }
  .gv-hero-bg-placeholder { position: absolute; inset: 0; min-height: 560px; }
  .gv-hero-bg-placeholder--1 { background: linear-gradient(135deg, var(--accent-peach), #FFD4BE); }
  .gv-hero-bg-placeholder--2 { background: linear-gradient(135deg, var(--accent-mint), #B8E8D4); }
  .gv-hero-bg-placeholder--3 { background: linear-gradient(135deg, var(--accent-yellow), #FFE08A); }

  /* Cards */
  .gv-hero-cards { position: absolute; top: 50%; left: 4%; transform: translateY(-50%); z-index: 3; width: min(420px, 42vw); }
  .gv-hero-card {
    display: none;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 28px 32px;
    border-radius: 20px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.10);
  }
  .gv-hero-card.active { display: block; animation: gv-card-in 0.5s ease; }
  @keyframes gv-card-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .gv-hero-eyebrow { font-family: var(--font-sans); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--coral-pulse); margin-bottom: 10px; }
  /* Override Horizon's h1 size — card headline is intentionally smaller */
  .gv-hero-headline { font-family: var(--font-sans) !important; font-size: 38px !important; font-weight: 700 !important; line-height: 1.1 !important; color: var(--berry-dark) !important; margin-bottom: 12px !important; letter-spacing: -0.01em !important; }
  .gv-hero-headline em { font-style: normal !important; color: var(--coral-pulse) !important; }
  .gv-hero-subline { font-family: var(--font-sans); font-size: 14px; color: var(--mid-gray); line-height: 1.6; margin-bottom: 22px; }
  .gv-hero-ctas { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; margin-bottom: 24px; }
  .gv-hero-trust { display: flex; align-items: center; gap: 10px; padding-top: 20px; border-top: 1px solid var(--warm-gray); }
  .gv-hero-stars { color: var(--coral-pulse); font-size: 13px; }
  .gv-hero-trust-text { font-family: var(--font-sans); font-size: 13px; color: var(--mid-gray); }
  .gv-hero-trust-text strong { color: var(--warm-espresso); font-weight: 600; }

  /* Dots */
  .gv-hero-dots { position: absolute; bottom: 20px; right: 24px; display: flex; gap: 8px; z-index: 5; }
  .gv-hero-dot { width: 8px; height: 8px; border-radius: 50%; border: none; background: rgba(255,255,255,0.5); cursor: pointer; padding: 8px; box-sizing: content-box; transition: background 0.3s, transform 0.3s; }
  .gv-hero-dot.active { background: var(--coral-pulse); transform: scale(1.3); }

  /* Arrows */
  .gv-hero-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; background: rgba(255,255,255,0.9); border: none; border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; color: var(--berry-dark); box-shadow: 0 4px 16px rgba(0,0,0,0.12); transition: background 0.2s; }
  .gv-hero-arrow:hover { background: #fff; }
  .gv-hero-arrow--prev { left: 20px; }
  .gv-hero-arrow--next { right: 20px; }

  /* Tablet — narrow the card a bit */
  @media (max-width: 1024px) and (min-width: 769px) {
    .gv-hero-cards { width: min(380px, 48vw); }
    .gv-hero-headline { font-size: 32px !important; }
  }

  /* Mobile — card drops below image, full width */
  @media (max-width: 768px) {
    .gv-hero-slides, .gv-hero-bg-img, .gv-hero-bg-placeholder { min-height: 400px; }
    .gv-hero-cards { position: relative; bottom: auto; left: auto; width: 100%; top: auto; transform: none; }
    .gv-hero-card { border-radius: 0; box-shadow: none; border-top: 3px solid var(--coral-pulse); padding: 24px 20px; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .gv-hero-headline { font-size: 28px !important; letter-spacing: 0 !important; }
    .gv-hero-subline { font-size: 14px; }
    .gv-hero-arrow { display: none; }
    .gv-hero-dots { position: absolute; top: 370px; right: 12px; bottom: auto; }
    .gv-hero-ctas { gap: 12px; }
    .gv-hero-trust { flex-wrap: wrap; gap: 6px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Hero",
  "tag": "div",
  "class": "glowve-hero-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds per slide",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Fallback copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Glow your way."
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Skin that <em>glows,</em><br>from ingredients that earn it.</p>"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Sub-headline",
      "default": "No fluff, no filler. Just real actives at real concentrations — made for Pakistan."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Build My Routine"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA link"
    },
    {
