{%- liquid
  assign has_image = false
  if section.settings.hero_image != blank
    assign has_image = true
  endif
  assign hero_product_1 = all_products[section.settings.hero_product_1]
  assign hero_product_2 = all_products[section.settings.hero_product_2]
  assign hero_product_3 = all_products[section.settings.hero_product_3]
-%}

<section class="gv-hero" aria-label="{{ section.settings.eyebrow | escape }}">

  {%- comment -%} — HERO BANNER IMAGE — {%- endcomment -%}
  <div class="gv-hero-banner">
    {%- if has_image -%}
      {%- assign img_alt = section.settings.hero_image.alt | default: section.settings.eyebrow | escape -%}
      {{ section.settings.hero_image | image_url: width: 2000 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        class: 'gv-hero-bg-img',
        alt: img_alt,
        widths: '800, 1200, 1600, 2000',
        sizes: '100vw'
      }}
    {%- else -%}
      <div class="gv-hero-bg-placeholder"></div>
    {%- endif -%}

    {%- comment -%} — PRODUCT STACK (shown in placeholder mode only) — {%- endcomment -%}
    {%- unless has_image -%}
      <div class="gv-hero-stack" aria-hidden="true">
        <div class="gv-stack-card gv-stack-card--1">
          <span class="gv-stack-badge">{{ section.settings.stack_badge_1 }}</span>
          {%- if hero_product_1.featured_image -%}
            {{ hero_product_1.featured_image | image_url: width: 280 | image_tag: loading: 'eager', class: 'gv-stack-img', alt: hero_product_1.title | escape, width: 280, height: 280 }}
          {%- else -%}
            <div class="gv-stack-img gv-stack-placeholder gv-stack-placeholder--1"></div>
          {%- endif -%}
          <p class="gv-stack-name">{{ hero_product_1.title | default: section.settings.stack_name_1 }}</p>
          <p class="gv-stack-tag">{{ section.settings.stack_tag_1 }}</p>
        </div>
        <div class="gv-stack-card gv-stack-card--2">
          {%- if hero_product_2.featured_image -%}
            {{ hero_product_2.featured_image | image_url: width: 240 | image_tag: loading: 'eager', class: 'gv-stack-img', alt: hero_product_2.title | escape, width: 240, height: 240 }}
          {%- else -%}
            <div class="gv-stack-img gv-stack-placeholder gv-stack-placeholder--2"></div>
          {%- endif -%}
          <p class="gv-stack-name">{{ hero_product_2.title | default: section.settings.stack_name_2 }}</p>
          <p class="gv-stack-tag">{{ section.settings.stack_tag_2 }}</p>
        </div>
        <div class="gv-stack-card gv-stack-card--3">
          {%- if hero_product_3.featured_image -%}
            {{ hero_product_3.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'gv-stack-img', alt: hero_product_3.title | escape, width: 200, height: 200 }}
          {%- else -%}
            <div class="gv-stack-img gv-stack-placeholder gv-stack-placeholder--3"></div>
          {%- endif -%}
          <p class="gv-stack-name">{{ hero_product_3.title | default: section.settings.stack_name_3 }}</p>
          <p class="gv-stack-tag">{{ section.settings.stack_tag_3 }}</p>
        </div>
      </div>
    {%- endunless -%}
  </div>

  {%- comment -%} — FLOATING COPY CARD — {%- endcomment -%}
  <div class="gv-hero-card">
    {%- if section.settings.eyebrow != blank -%}
      <p class="gv-hero-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="gv-hero-headline">{{ section.settings.headline }}</h1>

    {%- if section.settings.subline != blank -%}
      <p class="gv-hero-subline">{{ section.settings.subline }}</p>
    {%- endif -%}

    <div class="gv-hero-ctas">
      {%- if section.settings.cta_primary_label != blank -%}
        <a href="{{ section.settings.cta_primary_url }}" class="gv-btn-primary">
          {{ section.settings.cta_primary_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_label != blank -%}
        <a href="{{ section.settings.cta_secondary_url }}" class="gv-btn-secondary">
          {{ section.settings.cta_secondary_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.trust_rating != blank -%}
      <div class="gv-hero-trust">
        <div class="gv-hero-stars" aria-label="5 stars">
          {%- for i in (1..5) -%}★{%- endfor -%}
        </div>
        <p class="gv-hero-trust-text">
          <strong>{{ section.settings.trust_rating }}</strong> {{ section.settings.trust_reviews }}
        </p>
      </div>
    {%- endif -%}
  </div>

</section>

{% stylesheet %}
  /* ---- Hero wrapper ---- */
  .gv-hero {
    position: relative;
    background: var(--cream-glow);
    overflow: hidden;
  }

  /* ---- Banner image ---- */
  .gv-hero-banner {
    width: 100%;
    min-height: 560px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gv-hero-bg-img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Fallback gradient when no image is set */
  .gv-hero-bg-placeholder {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--accent-peach) 0%, var(--accent-mint) 100%);
  }

  /* ---- Floating copy card ---- */
  .gv-hero-card {
    position: absolute;
    bottom: 8%;
    left: 4%;
    background: rgba(255, 255, 255, 0.97);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 36px 44px;
    border-radius: 24px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.10);
    max-width: 460px;
    z-index: 10;
  }

  .gv-hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral-pulse);
    margin-bottom: 14px;
  }

  .gv-hero-headline {
    font-family: var(--font-sans);
    font-size: var(--gv-hero-headline-size);
    font-weight: 600;
    line-height: 1.1;
    color: var(--berry-dark);
    letter-spacing: 0;
    margin-bottom: 14px;
  }

  .gv-hero-headline em {
    font-style: normal !important;
    color: var(--coral-pulse) !important;
  }

  .gv-hero-subline {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--mid-gray);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .gv-hero-ctas {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .gv-hero-trust {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--warm-gray);
    flex-wrap: wrap;
  }

  .gv-hero-stars {
    color: var(--mango-zest);
    font-size: 13px;
    letter-spacing: 1px;
  }

  .gv-hero-trust-text {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--mid-gray);
  }

  .gv-hero-trust-text strong {
    color: var(--warm-espresso);
    font-weight: 600;
  }

  /* ---- Product stack (no-image fallback) ---- */
  .gv-hero-stack {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gv-stack-card {
    background: #fff;
    border-radius: 20px;
    padding: 20px;
    position: relative;
    border: 1px solid var(--warm-gray);
  }
  .gv-stack-card--1 { width: 200px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
  .gv-stack-card--2 { width: 180px; margin-top: -14px; margin-left: 80px; box-shadow: 0 8px 24px rgba(0,0,0,0.06); }
  .gv-stack-card--3 { width: 160px; margin-top: -14px; margin-left: -60px; box-shadow: 0 8px 24px rgba(0,0,0,0.05); }

  .gv-stack-badge {
    position: absolute;
    top: -10px; right: -10px;
    background: var(--coral-pulse);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }

  .gv-stack-img {
    width: 100%; aspect-ratio: 1;
    object-fit: contain;
    border-radius: 10px;
    display: block;
    margin-bottom: 12px;
  }
  .gv-stack-placeholder   { background: linear-gradient(135deg, #FFF3D6, #FFD58044); }
  .gv-stack-placeholder--2 { background: linear-gradient(135deg, #FFE0E8, #FF8FA344); }
  .gv-stack-placeholder--3 { background: linear-gradient(135deg, #E8F5E4, #A8C5A044); }

  .gv-stack-name {
    font-family: var(--font-sans);
    font-size: 11px; font-weight: 600;
    color: var(--warm-espresso);
    margin-bottom: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .gv-stack-tag {
    font-family: var(--font-sans);
    font-size: 9px;
    color: var(--coral-pulse);
    letter-spacing: 0.04em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .gv-hero-banner { min-height: 380px; }
    .gv-hero-bg-img { min-height: 380px; }
    .gv-hero-card {
      position: relative;
      bottom: auto;
      left: auto;
      max-width: 100%;
      border-radius: 0;
      box-shadow: none;
      border-top: 1px solid var(--warm-gray);
      padding: 32px 20px;
    }
    .gv-hero-headline { font-size: clamp(28px, 8vw, 44px); }
    .gv-hero-stack { transform: scale(0.82); transform-origin: center top; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Hero",
  "tag": "div",
  "class": "glowve-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Recommended: 2000×900px, landscape. Fills full width; copy card floats over it bottom-left."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Glow your way."
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline (wrap in <em> for pink highlight)",
      "default": "<p>Skin that <em>glows,</em><br>from ingredients that earn it.</p>"
    },
    {
      "type": "text",
      "id": "subline",
