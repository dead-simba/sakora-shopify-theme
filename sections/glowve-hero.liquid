{%- assign slide_count = section.blocks | where: 'type', 'slide' | size -%}

<section
  class="gv-hero"
  id="gv-hero-{{ section.id }}"
  aria-label="Hero banner"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed | default: 5000 }}"
>

  {%- comment -%} — SLIDE IMAGES — {%- endcomment -%}
  <div class="gv-hero-slides" aria-live="off">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div
          class="gv-hero-slide{% if forloop.first %} gv-hero-slide--active{% endif %}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag:
              loading: 'eager',
              fetchpriority: 'high',
              class: 'gv-hero-bg-img',
              alt: block.settings.image.alt,
              widths: '800, 1200, 1600, 2000',
              sizes: '100vw'
            }}
          {%- else -%}
            <div class="gv-hero-bg-placeholder gv-hero-bg-placeholder--{{ forloop.index }}"></div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if slide_count == 0 -%}
      <div class="gv-hero-slide gv-hero-slide--active">
        <div class="gv-hero-bg-placeholder"></div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} — FLOATING COPY CARDS (one per slide, crossfade in sync) — {%- endcomment -%}
  <div class="gv-hero-cards">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div class="gv-hero-card{% if forloop.first %} gv-hero-card--active{% endif %}">
          {%- if block.settings.eyebrow != blank -%}
            <p class="gv-hero-eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}

          <h1 class="gv-hero-headline">{{ block.settings.headline }}</h1>

          {%- if block.settings.subline != blank -%}
            <p class="gv-hero-subline">{{ block.settings.subline }}</p>
          {%- endif -%}

          <div class="gv-hero-ctas">
            {%- if block.settings.cta_primary_label != blank -%}
              <a href="{{ block.settings.cta_primary_url }}" class="gv-btn-primary">
                {{ block.settings.cta_primary_label }}
              </a>
            {%- endif -%}
            {%- if block.settings.cta_secondary_label != blank -%}
              <a href="{{ block.settings.cta_secondary_url }}" class="gv-btn-secondary">
                {{ block.settings.cta_secondary_label }}
              </a>
            {%- endif -%}
          </div>

          {%- if section.settings.trust_rating != blank -%}
            <div class="gv-hero-trust">
              <div class="gv-hero-stars" aria-label="5 stars">★★★★★</div>
              <p class="gv-hero-trust-text">
                <strong>{{ section.settings.trust_rating }}</strong> {{ section.settings.trust_reviews }}
              </p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if slide_count == 0 -%}
      <div class="gv-hero-card gv-hero-card--active">
        <p class="gv-hero-eyebrow">Glow your way.</p>
        <h1 class="gv-hero-headline">Skin that <em>glows,</em><br>from ingredients that earn it.</h1>
        <p class="gv-hero-subline">No fluff, no filler. Just real actives at real concentrations — made for Pakistan.</p>
        <div class="gv-hero-ctas">
          <a href="/collections/all" class="gv-btn-primary">Shop Bestsellers</a>
        </div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} — DOT NAVIGATION — {%- endcomment -%}
  {%- if slide_count > 1 -%}
    <div class="gv-hero-dots" role="tablist" aria-label="Slide navigation">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <button
            class="gv-hero-dot{% if forloop.first %} gv-hero-dot--active{% endif %}"
            data-index="{{ forloop.index0 }}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} — PREV / NEXT ARROWS — {%- endcomment -%}
  {%- if slide_count > 1 -%}
    <button class="gv-hero-arrow gv-hero-arrow--prev" aria-label="Previous slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <button class="gv-hero-arrow gv-hero-arrow--next" aria-label="Next slide">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  {%- endif -%}

</section>

{% stylesheet %}
  /* ---- Wrapper ---- */
  .gv-hero {
    position: relative;
    background: var(--cream-glow);
    overflow: hidden;
    user-select: none;
  }

  /* ---- Slide images (crossfade stack) ---- */
  .gv-hero-slides {
    position: relative;
    width: 100%;
    min-height: 560px;
  }

  .gv-hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    pointer-events: none;
  }
  .gv-hero-slide--active {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }

  .gv-hero-bg-img {
    width: 100%;
    height: 100%;
    min-height: 560px;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .gv-hero-bg-placeholder {
    position: absolute;
    inset: 0;
    min-height: 560px;
  }
  .gv-hero-bg-placeholder--1 { background: linear-gradient(135deg, var(--accent-peach) 0%, #FFD4BE 100%); }
  .gv-hero-bg-placeholder--2 { background: linear-gradient(135deg, var(--accent-mint) 0%, #B8E8D4 100%); }
  .gv-hero-bg-placeholder--3 { background: linear-gradient(135deg, var(--accent-yellow) 0%, #FFE08A 100%); }
  .gv-hero-bg-placeholder     { background: linear-gradient(135deg, var(--accent-peach) 0%, var(--accent-mint) 100%); }

  /* ---- Floating copy cards ---- */
  .gv-hero-cards {
    position: absolute;
    bottom: 8%;
    left: 4%;
    z-index: 10;
    width: min(460px, 90vw);
  }

  .gv-hero-card {
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.97);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 36px 44px;
    border-radius: 24px;
    box-shadow: 0 12px 40px rgba(0,0,0,0.10);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    pointer-events: none;
    /* make sure each card is tall enough for its content */
    position: relative;
    display: none;
  }
  .gv-hero-card--active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    display: block;
  }

  .gv-hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral-pulse);
    margin-bottom: 14px;
  }

  .gv-hero-headline {
    font-family: var(--font-sans);
    font-size: var(--gv-hero-headline-size);
    font-weight: 600;
    line-height: 1.1;
    color: var(--berry-dark);
    letter-spacing: 0;
    margin-bottom: 14px;
  }
  .gv-hero-headline em { font-style: normal !important; color: var(--coral-pulse) !important; }

  .gv-hero-subline {
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--mid-gray);
    line-height: 1.65;
    margin-bottom: 28px;
  }

  .gv-hero-ctas {
    display: flex;
    gap: 20px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }

  .gv-hero-trust {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--warm-gray);
    flex-wrap: wrap;
  }
  .gv-hero-stars { color: var(--coral-pulse); font-size: 13px; letter-spacing: 1px; }
  .gv-hero-trust-text { font-family: var(--font-sans); font-size: 13px; color: var(--mid-gray); }
  .gv-hero-trust-text strong { color: var(--warm-espresso); font-weight: 600; }

  /* ---- Dot navigation ---- */
  .gv-hero-dots {
    position: absolute;
    bottom: 20px;
    right: 28px;
    display: flex;
    gap: 8px;
    z-index: 20;
  }

  .gv-hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.5);
    cursor: pointer;
    padding: 0;
    transition: background 0.3s, transform 0.3s;
  }
  .gv-hero-dot--active {
    background: var(--coral-pulse);
    transform: scale(1.3);
  }

  /* ---- Arrow buttons ---- */
  .gv-hero-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 20;
    background: rgba(255,255,255,0.9);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--berry-dark);
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    transition: background 0.2s, transform 0.2s;
  }
  .gv-hero-arrow:hover { background: #fff; transform: translateY(-50%) scale(1.06); }
  .gv-hero-arrow--prev { left: 20px; }
  .gv-hero-arrow--next { right: 20px; }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .gv-hero-slides { min-height: 360px; }
    .gv-hero-slide { min-height: 360px; }
    .gv-hero-bg-img { min-height: 360px; }
    .gv-hero-bg-placeholder { min-height: 360px; }
    .gv-hero-cards {
      position: relative;
      bottom: auto;
      left: auto;
      width: 100%;
    }
    .gv-hero-card {
      border-radius: 0;
      box-shadow: none;
      border-top: 1px solid var(--warm-gray);
      padding: 28px 20px;
    }
    .gv-hero-headline { font-size: clamp(26px, 7vw, 40px); }
    .gv-hero-arrow { display: none; }
    .gv-hero-dots { right: 12px; bottom: auto; top: 340px; }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    var section = document.getElementById('gv-hero-{{ section.id }}');
    if (!section) return;

    var slides     = Array.from(section.querySelectorAll('.gv-hero-slide'));
    var cards      = Array.from(section.querySelectorAll('.gv-hero-card'));
    var dots       = Array.from(section.querySelectorAll('.gv-hero-dot'));
    var prevBtn    = section.querySelector('.gv-hero-arrow--prev');
    var nextBtn    = section.querySelector('.gv-hero-arrow--next');
    var total      = slides.length;
    var current    = 0;
    var autoplay   = section.dataset.autoplay === 'true';
    var speed      = parseInt(section.dataset.speed) || 5000;
    var timer      = null;

    if (total <= 1) return;

    function goTo(index) {
      slides[current].classList.remove('gv-hero-slide--active');
      slides[current].setAttribute('aria-hidden', 'true');
      cards[current].classList.remove('gv-hero-card--active');
      if (dots[current]) {
        dots[current].classList.remove('gv-hero-dot--active');
        dots[current].setAttribute('aria-selected', 'false');
      }

      current = (index + total) % total;

      slides[current].classList.add('gv-hero-slide--active');
      slides[current].setAttribute('aria-hidden', 'false');
      cards[current].classList.add('gv-hero-card--active');
      if (dots[current]) {
        dots[current].classList.add('gv-hero-dot--active');
        dots[current].setAttribute('aria-selected', 'true');
      }
    }

    function startTimer() {
      if (!autoplay) return;
      timer = setInterval(function() { goTo(current + 1); }, speed);
    }

    function resetTimer() {
      clearInterval(timer);
      startTimer();
    }

    /* Dot clicks */
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        goTo(parseInt(this.dataset.index));
        resetTimer();
      });
    });

    /* Arrow clicks */
    if (prevBtn) prevBtn.addEventListener('click', function() { goTo(current - 1); resetTimer(); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goTo(current + 1); resetTimer(); });

    /* Pause on hover */
    section.addEventListener('mouseenter', function() { clearInterval(timer); });
    section.addEventListener('mouseleave', startTimer);

    /* Touch swipe */
    var touchStartX = 0;
    section.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
    section.addEventListener('touchend', function(e) {
      var diff = touchStartX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) { goTo(diff > 0 ? current + 1 : current - 1); resetTimer(); }
    });

    startTimer();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Glowve Hero Slider",
  "tag": "div",
  "class": "glowve-hero-wrapper",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Autoplay"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
