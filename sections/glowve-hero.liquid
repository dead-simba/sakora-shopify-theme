          "label": "Eyebrow text",
          "default": "Glow your way."
        },
        {
          "type": "richtext",
          "id": "headline",
          "label": "Headline",
          "default": "<p>Skin that <em>glows,</em><br>from ingredients that earn it.</p>"
        },
        {
          "type": "text",
          "id": "subline",
          "label": "Sub-headline",
          "default": "No fluff, no filler. Just real actives — made for Pakistan."
        },
        {
          "type": "text",
          "id": "cta_primary_label",
          "label": "Primary button label",
          "default": "Shop Bestsellers"
        },
        {
          "type": "url",
          "id": "cta_primary_url",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "cta_secondary_label",
          "label": "Secondary button label",
          "default": "Build My Routine"
        },
        {
          "type": "url",
          "id": "cta_secondary_url",
