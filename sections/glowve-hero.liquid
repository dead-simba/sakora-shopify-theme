{%- liquid
  assign has_image   = false
  if section.settings.hero_image != blank
    assign has_image = true
  endif
  assign hero_product_1 = all_products[section.settings.hero_product_1]
  assign hero_product_2 = all_products[section.settings.hero_product_2]
  assign hero_product_3 = all_products[section.settings.hero_product_3]
-%}

<section
  class="gv-hero{% if has_image %} gv-hero--has-image{% endif %}"
  aria-label="{{ section.settings.eyebrow | escape }}"
>

  {%- comment -%} LEFT: Copy {%- endcomment -%}
  <div class="gv-hero-left">
    <p class="gv-hero-eyebrow">{{ section.settings.eyebrow }}</p>

    <h1 class="gv-hero-headline">{{ section.settings.headline }}</h1>

    <p class="gv-hero-subline">{{ section.settings.subline }}</p>

    <div class="gv-hero-ctas">
      {%- if section.settings.cta_primary_label != blank -%}
        <a href="{{ section.settings.cta_primary_url }}" class="gv-btn-primary">
          {{ section.settings.cta_primary_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_label != blank -%}
        <a href="{{ section.settings.cta_secondary_url }}" class="gv-btn-secondary">
          {{ section.settings.cta_secondary_label }}
          {% render 'gv-icon', icon: 'arrow-right', size: 14 %}
        </a>
      {%- endif -%}
    </div>

    <div class="gv-hero-trust">
      <div class="gv-hero-stars" aria-label="5 out of 5 stars">
        {%- for i in (1..5) -%}
          {% render 'gv-icon', icon: 'star', size: 14, class: 'gv-star-icon' %}
        {%- endfor -%}
      </div>
      <p class="gv-hero-trust-text">
        <strong>{{ section.settings.trust_rating }}</strong> {{ section.settings.trust_reviews }}
      </p>
      <div class="gv-hero-trust-divider" aria-hidden="true"></div>
      <p class="gv-hero-trust-text">{{ section.settings.trust_badge }}</p>
    </div>
  </div>

  {%- comment -%} RIGHT: Image or product stack {%- endcomment -%}
  <div class="gv-hero-right">
    <div class="gv-hero-orbs" aria-hidden="true">
      <div class="gv-orb gv-orb-1"></div>
      <div class="gv-orb gv-orb-2"></div>
      <div class="gv-orb gv-orb-3"></div>
    </div>

    {%- if has_image -%}
      {{
        section.settings.hero_image
        | image_url: width: 1200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          class: 'gv-hero-image',
          alt: section.settings.hero_image.alt | default: section.settings.eyebrow | escape,
          widths: '600, 800, 1000, 1200',
          sizes: '(max-width: 768px) 100vw, 50vw'
      }}
    {%- else -%}
      <div class="gv-hero-stack" aria-hidden="true">

        <div class="gv-stack-card gv-stack-card--1">
          <span class="gv-stack-badge">{{ section.settings.stack_badge_1 }}</span>
          {%- if hero_product_1.featured_image -%}
            {{
              hero_product_1.featured_image
              | image_url: width: 280
              | image_tag:
                loading: 'eager',
                class: 'gv-stack-img',
                alt: hero_product_1.featured_image.alt | default: hero_product_1.title | escape,
                width: 280,
                height: 280
            }}
          {%- else -%}
            <div class="gv-stack-img gv-stack-placeholder gv-stack-placeholder--1"></div>
          {%- endif -%}
          <p class="gv-stack-name">{{ hero_product_1.title | default: section.settings.stack_name_1 }}</p>
          <p class="gv-stack-tag">{{ section.settings.stack_tag_1 }}</p>
        </div>

        <div class="gv-stack-card gv-stack-card--2">
          {%- if hero_product_2.featured_image -%}
            {{
              hero_product_2.featured_image
              | image_url: width: 240
              | image_tag:
                loading: 'eager',
                class: 'gv-stack-img',
                alt: hero_product_2.featured_image.alt | default: hero_product_2.title | escape,
                width: 240,
                height: 240
            }}
          {%- else -%}
            <div class="gv-stack-img gv-stack-placeholder gv-stack-placeholder--2"></div>
          {%- endif -%}
          <p class="gv-stack-name">{{ hero_product_2.title | default: section.settings.stack_name_2 }}</p>
          <p class="gv-stack-tag">{{ section.settings.stack_tag_2 }}</p>
        </div>

        <div class="gv-stack-card gv-stack-card--3">
          {%- if hero_product_3.featured_image -%}
            {{
              hero_product_3.featured_image
              | image_url: width: 200
              | image_tag:
                loading: 'lazy',
                class: 'gv-stack-img',
                alt: hero_product_3.featured_image.alt | default: hero_product_3.title | escape,
                width: 200,
                height: 200
            }}
          {%- else -%}
            <div class="gv-stack-img gv-stack-placeholder gv-stack-placeholder--3"></div>
          {%- endif -%}
          <p class="gv-stack-name">{{ hero_product_3.title | default: section.settings.stack_name_3 }}</p>
          <p class="gv-stack-tag">{{ section.settings.stack_tag_3 }}</p>
        </div>

      </div>
    {%- endif -%}
  </div>

</section>

{% stylesheet %}
  .gv-hero {
    min-height: 92vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    background: var(--cream-glow);
  }

  /* ---- Left ---- */
  .gv-hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 60px 80px 80px;
  }

  .gv-hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--coral-pulse);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .gv-hero-eyebrow::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--coral-pulse);
  }

  .gv-hero-headline {
    font-family: var(--font-serif);
    font-size: var(--gv-hero-headline-size);
    font-weight: var(--gv-heading-weight);
    line-height: 1.05;
    color: var(--berry-dark);
    letter-spacing: -0.02em;
    margin-bottom: 28px;
  }
  .gv-hero-headline em { font-style: italic; color: var(--coral-pulse); }

  .gv-hero-subline {
    font-family: var(--font-sans);
    font-size: 17px;
    color: var(--mid-gray);
    line-height: 1.7;
    max-width: 420px;
    margin-bottom: 44px;
  }

  .gv-hero-ctas {
    display: flex;
    gap: 24px;
    align-items: center;
    flex-wrap: wrap;
  }
  .gv-btn-secondary { display: flex; align-items: center; gap: 6px; }

  .gv-hero-trust {
    margin-top: 52px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 32px;
    border-top: 1px solid var(--warm-gray);
    flex-wrap: wrap;
  }
  .gv-hero-stars {
    display: flex;
    gap: 2px;
    color: var(--mango-zest);
  }
  .gv-star-icon { color: var(--mango-zest); }
  .gv-hero-trust-text {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--mid-gray);
  }
  .gv-hero-trust-text strong { color: var(--warm-espresso); font-weight: 600; }
  .gv-hero-trust-divider { width: 1px; height: 32px; background: var(--warm-gray); flex-shrink: 0; }

  /* ---- Right ---- */
  .gv-hero-right {
    position: relative;
    background: linear-gradient(135deg, #FFE8D6 0%, #FFD4BE 40%, #FFBBA0 100%);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Hero image mode */
  .gv-hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  /* Orbs (decorative, hidden behind image) */
  .gv-hero-orbs { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 1; }
  .gv-hero--has-image .gv-hero-orbs { display: none; }
  .gv-orb { position: absolute; border-radius: 50%; opacity: 0.25; }
  .gv-orb-1 { width: 380px; height: 380px; background: radial-gradient(circle, #FF8FA3, #FF6B8A); top: -80px; right: -80px; }
  .gv-orb-2 { width: 200px; height: 200px; background: radial-gradient(circle, #FFC85C, #FFB347); bottom: 60px; left: 40px; }
  .gv-orb-3 { width: 120px; height: 120px; background: radial-gradient(circle, #A8C5A0, #7DAF73); top: 30%; right: 10%; opacity: 0.3; }

  /* ---- Product stack ---- */
  .gv-hero-stack {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .gv-stack-card {
    background: #fff;
    border-radius: 24px;
    padding: 20px;
    position: relative;
  }
  .gv-stack-card--1 { width: 200px; box-shadow: 0 20px 60px rgba(45,27,53,0.14); }
  .gv-stack-card--2 { width: 180px; margin-top: -16px; margin-left: 80px; box-shadow: 0 20px 60px rgba(45,27,53,0.10); }
  .gv-stack-card--3 { width: 160px; margin-top: -16px; margin-left: -60px; box-shadow: 0 20px 60px rgba(45,27,53,0.08); }

  .gv-stack-badge {
    position: absolute;
    top: -10px; right: -10px;
    background: var(--coral-pulse);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }

  .gv-stack-img {
    width: 100%; aspect-ratio: 1;
    object-fit: contain;
    border-radius: 12px;
    display: block;
    margin-bottom: 12px;
  }
  .gv-stack-placeholder { background: linear-gradient(135deg, #FFF3D6, #F4845F44); }
  .gv-stack-placeholder--2 { background: linear-gradient(135deg, #F0EBF8, #9B72AA44); }
  .gv-stack-placeholder--3 { background: linear-gradient(135deg, #FFF8D6, #FFB34744); }

  .gv-stack-name {
    font-family: var(--font-sans);
    font-size: 11px; font-weight: 600;
    color: var(--warm-espresso);
    margin-bottom: 4px;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .gv-stack-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--coral-pulse);
    letter-spacing: 0.05em;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }

  /* ---- Mobile ---- */
  @media (max-width: 768px) {
    .gv-hero { grid-template-columns: 1fr; min-height: auto; }

    /* Image mode mobile: full-bleed image behind text */
    .gv-hero--has-image {
      position: relative;
      min-height: 100svh;
    }
    .gv-hero--has-image .gv-hero-right {
      position: absolute;
      inset: 0;
      z-index: 0;
    }
    .gv-hero--has-image .gv-hero-left {
      position: relative;
      z-index: 1;
      padding: 120px 24px 60px;
      background: linear-gradient(
        to bottom,
        rgba(255,249,244,0.92) 0%,
        rgba(255,249,244,0.75) 60%,
        rgba(255,249,244,0.4) 100%
      );
      min-height: 100svh;
    }

    /* Stack mode mobile: image above, text below */
    .gv-hero:not(.gv-hero--has-image) .gv-hero-right { height: 340px; }
    .gv-hero:not(.gv-hero--has-image) .gv-hero-left { padding: 48px 24px; }

    .gv-hero-headline { font-size: clamp(40px, 10vw, 64px); }
    .gv-hero-trust-divider { display: none; }
    .gv-hero-stack { transform: scale(0.82); transform-origin: center top; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Glowve Hero",
  "tag": "div",
  "class": "glowve-hero-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Hero Image (optional)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Recommended: 1400×900px or taller. When set, replaces the product stack."
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Glow your way."
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline (supports <em> for italic colour)",
      "default": "<p>Skin that <em>glows,</em><br>from ingredients<br>that earn it.</p>"
    },
    {
      "type": "text",
      "id": "subline",
      "label": "Sub-headline",
      "default": "Every formula starts with one question: does this ingredient actually work? No fluff, no filler. Just real actives at real concentrations — made for Pakistan."
    },
    {
      "type": "header",
      "content": "CTAs"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button label",
      "default": "Build My Routine"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Trust bar"
    },
    {
      "type": "text",
      "id": "trust_rating",
      "label": "Rating",
      "default": "4.8 stars"
    },
    {
      "type": "text",
      "id": "trust_reviews",
      "label": "Review count text",
      "default": "across 1,200+ verified reviews"
    },
    {
      "type": "text",
      "id": "trust_badge",
      "label": "Trust badge text",
      "default": "Made for Pakistan. Dermatologist tested."
    },
    {
      "type": "header",
      "content": "Product Stack — Card 1 (shown when no hero image)"
    },
    {
      "type": "product",
      "id": "hero_product_1",
      "label": "Product 1"
    },
    {
      "type": "text",
      "id": "stack_name_1",
      "label": "Fallback name",
      "default": "2% Alpha Arbutin + Vitamin C"
    },
    {
      "type": "text",
      "id": "stack_tag_1",
      "label": "Ingredient tag",
      "default": "Alpha Arbutin · Ethyl Ascorbic Acid"
    },
    {
      "type": "text",
      "id": "stack_badge_1",
      "label": "Badge text",
      "default": "Bestseller"
    },
    {
      "type": "header",
      "content": "Product Stack — Card 2"
    },
    {
      "type": "product",
      "id": "hero_product_2",
      "label": "Product 2"
    },
    {
      "type": "text",
      "id": "stack_name_2",
      "label": "Fallback name",
      "default": "Barrier Renew Moisturizer"
    },
    {
      "type": "text",
      "id": "stack_tag_2",
      "label": "Ingredient tag",
      "default": "Triple Ceramide · Matrixyl 3000™"
    },
    {
      "type": "header",
      "content": "Product Stack — Card 3"
    },
    {
      "type": "product",
      "id": "hero_product_3",
      "label": "Product 3"
    },
    {
      "type": "text",
      "id": "stack_name_3",
      "label": "Fallback name",
      "default": "Matte UV Defence SPF 50+"
    },
    {
      "type": "text",
      "id": "stack_tag_3",
      "label": "Ingredient tag",
      "default": "SPF 50+ PA++++ · Niacinamide"
    }
  ],
  "presets": [{ "name": "Glowve Hero" }]
}
{% endschema %}
