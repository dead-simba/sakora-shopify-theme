          "id": "image",
          "label": "Desktop image",
          "info": "Recommended: 2000x900px landscape."
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Recommended: 800x1000px portrait. Falls back to desktop image if not set."
        },
        {
          "type": "text",
