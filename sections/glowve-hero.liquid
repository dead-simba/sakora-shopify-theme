      "default": "Bestseller"
    },
    {
      "type": "product",
      "id": "hero_product_2",
      "label": "Product 2"
    },
    {
      "type": "text",
      "id": "stack_name_2",
      "label": "Fallback name",
      "default": "Barrier Renew Moisturizer"
    },
    {
      "type": "text",
      "id": "stack_tag_2",
      "label": "Ingredient tag",
      "default": "Triple Ceramide · Matrixyl 3000™"
