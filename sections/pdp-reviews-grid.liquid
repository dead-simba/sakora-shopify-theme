<section class="reviews-section" id="reviews">
  <div class="container">
    <div class="section-label">{{ section.settings.label }}</div>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <div class="reviews-grid">
      {% for block in section.blocks %}
        <div class="review-card">
          <div class="rev-stars">
            {% assign stars = block.settings.stars | times: 1 %}
            {% for i in (1..5) %}
              {% if i <= stars %}★{% else %}☆{% endif %}
            {% endfor %}
          </div>
          <div class="rev-title">"{{ block.settings.title }}"</div>
          <p class="rev-body">{{ block.settings.body }}</p>
          <div class="rev-footer">
            <div>
              <div class="rev-name">{{ block.settings.author }}</div>
              <div class="rev-meta">{{ block.settings.date }}</div>
            </div>
            <div>
              <div class="rev-tags">
                {% if block.settings.tag1 != blank %}<span class="rev-tag">{{ block.settings.tag1 }}</span>{% endif %}
                {% if block.settings.tag2 != blank %}<span class="rev-tag">{{ block.settings.tag2 }}</span>{% endif %}
              </div>
              <div class="verified">✓ Verified Purchase</div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .reviews-section{background:var(--cream-glow, #fff); padding: 80px 0;}
  .reviews-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
  .review-card{background:white;border-radius:16px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.05); border: 1px solid var(--warm-gray, #ECECEC);}
  .rev-stars{color:#FFB800;font-size:14px;letter-spacing:2px;margin-bottom:10px;}
  .rev-title{font-weight:600;font-size:15px;color:var(--berry-dark, #1A1A1A);margin-bottom:10px;}
  .rev-body{font-size:14px;color:var(--mid-gray, #666);line-height:1.65;margin-bottom:18px;}
  .rev-footer{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:8px;}
  .rev-name{font-weight:500;font-size:13px;color:var(--berry-dark, #1A1A1A);}
  .rev-meta{font-size:12px;color:var(--mid-gray, #666);}
  .rev-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;}
  .rev-tag{font-family:var(--font-mono);font-size:10px;padding:3px 9px;border-radius:100px;background:var(--accent-light, #FFF0E6);color:var(--accent, #FF4D8D);}
  .verified{font-size:11px;color:#2E7D32;margin-top:4px; text-align: right;}
  
  @media(max-width:900px){
    .reviews-grid{grid-template-columns:1fr;}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "PDP Reviews Grid",
  "settings": [
    {
      "type": "text", "id": "label", "label": "Label", "default": "Early reviews"
    },
    {
      "type": "text", "id": "title", "label": "Title", "default": "From people who tried it first."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review Title" },
        { "type": "textarea", "id": "body", "label": "Review Body" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "date", "label": "Date/Location" },
        { "type": "text", "id": "tag1", "label": "Tag 1" },
        { "type": "text", "id": "tag2", "label": "Tag 2" }
      ]
    }
  ],
  "presets": [
    { "name": "PDP Reviews Grid" }
  ]
}
{% endschema %}
