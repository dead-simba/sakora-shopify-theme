    "pdp_faq": {
      "type": "glowve-pdp-faq",
      "blocks": {
        "faq_1": {
          "type": "item",
          "settings": {
            "question": "Can I use this if I have sensitive skin?",
            "answer": "<p>Yes — but start every other night for two weeks. Alpha Arbutin at 2% is generally well-tolerated. If you experience persistent redness or stinging, stop and consult a dermatologist. The fragrance-free formula helps but everyone's skin is different.</p>"
          }
        },
        "faq_2": {
          "type": "item",
          "settings": {
            "question": "Does this actually work on melasma?",
            "answer": "<p>Alpha Arbutin + Tranexamic Acid is one of the most clinically studied combinations for melasma. Takes 8–12 weeks for significant change and requires consistent daily SPF for results to hold. Many customers have shared their melasma results — they're genuinely impressive.</p>"
          }
        },
        "faq_3": {
          "type": "item",
          "settings": {
            "question": "Can I layer this with Vitamin C from another brand?",
            "answer": "<p>This serum already contains Ethyl Ascorbic Acid — a stable Vit C. Adding more from another product can cause sensitivity. Use this as your single Vit C source. Message us on WhatsApp if you need help building the right layering order for your routine.</p>"
          }
        },
        "faq_4": {
          "type": "item",
          "settings": {
            "question": "What order does it go in my routine?",
            "answer": "<p>On clean dry skin before moisturiser. AM: Cleanser → Serum → Moisturiser → SPF. PM: Double Cleanse → Serum → Moisturiser. Wait 30 seconds between serum and moisturiser.</p>"
          }
        },
        "faq_5": {
          "type": "item",
          "settings": {
            "question": "Is cash on delivery available?",
            "answer": "<p>Yes! COD available across all major cities — Karachi, Lahore, Islamabad, Rawalpindi, Faisalabad, Multan, Hyderabad, Peshawar, Quetta, Sialkot, Gujranwala, and more. No advance payment. Pay when it arrives at your door.</p>"
          }
        }
      },
