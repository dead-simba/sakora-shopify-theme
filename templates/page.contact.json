    "contact_faq": {
      "type": "glowve-page-faq",
      "blocks": {
        "faq_1": {
          "type": "item",
          "settings": {
            "question": "Can I change my order after placing it?",
            "answer": "<p>Yes — if your order hasn't been dispatched yet. Message us on WhatsApp or email hello@glowve.pk as soon as possible with your order number. We process orders quickly, so the sooner the better.</p>"
          }
        },
        "faq_2": {
          "type": "item",
          "settings": {
            "question": "What if my product arrives damaged?",
            "answer": "<p>Send us a photo of the damage at hello@glowve.pk or via WhatsApp. We'll send a replacement within 48 hours. No questions, no returns needed — we just fix it.</p>"
          }
        },
        "faq_3": {
          "type": "item",
          "settings": {
            "question": "Do you ship to my city?",
            "answer": "<p>We deliver to all major cities across Pakistan — including Karachi, Lahore, Islamabad, Rawalpindi, Faisalabad, Multan, Hyderabad, Peshawar, Quetta, Sialkot, Gujranwala, and Abbottabad. Don't see your city? Message us and we'll work it out.</p>"
          }
        },
        "faq_4": {
          "type": "item",
          "settings": {
            "question": "Can I return a product I've opened?",
            "answer": "<p>Unfortunately we can only accept returns on unopened products in original packaging within 7 days of delivery. If a product is reacting with your skin, message us — we want to understand what happened and help you find what works.</p>"
          }
        },
        "faq_5": {
          "type": "item",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>Use our order tracking page — just enter your order number and email. You'll also receive tracking updates by email once your order is dispatched.</p>"
          }
        }
      },
      "block_order": [
        "faq_1",
