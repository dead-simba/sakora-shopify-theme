    "supporting": {
      "type": "glowve-ingredients-supporting",
      "blocks": {
        "niacin": {
          "type": "ingredient",
          "settings": {
            "name": "Niacinamide",
            "icon": "💊",
            "badge": "Multi-tasker",
            "gradient": "linear-gradient(135deg, #FFF0F5, #FF85B0)",
            "image": "shopify://shop_images/FT_Ing_Niacinamide.webp",
            "inci": "NIACINAMIDE · VITAMIN B3",
            "short_fn": "Minimises pores, evens skin tone, and strengthens the barrier. In every single Glowve product.",
            "desc": "Niacinamide is a form of Vitamin B3 — one of the most well-researched skincare actives available. It works at the level of the skin barrier, pores, and tone simultaneously. Unlike single-action actives, it addresses multiple concerns without irritation, making it compatible with virtually every skin type including sensitised and acne-prone skin.",
            "why_label": "Why it's in every product",
            "why": "It's in every single Glowve product because it makes other actives work better. It calms inflammation triggered by stronger actives like Alpha-Arbutin and Tranexamic Acid, reinforces the barrier after UV exposure in Daylite, and stabilises the moisture network in Soft Reset.",
            "prod_1": "fade-theory",
            "prod_2": "soft-reset-moisturizer",
            "prod_3": "daylite-spf-50-sunscreen"
          }
        },
        "ha": {
          "type": "ingredient",
          "settings": {
            "name": "Sodium Hyaluronate",
            "icon": "💧",
            "badge": "Humectant",
            "gradient": "linear-gradient(135deg, #E0F4FF, #5BB8F5)",
            "image": "shopify://shop_images/BR_Ing_Hyaluronic.webp",
            "inci": "SODIUM HYALURONATE · LOW MOLECULAR WEIGHT HA",
            "short_fn": "Penetrates deeper than standard HA to hydrate from within — not just the surface.",
            "desc": "Sodium Hyaluronate is the sodium salt form of Hyaluronic Acid — smaller in molecular size, which means it penetrates beyond the skin surface into the upper dermis. It can hold up to 1,000 times its own weight in water, pulling moisture from the environment and deeper skin layers to the surface.",
            "why_label": "Why we use the low-molecular form",
            "why": "We use the low-molecular-weight form specifically because it works deeper than standard HA. It ensures that actives like Alpha-Arbutin and ceramides are delivered into a well-hydrated skin environment — hydrated skin absorbs actives significantly more effectively than dry skin.",
            "prod_1": "fade-theory",
            "prod_2": "soft-reset-moisturizer",
            "prod_3": "daylite-spf-50-sunscreen"
          }
        },
        "tranex": {
          "type": "ingredient",
          "settings": {
            "name": "Tranexamic Acid",
            "icon": "🔬",
            "badge": "Brightening",
            "gradient": "linear-gradient(135deg, #F5E8FF, #B06FD8)",
            "image": "shopify://shop_images/FT_Ing_TranexamicAcid.webp",
            "inci": "TRANEXAMIC ACID",
            "short_fn": "Blocks melanin transfer at a second pathway — works alongside Alpha-Arbutin for double the brightening effect.",
            "desc": "Tranexamic Acid was originally developed as a blood-clotting medication, but dermatologists discovered it inhibits melanin synthesis through a completely different pathway than arbutin or Vitamin C. It disrupts the communication between keratinocytes and melanocytes — stopping the signal that triggers pigment production in the first place.",
            "why_label": "Why it pairs with Alpha-Arbutin",
            "why": "Alpha-Arbutin blocks tyrosinase. Tranexamic Acid blocks the UV-induced signal that activates melanocytes. These are two separate pathways — which means together they create a double block on hyperpigmentation. This combination is particularly effective for PIH on South Asian and darker skin tones, where PIH tends to be deeper and more persistent.",
            "prod_1": "fade-theory",
            "prod_2": "",
            "prod_3": ""
          }
        },
        "pant": {
          "type": "ingredient",
          "settings": {
            "name": "Panthenol (Vitamin B5)",
            "icon": "🍯",
            "badge": "Humectant · Healing",
            "gradient": "linear-gradient(135deg, #FFF8D6, #F5C842)",
            "image": "shopify://shop_images/BR_Ing_Panthenol.webp",
            "inci": "PANTHENOL · PRO-VITAMIN B5",
            "short_fn": "Locks moisture in and accelerates skin healing. Essential for barrier repair and serum comfort.",
            "desc": "Panthenol (Pro-Vitamin B5) converts to Pantothenic Acid on the skin, where it plays a direct role in tissue repair and barrier maintenance. It's a humectant — meaning it draws water into the skin — but unlike HA, it also has film-forming properties that create a light protective layer on the surface.",
            "why_label": "Why it's in both the serum and moisturizer",
            "why": "In Fade Theory, it keeps the skin comfortable and calm while actives do their work — preventing the tightness or sensitivity some people experience with brightening serums. In Soft Reset, it's part of the complete repair system: ceramides rebuild the wall, panthenol keeps it hydrated and heals any micro-damage.",
            "prod_1": "fade-theory",
            "prod_2": "soft-reset-moisturizer",
            "prod_3": ""
          }
        },
        "zinc": {
          "type": "ingredient",
          "settings": {
            "name": "Zinc PCA",
            "icon": "🪨",
            "badge": "Sebum Control",
            "gradient": "linear-gradient(135deg, #F0F0F0, #A0A0A0)",
            "image": "shopify://shop_images/DL_Ing_Zinc_PCA.webp",
            "inci": "ZINC PCA · ZINC L-PYRROLIDONE CARBOXYLATE",
            "short_fn": "Controls sebum without drying. Keeps Daylite matte in Pakistani summer heat.",
            "desc": "Zinc PCA is the zinc salt of Pyrrolidone Carboxylic Acid — a naturally occurring moisturising factor in skin. It regulates sebaceous gland activity, reducing excess oil production without disrupting the skin's moisture balance. Unlike astringents that strip oil forcefully, Zinc PCA works at the cellular level to normalise sebum output.",
            "why_label": "Why it's essential in a Pakistani climate SPF",
            "why": "Pakistan's summers mean 38°C heat and 70–80% humidity. Most sunscreens become greasy and pill within an hour. Zinc PCA is what keeps Daylite matte throughout the day — controlling oil without drying the skin, so SPF reapplication doesn't feel like adding another layer of grease.",
            "prod_1": "",
            "prod_2": "",
            "prod_3": "daylite-spf-50-sunscreen"
          }
        },
        "licorice": {
          "type": "ingredient",
          "settings": {
            "name": "Licorice Root Extract",
            "icon": "🌿",
            "badge": "Botanical Brightening",
            "gradient": "linear-gradient(135deg, #F5ECD6, #C4944A)",
            "image": "shopify://shop_images/FT_Ing_Glabra.webp",
            "inci": "GLYCYRRHIZA GLABRA ROOT EXTRACT",
            "short_fn": "Botanical brightening and anti-inflammatory. A gentler complement to the brightening actives.",
            "desc": "Glycyrrhiza Glabra (Licorice) Root Extract contains Glabridin — a compound that inhibits tyrosinase activity and has significant anti-inflammatory properties. Unlike synthetic actives, it also soothes the skin at the same time it brightens, making it particularly well-suited for sensitised or post-acne skin.",
            "why_label": "Why a botanical alongside synthetics",
            "why": "Brightening actives like Alpha-Arbutin and Tranexamic Acid are effective, but they work most efficiently when inflammation is minimised. Licorice Root Extract acts as a calming support — reducing the baseline inflammation that drives post-acne hyperpigmentation in the first place, while adding a third brightening mechanism to the formula.",
            "prod_1": "fade-theory",
            "prod_2": "",
            "prod_3": ""
          }
        },
        "allant": {
          "type": "ingredient",
          "settings": {
            "name": "Allantoin",
            "icon": "🌱",
            "badge": "Soothing · Renewal",
            "gradient": "linear-gradient(135deg, #E8F5E4, #5DAF57)",
            "image": "shopify://shop_images/BR_Ing_Allantoin.webp",
            "inci": "ALLANTOIN · FROM COMFREY PLANT",
            "short_fn": "Speeds cell renewal and soothes redness — makes actives tolerable even for sensitive skin.",
            "desc": "Allantoin is a naturally occurring compound found in comfrey root. It promotes skin cell proliferation — the process of generating new skin cells to replace damaged ones — while simultaneously reducing irritation and redness. It's considered a \"skin normaliser\" because it works on both damaged and healthy skin.",
            "why_label": "Why it's the peacemaker in our formulas",
            "why": "Formulas with multiple active ingredients can cause irritation in sensitive skin. Allantoin acts as the buffer — it accelerates cell turnover so the skin clears damage faster, while soothing any irritation that actives might trigger. In Soft Reset, it supports the ceramide complex by speeding up natural barrier recovery.",
            "prod_1": "fade-theory",
            "prod_2": "soft-reset-moisturizer",
            "prod_3": ""
          }
        },
        "toco": {
          "type": "ingredient",
          "settings": {
            "name": "Tocopherol (Vitamin E)",
            "icon": "🌻",
            "badge": "Antioxidant",
            "gradient": "linear-gradient(135deg, #FFF3D6, #F5A623)",
            "image": "shopify://shop_images/Sunscreen.webp",
            "inci": "TOCOPHEROL / TOCOPHERYL ACETATE · VITAMIN E",
            "short_fn": "Antioxidant shield against UV damage and pollution. Amplifies the effect of other antioxidants.",
            "desc": "Tocopherol is the active form of Vitamin E — a fat-soluble antioxidant that neutralises free radicals generated by UV exposure, pollution, and oxidative stress. In skincare, it works synergistically with other antioxidants: Vitamin C (Ascorbic Acid derivatives) + Vitamin E together are significantly more effective than either alone.",
            "why_label": "Why antioxidants belong in both moisturizer and SPF",
            "why": "In Soft Reset, Tocopherol protects the ceramide barrier from oxidative breakdown — ceramides can degrade under UV and pollution stress without antioxidant support. In Daylite, it works alongside UV filters to neutralise the free radicals that filters miss, extending the effective protection beyond just SPF numbers.",
            "prod_1": "",
            "prod_2": "soft-reset-moisturizer",
            "prod_3": "daylite-spf-50-sunscreen"
          }
        },
        "peptide": {
          "type": "ingredient",
          "settings": {
            "name": "Matrixyl Peptides",
            "icon": "🧬",
            "badge": "Signal Peptides",
            "gradient": "linear-gradient(135deg, #EBE8FF, #7C5CBF)",
            "image": "shopify://shop_images/BR_-_Matrixyl_3000_Sederma.webp",
            "inci": "PALMITOYL TRIPEPTIDE-1 · PALMITOYL TETRAPEPTIDE-7",
            "short_fn": "Signal peptides that boost collagen production in the dermis.",
            "desc": "Palmitoyl Tripeptide-1 and Tetrapeptide-7 are the two peptides that make up Matrixyl 3000 — one of the most studied peptide complexes in cosmetic dermatology. They are signal peptides: they mimic fragments of damaged collagen, tricking the skin into activating collagen synthesis as if it were repairing a wound — without any actual injury.",
            "why_label": "Why collagen peptides belong in a barrier moisturizer",
            "why": "A barrier repair moisturizer that only fixes the top layer of skin misses an opportunity. The dermis — where collagen lives — is what gives skin its structure and resilience. Including Matrixyl peptides means Soft Reset works on two levels simultaneously: restoring the outer barrier with ceramides while signalling the dermis to produce more collagen underneath.",
            "prod_1": "",
            "prod_2": "soft-reset-moisturizer",
            "prod_3": ""
          }
        }
      },
