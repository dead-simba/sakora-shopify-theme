    "refused": {
      "type": "glowve-ingredients-refused",
      "blocks": {
        "hydro": {
          "type": "ingredient",
          "settings": {
            "name": "Hydroquinone",
            "why": "The most common bleaching agent in Pakistani fairness products. Linked to ochronosis with long-term use. We use alpha-arbutin instead — same pathway, no risk."
          }
        },
        "parab": {
          "type": "ingredient",
          "settings": {
            "name": "Parabens",
            "why": "Preservatives flagged for hormone disruption at accumulative doses. We use phenoxyethanol + ethylhexylglycerin — equally effective, cleaner profile."
          }
        },
        "mineral": {
          "type": "ingredient",
          "settings": {
            "name": "Mineral Oil",
            "why": "Cheap occlusive that sits on top of skin and does nothing for barrier repair. Our ceramide + cholesterol complex actually rebuilds it."
          }
        },
        "color": {
          "type": "ingredient",
          "settings": {
            "name": "Artificial Colorants",
            "why": "No colour ingredient in any of our formulas serves a function. If it doesn't do something, it doesn't go in."
          }
        },
        "bleach": {
          "type": "ingredient",
          "settings": {
            "name": "Bleaching Agents",
            "why": "Mercury, kojic acid at unregulated concentrations, and other depigmenting agents found in fairness creams. We brighten, we don't bleach."
          }
        },
        "sls": {
          "type": "ingredient",
          "settings": {
            "name": "SLS / SLES",
            "why": "Harsh surfactants that strip the skin barrier. Already compromised skin gets worse with every wash. Not in anything we make."
          }
        },
        "phthal": {
          "type": "ingredient",
          "settings": {
            "name": "Phthalates",
            "why": "Plasticiser chemicals used as fragrance carriers — with an endocrine disruption risk profile we're not comfortable with. Zero in our range."
          }
        },
        "steroid": {
          "type": "ingredient",
          "settings": {
            "name": "Steroid / Corticosteroid",
            "why": "Widely misused in Pakistani skin lightening creams. Temporarily clears skin while thinning it permanently. Never, under any circumstance."
          }
        }
      },
