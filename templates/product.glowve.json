            "price_card": {
              "type": "price",
              "settings": { "show_sale_price_first": true, "type_preset": "h6", "font_size": "1rem" },
              "blocks": {}
            }
          },
          "block_order": ["product_card_gallery", "product_title", "price_card"]
        }
      },
      "block_order": ["text_recs_header"],
      "settings": {
        "product": "{{ closest.product }}",
        "recommendation_type": "related",
        "layout_type": "grid",
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "section_width": "page-width",
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
