    "pdp_recs": {
      "type": "product-recommendations",
      "blocks": {
        "text_recs_header": {
          "type": "text",
          "name": "Header",
          "settings": {
            "text": "<h3>You may also like</h3>",
            "type_preset": "h4",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "Product card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "inherit_color_scheme": true,
            "border": "none",
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 8,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "settings": { "image_ratio": "adapt", "border": "none", "border_radius": 0 },
